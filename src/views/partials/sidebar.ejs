<% currentPage = typeof currentPage !== 'undefined' ? currentPage : '' %>
<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>
<aside class="sidebar glass" id="sidebar">
  <div class="sidebar-header">
    <i class="fas fa-bolt"></i>
    <span>FX9 Dashboard</span>
    <button class="sidebar-close" onclick="closeSidebar()">
      <i class="fas fa-times"></i>
    </button>
  </div>

  <button class="sidebar-collapse-btn" onclick="toggleSidebarMode()" title="طي القائمة">
    <i class="fas fa-chevron-right" id="collapseIcon"></i>
  </button>

  <nav class="sidebar-nav">
    <div class="nav-section">
      <span class="nav-section-title"><i class="fas fa-star"></i> <span>الرئيسية</span></span>
      <a href="/home" class="nav-link <%= currentPage === 'home' ? 'active' : '' %>" title="الصفحة الرئيسية">
        <i class="fas fa-home"></i>
        <span>الصفحة الرئيسية</span>
      </a>
      <a href="/dashboard" class="nav-link <%= currentPage === 'dashboard' ? 'active' : '' %> <%= roleLevel >= 3 ? '' : 'locked' %>" data-req="3" title="لوحة التحكم">
        <i class="fas fa-th-large"></i>
        <span>لوحة التحكم</span>
        <% if (roleLevel < 3) { %><i class="fas fa-lock nav-lock"></i><% } %>
      </a>
      <a href="/guilds" class="nav-link <%= currentPage === 'guilds' ? 'active' : '' %>" title="السيرفرات">
        <i class="fas fa-server"></i>
        <span>السيرفرات</span>
      </a>
      <a href="/status" class="nav-link <%= currentPage === 'status' ? 'active' : '' %>" title="حالة البوت">
        <i class="fas fa-heartbeat"></i>
        <span>حالة البوت</span>
      </a>
    </div>

    <% if (locals.guild) { %>
    <div class="nav-section">
      <span class="nav-section-title"><i class="fas fa-cog"></i> <span><%= guild.name %></span></span>
      <a href="/guilds/<%= guild.id %>" class="nav-link <%= currentPage === 'guild-overview' ? 'active' : '' %>" title="نظرة عامة">
        <i class="fas fa-info-circle"></i>
        <span>نظرة عامة</span>
      </a>
      <a href="/settings/<%= guild.id %>" class="nav-link <%= currentPage === 'settings' ? 'active' : '' %> <%= roleLevel >= 2 ? '' : 'locked' %>" data-req="2" title="الإعدادات">
        <i class="fas fa-sliders-h"></i>
        <span>الإعدادات</span>
        <% if (roleLevel < 2) { %><i class="fas fa-lock nav-lock"></i><% } %>
      </a>
      <a href="/commands/<%= guild.id %>" class="nav-link <%= currentPage === 'commands' ? 'active' : '' %> <%= roleLevel >= 2 ? '' : 'locked' %>" data-req="2" title="الأوامر">
        <i class="fas fa-terminal"></i>
        <span>الأوامر</span>
        <% if (roleLevel < 2) { %><i class="fas fa-lock nav-lock"></i><% } %>
      </a>
      <a href="/tickets/<%= guild.id %>" class="nav-link <%= currentPage === 'tickets' ? 'active' : '' %>" title="التذاكر">
        <i class="fas fa-ticket-alt"></i>
        <span>التذاكر</span>
      </a>
      <a href="/voice/<%= guild.id %>" class="nav-link <%= currentPage === 'voice' ? 'active' : '' %> <%= roleLevel >= 1 ? '' : 'locked' %>" data-req="1" title="الرومات المؤقتة">
        <i class="fas fa-microphone"></i>
        <span>الرومات المؤقتة</span>
        <% if (roleLevel < 1) { %><i class="fas fa-lock nav-lock"></i><% } %>
      </a>
      <a href="/logs/<%= guild.id %>" class="nav-link <%= currentPage === 'logs' ? 'active' : '' %> <%= roleLevel >= 1 ? '' : 'locked' %>" data-req="1" title="سجل النشاط">
        <i class="fas fa-history"></i>
        <span>سجل النشاط</span>
        <% if (roleLevel < 1) { %><i class="fas fa-lock nav-lock"></i><% } %>
      </a>
      <a href="/notifications/<%= guild.id %>" class="nav-link <%= currentPage === 'notifications' ? 'active' : '' %> <%= roleLevel >= 1 ? '' : 'locked' %>" data-req="1" title="الإشعارات">
        <i class="fas fa-bell"></i>
        <span>الإشعارات</span>
        <% if (roleLevel < 1) { %><i class="fas fa-lock nav-lock"></i><% } %>
      </a>
      <a href="/protection/<%= guild.id %>" class="nav-link <%= currentPage === 'protection' ? 'active' : '' %> <%= roleLevel >= 2 ? '' : 'locked' %>" data-req="2" title="الحماية">
        <i class="fas fa-shield-alt"></i>
        <span>الحماية</span>
        <% if (roleLevel < 2) { %><i class="fas fa-lock nav-lock"></i><% } %>
      </a>
      <a href="/admins/<%= guild.id %>" class="nav-link <%= currentPage === 'admins' ? 'active' : '' %> <%= roleLevel >= 3 ? '' : 'locked' %>" data-req="3" title="المدراء">
        <i class="fas fa-users-cog"></i>
        <span>المدراء</span>
        <% if (roleLevel < 3) { %><i class="fas fa-lock nav-lock"></i><% } %>
      </a>
      <a href="/backup/<%= guild.id %>" class="nav-link <%= currentPage === 'backup' ? 'active' : '' %> <%= roleLevel >= 3 ? '' : 'locked' %>" data-req="3" title="النسخ الاحتياطي">
        <i class="fas fa-database"></i>
        <span>النسخ الاحتياطي</span>
        <% if (roleLevel < 3) { %><i class="fas fa-lock nav-lock"></i><% } %>
      </a>
    </div>
    <% } %>

    <div class="nav-section">
      <span class="nav-section-title"><i class="fas fa-ellipsis-h"></i> <span>أخرى</span></span>
      <a href="/docs" class="nav-link <%= currentPage === 'docs' ? 'active' : '' %>" title="التوثيق">
        <i class="fas fa-book"></i>
        <span>التوثيق</span>
      </a>
      <a href="/dev" class="nav-link <%= currentPage === 'dev' ? 'active' : '' %> <%= roleLevel >= 4 ? '' : 'locked' %>" data-req="4" title="لوحة المطور">
        <i class="fas fa-code"></i>
        <span>لوحة المطور</span>
        <% if (roleLevel < 4) { %><i class="fas fa-lock nav-lock"></i><% } %>
      </a>
    </div>
  </nav>

  <div class="sidebar-footer">
    <div class="bot-status" id="botStatus">
      <span class="status-dot online"></span>
      <span class="status-text">البوت متصل</span>
    </div>
    <a href="/auth/logout" class="sidebar-logout" title="تسجيل الخروج">
      <i class="fas fa-sign-out-alt"></i>
      <span>تسجيل الخروج</span>
    </a>
    <div class="sidebar-resize-handle" onclick="toggleSidebarMode()">
      <i class="fas fa-chevron-right"></i>
    </div>
  </div>
</aside>
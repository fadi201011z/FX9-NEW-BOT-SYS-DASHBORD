<%# The rail. `currentPage` and `perms` are defaulted here because this partial is
    included by every view on the layout, including the ones a logged-out visitor
    can reach -- the original assignment (not a declaration) is deliberate: an
    include() is compiled into the including template's function body, so a const
    would collide with the host view's own `perms`. --%>
<% currentPage = typeof currentPage !== 'undefined' ? currentPage : '' %>
<% perms = (typeof perms !== 'undefined' && perms) ? perms : { level: -1, role: 'guest', roleLabel: 'زائر', isOwner: false, isDeveloper: false, inGuild: false, can: {} } %>

<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<aside class="sidebar" id="sidebar" aria-label="قائمة التنقل">
  <div class="sidebar-header">
    <i class="fas fa-bolt" aria-hidden="true"></i>
    <span>Kratos</span>
    <button class="sidebar-close" type="button" onclick="closeSidebar()" aria-label="إغلاق القائمة">
      <i class="fas fa-times" aria-hidden="true"></i>
    </button>
  </div>

  <% if (locals.guild) { %>
  <div class="sidebar-role" data-tip="منصبك في هذا السيرفر">
    <i class="fas fa-id-badge" aria-hidden="true"></i>
    <span class="sidebar-role-label"><%= perms.roleLabel %></span>
    <% if (perms.isDeveloper) { %><span class="sidebar-role-dev">مطور</span><% } %>
  </div>
  <% } %>

  <button class="sidebar-collapse-btn" type="button" onclick="toggleSidebarMode()" data-tip="طي القائمة" aria-label="طي القائمة أو توسيعها">
    <i class="fas fa-chevron-right" id="collapseIcon" aria-hidden="true"></i>
  </button>

  <nav class="sidebar-nav">
    <%# The four pages the site is made of, in the order they were asked for, and
        the only four in this section.

        لوحة التحكم and السيرفرات used to sit here as well. They are gone from the
        rail on purpose: this section is the list of where you can *go*, and
        neither of them is that -- both are places you configure a server, so both
        belong to the server's own section, which is where the other twelve
        per-guild pages already live. Neither is unreachable: the home page's grid
        links to both, and so does the account menu.

        Nothing here is permission-gated, so no data-req and no lock icon. That was
        never true of these four and it is worth saying, because the section below
        is full of them and the absence here would otherwise look like a mistake.

        The whole section is absent inside a server. The rail's first row is /home
        and it is there on every page, so on a guild page the way back to all four
        is one press in a column that does not change -- and a second copy of the
        same four links, a scroll under the server's own twelve, would say the site
        and the server are two places you stand side by side. They are not: the
        server is the part of the site you are inside.

        What that costs is one hop, and it is worth being exact about which: on a
        guild page, /docs and /status are no longer one press away -- both are
        linked from /home, which is where the rail's home row goes. /about was
        reachable from this rail and from nowhere else in the shell, so /home links
        it too now. Nothing is stranded; all three are a press and a half instead
        of a press. -%>
    <% if (!locals.guild) { %>
    <div class="nav-section">
      <span class="nav-section-title"><i class="fas fa-compass" aria-hidden="true"></i> <span>الرئيسية</span></span>
      <a href="/home" class="nav-link <%= currentPage === 'home' ? 'active' : '' %>" data-tip="الصفحة الرئيسية" aria-label="الصفحة الرئيسية"<% if (currentPage === 'home') { %> aria-current="page"<% } %>>
        <i class="fas fa-home" aria-hidden="true"></i>
        <span>الصفحة الرئيسية</span>
      </a>
      <a href="/docs" class="nav-link <%= currentPage === 'docs' ? 'active' : '' %>" data-tip="الدليل الشامل" aria-label="الدليل الشامل"<% if (currentPage === 'docs') { %> aria-current="page"<% } %>>
        <i class="fas fa-book" aria-hidden="true"></i>
        <span>الدليل الشامل</span>
      </a>
      <a href="/about" class="nav-link <%= currentPage === 'about' ? 'active' : '' %>" data-tip="نبذة عنا" aria-label="نبذة عنا"<% if (currentPage === 'about') { %> aria-current="page"<% } %>>
        <i class="fas fa-address-card" aria-hidden="true"></i>
        <span>نبذة عنا</span>
      </a>
      <a href="/status" class="nav-link <%= currentPage === 'status' ? 'active' : '' %>" data-tip="حالة البوت" aria-label="حالة البوت"<% if (currentPage === 'status') { %> aria-current="page"<% } %>>
        <i class="fas fa-heartbeat" aria-hidden="true"></i>
        <span>حالة البوت</span>
      </a>
    </div>
    <% } %>

    <% if (locals.guild) { %>
    <div class="nav-section">
      <%# The only section on a server page, and that is the point of it: inside a
          guild the site section above is gone, so this column is nothing but this
          server, top to bottom. The way out is not here -- it is the first row of
          the server rail, which is on every page and does not change when you
          enter a guild. It was a card here once, above this title, and it was
          both a second way out and a control whose lifetime had to be kept in step
          with this block's by hand. One column and one rule is fewer moving parts,
          and one less thing that can be in two places at once. -%>
      <span class="nav-section-title"><i class="fas fa-server" aria-hidden="true"></i> <span><%= guild.name %></span></span>
      <a href="/guilds/<%= guild.id %>" class="nav-link <%= currentPage === 'guild-overview' ? 'active' : '' %>" data-tip="نظرة عامة" aria-label="نظرة عامة"<% if (currentPage === 'guild-overview') { %> aria-current="page"<% } %>>
        <i class="fas fa-circle-info" aria-hidden="true"></i>
        <span>نظرة عامة</span>
      </a>
      <a href="/settings/<%= guild.id %>" class="nav-link <%= currentPage === 'settings' ? 'active' : '' %> <%= perms.can.settings ? '' : 'locked' %>" data-req="2" data-tip="الإعدادات" aria-label="الإعدادات"<% if (currentPage === 'settings') { %> aria-current="page"<% } %>>
        <i class="fas fa-sliders" aria-hidden="true"></i>
        <span>الإعدادات</span>
        <% if (!perms.can.settings) { %><i class="fas fa-lock nav-lock" aria-hidden="true"></i><% } %>
      </a>
      <a href="/commands/<%= guild.id %>" class="nav-link <%= currentPage === 'commands' ? 'active' : '' %> <%= perms.can.commands ? '' : 'locked' %>" data-req="2" data-tip="الأوامر" aria-label="الأوامر"<% if (currentPage === 'commands') { %> aria-current="page"<% } %>>
        <i class="fas fa-terminal" aria-hidden="true"></i>
        <span>الأوامر</span>
        <% if (!perms.can.commands) { %><i class="fas fa-lock nav-lock" aria-hidden="true"></i><% } %>
      </a>
      <a href="/tickets/<%= guild.id %>" class="nav-link <%= currentPage === 'tickets' ? 'active' : '' %> <%= perms.can.tickets ? '' : 'locked' %>" data-req="0" data-tip="التذاكر" aria-label="التذاكر"<% if (currentPage === 'tickets') { %> aria-current="page"<% } %>>
        <i class="fas fa-ticket" aria-hidden="true"></i>
        <span>التذاكر</span>
        <% if (!perms.can.tickets) { %><i class="fas fa-lock nav-lock" aria-hidden="true"></i><% } %>
      </a>
      <a href="/voice/<%= guild.id %>" class="nav-link <%= currentPage === 'voice' ? 'active' : '' %> <%= perms.can.voice ? '' : 'locked' %>" data-req="1" data-tip="الرومات المؤقتة" aria-label="الرومات المؤقتة"<% if (currentPage === 'voice') { %> aria-current="page"<% } %>>
        <i class="fas fa-microphone" aria-hidden="true"></i>
        <span>الرومات المؤقتة</span>
        <% if (!perms.can.voice) { %><i class="fas fa-lock nav-lock" aria-hidden="true"></i><% } %>
      </a>
      <a href="/logs/<%= guild.id %>" class="nav-link <%= currentPage === 'logs' ? 'active' : '' %> <%= perms.can.logs ? '' : 'locked' %>" data-req="1" data-tip="سجل النشاط" aria-label="سجل النشاط"<% if (currentPage === 'logs') { %> aria-current="page"<% } %>>
        <i class="fas fa-clock-rotate-left" aria-hidden="true"></i>
        <span>سجل النشاط</span>
        <% if (!perms.can.logs) { %><i class="fas fa-lock nav-lock" aria-hidden="true"></i><% } %>
      </a>
      <a href="/notifications/<%= guild.id %>" class="nav-link <%= currentPage === 'notifications' ? 'active' : '' %> <%= perms.can.notifications ? '' : 'locked' %>" data-req="1" data-tip="الإشعارات" aria-label="الإشعارات"<% if (currentPage === 'notifications') { %> aria-current="page"<% } %>>
        <i class="fas fa-bell" aria-hidden="true"></i>
        <span>الإشعارات</span>
        <% if (!perms.can.notifications) { %><i class="fas fa-lock nav-lock" aria-hidden="true"></i><% } %>
      </a>
      <a href="/protection/<%= guild.id %>" class="nav-link <%= currentPage === 'protection' ? 'active' : '' %> <%= perms.can.protection ? '' : 'locked' %>" data-req="2" data-tip="الحماية" aria-label="الحماية"<% if (currentPage === 'protection') { %> aria-current="page"<% } %>>
        <i class="fas fa-shield" aria-hidden="true"></i>
        <span>الحماية</span>
        <% if (!perms.can.protection) { %><i class="fas fa-lock nav-lock" aria-hidden="true"></i><% } %>
      </a>
      <a href="/premium/<%= guild.id %>" class="nav-link <%= currentPage === 'premium' ? 'active' : '' %> <%= perms.can.premium ? '' : 'locked' %>" data-req="2" data-tip="نظام البريميوم" aria-label="نظام البريميوم" id="premiumSideLink"<% if (currentPage === 'premium') { %> aria-current="page"<% } %>>
        <i class="fas fa-gem" aria-hidden="true"></i>
        <span>نظام البريميوم</span>
        <% if (locals.premiumStatus && locals.premiumStatus.active) { %>
          <span class="premium-side-dot" id="premiumSideDot">
            <span class="dot"></span><%= locals.premiumStatus.planLabel %>
          </span>
        <% } %>
        <% if (!perms.can.premium) { %><i class="fas fa-lock nav-lock" aria-hidden="true"></i><% } %>
      </a>
      <a href="/admins/<%= guild.id %>" class="nav-link <%= currentPage === 'admins' ? 'active' : '' %> <%= perms.can.admins ? '' : 'locked' %>" data-req="3" data-tip="المدراء" aria-label="المدراء"<% if (currentPage === 'admins') { %> aria-current="page"<% } %>>
        <i class="fas fa-user-gear" aria-hidden="true"></i>
        <span>المدراء</span>
        <% if (!perms.can.admins) { %><i class="fas fa-lock nav-lock" aria-hidden="true"></i><% } %>
      </a>
      <a href="/backup/<%= guild.id %>" class="nav-link <%= currentPage === 'backup' ? 'active' : '' %> <%= perms.can.backup ? '' : 'locked' %>" data-req="3" data-tip="النسخ الاحتياطي" aria-label="النسخ الاحتياطي"<% if (currentPage === 'backup') { %> aria-current="page"<% } %>>
        <i class="fas fa-database" aria-hidden="true"></i>
        <span>النسخ الاحتياطي</span>
        <% if (!perms.can.backup) { %><i class="fas fa-lock nav-lock" aria-hidden="true"></i><% } %>
      </a>
    </div>
    <% } %>

    <%# Rendered only when there is something in it. التوثيق moved up into the
        section above because it is one of the four pages, which left this one
        holding a single developer-only row -- so for everyone else it was a
        heading with nothing under it, and an empty heading reads as a broken
        section rather than as one that is not there. -%>
    <% if (perms.can.dev) { %>
    <div class="nav-section">
      <span class="nav-section-title"><i class="fas fa-ellipsis-h" aria-hidden="true"></i> <span>أخرى</span></span>
      <a href="/dev" class="nav-link <%= currentPage === 'dev' ? 'active' : '' %>" data-tip="لوحة المطور" aria-label="لوحة المطور"<% if (currentPage === 'dev') { %> aria-current="page"<% } %>>
        <i class="fas fa-code" aria-hidden="true"></i>
        <span>لوحة المطور</span>
      </a>
    </div>
    <% } %>
  </nav>

  <%# websocket.js replaces this element's innerHTML with the same
      dot-plus-label pair, so both children are the elements it writes and the
      status pill is styled around them rather than around markup it replaces. --%>
  <div class="sidebar-footer">
    <div class="bot-status" id="botStatus">
      <span class="status-dot online"></span>
      <span>البوت متصل</span>
    </div>
    <a href="/auth/logout" class="sidebar-logout" data-tip="تسجيل الخروج">
      <i class="fas fa-arrow-right-from-bracket" aria-hidden="true"></i>
      <span>تسجيل الخروج</span>
    </a>
  </div>
</aside>
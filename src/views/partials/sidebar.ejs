<%# The rail. `currentPage` and `perms` are defaulted here because this partial is
    included by every view on the layout, including the ones a logged-out visitor
    can reach -- the original assignment (not a declaration) is deliberate: an
    include() is compiled into the including template's function body, so a const
    would collide with the host view's own `perms`. --%>
<% currentPage = typeof currentPage !== 'undefined' ? currentPage : '' %>
<% perms = (typeof perms !== 'undefined' && perms) ? perms : { level: -1, role: 'guest', roleLabel: 'زائر', isOwner: false, isDeveloper: false, inGuild: false, can: {} } %>

<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<aside class="sidebar" id="sidebar" aria-label="قائمة التنقل">
  <div class="sidebar-header">
    <i class="fas fa-bolt" aria-hidden="true"></i>
    <span>Kratos</span>
    <button class="sidebar-close" type="button" onclick="closeSidebar()" aria-label="إغلاق القائمة">
      <i class="fas fa-times" aria-hidden="true"></i>
    </button>
  </div>

  <% if (locals.guild) { %>
  <div class="sidebar-role" title="منصبك في هذا السيرفر">
    <i class="fas fa-id-badge" aria-hidden="true"></i>
    <span class="sidebar-role-label"><%= perms.roleLabel %></span>
    <% if (perms.isDeveloper) { %><span class="sidebar-role-dev">مطور</span><% } %>
  </div>
  <% } %>

  <button class="sidebar-collapse-btn" type="button" onclick="toggleSidebarMode()" title="طي القائمة" aria-label="طي القائمة أو توسيعها">
    <i class="fas fa-chevron-right" id="collapseIcon" aria-hidden="true"></i>
  </button>

  <nav class="sidebar-nav">
    <div class="nav-section">
      <span class="nav-section-title"><i class="fas fa-compass" aria-hidden="true"></i> <span>الرئيسية</span></span>
      <a href="/home" class="nav-link <%= currentPage === 'home' ? 'active' : '' %>" title="الصفحة الرئيسية"<% if (currentPage === 'home') { %> aria-current="page"<% } %>>
        <i class="fas fa-home" aria-hidden="true"></i>
        <span>الصفحة الرئيسية</span>
      </a>
      <a href="/dashboard" class="nav-link <%= currentPage === 'dashboard' ? 'active' : '' %> <%= perms.can.dashboard ? '' : 'locked' %>" data-req="3" title="لوحة التحكم"<% if (currentPage === 'dashboard') { %> aria-current="page"<% } %>>
        <i class="fas fa-th-large" aria-hidden="true"></i>
        <span>لوحة التحكم</span>
        <% if (!perms.can.dashboard) { %><i class="fas fa-lock nav-lock" aria-hidden="true"></i><% } %>
      </a>
      <a href="/guilds" class="nav-link <%= currentPage === 'guilds' ? 'active' : '' %>" title="السيرفرات"<% if (currentPage === 'guilds') { %> aria-current="page"<% } %>>
        <i class="fas fa-server" aria-hidden="true"></i>
        <span>السيرفرات</span>
      </a>
      <a href="/status" class="nav-link <%= currentPage === 'status' ? 'active' : '' %>" title="حالة البوت"<% if (currentPage === 'status') { %> aria-current="page"<% } %>>
        <i class="fas fa-heartbeat" aria-hidden="true"></i>
        <span>حالة البوت</span>
      </a>
    </div>

    <% if (locals.guild) { %>
    <div class="nav-section">
      <span class="nav-section-title"><i class="fas fa-server" aria-hidden="true"></i> <span><%= guild.name %></span></span>
      <a href="/guilds/<%= guild.id %>" class="nav-link <%= currentPage === 'guild-overview' ? 'active' : '' %>" title="نظرة عامة"<% if (currentPage === 'guild-overview') { %> aria-current="page"<% } %>>
        <i class="fas fa-circle-info" aria-hidden="true"></i>
        <span>نظرة عامة</span>
      </a>
      <a href="/settings/<%= guild.id %>" class="nav-link <%= currentPage === 'settings' ? 'active' : '' %> <%= perms.can.settings ? '' : 'locked' %>" data-req="2" title="الإعدادات"<% if (currentPage === 'settings') { %> aria-current="page"<% } %>>
        <i class="fas fa-sliders" aria-hidden="true"></i>
        <span>الإعدادات</span>
        <% if (!perms.can.settings) { %><i class="fas fa-lock nav-lock" aria-hidden="true"></i><% } %>
      </a>
      <a href="/commands/<%= guild.id %>" class="nav-link <%= currentPage === 'commands' ? 'active' : '' %> <%= perms.can.commands ? '' : 'locked' %>" data-req="2" title="الأوامر"<% if (currentPage === 'commands') { %> aria-current="page"<% } %>>
        <i class="fas fa-terminal" aria-hidden="true"></i>
        <span>الأوامر</span>
        <% if (!perms.can.commands) { %><i class="fas fa-lock nav-lock" aria-hidden="true"></i><% } %>
      </a>
      <a href="/tickets/<%= guild.id %>" class="nav-link <%= currentPage === 'tickets' ? 'active' : '' %> <%= perms.can.tickets ? '' : 'locked' %>" data-req="0" title="التذاكر"<% if (currentPage === 'tickets') { %> aria-current="page"<% } %>>
        <i class="fas fa-ticket" aria-hidden="true"></i>
        <span>التذاكر</span>
        <% if (!perms.can.tickets) { %><i class="fas fa-lock nav-lock" aria-hidden="true"></i><% } %>
      </a>
      <a href="/voice/<%= guild.id %>" class="nav-link <%= currentPage === 'voice' ? 'active' : '' %> <%= perms.can.voice ? '' : 'locked' %>" data-req="1" title="الرومات المؤقتة"<% if (currentPage === 'voice') { %> aria-current="page"<% } %>>
        <i class="fas fa-microphone" aria-hidden="true"></i>
        <span>الرومات المؤقتة</span>
        <% if (!perms.can.voice) { %><i class="fas fa-lock nav-lock" aria-hidden="true"></i><% } %>
      </a>
      <a href="/logs/<%= guild.id %>" class="nav-link <%= currentPage === 'logs' ? 'active' : '' %> <%= perms.can.logs ? '' : 'locked' %>" data-req="1" title="سجل النشاط"<% if (currentPage === 'logs') { %> aria-current="page"<% } %>>
        <i class="fas fa-clock-rotate-left" aria-hidden="true"></i>
        <span>سجل النشاط</span>
        <% if (!perms.can.logs) { %><i class="fas fa-lock nav-lock" aria-hidden="true"></i><% } %>
      </a>
      <a href="/notifications/<%= guild.id %>" class="nav-link <%= currentPage === 'notifications' ? 'active' : '' %> <%= perms.can.notifications ? '' : 'locked' %>" data-req="1" title="الإشعارات"<% if (currentPage === 'notifications') { %> aria-current="page"<% } %>>
        <i class="fas fa-bell" aria-hidden="true"></i>
        <span>الإشعارات</span>
        <% if (!perms.can.notifications) { %><i class="fas fa-lock nav-lock" aria-hidden="true"></i><% } %>
      </a>
      <a href="/protection/<%= guild.id %>" class="nav-link <%= currentPage === 'protection' ? 'active' : '' %> <%= perms.can.protection ? '' : 'locked' %>" data-req="2" title="الحماية"<% if (currentPage === 'protection') { %> aria-current="page"<% } %>>
        <i class="fas fa-shield" aria-hidden="true"></i>
        <span>الحماية</span>
        <% if (!perms.can.protection) { %><i class="fas fa-lock nav-lock" aria-hidden="true"></i><% } %>
      </a>
      <a href="/premium/<%= guild.id %>" class="nav-link <%= currentPage === 'premium' ? 'active' : '' %> <%= perms.can.premium ? '' : 'locked' %>" data-req="2" title="نظام البريميوم" id="premiumSideLink"<% if (currentPage === 'premium') { %> aria-current="page"<% } %>>
        <i class="fas fa-gem" aria-hidden="true"></i>
        <span>نظام البريميوم</span>
        <% if (locals.premiumStatus && locals.premiumStatus.active) { %>
          <span class="premium-side-dot" id="premiumSideDot">
            <span class="dot"></span><%= locals.premiumStatus.planLabel %>
          </span>
        <% } %>
        <% if (!perms.can.premium) { %><i class="fas fa-lock nav-lock" aria-hidden="true"></i><% } %>
      </a>
      <a href="/admins/<%= guild.id %>" class="nav-link <%= currentPage === 'admins' ? 'active' : '' %> <%= perms.can.admins ? '' : 'locked' %>" data-req="3" title="المدراء"<% if (currentPage === 'admins') { %> aria-current="page"<% } %>>
        <i class="fas fa-user-gear" aria-hidden="true"></i>
        <span>المدراء</span>
        <% if (!perms.can.admins) { %><i class="fas fa-lock nav-lock" aria-hidden="true"></i><% } %>
      </a>
      <a href="/backup/<%= guild.id %>" class="nav-link <%= currentPage === 'backup' ? 'active' : '' %> <%= perms.can.backup ? '' : 'locked' %>" data-req="3" title="النسخ الاحتياطي"<% if (currentPage === 'backup') { %> aria-current="page"<% } %>>
        <i class="fas fa-database" aria-hidden="true"></i>
        <span>النسخ الاحتياطي</span>
        <% if (!perms.can.backup) { %><i class="fas fa-lock nav-lock" aria-hidden="true"></i><% } %>
      </a>
    </div>
    <% } %>

    <div class="nav-section">
      <span class="nav-section-title"><i class="fas fa-ellipsis-h" aria-hidden="true"></i> <span>أخرى</span></span>
      <a href="/docs" class="nav-link <%= currentPage === 'docs' ? 'active' : '' %>" title="التوثيق"<% if (currentPage === 'docs') { %> aria-current="page"<% } %>>
        <i class="fas fa-book" aria-hidden="true"></i>
        <span>التوثيق</span>
      </a>
      <% if (perms.can.dev) { %>
      <a href="/dev" class="nav-link <%= currentPage === 'dev' ? 'active' : '' %>" title="لوحة المطور"<% if (currentPage === 'dev') { %> aria-current="page"<% } %>>
        <i class="fas fa-code" aria-hidden="true"></i>
        <span>لوحة المطور</span>
      </a>
      <% } %>
    </div>
  </nav>

  <%# websocket.js replaces this element's innerHTML with the same
      dot-plus-label pair, so both children are the elements it writes and the
      status pill is styled around them rather than around markup it replaces. --%>
  <div class="sidebar-footer">
    <div class="bot-status" id="botStatus">
      <span class="status-dot online"></span>
      <span>البوت متصل</span>
    </div>
    <a href="/auth/logout" class="sidebar-logout" title="تسجيل الخروج" aria-label="تسجيل الخروج">
      <i class="fas fa-arrow-right-from-bracket" aria-hidden="true"></i>
      <span>تسجيل الخروج</span>
    </a>
  </div>
</aside>
<% currentPage = typeof currentPage !== 'undefined' ? currentPage : '' %>
<% perms = (typeof perms !== 'undefined' && perms) ? perms : { level: -1, role: 'guest', roleLabel: 'زائر', isOwner: false, isDeveloper: false, inGuild: false, can: {} } %>
<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>
<aside class="sidebar glass" id="sidebar">
  <div class="sidebar-header">
    <i class="fas fa-bolt"></i>
    <span>Kratos Dashboard</span>
    <button class="sidebar-close" onclick="closeSidebar()">
      <i class="fas fa-times"></i>
    </button>
  </div>

  <% if (locals.guild) { %>
  <div class="sidebar-role" title="منصبك في هذا السيرفر">
    <i class="fas fa-id-badge"></i>
    <span class="sidebar-role-label"><%= perms.roleLabel %></span>
    <% if (perms.isDeveloper) { %><span class="sidebar-role-dev">مطور</span><% } %>
  </div>
  <% } %>

  <button class="sidebar-collapse-btn" onclick="toggleSidebarMode()" title="طي القائمة">
    <i class="fas fa-chevron-right" id="collapseIcon"></i>
  </button>

  <nav class="sidebar-nav">
    <div class="nav-section">
      <span class="nav-section-title"><i class="fas fa-star"></i> <span>الرئيسية</span></span>
      <a href="/home" class="nav-link <%= currentPage === 'home' ? 'active' : '' %>" title="الصفحة الرئيسية">
        <i class="fas fa-home"></i>
        <span>الصفحة الرئيسية</span>
      </a>
      <a href="/dashboard" class="nav-link <%= currentPage === 'dashboard' ? 'active' : '' %> <%= perms.can.dashboard ? '' : 'locked' %>" data-req="3" title="لوحة التحكم">
        <i class="fas fa-th-large"></i>
        <span>لوحة التحكم</span>
        <% if (!perms.can.dashboard) { %><i class="fas fa-lock nav-lock"></i><% } %>
      </a>
      <a href="/guilds" class="nav-link <%= currentPage === 'guilds' ? 'active' : '' %>" title="السيرفرات">
        <i class="fas fa-server"></i>
        <span>السيرفرات</span>
      </a>
      <a href="/status" class="nav-link <%= currentPage === 'status' ? 'active' : '' %>" title="حالة البوت">
        <i class="fas fa-heartbeat"></i>
        <span>حالة البوت</span>
      </a>
    </div>

    <% if (locals.guild) { %>
    <div class="nav-section">
      <span class="nav-section-title"><i class="fas fa-cog"></i> <span><%= guild.name %></span></span>
      <a href="/guilds/<%= guild.id %>" class="nav-link <%= currentPage === 'guild-overview' ? 'active' : '' %>" title="نظرة عامة">
        <i class="fas fa-info-circle"></i>
        <span>نظرة عامة</span>
      </a>
      <a href="/settings/<%= guild.id %>" class="nav-link <%= currentPage === 'settings' ? 'active' : '' %> <%= perms.can.settings ? '' : 'locked' %>" data-req="2" title="الإعدادات">
        <i class="fas fa-sliders-h"></i>
        <span>الإعدادات</span>
        <% if (!perms.can.settings) { %><i class="fas fa-lock nav-lock"></i><% } %>
      </a>
      <a href="/commands/<%= guild.id %>" class="nav-link <%= currentPage === 'commands' ? 'active' : '' %> <%= perms.can.commands ? '' : 'locked' %>" data-req="2" title="الأوامر">
        <i class="fas fa-terminal"></i>
        <span>الأوامر</span>
        <% if (!perms.can.commands) { %><i class="fas fa-lock nav-lock"></i><% } %>
      </a>
      <a href="/tickets/<%= guild.id %>" class="nav-link <%= currentPage === 'tickets' ? 'active' : '' %> <%= perms.can.tickets ? '' : 'locked' %>" data-req="0" title="التذاكر">
        <i class="fas fa-ticket-alt"></i>
        <span>التذاكر</span>
        <% if (!perms.can.tickets) { %><i class="fas fa-lock nav-lock"></i><% } %>
      </a>
      <a href="/voice/<%= guild.id %>" class="nav-link <%= currentPage === 'voice' ? 'active' : '' %> <%= perms.can.voice ? '' : 'locked' %>" data-req="1" title="الرومات المؤقتة">
        <i class="fas fa-microphone"></i>
        <span>الرومات المؤقتة</span>
        <% if (!perms.can.voice) { %><i class="fas fa-lock nav-lock"></i><% } %>
      </a>
      <a href="/logs/<%= guild.id %>" class="nav-link <%= currentPage === 'logs' ? 'active' : '' %> <%= perms.can.logs ? '' : 'locked' %>" data-req="1" title="سجل النشاط">
        <i class="fas fa-history"></i>
        <span>سجل النشاط</span>
        <% if (!perms.can.logs) { %><i class="fas fa-lock nav-lock"></i><% } %>
      </a>
      <a href="/notifications/<%= guild.id %>" class="nav-link <%= currentPage === 'notifications' ? 'active' : '' %> <%= perms.can.notifications ? '' : 'locked' %>" data-req="1" title="الإشعارات">
        <i class="fas fa-bell"></i>
        <span>الإشعارات</span>
        <% if (!perms.can.notifications) { %><i class="fas fa-lock nav-lock"></i><% } %>
      </a>
      <a href="/protection/<%= guild.id %>" class="nav-link <%= currentPage === 'protection' ? 'active' : '' %> <%= perms.can.protection ? '' : 'locked' %>" data-req="2" title="الحماية">
        <i class="fas fa-shield-alt"></i>
        <span>الحماية</span>
        <% if (!perms.can.protection) { %><i class="fas fa-lock nav-lock"></i><% } %>
      </a>
      <a href="/premium/<%= guild.id %>" class="nav-link <%= currentPage === 'premium' ? 'active' : '' %> <%= perms.can.premium ? '' : 'locked' %>" data-req="2" title="نظام البريميوم" id="premiumSideLink">
        <i class="fas fa-gem"></i>
        <span>نظام البريميوم</span>
        <% if (locals.premiumStatus && locals.premiumStatus.active) { %>
          <span class="premium-side-dot" id="premiumSideDot">
            <span class="dot"></span><%= locals.premiumStatus.planLabel %>
          </span>
        <% } %>
        <% if (!perms.can.premium) { %><i class="fas fa-lock nav-lock"></i><% } %>
      </a>
      <a href="/admins/<%= guild.id %>" class="nav-link <%= currentPage === 'admins' ? 'active' : '' %> <%= perms.can.admins ? '' : 'locked' %>" data-req="3" title="المدراء">
        <i class="fas fa-users-cog"></i>
        <span>المدراء</span>
        <% if (!perms.can.admins) { %><i class="fas fa-lock nav-lock"></i><% } %>
      </a>
      <a href="/backup/<%= guild.id %>" class="nav-link <%= currentPage === 'backup' ? 'active' : '' %> <%= perms.can.backup ? '' : 'locked' %>" data-req="3" title="النسخ الاحتياطي">
        <i class="fas fa-database"></i>
        <span>النسخ الاحتياطي</span>
        <% if (!perms.can.backup) { %><i class="fas fa-lock nav-lock"></i><% } %>
      </a>
    </div>
    <% } %>

    <div class="nav-section">
      <span class="nav-section-title"><i class="fas fa-ellipsis-h"></i> <span>أخرى</span></span>
      <a href="/docs" class="nav-link <%= currentPage === 'docs' ? 'active' : '' %>" title="التوثيق">
        <i class="fas fa-book"></i>
        <span>التوثيق</span>
      </a>
      <% if (perms.can.dev) { %>
      <a href="/dev" class="nav-link <%= currentPage === 'dev' ? 'active' : '' %>" title="لوحة المطور">
        <i class="fas fa-code"></i>
        <span>لوحة المطور</span>
      </a>
      <% } %>
    </div>
  </nav>

  <div class="sidebar-footer">
    <div class="bot-status" id="botStatus">
      <span class="status-dot online"></span>
      <span class="status-text">البوت متصل</span>
    </div>
    <a href="/auth/logout" class="sidebar-logout" title="تسجيل الخروج">
      <i class="fas fa-sign-out-alt"></i>
      <span>تسجيل الخروج</span>
    </a>
    <div class="sidebar-resize-handle" onclick="toggleSidebarMode()">
      <i class="fas fa-chevron-right"></i>
    </div>
  </div>
</aside>
<!-- ══ CTA + Footer ═══════════════════════════════════════════════════════
     The wave below is a CSS redraw of novax's footer.svg — two blurred purple
     radial gradients under a radial mask. Their file is not copied. -->
<section class="nx-cta">
  <div class="nx-wrap nx-cta__top">
    <h2 class="nx-cta__title">جاهز لتجربة رائعة؟<br><span>ابدأ الآن!</span></h2>
    <div class="nx-cta__acts">
      <a href="/invite" class="nx-btn nx-btn-d">دعوة البوت <i class="fas fa-arrow-left nx-ico"></i></a>
    </div>
  </div>

  <div class="nx-wave" aria-hidden="true"></div>

  <footer class="nx-footer">
   <div class="nx-wrap">
    <div class="nx-foot__grid">
      <!-- The language switch sits under the about paragraph, inside the same
           narrow column — it is not a fourth link module. -->
      <div class="nx-foot__about">
        <!-- The source runs the mark and the heading as one centred row: a 35x25
             graphic 5px from a 20px/700 h3. Ours is a square mark, so it sits at
             25px on the same baseline rather than being stretched to 35 wide. -->
        <div class="nx-foot__head">
          <svg viewBox="0 0 64 64" aria-hidden="true">
            <defs>
              <linearGradient id="nxlgf" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#8c5aff"/>
                <stop offset="100%" stop-color="#681fd1"/>
              </linearGradient>
            </defs>
            <rect x="2" y="2" width="60" height="60" rx="16" fill="#12131c" stroke="url(#nxlgf)" stroke-width="3"/>
            <path d="M20 22 L32 32 L20 42" fill="none" stroke="#a855f7" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M33 42 L45 42" fill="none" stroke="#f5e625" stroke-width="5" stroke-linecap="round"/>
          </svg>
          <h3>عن كراتوس</h3>
        </div>
        <p>كراتوس بوت ديسكورد قوي ومتعدد الاستخدامات، ليمنح سيرفرك تجربة متكاملة. من الإشراف المتقدم وأوامر المرح إلى إحصائيات مباشرة وتكاملات مخصصة، رفيقك الشامل لإدارة السيرفر.</p>
        <div class="nx-lang">
          <button class="nx-lang__btn" type="button" id="nxLangBtn"
                  aria-haspopup="true" aria-expanded="false" aria-controls="nxLangMenu"
                  aria-label="اللغة: العربية">
            <span class="nx-lang__ico" aria-hidden="true">
              <svg viewBox="0 0 32 32">
                <circle cx="16" cy="16" r="12" fill="none" stroke="#34d399" stroke-width="2.6"/>
                <ellipse cx="16" cy="16" rx="5.2" ry="12" fill="none" stroke="#34d399" stroke-width="2.6"/>
                <path d="M5 11.4h22M5 20.6h22M4.4 16h23.2" stroke="#34d399" stroke-width="2.6" stroke-linecap="round"/>
              </svg>
            </span>
            <span>العربية</span>
            <i class="nx-lang__caret" aria-hidden="true"></i>
          </button>
          <div class="nx-lang__menu" id="nxLangMenu" role="menu" aria-labelledby="nxLangBtn">
            <button class="nx-lang__opt" type="button" role="menuitem" aria-current="true">
              <span>العربية</span><i class="fas fa-check"></i>
            </button>
            <!-- Further locales go here as translations land. -->
          </div>
        </div>
      </div>

      <div class="nx-foot__links">
        <div class="nx-foot__mod">
          <h3>تواصل معنا</h3>
          <!-- Discord is the only channel with a real address. Add further
               accounts here as they exist — a link to x.com or instagram.com
               with no handle sends people to those sites' homepages. -->
          <ul>
            <li><a href="https://discord.gg/fadix9" target="_blank" rel="noopener">ديسكورد</a></li>
          </ul>
        </div>
        <div class="nx-foot__mod">
          <h3>الصفحات</h3>
          <ul>
            <li><a href="/home">لوحة التحكم</a></li>
            <li><a href="/premium">بلس</a></li>
            <li><a href="/commands">الأوامر</a></li>
          </ul>
        </div>
        <div class="nx-foot__mod">
          <h3>قانوني</h3>
          <ul>
            <li><a href="/terms">شروط الخدمة</a></li>
            <li><a href="/privacy">سياسة الخصوصية</a></li>
            <li><a href="/refund">سياسة الاسترجاع</a></li>
          </ul>
        </div>
      </div>
    </div>

    <hr class="nx-foot__rule">
    <div class="nx-foot__row">
      <span class="nx-foot__note">© كل الحقوق محفوظة</span>
      <div class="nx-foot__soc">
        <a href="https://discord.gg/fadix9" target="_blank" rel="noopener" aria-label="ديسكورد"><i class="fab fa-discord"></i></a>
      </div>
    </div>
   </div>
  </footer>
</section>

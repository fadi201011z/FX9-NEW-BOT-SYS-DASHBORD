<!-- ══ Header ══════════════════════════════════════════════════════════════ -->
<header class="nx-header" id="nxHeader">
  <div class="nx-wrap">
    <div class="nx-header__bar">
      <div class="nx-header__left">
        <a href="/" class="nx-logo" aria-label="Kratos System">
          <img src="/images/logo.png" alt="" width="50" height="50" decoding="async">
        </a>
        <nav class="nx-nav">
          <%# The quotes must be template text, not output. EJS's escaped-output tag
              escapes them, and an unquoted attribute value does not decode
              entities, so emitting the whole attribute through it shipped
              aria-current=&#34;page&#34; and the parsed value was never "page". %>
          <a href="/commands"<% if (locals.page === 'commands') { %> aria-current="page"<% } %>>الأوامر</a>
          <a href="https://discord.gg/ENQut4HHKb" target="_blank" rel="noopener">تواصل معنا</a>
          <a href="/premium" class="nx-btn nx-btn-g"><i class="fas fa-crown"></i> بلس</a>
          <span class="nx-sparks" aria-hidden="true">
            <i class="nx-spark">✦</i><i class="nx-spark">✦</i><i class="nx-spark">✦</i>
          </span>
        </nav>
      </div>
      <div class="nx-header__right">
        <button class="nx-lang" type="button"><i class="fas fa-globe"></i> العربية <i class="fas fa-chevron-down language-chevron"></i></button>
        <%# The landing pages are reachable while signed in (see the note on the
            `/` route), so this button has two states: the unauthenticated
            invitation to log in, and the panel a signed-in visitor actually
            wants. /home is that panel — the old /dashboard was retired and
            redirects here, so there is one destination for everyone. %>
        <% if (locals.user) { %>
          <a href="/home" class="nx-btn nx-btn-p"><i class="fas fa-gauge-high nx-sico"></i> الانتقال إلى الداشبورد</a>
        <% } else { %>
          <a href="/auth/discord" class="nx-btn nx-btn-p"><i class="fas fa-right-to-bracket nx-sico"></i> دخول</a>
        <% } %>
      </div>
    </div>
  </div>
</header>
<!-- Transparent at the top, glass once the page moves. Kept out of
     partials/landing-script.ejs on purpose: that partial must stay
     byte-identical to the block audited out of index.ejs. -->
<script src="/js/header-stuck.js" defer></script>

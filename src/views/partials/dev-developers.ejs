<%
  // Who counts as a bot developer. Owner-only editing: a developer who could
  // promote themselves would make the gate in front of /dev meaningless.
  const dvdDevelopers = Array.isArray(locals.developers) ? locals.developers : [];
  const dvdIsOwner = !!locals.isOwner;
  const dvdOwnerId = locals.ownerId || '';
  const dvdNotice = locals.notice || null;
  const dvdDate = (ms) => {
    try {
      return new Intl.DateTimeFormat('ar-EG', { dateStyle: 'medium' }).format(new Date(ms));
    } catch (e) {
      return new Date(ms).toISOString().slice(0, 10);
    }
  };
%>

<style>
.dvd{margin-top:22px}
.dvd-head{display:flex;align-items:center;gap:10px;margin-bottom:14px;padding:0 4px}
.dvd-head h2{font-size:1.02rem;font-weight:800;margin:0;display:flex;align-items:center;gap:9px}
.dvd-head h2 i{color:#a855f7;font-size:.92rem}
.dvd-count{display:inline-flex;align-items:center;justify-content:center;min-width:24px;height:22px;padding:0 8px;border-radius:100px;font-size:.7rem;font-weight:700;background:rgba(168,85,247,.12);border:1px solid rgba(168,85,247,.24);color:#c084fc}

.dvd-note{display:flex;gap:10px;align-items:flex-start;padding:12px 15px;border-radius:12px;background:rgba(168,85,247,.06);border:1px solid rgba(168,85,247,.16);font-size:.78rem;line-height:1.85;color:rgba(255,255,255,.55);margin-bottom:14px}
.dvd-note i{color:#a855f7;margin-top:5px;flex-shrink:0;font-size:.85rem}
.dvd-note b{color:rgba(255,255,255,.85);font-weight:700}

.dvd-banner{display:flex;align-items:center;gap:9px;padding:11px 15px;border-radius:12px;font-size:.8rem;font-weight:600;margin-bottom:14px}
.dvd-banner.ok{background:rgba(87,242,135,.08);border:1px solid rgba(87,242,135,.24);color:#57f287}
.dvd-banner.err{background:rgba(248,113,113,.08);border:1px solid rgba(248,113,113,.24);color:#f87171}

.dvd-list{display:flex;flex-direction:column;gap:9px;margin-bottom:16px}
.dvd-row{display:flex;align-items:center;gap:13px;padding:13px 15px;border-radius:13px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06)}
.dvd-ava{width:38px;height:38px;flex-shrink:0;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.85rem;font-weight:700;color:#c084fc;background:rgba(168,85,247,.13);border:1px solid rgba(168,85,247,.22)}
.dvd-info{flex:1;min-width:0}
.dvd-id{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:.78rem;color:rgba(255,255,255,.82);direction:ltr;text-align:right;letter-spacing:.02em}
.dvd-meta{font-size:.68rem;color:rgba(255,255,255,.32);margin-top:3px}
.dvd-tags{display:flex;gap:6px;align-items:center;flex-shrink:0}
.dvd-tag{font-size:.64rem;font-weight:700;padding:3px 10px;border-radius:100px;white-space:nowrap}
.dvd-tag-owner{background:rgba(245,214,37,.1);border:1px solid rgba(245,214,37,.26);color:#f5d623}
.dvd-tag-dev{background:rgba(168,85,247,.12);border:1px solid rgba(168,85,247,.26);color:#c084fc}
.dvd-del{width:32px;height:32px;flex-shrink:0;border-radius:9px;display:flex;align-items:center;justify-content:center;background:rgba(248,113,113,.08);border:1px solid rgba(248,113,113,.22);color:#f87171;cursor:pointer;font-size:.8rem;transition:all .2s}
.dvd-del:hover{background:rgba(248,113,113,.18);border-color:rgba(248,113,113,.42)}

.dvd-empty{padding:30px 18px;text-align:center;border-radius:13px;background:rgba(255,255,255,.02);border:1px dashed rgba(255,255,255,.09)}
.dvd-empty i{font-size:1.5rem;color:rgba(255,255,255,.14);margin-bottom:11px;display:block}
.dvd-empty p{margin:0;font-size:.8rem;color:rgba(255,255,255,.34);line-height:1.85}

.dvd-add{padding:17px;border-radius:14px;background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.06)}
.dvd-add h3{font-size:.86rem;font-weight:700;margin:0 0 4px}
.dvd-add p.dvd-sub{margin:0 0 14px;font-size:.74rem;color:rgba(255,255,255,.34);line-height:1.8}
.dvd-fields{display:flex;flex-wrap:wrap;gap:10px}
.dvd-f{display:flex;flex-direction:column;gap:6px;flex:1;min-width:180px}
.dvd-f label{font-size:.7rem;font-weight:600;color:rgba(255,255,255,.45)}
.dvd-f input{padding:10px 13px;border-radius:10px;background:rgba(0,0,0,.28);border:1px solid rgba(255,255,255,.08);color:#fff;font-family:inherit;font-size:.82rem;transition:border-color .2s,box-shadow .2s}
.dvd-f input:focus{outline:none;border-color:rgba(168,85,247,.5);box-shadow:0 0 0 3px rgba(168,85,247,.12)}
.dvd-f input::placeholder{color:rgba(255,255,255,.22)}
.dvd-f input.dvd-ltr{direction:ltr;text-align:right;font-family:'JetBrains Mono',ui-monospace,monospace}
.dvd-submit{width:100%;margin-top:13px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:11px 20px;border-radius:11px;font-family:inherit;font-size:.82rem;font-weight:600;cursor:pointer;border:none;background:linear-gradient(135deg,#a855f7,#7c3aed);color:#fff;box-shadow:0 6px 20px rgba(168,85,247,.28);transition:all .22s}
.dvd-submit:hover{transform:translateY(-2px);box-shadow:0 11px 30px rgba(168,85,247,.4)}
</style>

<section class="dvd">
  <div class="dvd-head">
    <h2><i class="fas fa-user-astronaut"></i> مطوّرو البوت</h2>
    <span class="dvd-count"><%= dvdDevelopers.length %></span>
  </div>

  <div class="dvd-note">
    <i class="fas fa-circle-info"></i>
    <div>
      مطوّرو البوت يدخلون <b>لوحة المطور</b> فقط — أدوات النظام والصيانة وإدارة المطوّرين.
      هذا <b>لا يعطيهم أي صلاحية على سيرفرات الناس</b>؛ صلاحيات السيرفر تبقى منفصلة تماماً.
    </div>
  </div>

  <% if (dvdNotice) { %>
    <div class="dvd-banner <%= dvdNotice.kind %>">
      <i class="fas <%= dvdNotice.kind === 'ok' ? 'fa-circle-check' : 'fa-triangle-exclamation' %>"></i>
      <%= dvdNotice.text %>
    </div>
  <% } %>

  <div class="dvd-list">
    <% if (dvdOwnerId) { %>
      <div class="dvd-row">
        <div class="dvd-ava"><i class="fas fa-crown"></i></div>
        <div class="dvd-info">
          <div class="dvd-id"><%= dvdOwnerId %></div>
          <div class="dvd-meta">مالك النظام — صلاحية كاملة</div>
        </div>
        <div class="dvd-tags"><span class="dvd-tag dvd-tag-owner">المالك</span></div>
      </div>
    <% } %>

    <% dvdDevelopers.forEach(function (d) { %>
      <div class="dvd-row">
        <div class="dvd-ava"><i class="fas fa-code"></i></div>
        <div class="dvd-info">
          <div class="dvd-id"><%= d.userId %></div>
          <div class="dvd-meta">
            <% if (d.username) { %><%= d.username %> · <% } %>
            <% if (d.note) { %><%= d.note %> · <% } %>
            أُضيف <%= dvdDate(d.addedAt || d.createdAt) %>
          </div>
        </div>
        <div class="dvd-tags"><span class="dvd-tag dvd-tag-dev">مطور</span></div>
        <% if (dvdIsOwner) { %>
          <form method="POST" action="/dev/developers/remove" onsubmit="return confirm('إزالة هذا المطور؟ سيفقد الوصول للوحة المطور فوراً.');">
            <input type="hidden" name="userId" value="<%= d.userId %>">
            <button type="submit" class="dvd-del" title="إزالة المطور" aria-label="إزالة المطور">
              <i class="fas fa-user-minus"></i>
            </button>
          </form>
        <% } %>
      </div>
    <% }); %>

    <% if (!dvdDevelopers.length && !dvdOwnerId) { %>
      <div class="dvd-empty">
        <i class="fas fa-user-astronaut"></i>
        <p>لا يوجد مطورون مسجّلون بعد.</p>
      </div>
    <% } %>
  </div>

  <% if (dvdIsOwner) { %>
    <form class="dvd-add" method="POST" action="/dev/developers">
      <h3>إضافة مطور جديد</h3>
      <p class="dvd-sub">ألصق Discord ID الخاص بالشخص. انسخه من ديسكورد بضغط كليك يمين على الصورة ← نسخ معرف المستخدم.</p>
      <div class="dvd-fields">
        <div class="dvd-f">
          <label for="dvdUserId">Discord ID <span style="color:#f87171">*</span></label>
          <input id="dvdUserId" name="userId" class="dvd-ltr" required pattern="[0-9]{17,20}" inputmode="numeric" maxlength="20" placeholder="123456789012345678" autocomplete="off">
        </div>
        <div class="dvd-f">
          <label for="dvdUsername">الاسم (اختياري)</label>
          <input id="dvdUsername" name="username" maxlength="64" placeholder="مثال: FAdiX9" autocomplete="off">
        </div>
        <div class="dvd-f">
          <label for="dvdNote">ملاحظة (اختياري)</label>
          <input id="dvdNote" name="note" maxlength="200" placeholder="مثال: مسؤول البوت الخلفي" autocomplete="off">
        </div>
      </div>
      <button type="submit" class="dvd-submit"><i class="fas fa-user-plus"></i> إضافة كمطوّر</button>
    </form>
  <% } else { %>
    <div class="dvd-empty">
      <i class="fas fa-lock"></i>
      <p>إضافة وإزالة المطوّرين متاحة للمالك فقط.</p>
    </div>
  <% } %>
</section>
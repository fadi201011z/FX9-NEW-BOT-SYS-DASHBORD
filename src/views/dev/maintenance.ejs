<% currentPage = 'dev-maintenance' %>
<%
  /* وضع الصيانة — the control room for the bot and the site.
     Two independent scopes over one shared document: the bot half gates the
     bot's commands/presence and posts Discord notices, the site half drives the
     dashboard redirect and the public landing banner. Everything static is
     server-rendered; live state (countdowns, the bot's own view) is refreshed
     by the script at the bottom. */
  const b = maintenance.bot;
  const s = maintenance.site;
  const fmt = (ms) => {
    if (!ms || ms <= 0) return '';
    const total = Math.floor(ms / 1000);
    const d = Math.floor(total / 86400);
    const h = Math.floor((total % 86400) / 3600);
    const m = Math.floor((total % 3600) / 60);
    const sec = total % 60;
    const parts = [];
    if (d) parts.push(d + ' يوم');
    if (h) parts.push(h + ' ساعة');
    if (m) parts.push(m + ' دقيقة');
    if (!d && !h) parts.push(sec + ' ثانية');
    return parts.join(' و ');
  };
%>
<div class="dmx">
  <!-- ── الهيرو ── -->
  <section class="dmx-hero" id="dmxHero" data-state="<%= (b.enabled || s.enabled) ? 'warn' : 'ok' %>">
    <span class="dmx-hero-glow"></span>
    <div class="dmx-orb"><i class="fas fa-screwdriver-wrench"></i></div>
    <div class="dmx-hero-body">
      <div class="dmx-eyebrow"><span class="dmx-dot"></span> لوحة المطوّر — مركز الصيانة</div>
      <h1 id="dmxHeroTitle"><%= (b.enabled || s.enabled) ? 'وضع الصيانة مُفعّل' : 'كل الأنظمة تعمل' %></h1>
      <p>
        حالتان مستقلتان: يمكن إدخال <strong>البوت</strong> في الصيانة (توقف الأوامر، يتغيّر الحضور، ويُرسل إشعار في ديسكورد)
        دون إغلاق <strong>الموقع</strong>، والعكس. كل تغيير يُسجَّل ويُزامَن مع البوت فوراً.
      </p>
    </div>
    <div class="dmx-hero-side">
      <div class="dmx-score" id="dmxScore"><%= [b.enabled, s.enabled].filter(Boolean).length %>/<span>2</span></div>
      <div class="dmx-score-lbl">أنظمة تحت الصيانة</div>
      <button type="button" class="dmx-btn dmx-btn-ghost" id="dmxRefresh"><i class="fas fa-rotate"></i> تحديث</button>
      <span class="dmx-sync" id="dmxSync" data-state="unknown"><i class="fas fa-circle-notch fa-spin"></i> جارٍ التحقق من البوت…</span>
    </div>
  </section>

  <div class="dmx-reason" id="dmxReason" role="status" hidden></div>

  <!-- ── البطاقتان ── -->
  <section class="dmx-grid">
    <!-- البوت -->
    <article class="dmx-card" id="dmxCardBot" data-scope="bot" data-enabled="<%= b.enabled ? '1' : '0' %>">
      <header class="dmx-card-head">
        <span class="dmx-ic ic-bot"><i class="fas fa-robot"></i></span>
        <div class="dmx-card-title"><b>البوت</b><small>الأوامر، الحضور، وإشعارات ديسكورد</small></div>
        <span class="dmx-pill" data-on="<%= b.enabled ? '1' : '0' %>"><i></i> <span class="dmx-pill-txt"><%= b.enabled ? 'تحت الصيانة' : 'يعمل' %></span></span>
      </header>

      <div class="dmx-cd" data-cd hidden><i class="fas fa-hourglass-half"></i> <span class="dmx-cd-txt"></span></div>

      <div class="dmx-form">
        <label class="dmx-lbl"><i class="fas fa-clock"></i> المدة الزمنية <small>(بالدقائق — 0 تعني صيانة مفتوحة)</small></label>
        <div class="dmx-dur">
          <input type="number" class="dmx-min" min="0" step="1" value="<%= b.durationMinutes || 0 %>" aria-label="مدة صيانة البوت">
          <div class="dmx-presets">
            <button type="button" data-min="15">15د</button>
            <button type="button" data-min="30">30د</button>
            <button type="button" data-min="60">ساعة</button>
            <button type="button" data-min="120">ساعتان</button>
            <button type="button" data-min="360">6س</button>
            <button type="button" data-min="1440">24س</button>
            <button type="button" data-min="0">بلا حد</button>
          </div>
        </div>

        <label class="dmx-lbl"><i class="fas fa-comment-dots"></i> رسالة الصيانة</label>
        <input type="text" class="dmx-msg" maxlength="400" value="<%= b.message %>" placeholder="البوت تحت الصيانة والتطوير. سنعود قريباً!">

        <label class="dmx-lbl"><i class="fas fa-bullhorn"></i> روم إشعارات الصيانة <small>(ID الروم)</small></label>
        <input type="text" class="dmx-channel" dir="ltr" maxlength="32" value="<%= maintenance.channelId %>" placeholder="123456789012345678">
      </div>

      <div class="dmx-changelog">
        <div class="dmx-lbl"><i class="fas fa-list-check"></i> سجل التحديثات <small>(يُرسل مع إشعار إيقاف الصيانة)</small></div>
        <textarea class="dmx-cl" data-cl="botUpdates" rows="2" maxlength="1500" placeholder="ما الذي تغيّر في البوت خلال الصيانة…"><%= maintenance.changelog.botUpdates || '' %></textarea>
        <textarea class="dmx-cl" data-cl="siteUpdates" rows="2" maxlength="1500" placeholder="ما الذي تغيّر في الموقع خلال الصيانة…"><%= maintenance.changelog.siteUpdates || '' %></textarea>
      </div>

      <div class="dmx-actions">
        <button type="button" class="dmx-btn dmx-btn-on" data-action="start"><i class="fas fa-play"></i> تفعيل صيانة البوت</button>
        <button type="button" class="dmx-btn dmx-btn-off" data-action="stop"><i class="fas fa-power-off"></i> إيقاف الصيانة</button>
        <button type="button" class="dmx-btn dmx-btn-save" data-action="save"><i class="fas fa-floppy-disk"></i> حفظ الإعدادات</button>
      </div>
    </article>

    <!-- ── الموقع ── -->
    <article class="dmx-card" id="dmxCardSite" data-scope="site" data-enabled="<%= s.enabled ? '1' : '0' %>">
      <header class="dmx-card-head">
        <span class="dmx-ic ic-site"><i class="fas fa-globe"></i></span>
        <div class="dmx-card-title"><b>الموقع</b><small>لوحة التحكم والصفحات العامة</small></div>
        <span class="dmx-pill" data-on="<%= s.enabled ? '1' : '0' %>"><i></i> <span class="dmx-pill-txt"><%= s.enabled ? 'تحت الصيانة' : 'يعمل' %></span></span>
      </header>

      <div class="dmx-cd" data-cd hidden><i class="fas fa-hourglass-half"></i> <span class="dmx-cd-txt"></span></div>

      <div class="dmx-form">
        <label class="dmx-lbl"><i class="fas fa-clock"></i> المدة الزمنية <small>(بالدقائق — 0 تعني صيانة مفتوحة)</small></label>
        <div class="dmx-dur">
          <input type="number" class="dmx-min" min="0" step="1" value="<%= s.durationMinutes || 0 %>" aria-label="مدة صيانة الموقع">
          <div class="dmx-presets">
            <button type="button" data-min="15">15د</button>
            <button type="button" data-min="30">30د</button>
            <button type="button" data-min="60">ساعة</button>
            <button type="button" data-min="120">ساعتان</button>
            <button type="button" data-min="360">6س</button>
            <button type="button" data-min="1440">24س</button>
            <button type="button" data-min="0">بلا حد</button>
          </div>
        </div>

        <label class="dmx-lbl"><i class="fas fa-comment-dots"></i> رسالة الصيانة <small>(يراها الزائر في صفحة الصيانة)</small></label>
        <input type="text" class="dmx-msg" maxlength="400" value="<%= s.message %>">
      </div>

      <div class="dmx-actions">
        <button type="button" class="dmx-btn dmx-btn-on" data-action="start"><i class="fas fa-play"></i> تفعيل صيانة الموقع</button>
        <button type="button" class="dmx-btn dmx-btn-off" data-action="stop"><i class="fas fa-power-off"></i> إيقاف الصيانة</button>
        <button type="button" class="dmx-btn dmx-btn-save" data-action="save"><i class="fas fa-floppy-disk"></i> حفظ الإعدادات</button>
        <a class="dmx-btn dmx-btn-ghost" href="/maintenance?preview=1" target="_blank" rel="noopener"><i class="fas fa-eye"></i> معاينة</a>
      </div>
    </article>
  </section>

  <p class="dmx-note">
    <i class="fas fa-circle-info"></i>
    <span>تفعيل صيانة البوت يمنع تنفيذ أوامر البوت لكل الأعضاء (عدا المالك والمطوّرين) ويغيّر حضوره إلى <strong>عدم الإزعاج</strong>، ويرسل إشعاراً في روم الصيانة المحدّد إن وُجد. إيقاف الصيانة يُرسل إشعار العودة مع سجل التحديثات. صيانة الموقع تحوّل الزوّار إلى صفحة الصيانة وتُظهر شريطاً في الصفحات العامة.</p>

  <div class="dmx-foot" id="dmxFoot" data-empty="<%= maintenance.updatedAt ? '0' : '1' %>">
    <i class="fas fa-clock-rotate-left"></i>
    <span id="dmxFootTxt"><% if (maintenance.updatedAt) { %>آخر تعديل: <%= new Date(maintenance.updatedAt).toLocaleString('ar-EG') %><% if (maintenance.updatedBy) { %> بواسطة <code><%= maintenance.updatedBy %></code><% } %><% } else { %>لم يُضبط وضع الصيانة بعد.<% } %></span>
  </div>
</div>

<div class="dmx-toast" id="dmxToast" role="status" aria-live="polite"></div>

<style>
.dmx{--acc:#a855f7;--bot:#a855f7;--site:#38bdf8;--ok:#57f287;--warn:#ffd93d;--err:#ff6b6b;--line:var(--border);--card:var(--bg-card);display:flex;flex-direction:column;gap:16px}
.dmx-hero{position:relative;overflow:hidden;isolation:isolate;display:flex;align-items:center;gap:22px;padding:25px;border-radius:22px;border:1px solid var(--line);background:radial-gradient(120% 190% at 92% -45%,rgba(168,85,247,.14),transparent 60%),var(--card);box-shadow:var(--shadow)}
.dmx-hero-glow{position:absolute;z-index:-1;top:-45%;inset-inline-end:-6%;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(168,85,247,.30),transparent 70%);filter:blur(30px);pointer-events:none}
.dmx-orb{flex-shrink:0;width:64px;height:64px;border-radius:18px;display:flex;align-items:center;justify-content:center;font-size:1.6rem;color:#c9a4ff;background:rgba(168,85,247,.12);border:1px solid rgba(168,85,247,.3)}
.dmx-hero[data-state="warn"] .dmx-orb{color:#e7b500;background:rgba(255,217,61,.14);border-color:rgba(255,217,61,.34)}
.dmx-hero-body{flex:1;min-width:0}
.dmx-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:.72rem;font-weight:700;color:var(--text-muted)}
.dmx-dot{width:7px;height:7px;border-radius:50%;background:#a855f7;box-shadow:0 0 0 4px rgba(168,85,247,.12)}
.dmx-hero h1{font-size:1.4rem;font-weight:900;margin:8px 0 6px;line-height:1.25}
.dmx-hero p{font-size:.82rem;color:var(--text-muted);line-height:1.85;margin:0;max-width:660px}
.dmx-hero-side{display:flex;flex-direction:column;align-items:flex-end;gap:9px;flex-shrink:0}
.dmx-score{font-size:1.55rem;font-weight:900;font-variant-numeric:tabular-nums}
.dmx-score span{font-size:1rem;color:var(--text-muted)}
.dmx-score-lbl{font-size:.72rem;color:var(--text-muted);margin-top:-6px}
.dmx-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 17px;border-radius:11px;border:none;cursor:pointer;font-family:inherit;font-size:.78rem;font-weight:700;color:#fff;background:linear-gradient(135deg,#7c3aed,#6d28d9);box-shadow:0 6px 20px rgba(124,58,237,.28);transition:transform .2s,box-shadow .2s,opacity .2s;text-decoration:none}
.dmx-btn:hover{transform:translateY(-2px)}
.dmx-btn:disabled{opacity:.45;cursor:default;transform:none;pointer-events:none}
.dmx-btn-ghost{background:var(--bg-glass);color:var(--text);border:1px solid var(--dfe-line,var(--border));box-shadow:none}
.dmx-sync{display:inline-flex;align-items:center;gap:7px;font-size:.73rem;font-weight:700;color:var(--text-muted);padding:6px 11px;border-radius:999px;background:var(--bg-glass);border:1px solid var(--border)}
.dmx-sync[data-state="ok"]{color:#3ddc84;border-color:rgba(87,242,133,.34);background:rgba(87,242,133,.08)}
.dmx-sync[data-state="warn"]{color:#b98900;border-color:rgba(255,217,61,.34);background:rgba(255,217,61,.08)}

.dmx-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:880px){.dmx-grid{grid-template-columns:1fr}}

.dmx-card{position:relative;display:flex;flex-direction:column;gap:14px;padding:20px;border-radius:18px;background:var(--card);border:1px solid var(--border);transition:border-color .25s,box-shadow .25s}
.dmx-card[data-enabled="1"]{border-color:rgba(255,217,61,.34);box-shadow:0 12px 40px rgba(255,217,61,.06)}
.dmx-card-head{display:flex;align-items:center;gap:12px}
.dmx-ic{width:46px;height:46px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.12rem;flex-shrink:0}
.ic-bot{background:rgba(168,85,247,.12);color:#c9a4ff}
.ic-site{background:rgba(56,189,248,.12);color:#5cc8fb}
.dmx-card-title{flex:1;min-width:0}
.dmx-card-title b{display:block;font-size:.95rem;font-weight:800}
.dmx-card-title small{font-size:.72rem;color:var(--text-muted)}
.dmx-pill{display:inline-flex;align-items:center;gap:6px;flex-shrink:0;padding:5px 12px;border-radius:999px;font-size:.71rem;font-weight:800;color:#3ddc84;background:rgba(87,242,133,.10);border:1px solid rgba(87,242,133,.34)}
.dmx-pill i{width:7px;height:7px;border-radius:50%;background:currentColor}
.dmx-pill[data-on="1"]{color:#e7b500;background:rgba(255,217,61,.10);border-color:rgba(255,217,61,.34)}
.dmx-pill[data-on="true"]{color:#e7b500;background:rgba(255,217,61,.10);border-color:rgba(255,217,61,.34)}

.dmx-cd{display:flex;align-items:center;gap:9px;padding:10px 14px;border-radius:12px;font-size:.76rem;font-weight:700;color:#b98900;background:rgba(255,217,61,.08);border:1px solid rgba(255,217,61,.24)}
.dmx-card[data-enabled="0"] .dmx-cd{display:none}
.dmx-card[data-enabled="false"] .dmx-cd{display:none}

.dmx-form{display:flex;flex-direction:column;gap:7px}
.dmx-lbl{font-size:.73rem;font-weight:700;color:var(--text-muted);display:flex;align-items:center;gap:7px;margin-top:5px}
.dmx-lbl i{color:#a855f7}
.dmx-lbl small{font-weight:500;opacity:.75}
.dmx-card input[type="text"],.dmx-card input[type="number"],.dmx-card textarea{padding:10px 13px;border-radius:11px;background:var(--bg-glass);border:1px solid var(--border);color:var(--text);font-family:inherit;font-size:.8rem;outline:none;transition:border-color .2s;width:100%;box-sizing:border-box}
.dmx-card input:focus,.dmx-card textarea:focus{border-color:rgba(168,85,247,.5)}
.dmx-card textarea{resize:vertical;line-height:1.7}
.dmx-dur{display:flex;flex-direction:column;gap:9px}
.dmx-presets{display:flex;flex-wrap:wrap;gap:6px}
.dmx-presets button{padding:6px 12px;border-radius:9px;border:1px solid var(--border);background:var(--bg-glass);color:var(--text-muted);font-family:inherit;font-size:.72rem;font-weight:700;cursor:pointer;transition:all .18s}
.dmx-presets button:hover{color:var(--text);border-color:rgba(168,85,247,.45)}
.dmx-presets button.is-active{background:rgba(168,85,247,.14);color:#c9a4ff;border-color:rgba(168,85,247,.4)}
.dmx-changelog{display:flex;flex-direction:column;gap:7px;padding:13px;border-radius:13px;background:var(--bg-glass);border:1px dashed var(--border)}
.dmx-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto;padding-top:4px}
.dmx-btn-on{background:linear-gradient(135deg,#eab308,#b98900);color:#1a1300}
.dmx-btn-off{background:linear-gradient(135deg,#ef4444,#b91c1c)}
.dmx-btn-save{background:linear-gradient(135deg,#334155,#1e293b)}

.dmx-note{display:flex;gap:10px;align-items:flex-start;margin:4px 0 0;padding:13px 16px;border-radius:13px;font-size:.76rem;line-height:1.9;color:var(--text-muted);background:rgba(168,85,247,.06);border:1px solid rgba(168,85,247,.16)}
.dmx-note i{color:#c9a4ff;margin-top:4px}

.dmx-toast{position:fixed;left:50%;bottom:26px;transform:translate(-50%,140%);z-index:1200;display:flex;align-items:center;gap:10px;padding:12px 20px;border-radius:13px;background:var(--bg-card);border:1px solid var(--border);box-shadow:var(--shadow);font-size:.8rem;font-weight:700;transition:transform .35s cubic-bezier(.2,.9,.3,1.2);max-width:90vw}
.dmx-toast.is-show{transform:translate(-50%,0)}
.dmx-toast[data-kind="ok"]{border-color:rgba(87,242,133,.4)}
.dmx-toast[data-kind="warn"]{border-color:rgba(255,217,61,.4)}
.dmx-toast[data-kind="err"]{border-color:rgba(255,107,107,.4)}
.dmx-card.is-busy{opacity:.6;pointer-events:none}

@media(max-width:720px){.dmx-hero{flex-direction:column;align-items:flex-start;padding:22px}.dmx-hero-side{flex-direction:row;flex-wrap:wrap;align-items:center;width:100%}.dmx-score-lbl{margin:0}}
@media(prefers-reduced-motion:reduce){.dmx-toast{transition:none}}
</style>

<script>
(function () {
  function $(sel, root) { return (root || document).querySelector(sel); }
  function $$(sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); }

  var hero = $('#dmxHero');
  var sync = $('#dmxSync');
  var toastEl = $('#dmxToast');
  var toastTimer = null;

  // Local mirror of both scopes, so the countdown can tick without the server.
  var state = {
    bot:  { enabled: <%- JSON.stringify(b.enabled) %>, endTime: <%- JSON.stringify(b.endTime) %>, durationMinutes: <%- JSON.stringify(b.durationMinutes || 0) %> },
    site: { enabled: <%- JSON.stringify(s.enabled) %>, endTime: <%- JSON.stringify(s.endTime) %>, durationMinutes: <%- JSON.stringify(s.durationMinutes || 0) %> }
  };

  function toast(text, kind) {
    if (!toastEl) return;
    toastEl.textContent = text;
    toastEl.dataset.kind = kind || 'ok';
    toastEl.classList.add('is-show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { toastEl.classList.remove('is-show'); }, 3400);
  }

  function card(scope) { return document.getElementById(scope === 'bot' ? 'dmxCardBot' : 'dmxCardSite'); }
  function humanize(ms) {
    if (!ms || ms <= 0) return '';
    var total = Math.floor(ms / 1000);
    var d = Math.floor(total / 86400), h = Math.floor((total % 86400) / 3600), m = Math.floor((total % 3600) / 60), sec = total % 60;
    var parts = [];
    if (d) parts.push(d + ' يوم');
    if (h) parts.push(h + ' ساعة');
    if (m) parts.push(m + ' دقيقة');
    if (!d && !h) parts.push(sec + ' ثانية');
    return parts.join(' و ');
  }

  function paintScope(scope) {
    var c = card(scope); if (!c) return;
    var st = state[scope];
    c.dataset.enabled = st.enabled ? '1' : '0';
    var pill = $('.dmx-pill', c);
    if (pill) { pill.dataset.on = st.enabled ? '1' : '0'; $('.dmx-pill-txt', pill).textContent = st.enabled ? 'تحت الصيانة' : 'يعمل'; }
    var startBtn = $('[data-action="start"]', c);
    var stopBtn = $('[data-action="stop"]', c);
    if (startBtn) startBtn.disabled = st.enabled;
    if (stopBtn) stopBtn.disabled = !st.enabled;
  }

  function tickCountdowns() {
    var now = Date.now();
    ['bot', 'site'].forEach(function (scope) {
      var c = card(scope); if (!c) return;
      var box = $('[data-cd]', c); if (!box) return;
      var st = state[scope];
      if (st.enabled && st.endTime) {
        var remain = st.endTime - now;
        if (remain <= 0) { st.enabled = false; st.endTime = null; paintScope(scope); refreshState(); return; }
        box.hidden = false;
        $('.dmx-cd-txt', box).textContent = 'تنتهي تلقائياً بعد ' + humanize(remain);
      } else {
        box.hidden = st.enabled ? false : true;
        if (st.enabled && !st.endTime) $('.dmx-cd-txt', box).textContent = 'صيانة مفتوحة — لا نهاية محددة';
      }
    });
  }

  function paintHero() {
    var n = (state.bot.enabled ? 1 : 0) + (state.site.enabled ? 1 : 0);
    $('#dmxScore').innerHTML = n + '/<span>2</span>';
    var title = $('#dmxHeroTitle');
    if (title) title.textContent = n ? 'وضع الصيانة مُفعّل' : 'كل الأنظمة تعمل';
    if (hero) hero.dataset.state = n ? 'warn' : 'ok';
  }

  function apply(next) {
    if (!next) return;
    state.bot = { enabled: !!next.bot.enabled, endTime: next.bot.endTime || null, durationMinutes: next.bot.durationMinutes || 0 };
    state.site = { enabled: !!next.site.enabled, endTime: next.site.endTime || null, durationMinutes: next.site.durationMinutes || 0 };
    paintScope('bot'); paintScope('site'); paintHero(); tickCountdowns();
  }

  function post(url, body) {
    return fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    }).then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); });
  }

  function saveScope(scope, enabled) {
    var c = card(scope); if (!c) return Promise.resolve();
    c.classList.add('is-busy');
    var body = {
      enabled: enabled,
      minutes: parseInt($('.dmx-min', c).value, 10) || 0,
      message: $('.dmx-msg', c).value.trim()
    };
    if (scope === 'bot') {
      var chEl = $('.dmx-channel', c);
      if (chEl) body.channelId = chEl.value.trim();
      $$('.dmx-cl', c).forEach(function (t) { body[t.dataset.cl] = t.value.trim(); });
    }
    var url = scope === 'bot' ? '/dev/maintenance/bot' : '/dev/maintenance/site';
    return post(url, body)
      .then(function (res) {
        if (!res.ok || !res.d.ok) throw new Error('failed');
        apply(res.d.maintenance);
        if (scope === 'bot') {
          if (res.d.synced) { if (sync) { sync.dataset.state = 'ok'; sync.innerHTML = '<i class="fas fa-plug-circle-check"></i> مُتزامن مع البوت'; } }
          else toast('حُفظ — سيطبّق البوت التغيير خلال ثوانٍ', 'warn');
        }
        toast(enabled ? 'تم وضع ' + (scope === 'bot' ? 'البوت' : 'الموقع') + ' في الصيانة' : 'تم إيقاف صيانة ' + (scope === 'bot' ? 'البوت' : 'الموقع'), enabled ? 'warn' : 'ok');
        return res.d;
      })
      .catch(function () { toast('تعذّر تنفيذ العملية، حاول مجدداً', 'err'); })
      .then(function (d) { c.classList.remove('is-busy'); return d; },
            function (e) { c.classList.remove('is-busy'); throw e; });
  }

  function refreshState() {
    return fetch('/dev/maintenance/state', { cache: 'no-store' })
      .then(function (r) { return r.json(); })
      .then(function (d) { if (d && d.ok) apply(d.maintenance); })
      .catch(function () {});
  }

  function refreshBotLive() {
    if (!sync) return Promise.resolve();
    return fetch('/dev/maintenance/live', { cache: 'no-store' })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (d && d.online && d.bot && d.bot.botEnabled === state.bot.enabled) {
          sync.dataset.state = 'ok';
          sync.innerHTML = '<i class="fas fa-plug-circle-check"></i> مُتزامن مع البوت';
        } else if (d && d.online) {
          sync.dataset.state = 'warn';
          sync.innerHTML = '<i class="fas fa-clock-rotate-left"></i> بانتظار المزامنة';
        } else {
          sync.dataset.state = 'warn';
          sync.innerHTML = '<i class="fas fa-plug-circle-xmark"></i> تعذّر الوصول للبوت';
        }
      })
      .catch(function () { sync.dataset.state = 'warn'; sync.innerHTML = '<i class="fas fa-plug-circle-xmark"></i> تعذّر الوصول للبوت'; });
  }

  // Presets fill the nearest minutes input; actions dispatch to saveScope.
  document.addEventListener('click', function (ev) {
    var min = ev.target.closest && ev.target.closest('.dmx-presets button');
    if (min) {
      var c = min.closest('.dmx-card');
      var input = $('.dmx-min', c);
      input.value = min.dataset.min;
      $$('.dmx-presets button', c).forEach(function (b) { b.classList.toggle('is-active', b === min); });
      return;
    }
    var action = ev.target.closest && ev.target.closest('[data-action]');
    if (action) {
      var cardEl = action.closest('.dmx-card');
      var scope = cardEl.dataset.scope;
      var act = action.dataset.action;
      if (act === 'start') saveScope(scope, true);
      else if (act === 'stop') saveScope(scope, false);
      else if (act === 'save') {
        // Saving without changing state: mirror the current enabled flag.
        saveScope(scope, !!(state[scope] && state[scope].enabled));
      }
      return;
    }
  });

  if ($('#dmxRefresh')) $('#dmxRefresh').addEventListener('click', function () {
    var b = this; b.disabled = true; b.innerHTML = '<i class="fas fa-rotate fa-spin"></i> تحديث';
    Promise.all([refreshState(), refreshBotLive()]).then(function () {
      b.disabled = false; b.innerHTML = '<i class="fas fa-rotate"></i> تحديث';
    });
  });

  ['bot', 'site'].forEach(paintScope);
  paintHero();
  tickCountdowns();
  refreshState().then(refreshBotLive);
  setInterval(tickCountdowns, 1000);
  setInterval(function () { if (!document.hidden) refreshState(); }, 15000);
  setInterval(function () { if (!document.hidden) refreshBotLive(); }, 25000);
})();
</script>
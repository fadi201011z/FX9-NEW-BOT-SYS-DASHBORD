<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kratos Dashboard — لوحة تحكم البوت</title>
  <meta name="description" content="The Kratos Dashboard is an all-in-one, professional control panel designed to streamline and elevate your Discord server management. It brings together all the essential tools you need into a single, sleek interface featuring real-time synchronization.">
  <meta property="og:title" content="Kratos Dashboard — لوحة تحكم البوت" />
  <meta property="og:description" content="The Kratos Dashboard is an all-in-one, professional control panel designed to streamline and elevate your Discord server management. It brings together all the essential tools you need into a single, sleek interface featuring real-time synchronization." />
  <meta property="og:image" content="https://l.top4top.io/p_3846iqy4s1.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="theme-color" content="#a855f7" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">

  <style>
  /* ═══════════════════════════════════════════════════════════════════════
     KRS — Landing Design System
     Duotone identity: Neon Purple  ×  Electric Yellow
     Deep glassmorphism · ambient glow · glossy cards · micro-interactions
     ═══════════════════════════════════════════════════════════════════════ */

  :root {
    /* Surfaces */
    --fx-void:      #04040b;
    --fx-deep:      #08081a;
    --fx-line:      rgba(255,255,255,.07);
    --fx-line-2:    rgba(255,255,255,.13);
    --fx-txt:       rgba(255,255,255,.92);
    --fx-mut:       rgba(255,255,255,.44);
    --fx-dim:       rgba(255,255,255,.26);

    /* Neon purple */
    --pu:           #a855f7;
    --pu-d:         #7c3aed;
    --pu-l:         #d8b4fe;
    --pu-a:         rgba(168,85,247,.14);

    /* Electric yellow */
    --ye:           #f5e625;
    --ye-d:         #d9b310;
    --ye-l:         #fef08a;
    --ye-a:         rgba(245,230,37,.12);

    /* Signals */
    --ok:           #34f5a5;
    --warn:         #fbbf24;
    --bad:          #ff5c6c;

    --r-lg: 22px;
    --r-md: 16px;
    --r-sm: 12px;

    --ease: cubic-bezier(.16,1,.3,1);
    --ease-io: cubic-bezier(.4,0,.2,1);

    --blur: blur(26px) saturate(165%);
    --blur-lg: blur(40px) saturate(180%);

    /* Shared glow recipes */
    --grad-brand: linear-gradient(120deg,var(--pu-l) 0%,var(--pu) 32%,var(--ye) 100%);
    --grad-pu:    linear-gradient(135deg,var(--pu) 0%,var(--pu-d) 100%);
    --grad-ye:    linear-gradient(135deg,var(--ye-l) 0%,var(--ye) 45%,var(--ye-d) 100%);
  }

  * { margin:0; padding:0; box-sizing:border-box; }

  html { scroll-behavior:smooth; -webkit-text-size-adjust:100%; }

  body {
    font-family:'Cairo',system-ui,sans-serif;
    background:var(--fx-void);
    color:var(--fx-txt);
    overflow-x:hidden;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  a { text-decoration:none; color:inherit; }
  button { font-family:inherit; }
  ::selection { background:rgba(168,85,247,.35); color:#fff; }

  ::-webkit-scrollbar { width:8px; height:8px; }
  ::-webkit-scrollbar-track { background:transparent; }
  ::-webkit-scrollbar-thumb { background:rgba(168,85,247,.3); border-radius:8px; }
  ::-webkit-scrollbar-thumb:hover { background:rgba(168,85,247,.5); }

  /* ─── Ambient background layer ─────────────────────────────────────── */
  .f-ambient {
    position:fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden;
    background:
      radial-gradient(ellipse 90% 60% at 50% -10%, #14102e 0%, transparent 65%),
      linear-gradient(180deg, var(--fx-void) 0%, var(--fx-deep) 45%, var(--fx-void) 100%);
  }
  .fx-orb {
    position:absolute; border-radius:50%;
    filter:blur(120px); will-change:transform;
    animation:fxDrift 22s var(--ease-io) infinite;
  }
  .fx-orb.o-pu-a { width:620px; height:620px; background:var(--pu);   top:-300px; right:-140px; opacity:.20; }
  .fx-orb.o-pu-b { width:520px; height:520px; background:var(--pu-d); bottom:-280px; left:-160px; opacity:.16; animation-delay:-7s; }
  .fx-orb.o-ye-a { width:440px; height:440px; background:var(--ye);   top:38%; left:-200px;     opacity:.07; animation-delay:-13s; }
  .fx-orb.o-ye-b { width:360px; height:360px; background:var(--ye-d); bottom:12%; right:-160px;   opacity:.06; animation-delay:-4s; }
  @keyframes fxDrift {
    0%,100% { transform:translate3d(0,0,0) scale(1); }
    33%     { transform:translate3d(-42px,36px,0) scale(1.09); }
    66%     { transform:translate3d(34px,-28px,0) scale(.95); }
  }

  /* Fine tech grid, masked to fade out */
  .fx-mesh {
    position:absolute; inset:0; opacity:.5;
    background-image:
      linear-gradient(rgba(255,255,255,.022) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.022) 1px, transparent 1px);
    background-size:58px 58px;
    -webkit-mask-image:radial-gradient(ellipse 85% 60% at 50% 0%, #000 0%, transparent 78%);
    mask-image:radial-gradient(ellipse 85% 60% at 50% 0%, #000 0%, transparent 78%);
  }
  /* Scanning beam for ambient motion */
  .fx-scan {
    position:absolute; top:0; left:0; right:0; height:220px;
    background:linear-gradient(180deg, transparent, rgba(168,85,247,.055) 45%, rgba(245,230,37,.035) 60%, transparent);
    animation:fxScan 11s linear infinite;
  }
  @keyframes fxScan { 0%{transform:translateY(-240px)} 100%{transform:translateY(110vh)} }

  /* ─── Glass primitives ────────────────────────────────────────────── */
  .fx-glass {
    position:relative;
    background:linear-gradient(158deg, rgba(40,32,86,.60) 0%, rgba(14,12,34,.74) 100%);
    -webkit-backdrop-filter:var(--blur);
    backdrop-filter:var(--blur);
    border-radius:var(--r-lg);
    box-shadow:
      0 22px 60px rgba(0,0,0,.46),
      inset 0 1px 0 rgba(255,255,255,.10),
      inset 0 -1px 0 rgba(0,0,0,.28);
    isolation:isolate;
  }
  /* Gradient hairline border */
  .fx-glass::before {
    content:''; position:absolute; inset:0; border-radius:inherit;
    padding:1px; pointer-events:none; z-index:2;
    background:linear-gradient(145deg,
      rgba(255,255,255,.34) 0%,
      rgba(255,255,255,.05) 34%,
      rgba(168,85,247,.30) 68%,
      rgba(245,230,37,.22) 100%);
    -webkit-mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite:xor;
            mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask-composite:exclude;
  }
  /* Glossy top sheen */
  .fx-glass::after {
    content:''; position:absolute; inset:0; border-radius:inherit;
    pointer-events:none; z-index:1;
    background:linear-gradient(178deg, rgba(255,255,255,.085) 0%, rgba(255,255,255,.015) 38%, transparent 62%);
  }
  .fx-glass > * { position:relative; z-index:3; }

  /* ─── Navigation ──────────────────────────────────────────────────── */
  .f-nav {
    position:fixed; top:0; left:0; right:0; z-index:1000;
    display:flex; align-items:center; justify-content:space-between;
    padding:0 clamp(16px,3vw,32px); height:70px;
    background:rgba(6,6,18,.55);
    -webkit-backdrop-filter:blur(24px) saturate(180%);
            backdrop-filter:blur(24px) saturate(180%);
    border-bottom:1px solid var(--fx-line);
    transition:background .4s var(--ease-io), height .4s var(--ease), border-color .4s;
  }
  .f-nav.scrolled {
    background:rgba(6,6,18,.82);
    border-bottom-color:rgba(168,85,247,.22);
    box-shadow:0 12px 40px rgba(0,0,0,.5);
  }
  /* Accent hairline under nav */
  .f-nav::after {
    content:''; position:absolute; left:0; right:0; bottom:-1px; height:1px;
    background:linear-gradient(90deg, transparent, var(--pu) 30%, var(--ye) 70%, transparent);
    opacity:.4; pointer-events:none;
  }

  .f-brand { display:flex; align-items:center; gap:11px; font-size:1.15rem; font-weight:900; color:#fff; letter-spacing:.3px; }
  .f-brand-badge {
    position:relative; width:34px; height:34px; border-radius:10px;
    background:var(--grad-pu); display:flex; align-items:center; justify-content:center;
    font-size:.85rem; color:#fff; overflow:hidden;
    box-shadow:0 6px 20px rgba(168,85,247,.5), inset 0 1px 0 rgba(255,255,255,.35);
    transition:transform .45s var(--ease), box-shadow .45s var(--ease);
  }
  .f-brand:hover .f-brand-badge {
    transform:rotate(-8deg) scale(1.08);
    box-shadow:0 8px 30px rgba(245,230,37,.5), inset 0 1px 0 rgba(255,255,255,.45);
  }
  .f-brand-badge::after {
    content:''; position:absolute; top:-60%; left:-40%; width:40px; height:200%;
    background:linear-gradient(90deg, transparent, rgba(255,255,255,.75), transparent);
    transform:rotate(20deg); animation:fxSheen 4.5s ease-in-out infinite;
  }
  @keyframes fxSheen { 0%,72%{left:-40%} 92%,100%{left:130%} }
  .f-brand-name { background:var(--grad-brand); background-size:200% 100%; -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; animation:fxHue 7s ease-in-out infinite; }
  @keyframes fxHue { 0%,100%{background-position:0% 50%} 50%{background-position:100% 50%} }

  .f-nav-acts { display:flex; align-items:center; gap:9px; }

  /* ─── Buttons ─────────────────────────────────────────────────────── */
  .f-btn {
    position:relative; display:inline-flex; align-items:center; justify-content:center; gap:8px;
    padding:12px 28px; border-radius:12px; border:1px solid transparent;
    font-size:.9rem; font-weight:700; cursor:pointer; overflow:hidden;
    transition:transform .3s var(--ease), box-shadow .3s var(--ease), background .3s;
    will-change:transform;
  }
  .f-btn:hover { transform:translateY(-2px); }
  .f-btn:active { transform:translateY(0) scale(.985); }
  /* Shine sweep */
  .f-btn::after {
    content:''; position:absolute; top:0; left:-120%; width:55%; height:100%;
    background:linear-gradient(90deg, transparent, rgba(255,255,255,.45), transparent);
    transform:skewX(-20deg); transition:left .65s var(--ease);
  }
  .f-btn:hover::after { left:150%; }

  .f-btn-p {
    background:var(--grad-pu); color:#fff;
    box-shadow:0 8px 26px rgba(168,85,247,.42), inset 0 1px 0 rgba(255,255,255,.28);
  }
  .f-btn-p:hover { box-shadow:0 14px 42px rgba(168,85,247,.58), inset 0 1px 0 rgba(255,255,255,.35); color:#fff; }

  .f-btn-ye {
    background:var(--grad-ye); color:#141004;
    box-shadow:0 8px 26px rgba(245,230,37,.34), inset 0 1px 0 rgba(255,255,255,.6);
  }
  .f-btn-ye:hover { box-shadow:0 14px 44px rgba(245,230,37,.5), inset 0 1px 0 rgba(255,255,255,.7); color:#141004; }

  .f-btn-g {
    background:rgba(255,255,255,.045); color:var(--fx-mut);
    border-color:var(--fx-line);
    -webkit-backdrop-filter:blur(14px); backdrop-filter:blur(14px);
  }
  .f-btn-g:hover { color:#fff; border-color:rgba(168,85,247,.4); background:rgba(168,85,247,.1); }

  .f-nbtn {
    display:inline-flex; align-items:center; gap:7px; cursor:pointer;
    padding:9px 18px; border-radius:11px; border:1px solid transparent;
    font-size:.82rem; font-weight:700; white-space:nowrap;
    transition:transform .3s var(--ease), box-shadow .3s var(--ease), background .3s, color .3s;
  }
  .f-nbtn:hover { transform:translateY(-2px); }
  .f-nbtn-p { background:var(--grad-pu); color:#fff; box-shadow:0 5px 20px rgba(168,85,247,.4); }
  .f-nbtn-p:hover { color:#fff; box-shadow:0 9px 32px rgba(168,85,247,.55); }
  .f-nbtn-ye { background:var(--grad-ye); color:#141004; box-shadow:0 5px 20px rgba(245,230,37,.32); }
  .f-nbtn-ye:hover { color:#141004; box-shadow:0 9px 34px rgba(245,230,37,.48); }
  .f-nbtn-g { background:rgba(255,255,255,.045); color:var(--fx-mut); border-color:var(--fx-line); }
  .f-nbtn-g:hover { color:#fff; background:rgba(255,255,255,.09); border-color:var(--fx-line-2); }
  .f-nbtn-d { background:rgba(255,92,108,.1); color:#ff8f9a; border-color:rgba(255,92,108,.18); }
  .f-nbtn-d:hover { color:#ffb0b8; background:rgba(255,92,108,.17); }

  /* ─── Live status pill ────────────────────────────────────────────── */
  .f-pill {
    display:inline-flex; align-items:center; gap:8px;
    padding:6px 15px; border-radius:100px; font-size:.72rem; font-weight:700;
    color:var(--pu-l); background:rgba(168,85,247,.09);
    border:1px solid rgba(168,85,247,.24); margin-bottom:20px;
    -webkit-backdrop-filter:blur(12px); backdrop-filter:blur(12px);
    box-shadow:0 0 22px rgba(168,85,247,.14), inset 0 1px 0 rgba(255,255,255,.1);
  }
  .fx-dot {
    width:7px; height:7px; border-radius:50%; background:var(--ok); flex-shrink:0;
    box-shadow:0 0 0 0 rgba(52,245,165,.6); animation:fxPulse 2.1s ease-out infinite;
  }
  @keyframes fxPulse {
    0%   { box-shadow:0 0 0 0 rgba(52,245,165,.55); }
    70%  { box-shadow:0 0 0 9px rgba(52,245,165,0); }
    100% { box-shadow:0 0 0 0 rgba(52,245,165,0); }
  }
  .fx-dot.off { background:var(--bad); animation:none; box-shadow:0 0 10px rgba(255,92,108,.6); }

  /* ─── Hero ────────────────────────────────────────────────────────── */
  .f-hero { position:relative; z-index:1; min-height:100vh; display:flex; align-items:center; overflow:hidden; }
  .f-hero-inner {
    position:relative; z-index:3; width:100%; max-width:1220px; margin:0 auto;
    padding:132px clamp(16px,3vw,32px) 88px;
    display:grid; grid-template-columns:1.05fr .95fr; gap:clamp(32px,5vw,60px); align-items:center;
  }

  .f-left { max-width:540px; }

  .f-left h1 {
    font-size:clamp(2.3rem,5.2vw,3.7rem); font-weight:900; line-height:1.14;
    margin-bottom:20px; letter-spacing:-.5px;
  }
  .f-left h1 em {
    font-style:normal; position:relative; display:inline-block;
    background:var(--grad-brand); background-size:220% 100%;
    -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent;
    animation:fxHue 8s ease-in-out infinite;
    filter:drop-shadow(0 0 26px rgba(168,85,247,.45));
  }
  /* Yellow underline stroke beneath the highlighted word */
  .f-left h1 em::after {
    content:''; position:absolute; right:0; left:0; bottom:-6px; height:3px;
    background:var(--grad-ye); border-radius:100px;
    box-shadow:0 0 16px rgba(245,230,37,.6);
    transform:scaleX(0); transform-origin:right;
    animation:fxStroke 1s var(--ease) .7s forwards;
  }
  @keyframes fxStroke { to { transform:scaleX(1); } }

  .f-left > p {
    font-size:clamp(.92rem,1.6vw,1.02rem); color:var(--fx-mut);
    line-height:2; margin-bottom:30px; max-width:490px;
  }

  .f-acts { display:flex; gap:12px; flex-wrap:wrap; margin-bottom:34px; }

  /* Feature chips under CTAs */
  .f-chips { display:flex; gap:9px; flex-wrap:wrap; }
  .f-chip {
    display:inline-flex; align-items:center; gap:7px;
    padding:7px 15px; border-radius:100px; font-size:.73rem; font-weight:600;
    color:var(--fx-mut); background:rgba(255,255,255,.035);
    border:1px solid var(--fx-line);
    transition:transform .3s var(--ease), border-color .3s, background .3s, color .3s;
  }
  .f-chip:hover { transform:translateY(-2px); color:#fff; background:rgba(255,255,255,.07); border-color:rgba(168,85,247,.3); }
  .f-chip i { font-size:.66rem; }
  .f-chip.c-pu i { color:var(--pu); }
  .f-chip.c-ye i { color:var(--ye); }

  /* ─── Live console / metric panel ─────────────────────────────────── */
  .f-right { display:flex; justify-content:center; }

  .f-frame {
    position:relative; width:100%; max-width:520px; padding:5px;
    border-radius:24px; transition:transform .5s var(--ease);
  }
  .f-frame-in {
    position:relative; border-radius:20px; overflow:hidden;
    background:linear-gradient(158deg, rgba(40,32,86,.5) 0%, rgba(10,9,26,.8) 100%);
    -webkit-backdrop-filter:var(--blur-lg); backdrop-filter:var(--blur-lg);
    box-shadow:0 30px 80px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.1);
  }
  /* Pulsing duotone halo behind the console */
  .f-frame-in::before {
    content:''; position:absolute; inset:-2px; border-radius:22px; z-index:-1;
    background:linear-gradient(135deg, rgba(168,85,247,.55), rgba(245,230,37,.4));
    filter:blur(22px); opacity:.42; animation:fxHalo 5.5s ease-in-out infinite;
  }
  @keyframes fxHalo { 0%,100%{opacity:.3; transform:scale(1)} 50%{opacity:.55; transform:scale(1.03)} }

  .f-frame-h {
    display:flex; align-items:center; gap:11px; padding:14px 18px;
    background:rgba(255,255,255,.028); border-bottom:1px solid var(--fx-line);
  }
  .f-frame-dots { display:flex; gap:6px; }
  .f-frame-dot { width:9px; height:9px; border-radius:50%; }
  .f-frame-dot:nth-child(1) { background:#ff5f57; }
  .f-frame-dot:nth-child(2) { background:var(--ye); }
  .f-frame-dot:nth-child(3) { background:var(--ok); }
  .f-frame-title { font-size:.72rem; font-weight:600; color:var(--fx-mut); flex:1; text-align:center; }
  .f-frame-badge {
    display:inline-flex; align-items:center; gap:5px; font-size:.6rem; font-weight:700;
    color:var(--ok); padding:3px 9px; border-radius:100px;
    background:rgba(52,245,165,.1); border:1px solid rgba(52,245,165,.2);
  }
  .f-frame-badge i { font-size:.36rem; }

  .f-frame-b { padding:18px; display:grid; grid-template-columns:1fr 1fr; gap:13px; }

  /* ─── Metric cards ────────────────────────────────────────────────── */
  .fx-metric {
    position:relative; padding:16px 15px 14px; border-radius:var(--r-md);
    background:linear-gradient(160deg, rgba(255,255,255,.055) 0%, rgba(255,255,255,.018) 100%);
    border:1px solid var(--fx-line); overflow:hidden;
    transition:transform .4s var(--ease), border-color .4s, box-shadow .4s var(--ease);
    will-change:transform;
  }
  .fx-metric::before {
    content:''; position:absolute; inset:0; border-radius:inherit; pointer-events:none;
    background:linear-gradient(180deg, rgba(255,255,255,.10), transparent 55%);
  }
  /* Accent wash keyed to --a (duotone assignment) */
  .fx-metric::after {
    content:''; position:absolute; top:-46px; right:-46px;
    width:130px; height:130px; border-radius:50%;
    background:var(--a); filter:blur(46px); opacity:.2;
    transition:opacity .45s var(--ease);
    pointer-events:none;
  }
  .fx-metric:hover {
    transform:translateY(-4px);
    border-color:color-mix(in srgb, var(--a) 45%, transparent);
    box-shadow:0 18px 44px rgba(0,0,0,.48), 0 0 26px color-mix(in srgb, var(--a) 22%, transparent);
  }
  .fx-metric:hover::after { opacity:.42; }

  .fx-metric-top { display:flex; align-items:center; justify-content:space-between; margin-bottom:13px; position:relative; z-index:2; }
  .fx-metric-ic {
    width:36px; height:36px; border-radius:11px; display:flex; align-items:center; justify-content:center;
    font-size:.88rem; color:var(--a);
    background:color-mix(in srgb, var(--a) 13%, transparent);
    border:1px solid color-mix(in srgb, var(--a) 26%, transparent);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.16);
    transition:transform .4s var(--ease);
  }
  .fx-metric:hover .fx-metric-ic { transform:scale(1.1) rotate(-6deg); }

  .fx-metric-val {
    display:block; font-size:1.72rem; font-weight:900; line-height:1.15;
    font-variant-numeric:tabular-nums; letter-spacing:-.5px; position:relative; z-index:2;
    text-shadow:0 2px 20px color-mix(in srgb, var(--a) 40%, transparent);
  }
  .fx-metric-lbl { display:block; font-size:.7rem; color:var(--fx-dim); margin-top:3px; position:relative; z-index:2; }
  .fx-metric-sub {
    display:inline-flex; align-items:center; gap:5px; margin-top:9px;
    font-size:.63rem; font-weight:700; color:var(--a);
    padding:3px 10px; border-radius:100px;
    background:color-mix(in srgb, var(--a) 11%, transparent);
    border:1px solid color-mix(in srgb, var(--a) 22%, transparent);
    position:relative; z-index:2;
  }
  /* Ping quality modifiers (set from JS) */
  .fx-metric.q-good .fx-metric-val { color:var(--ok); text-shadow:0 2px 20px rgba(52,245,165,.4); }
  .fx-metric.q-mid  .fx-metric-val { color:var(--warn); text-shadow:0 2px 20px rgba(251,191,36,.4); }
  .fx-metric.q-bad  .fx-metric-val { color:var(--bad); text-shadow:0 2px 20px rgba(255,92,108,.4); }
  /* Waiting: dimmed value + gently pulsing sparkline */
  .fx-metric.q-wait .fx-metric-val { color:var(--fx-dim); text-shadow:none; }
  .fx-metric.q-wait .fx-metric-ic { animation:fxWait 1.6s ease-in-out infinite; }
  .fx-metric.q-wait .fx-spark i { animation-duration:1.4s; opacity:.18; }
  .fx-metric.q-wait .fx-metric-sub { color:var(--warn); background:rgba(251,191,36,.1); border-color:rgba(251,191,36,.22); }
  @keyframes fxWait { 0%,100%{opacity:.5} 50%{opacity:1} }
  /* Sub-label in a pending tone */
  .fx-metric-sub.is-wait { color:var(--warn); background:rgba(251,191,36,.1); border-color:rgba(251,191,36,.22); }

  /* Sparkline strip inside metric */
  .fx-spark { display:flex; align-items:flex-end; gap:3px; height:22px; margin-top:11px; position:relative; z-index:2; }
  .fx-spark i {
    flex:1; border-radius:2px 2px 0 0; background:var(--a); opacity:.3;
    transform-origin:bottom; animation:fxBar 2.4s var(--ease-io) infinite;
  }
  @keyframes fxBar { 0%,100%{transform:scaleY(.3)} 50%{transform:scaleY(1)} }

  /* ─── Trust strip ─────────────────────────────────────────────────── */
  .f-strip {
    position:relative; z-index:2; max-width:1220px; margin:0 auto;
    padding:0 clamp(16px,3vw,32px) 68px;
  }
  .f-strip-in {
    display:grid; grid-template-columns:repeat(4,1fr); gap:1px;
    border-radius:var(--r-md); overflow:hidden;
    background:var(--fx-line);
    border:1px solid var(--fx-line);
  }
  .f-strip-c {
    padding:22px 18px; text-align:center; background:rgba(12,10,30,.5);
    -webkit-backdrop-filter:blur(18px); backdrop-filter:blur(18px);
    transition:background .35s;
  }
  .f-strip-c:hover { background:rgba(168,85,247,.09); }
  .f-strip-c i { font-size:1rem; color:var(--pu); margin-bottom:9px; display:block; transition:transform .4s var(--ease); }
  .f-strip-c:nth-child(even) i { color:var(--ye); }
  .f-strip-c:hover i { transform:translateY(-3px) scale(1.12); }
  .f-strip-c b { display:block; font-size:.9rem; font-weight:800; margin-bottom:2px; }
  .f-strip-c span { font-size:.72rem; color:var(--fx-dim); }

  /* ─── Sections ────────────────────────────────────────────────────── */
  .f-sec { position:relative; z-index:2; padding:clamp(64px,9vw,104px) clamp(16px,3vw,32px); }
  .f-sec-inner { max-width:1160px; margin:0 auto; }

  .f-center { text-align:center; margin-bottom:clamp(38px,5vw,58px); }
  .f-label {
    display:inline-flex; align-items:center; gap:7px; margin-bottom:14px;
    padding:6px 16px; border-radius:100px; font-size:.7rem; font-weight:700;
  }
  .f-label-p { background:rgba(168,85,247,.1); border:1px solid rgba(168,85,247,.24); color:var(--pu-l); }
  .f-label-y { background:rgba(245,230,37,.09); border:1px solid rgba(245,230,37,.22); color:var(--ye-l); }
  .f-center h2 { font-size:clamp(1.6rem,3.6vw,2.4rem); font-weight:900; line-height:1.28; margin-bottom:12px; }
  .f-center h2 em {
    font-style:normal; background:var(--grad-brand); background-size:200% 100%;
    -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent;
    animation:fxHue 8s ease-in-out infinite;
  }
  .f-center p { color:var(--fx-mut); font-size:.94rem; line-height:1.95; max-width:560px; margin:0 auto; }

  /* ─── Feature cards ───────────────────────────────────────────────── */
  .f-cards { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; }
  .f-card { padding:26px 24px; transition:transform .45s var(--ease), box-shadow .45s var(--ease); }
  .f-card:hover { transform:translateY(-6px); box-shadow:0 30px 70px rgba(0,0,0,.55), 0 0 34px color-mix(in srgb, var(--a) 20%, transparent); }
  /* Bottom duotone rail, reveals on hover */
  .f-card-rail {
    position:absolute; bottom:0; right:22px; left:22px; height:2px; border-radius:2px;
    background:linear-gradient(90deg, transparent, var(--a), var(--a2,var(--a)), transparent);
    opacity:0; transform:scaleX(.4); transition:opacity .45s var(--ease), transform .45s var(--ease);
  }
  .f-card:hover .f-card-rail { opacity:1; transform:scaleX(1); }

  .fx-cicon {
    width:50px; height:50px; border-radius:15px; display:flex; align-items:center; justify-content:center;
    font-size:1.12rem; margin-bottom:17px; color:var(--a);
    background:color-mix(in srgb, var(--a) 12%, transparent);
    border:1px solid color-mix(in srgb, var(--a) 26%, transparent);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.18), 0 8px 24px color-mix(in srgb, var(--a) 16%, transparent);
    transition:transform .45s var(--ease), box-shadow .45s var(--ease);
  }
  .f-card:hover .fx-cicon { transform:translateY(-3px) scale(1.08) rotate(-6deg); }
  .f-card h3 { font-size:.95rem; font-weight:800; margin-bottom:7px; }
  .f-card p { font-size:.8rem; color:var(--fx-dim); line-height:1.95; }
  .f-card-tag {
    display:inline-flex; align-items:center; gap:5px; margin-top:14px;
    font-size:.63rem; font-weight:700; color:var(--a);
    padding:3px 10px; border-radius:100px;
    background:color-mix(in srgb, var(--a) 10%, transparent);
    border:1px solid color-mix(in srgb, var(--a) 20%, transparent);
  }

  /* ─── Steps ───────────────────────────────────────────────────────── */
  .f-steps { display:grid; grid-template-columns:repeat(3,1fr); gap:22px; position:relative; }
  .f-step {
    position:relative; padding:28px 24px; text-align:center;
    transition:transform .45s var(--ease);
  }
  .f-step:hover { transform:translateY(-5px); }
  /* Connector line */
  .f-step:not(:last-child)::after {
    content:''; position:absolute; top:52px; left:-11px; width:22px; height:1px;
    background:linear-gradient(90deg, transparent, rgba(168,85,247,.5));
  }
  .f-step-num {
    position:relative; z-index:3; width:52px; height:52px; border-radius:16px;
    margin:0 auto 18px; display:flex; align-items:center; justify-content:center;
    font-size:1.2rem; font-weight:900; color:#fff;
    background:var(--grad-pu); border:1px solid rgba(255,255,255,.16);
    box-shadow:0 12px 32px rgba(168,85,247,.42), inset 0 1px 0 rgba(255,255,255,.32);
    transition:transform .5s var(--ease), box-shadow .5s var(--ease), background .5s;
  }
  .f-step:nth-child(even) .f-step-num { background:var(--grad-ye); color:#141004; box-shadow:0 12px 32px rgba(245,230,37,.4), inset 0 1px 0 rgba(255,255,255,.6); }
  .f-step:hover .f-step-num { transform:translateY(-4px) rotate(-8deg) scale(1.08); }
  .f-step-num::before {
    content:''; position:absolute; inset:-8px; border-radius:22px;
    border:1px solid rgba(168,85,247,.3); opacity:0;
    animation:fxRing 3s var(--ease-io) infinite;
  }
  @keyframes fxRing { 0%{opacity:.7; transform:scale(.9)} 70%,100%{opacity:0; transform:scale(1.22)} }
  .f-step h4 { font-size:1rem; font-weight:800; margin-bottom:7px; }
  .f-step p { font-size:.8rem; color:var(--fx-dim); line-height:1.9; }

  /* ─── Numbers ─────────────────────────────────────────────────────── */
  .f-nums { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; }
  .fx-num {
    padding:30px 20px; text-align:center;
    transition:transform .45s var(--ease), box-shadow .45s var(--ease);
  }
  .fx-num:hover { transform:translateY(-5px) scale(1.02); box-shadow:0 26px 60px rgba(0,0,0,.5), 0 0 30px color-mix(in srgb, var(--a) 20%, transparent); }
  .fx-num-v {
    display:block; font-size:clamp(1.9rem,4.4vw,2.7rem); font-weight:900; line-height:1.1;
    font-variant-numeric:tabular-nums; letter-spacing:-1px;
    background:var(--g); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent;
  }
  .fx-num-l { display:block; font-size:.8rem; color:var(--fx-dim); margin-top:7px; }
  .fx-num-i { font-size:1.05rem; color:var(--a); margin-bottom:13px; display:block; transition:transform .4s var(--ease); }
  .fx-num:hover .fx-num-i { transform:translateY(-3px) scale(1.14); }

  /* ─── Final CTA ───────────────────────────────────────────────────── */
  .f-cta { position:relative; padding:clamp(40px,6vw,64px) clamp(24px,5vw,56px); text-align:center; overflow:hidden; }
  .f-cta::after { border-radius:inherit; }
  .f-cta::before {
    content:''; position:absolute; inset:-1px; border-radius:inherit; z-index:0;
    background:radial-gradient(ellipse 70% 90% at 50% 0%, rgba(245,230,37,.16), transparent 62%),
               radial-gradient(ellipse 70% 90% at 50% 100%, rgba(168,85,247,.2), transparent 62%);
  }
  .f-cta h2 { font-size:clamp(1.5rem,3.4vw,2.15rem); font-weight:900; margin-bottom:11px; }
  .f-cta h2 em { font-style:normal; background:var(--grad-brand); background-size:200% 100%; -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; animation:fxHue 8s ease-in-out infinite; }
  .f-cta p { color:var(--fx-mut); margin-bottom:28px; font-size:.92rem; line-height:1.85; }
  .f-cta .f-acts { justify-content:center; margin-bottom:0; }

  /* ─── Footer ──────────────────────────────────────────────────────── */
  .f-footer { position:relative; z-index:2; border-top:1px solid var(--fx-line); padding:26px clamp(16px,3vw,32px); background:rgba(6,6,18,.5); -webkit-backdrop-filter:blur(20px); backdrop-filter:blur(20px); }
  .f-footer-inner { display:flex; justify-content:space-between; align-items:center; gap:14px; max-width:1160px; margin:0 auto; font-size:.78rem; color:var(--fx-dim); flex-wrap:wrap; }
  .f-fsocial { display:flex; gap:10px; }
  .f-fsocial a {
    width:36px; height:36px; border-radius:11px; display:flex; align-items:center; justify-content:center;
    background:rgba(255,255,255,.04); border:1px solid var(--fx-line); color:var(--fx-mut);
    transition:transform .35s var(--ease), color .3s, border-color .3s, background .3s, box-shadow .35s;
  }
  .f-fsocial a:hover { transform:translateY(-3px); color:#fff; border-color:rgba(168,85,247,.45); background:rgba(168,85,247,.14); box-shadow:0 8px 22px rgba(168,85,247,.28); }

  /* ─── Scroll reveal ───────────────────────────────────────────────── */
  .fx-reveal { opacity:0; transform:translateY(26px); }
  .fx-reveal.in { opacity:1; transform:none; transition:opacity .8s var(--ease-io), transform .8s var(--ease); }
  .fx-reveal:nth-child(2).in { transition-delay:.08s; }
  .fx-reveal:nth-child(3).in { transition-delay:.16s; }
  .fx-reveal:nth-child(4).in { transition-delay:.24s; }
  .fx-reveal:nth-child(5).in { transition-delay:.32s; }
  .fx-reveal:nth-child(6).in { transition-delay:.4s; }

  /* ─── Toast (auth errors) ─────────────────────────────────────────── */
  .f-toast {
    position:fixed; bottom:26px; left:50%; transform:translateX(-50%); z-index:9999;
    background:rgba(255,92,108,.14); -webkit-backdrop-filter:blur(22px); backdrop-filter:blur(22px);
    border:1px solid rgba(255,92,108,.24); border-radius:12px;
    padding:12px 24px; font-size:.84rem; color:#ffb0b8; direction:rtl;
    box-shadow:0 16px 44px rgba(0,0,0,.5);
    animation:fxToast .5s var(--ease) both;
  }
  @keyframes fxToast { from{opacity:0; transform:translate(-50%,18px)} to{opacity:1; transform:translate(-50%,0)} }

  /* ═══ Maintenance mode (classes injected by JS) ════════════════════ */
  .f-frame { position:relative; }
  .f-frame-glass {
    position:absolute; inset:5px; z-index:10; display:none;
    flex-direction:column; align-items:center; justify-content:center; gap:8px;
    background:rgba(8,8,22,.62); -webkit-backdrop-filter:var(--blur-lg); backdrop-filter:var(--blur-lg);
    border-radius:20px; transition:opacity .5s ease; text-align:center; padding:20px;
  }
  .f-frame-glass.show { display:flex; animation:fxFade .5s ease both; }
  @keyframes fxFade { from{opacity:0} to{opacity:1} }
  .f-glass-icon {
    width:46px; height:46px; border-radius:50%;
    background:rgba(255,92,108,.15); border:1px solid rgba(255,92,108,.25);
    display:flex; align-items:center; justify-content:center;
    font-size:1.1rem; color:#ff5c6c; animation:fxBlink 1.3s ease-in-out infinite;
  }
  @keyframes fxBlink { 0%,100%{opacity:1} 50%{opacity:.2} }
  .f-glass-title { font-size:.9rem; font-weight:800; color:rgba(255,255,255,.9); }
  .f-glass-msg { font-size:.75rem; color:var(--fx-mut); padding:0 12px; line-height:1.7; }
  .f-glass-time {
    display:inline-flex; align-items:center; gap:6px; margin-top:4px;
    padding:4px 14px; border-radius:100px;
    background:rgba(255,255,255,.05); border:1px solid var(--fx-line);
    font-family:'Cairo',ui-monospace,monospace; font-size:.72rem; color:var(--fx-mut); direction:ltr;
  }
  .f-glass-time i { font-size:.5rem; color:#ff5c6c; animation:fxBlink 1.3s ease-in-out infinite; }

  .mnt-banner {
    position:sticky; top:0; z-index:10000;
    background:rgba(255,92,108,.16);
    -webkit-backdrop-filter:blur(26px) saturate(180%); backdrop-filter:blur(26px) saturate(180%);
    border-bottom:1px solid rgba(255,255,255,.07);
    animation:fxDrop .55s var(--ease) both;
  }
  @keyframes fxDrop { from{transform:translateY(-100%); opacity:0} to{transform:translateY(0); opacity:1} }
  .mnt-banner-inner { max-width:1160px; margin:0 auto; padding:9px clamp(16px,3vw,24px); display:flex; align-items:center; gap:12px; direction:rtl; }
  .mnt-banner-icon {
    width:34px; height:34px; border-radius:50%; flex-shrink:0;
    background:rgba(255,92,108,.2); border:1px solid rgba(255,92,108,.28);
    display:flex; align-items:center; justify-content:center; font-size:.85rem; color:#ff5c6c;
  }
  .mnt-banner-text { flex:1; }
  .mnt-banner-title { font-weight:800; font-size:.84rem; color:rgba(255,255,255,.9); margin-bottom:1px; }
  .mnt-banner-desc { font-size:.74rem; color:var(--fx-mut); display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
  .mnt-banner-time {
    display:inline-flex; align-items:center; gap:5px; padding:2px 11px; border-radius:100px;
    background:rgba(255,255,255,.05); border:1px solid var(--fx-line);
    font-family:'Cairo',ui-monospace,monospace; font-size:.73rem; color:var(--fx-mut); direction:ltr;
  }
  .mnt-banner-time i { font-size:.55rem; color:#ff5c6c; animation:fxBlink 1.3s ease-in-out infinite; }
  body.mnt-active .f-nav { top:55px; }
  body.mnt-active .mnt-banner { position:fixed; left:0; right:0; }

  /* ═══ Responsive ══════════════════════════════════════════════════ */
  @media (max-width:1080px) {
    .f-hero-inner { grid-template-columns:1fr; text-align:center; gap:52px; }
    .f-left { margin:0 auto; max-width:620px; }
    .f-left > p { margin-inline:auto; }
    .f-acts, .f-chips { justify-content:center; }
    .f-frame { max-width:560px; }
    .f-cards { grid-template-columns:repeat(2,1fr); }
  }
  @media (max-width:900px) {
    .f-strip-in { grid-template-columns:repeat(2,1fr); }
    .f-nums { grid-template-columns:repeat(2,1fr); }
    .f-steps { grid-template-columns:1fr; gap:18px; }
    .f-step:not(:last-child)::after { display:none; }
  }
  @media (max-width:640px) {
    .f-nav { height:62px; }
    .f-brand-name { display:none; }
    .f-hero-inner { padding:112px 16px 64px; }
    .f-acts { flex-direction:column; align-items:stretch; }
    .f-btn { width:100%; }
    .f-frame-b { grid-template-columns:1fr; }
    .f-cards { grid-template-columns:1fr; }
    .f-strip-in, .f-nums { grid-template-columns:1fr; }
    .f-strip-c { padding:18px 14px; }
    .f-footer-inner { flex-direction:column; text-align:center; }
    .mnt-banner-inner { flex-direction:row; text-align:right; padding:7px 14px; gap:9px; }
    .mnt-banner-title { font-size:.77rem; }
    .fx-metric-val { font-size:1.5rem; }
  }

  /* ═══ Reduced motion ══════════════════════════════════════════════ */
  @media (prefers-reduced-motion:reduce) {
    *, *::before, *::after {
      animation-duration:.001ms !important; animation-iteration-count:1 !important;
      transition-duration:.001ms !important; scroll-behavior:auto !important;
    }
    .fx-reveal { opacity:1; transform:none; }
  }
  </style>
</head>
<body>
<%
  /* ── Null-safe readers ────────────────────────────────────────────────
     `stats.bot.members` can legitimately be 0 (or NaN when the bot's guild
     cache has no memberCount yet). A plain truthiness test treats those as
     "missing" and renders a dash, which is why the live metrics showed
     nothing. These helpers only treat null/undefined/NaN as absent. */
  const botStat = locals.stats && stats.bot ? stats.bot : {};
  const hasVal = v => v !== null && v !== undefined && !Number.isNaN(v);
  const orDash  = v => hasVal(v) ? v : '—';
  const orNum   = v => hasVal(v) ? Number(v).toLocaleString() : '—';
  const pingTxt = v => hasVal(v) ? v + 'ms' : '—';
  const pingLbl = v => hasVal(v) && v > 0 ? (v < 200 ? 'ممتاز' : 'جيد') : 'غير متاح';
  const guildLbl = v => hasVal(v) && v > 0 ? 'متصل' : 'غير متصل';
%>

  <div class="f-ambient" aria-hidden="true">
    <div class="fx-orb o-pu-a"></div>
    <div class="fx-orb o-pu-b"></div>
    <div class="fx-orb o-ye-a"></div>
    <div class="fx-orb o-ye-b"></div>
    <div class="fx-mesh"></div>
    <div class="fx-scan"></div>
  </div>

  <!-- ══════════ Navigation ══════════ -->
  <nav class="f-nav" id="fxNav">
    <a href="/" class="f-brand">
      <div class="f-brand-badge"><i class="fas fa-bolt"></i></div>
      <span class="f-brand-name">KRS</span>
    </a>
    <div class="f-nav-acts">
      <a href="/premium" class="f-nbtn f-nbtn-ye"><i class="fas fa-crown"></i> البريميوم</a>
      <% if (locals.user) { %>
        <a href="/home" class="f-nbtn f-nbtn-p"><i class="fas fa-th-large"></i> لوحة التحكم</a>
        <a href="/auth/logout" class="f-nbtn f-nbtn-d"><i class="fas fa-sign-out-alt"></i> خروج</a>
      <% } else { %>
        <a href="/auth/discord" class="f-nbtn f-nbtn-p"><i class="fab fa-discord"></i> Login with Discord</a>
      <% } %>
    </div>
  </nav>

  <% if (locals.error) { %>
    <div class="f-toast"><i class="fas fa-circle-exclamation"></i> <%= error %></div>
  <% } %>

  <!-- ══════════ Hero ══════════ -->
  <section class="f-hero">
    <div class="f-hero-inner">

      <div class="f-left">
        <div class="f-pill" id="landPill"><span class="fx-dot"></span> KRATOS SYSTEM v1.0.11 — شغال</div>

        <h1>أداة متكاملة<br>لإدارة <em>السيرفر</em></h1>

        <p>لوحة تحكم شاملة تجمع الحماية، التذاكر، الغرف الصوتية، الإشراف، والإشعارات — كلها في واجهة واحدة بمزامنة فورية.</p>

        <div class="f-acts">
          <% if (locals.user) { %>
            <a href="/home" class="f-btn f-btn-p"><i class="fas fa-th-large"></i> لوحة التحكم</a>
            <a href="/auth/logout" class="f-btn f-btn-g"><i class="fas fa-sign-out-alt"></i> خروج</a>
          <% } else { %>
            <a href="/auth/discord" class="f-btn f-btn-p"><i class="fab fa-discord"></i> سجل بدقيقة</a>
            <a href="/invite-dev" class="f-btn f-btn-ye"><i class="fas fa-code-branch"></i> أضف البوت</a>
            <a href="/premium" class="f-btn f-btn-g"><i class="fas fa-crown"></i> البريميوم</a>
          <% } %>
        </div>

        <div class="f-chips">
          <span class="f-chip c-pu"><i class="fas fa-shield-halved"></i> حماية متقدمة</span>
          <span class="f-chip c-ye"><i class="fas fa-ticket-alt"></i> تذاكر ذكية</span>
          <span class="f-chip c-pu"><i class="fas fa-microphone"></i> غرف صوتية</span>
          <span class="f-chip c-ye"><i class="fas fa-bolt"></i> مزامنة فورية</span>
        </div>
      </div>

      <!-- Live metrics console -->
      <div class="f-right">
        <div class="f-frame" data-tilt>
          <div class="f-frame-in">

            <div class="f-frame-h">
              <div class="f-frame-dots">
                <div class="f-frame-dot"></div>
                <div class="f-frame-dot"></div>
                <div class="f-frame-dot"></div>
              </div>
              <span class="f-frame-title">لوحة قياس حيّة — بيانات لحظية</span>
              <span class="f-frame-badge"><i class="fas fa-circle"></i> LIVE</span>
            </div>

            <div class="f-frame-b">

              <div class="fx-metric" style="--a:#a855f7">
                <div class="fx-metric-top">
                  <span class="fx-metric-ic"><i class="fas fa-server"></i></span>
                </div>
                <b class="fx-metric-val" id="frameGuilds"><%= orDash(botStat.guilds) %></b>
                <span class="fx-metric-lbl">سيرفر نشط</span>
                <span class="fx-metric-sub" id="frameGuildsVal"><%= guildLbl(botStat.guilds) %></span>

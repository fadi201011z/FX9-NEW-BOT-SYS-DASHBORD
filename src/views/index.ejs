<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Kratos Dashboard — لوحة تحكم البوت</title>
<meta name="description" content="لوحة تحكم متكاملة لإدارة سيرفرك على ديسكورد — إشراف، تذاكر، غرف صوتية، حماية، وأدوات.">
<meta name="theme-color" content="#08080f">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">

<meta property="og:type" content="website">
<meta property="og:title" content="Kratos System — لوحة تحكم البوت">
<meta property="og:description" content="أدر سيرفرك، تواصل مع مجتمعك، وافتح كل الإمكانات — كل ذلك في مكان واحد.">
<meta property="og:site_name" content="Kratos System">
<meta name="twitter:card" content="summary">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&amp;family=Poppins:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>
/* ═══════════════════════════════════════════════════════════════════════════
   Kratos System — landing page
   Full structural copy of novax.gg, rebuilt from measurements rather than
   copied markup. Every value below was read off that page with
   getComputedStyle / the shipped stylesheets.

   Deviations from the source, all deliberate:
     - no planet artwork. novax paints assets/images/landing/hero.svg across the
       hero; that file is not reproduced and nothing references it.
     - the footer wave is drawn with CSS radial gradients instead of their
       footer.svg.
     - copy is Arabic. Poppins carries the Latin and numeral runs, Cairo picks
       up the Arabic through the same stack, so no font swap is needed.
   ═══════════════════════════════════════════════════════════════════════════ */

:root {
  /* sampled off novax.gg */
  --nx-purple:   #681fd1;
  --nx-purple-l: #8c5aff;
  --nx-rim:      rgba(188,146,253,.59);
  --nx-gold:     #ffd93d;
  --nx-ink:      #08080f;
  --nx-bar:      #12131c;
  --nx-panel:    #0d0d14;
  --nx-panel-2:  #14141d;
  --nx-muted:    #8890a1;
  --nx-line:     rgba(255,255,255,.08);
  --nx-line-2:   rgba(255,255,255,.06);
  --nx-fill:     rgba(255,255,255,.03);
  --nx-violet-2: #d8b4fe;
  --nx-green:    #57f287;

  --nx-card-bg: linear-gradient(rgba(255,255,255,.035), rgba(255,255,255,0) 55%), var(--nx-panel);
  --nx-panel-bg: linear-gradient(rgba(255,255,255,.03), rgba(255,255,255,0) 45%), var(--nx-panel);
}

*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  font-family: 'Poppins', 'Cairo', system-ui, sans-serif;
  background: var(--nx-ink);
  color: #fff;
  line-height: 1.6;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}
a { text-decoration: none; color: inherit; }
h1, h2, h3, h4, p { margin: 0; }
ul { margin: 0; padding: 0; list-style: none; }
button { font-family: inherit; }
::selection { background: rgba(104,31,209,.4); color: #fff; }

::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(104,31,209,.4); border-radius: 8px; }
::-webkit-scrollbar-thumb:hover { background: rgba(104,31,209,.65); }

.nx-wrap { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 24px; }
@media (max-width: 599.98px) { .nx-wrap { padding: 0 16px; } }

/* ─── Buttons ──────────────────────────────────────────────────────────────
   novax uses three distinct treatments. .nx-btn-p is the contained purple
   with the inset bottom rim light; .nx-btn-o the dark outlined sibling;
   .nx-btn-g the gold "Plus" button, which carries its own sweep. */
.nx-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 9px;
  border: 1px solid transparent; border-radius: 11px; cursor: pointer;
  font-family: inherit; text-transform: capitalize; line-height: 1.75;
  white-space: nowrap; transition: .3s ease-out, background-color .2s, border-color .2s, transform .16s;
}
.nx-btn i { font-size: 1.05rem; }

.nx-btn-p {
  padding: 8px 22px; min-height: 48px; font-size: 15px; font-weight: 500;
  background: var(--nx-purple); color: #fff;
  border-color: var(--nx-rim);
  box-shadow: inset 0 -4px 10px 0 var(--nx-rim), 0 10px 30px rgba(104,31,209,.35);
}
.nx-btn-p:hover {
  background: #5e1cbe; border-color: #8b4dff; transform: translateY(-1px);
  filter: brightness(1.2);
}

.nx-btn-o {
  padding: 7px 21px; min-height: 46px; font-size: 15px; font-weight: 500;
  background: #181820; color: #fff; border-color: rgba(139,139,143,.26);
}
.nx-btn-o:hover { background: #201f2b; border-color: rgba(139,139,143,.5); }

/* Trailing arrow slides on hover, matching the source's endIcon timing. */
.nx-btn i:last-child { transition: transform .2s cubic-bezier(.23,1,.32,1); }
.nx-btn:hover i:last-child { transform: translateX(-3px); }

.nx-btn-g {
  position: relative; overflow: hidden;
  padding: .5rem 1rem; gap: .5rem; font-size: .8125rem; font-weight: 500;
  background: transparent; color: var(--nx-gold);
}
.nx-btn-g::before {
  content: ''; position: absolute; inset: 0 auto 0 0; width: 60%; height: 100%;
  background: linear-gradient(115deg, transparent, rgba(255,217,61,.35), transparent);
  transform: translateX(-150%) skewX(-20deg);
  transition: transform .6s cubic-bezier(.23,1,.32,1); pointer-events: none;
}
.nx-btn-g:hover {
  background: rgba(101,86,23,.5); transform: translateY(-1px);
  box-shadow: 0 0 0 1px rgba(255,217,61,.25), 0 6px 18px rgba(255,217,61,.18);
}
.nx-btn-g:hover::before { transform: translateX(220%) skewX(-20deg); }
.nx-btn-g:hover i { transform: scale(1.15) rotate(15deg); }
.nx-btn-g i { transition: transform .2s cubic-bezier(.23,1,.32,1); }

/* ─── Header ────────────────────────────────────────────────────────────── */
/* The bar is transparent in every scroll state, not just at the top: measured
   on novax at scrollY 0 and 3000 both give background-color rgba(0,0,0,0),
   background-image none, box-shadow none, border 0 and no backdrop-filter.
   The starfield behind the hero reads straight through it. The 82px total is
   8px of padding over the 66px bar, matching their 82px outer box and 66px
   inner container. Nothing ever toggles the background, so the .3s
   background transition that used to sit here was dead CSS. */
.nx-header {
  position: fixed; top: 0; left: 0; right: 0; z-index: 1001;
  display: flex; flex-direction: column; width: 100%;
  padding: 8px 0; background: transparent; color: #fff;
  transition: background-color .3s, backdrop-filter .3s;
}
/* Clear at the top so the hero starfield reads straight through the bar. Once
   the page has moved, the bar frosts over: nav labels sit on top of whatever
   is scrolling underneath, and a tint alone leaves that collision muddy, so
   the blur does the work and the tint only sets the floor.
   This part is ours, not a measurement — novax keeps the bar transparent at
   every scroll position, measured at scrollY 0 and 3000, where backdrop-filter
   is none. */
.nx-header.is-stuck {
  background: rgba(8,8,15,.72);
  -webkit-backdrop-filter: blur(14px) saturate(140%);
  backdrop-filter: blur(14px) saturate(140%);
}
.nx-header__bar {
  display: flex; align-items: center; justify-content: space-between;
  gap: 1rem; height: 66px; width: 100%;
}
.nx-header__left { display: flex; align-items: center; gap: 1.1rem; min-width: 0; }
.nx-logo { display: inline-flex; flex-shrink: 0; width: 50px; height: 50px; }
.nx-logo img, .nx-logo svg { width: 100%; height: 100%; display: block; }
.nx-nav { display: flex; align-items: center; gap: .35rem; }
.nx-nav a {
  display: inline-flex; align-items: center; justify-content: center;
  min-width: 64px; padding: 1rem .5rem; border: 0;
  font-family: inherit; font-size: .8125rem; font-weight: 500; line-height: 0;
  text-transform: capitalize; color: #fff; border-radius: 11px;
  transition: background-color .2s;
}
.nx-nav a:hover { background: #36363d; }
.nx-header__right { display: flex; align-items: center; gap: .55rem; }
.nx-lang {
  display: flex; align-items: center; gap: .5rem;
  padding: 0; border: 0; background: transparent; cursor: pointer;
  font-family: inherit; font-size: .8125rem; font-weight: 500;
  color: var(--nx-muted); border-radius: 11px; transition: color .15s;
}
.nx-lang:hover { color: #fff; }
.nx-lang i { font-size: .8rem; transition: transform .2s; }

/* ─── Hero ────────────────────────────────────────────────────────────────
   66px/700 Poppins with a background-clip shine, 18px #8890a1 body at
   768px, 11px-radius buttons, two blurred radial orbs, and a wrapper that
   fades up from translateY(-10px). The planet SVG that sits behind this on
   novax is deliberately absent; the orbs replace it. */
.nx-hero {
  position: relative; z-index: 1; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  min-height: 657px; padding: 80px 0;
  width: 100%;
}
.nx-hero__glow { position: absolute; z-index: 0; pointer-events: none; border-radius: 50%; }
.nx-hero__glow--1 {
  width: 900px; height: 608px; top: 50%; left: 50%; transform: translate(-50%,-50%);
  background: radial-gradient(closest-side, rgba(104,31,209,.28), rgba(104,31,209,0) 70%);
  filter: blur(60px);
}
.nx-hero__glow--2 {
  width: 352px; height: 352px; top: 14%; right: 11%;
  background: radial-gradient(closest-side, rgba(140,90,255,.16), rgba(140,90,255,0) 70%);
  filter: blur(50px);
}
/* ─── Starfield ───────────────────────────────────────────────────────────
   The one thing on the source page that genuinely moves: a canvas of ~34
   slow-drifting white points behind the hero. Measured there — 968x724
   backing store, 0.1% of pixels lit, every particle pure white, peak alpha
   176, drifting slowly enough that two consecutive frames differ by ~40
   pixels. Those numbers drive the constants below.

   Drawn, not shipped as a bitmap, and it stands on its own: the planet image
   that shares their container is deliberately not used. */
.nx-sky {
  position: absolute; inset: 0; z-index: 0;
  width: 100%; height: 100%; pointer-events: none;
}

/* Header sparkles. Keyframes and colour lifted from the source's own
   novaSparkleTwinkle; only the duration and size are randomised per load,
   which is what keeps the three from pulsing in lockstep. */
@keyframes nxSparkle {
  0%, 100% { opacity: 0; transform: scale(.3) rotate(0deg); }
  50%      { opacity: 1; transform: scale(1) rotate(20deg); }
}
.nx-sparks { display: inline-flex; align-items: center; gap: 2px; }
.nx-spark {
  display: inline-block; color: #ffe27a; line-height: 1;
  animation: nxSparkle 3s ease-in-out infinite;
}

/* The hero copy column is 920px on novax — their Grid container inside a 968px
   viewport — with the sub copy capped at 768px inside it. Matching the measure
   matters here: at 66px type a full-bleed line is long enough that the Arabic
   breaks in a different place than the Latin did. */
.nx-hero__in {
  position: relative; z-index: 2; width: 100%;
  max-width: 920px; margin-inline: auto; text-align: center;
}
.nx-hero__row { width: 100%; animation: nxFadeUp .8s cubic-bezier(.4,0,.2,1) both; }
.nx-hero__row + .nx-hero__row { animation-delay: .1s; }
@keyframes nxFadeUp { from { opacity: 0; transform: translateY(-10px); } }

/* Size, weight, line-height and the gradient are all off novax's h1: 64.8 /
   700 / 81px and linear-gradient(to top, #555, #fff 42%, #fff) behind a
   transparent text fill.

   Tracking is not. novax measures -0.03em here, and that value is tuned for
   Poppins — a geometric Latin face whose letters carry real sidebearings and
   can be pinched together. Arabic is cursive: the shaper emits joined glyph
   clusters and letter-spacing is inserted between those clusters, so any
   non-zero value opens the connecting stroke. -1.98px between Arabic letters
   is not tight type, it is broken joins. Tracking therefore goes to normal on
   every Arabic run on this page, and the display tightness is rebuilt from
   word-spacing, which closes the word gaps without separating the letters.
   Latin runs keep their measured tracking. */
.nx-hero h1 {
  margin: 0 0 22px;
  font-size: clamp(2rem, 1rem + 5vw, 4.125rem);
  font-weight: 700; line-height: 1.25;
  letter-spacing: normal; word-spacing: -.05em;
  background: linear-gradient(to top, #555, #fff 42%, #fff);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
}
.nx-hero__sub {
  margin: -20px auto 0; max-width: 768px;
  font-size: 18px; line-height: 1.334; color: var(--nx-muted);
}
.nx-hero__acts {
  display: flex; align-items: flex-end; justify-content: center;
  gap: 16px; flex-wrap: wrap; margin-top: 40px;
}

/* ─── Dashboard showcase ───────────────────────────────────────────────────
   novax drops a screenshot of their dashboard in here. Measured off their
   page: a 1160px-wide image inside a 968px wrapper with padding 70px 0, so
   the picture runs off both sides and only its content column stays on
   screen. The image itself carries no radius, no border and no shadow — the
   stacked gradient layers below are what dissolve whatever edge is left.

   The picture inside is a CSS rendering of OUR dashboard, laid out to the
   proportions read off their file: a full-width topbar carrying the brand at
   the start, a 180px sidebar, then a 2-up band of wide cards, a 3-up band of
   purple gradient tiles, and a second 3-up band. Palette is sampled from
   their pixels — page #090a11, sidebar #08090f, card #12131c, tiles running
   #3b1b73 → #2a1850 → #1c1030, brand #681fd1. */
.nx-shot { position: relative; padding: 0; overflow: hidden; }
@media (min-width: 900px) { .nx-shot { padding: 70px 0; } }
.nx-shot__bleed { position: absolute; inset: -128px; pointer-events: none; }
.nx-shot__bleed--a { background: linear-gradient(in oklab, rgba(8,8,15,.14) 0, rgba(8,8,15,.08) 50%, rgba(8,8,15,.59) 100%); }
.nx-shot__bleed--b { background: linear-gradient(to right, rgba(8,8,15,.89) 0, #08080f 50%, rgba(8,8,15,.91) 100%); }
.nx-shot__bleed--c {
  background:
    linear-gradient(to right, rgba(255,255,255,.2) 1px, transparent 1px) 0 0 / 60px 100%,
    linear-gradient(to bottom, rgba(255,255,255,.2) 1px, transparent 1px) 0 0 / 100% 60px;
  opacity: .25;
}
.nx-shot__vig {
  position: absolute; inset: 0; pointer-events: none;
  background: radial-gradient(125% 125% at 50% 10%, rgba(0,0,0,0) 40%, #09090b 100%);
}
.nx-shot__fade {
  position: absolute; inset: 0; pointer-events: none;
  background: linear-gradient(to left, #08080f 0, transparent 100%);
}
/* Centred with flex rather than auto margins: the panel is wider than this
   wrapper on a laptop, and flex overflows both edges evenly where auto
   margins would pin it to one side. The min-height is theirs — a 654px
   content box around a 466px screenshot, which lands the whole band at the
   794px the source measures. */
.nx-shot__in {
  position: relative; z-index: 1;
  display: flex; justify-content: center; align-items: center;
  max-width: none; padding-inline: 0;
}
@media (min-width: 900px) { .nx-shot__in { min-height: 654px; } }

/* the dashboard itself, drawn in CSS */
.nx-dash {
  flex: 0 0 1160px; width: 1160px;
  display: flex; flex-direction: column; overflow: hidden;
  background: #090a11; border: 0; border-radius: 0; box-shadow: none;
  text-align: start;
}
.nx-dash__bar {
  flex: 0 0 64px; display: flex; align-items: center; gap: 14px;
  padding-inline: 20px; background: #0b0c13;
  border-block-end: 1px solid var(--nx-line-2);
}
.nx-dash__brand { display: flex; align-items: center; gap: 9px; font-size: .875rem; font-weight: 700; color: #fff; }
.nx-dash__brand i {
  width: 26px; height: 26px; border-radius: 8px;
  background: linear-gradient(150deg, var(--nx-purple-l), var(--nx-purple));
  box-shadow: 0 0 18px rgba(104,31,209,.55);
}
.nx-dash__crumb { display: flex; align-items: center; gap: 8px; font-size: .75rem; color: var(--nx-muted); }
.nx-dash__crumb em {
  width: 6px; height: 6px; border-radius: 50%; font-style: normal;
  background: var(--nx-green); box-shadow: 0 0 8px rgba(87,242,135,.8);
}
.nx-dash__acts { margin-inline-start: auto; display: flex; align-items: center; gap: 10px; }
.nx-dash__acts s { width: 84px; height: 26px; border-radius: 7px; background: rgba(255,255,255,.07); text-decoration: none; }
.nx-dash__acts b { width: 30px; height: 26px; border-radius: 7px; background: var(--nx-purple); }

.nx-dash__body { flex: 1; display: flex; min-height: 0; }
.nx-dash__side {
  flex: 0 0 180px; padding: 14px 10px;
  background: #08090f; border-inline-end: 1px solid var(--nx-line-2);
  display: flex; flex-direction: column; gap: 3px;
}
.nx-dash__grp {
  padding: 12px 9px 5px; font-size: .625rem; font-weight: 700;
  letter-spacing: normal; color: #5b6270;
}
.nx-dash__link {
  display: flex; align-items: center; gap: 9px;
  padding: 6px 9px; border-radius: 7px; font-size: .75rem; color: var(--nx-muted);
}
.nx-dash__link i { width: 14px; text-align: center; font-size: .6875rem; opacity: .7; }
.nx-dash__link.is-on { background: rgba(104,31,209,.2); color: #fff; }
.nx-dash__link.is-on i { color: var(--nx-violet-2); opacity: 1; }

.nx-dash__main {
  flex: 1; min-width: 0; padding: 18px 20px 22px;
  display: flex; flex-direction: column; gap: 14px;
}
.nx-dash__head { display: flex; align-items: baseline; gap: 10px; }
.nx-dash__head b { font-size: 1rem; font-weight: 700; color: #fff; }
.nx-dash__head span { font-size: .6875rem; color: #5b6270; }

.nx-dash__wide { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.nx-dash__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
.nx-dash__card {
  padding: 14px 16px; border-radius: 12px;
  border: 1px solid var(--nx-line-2); background: var(--nx-bar);
}
.nx-dash__card u { display: block; font-size: .6875rem; color: var(--nx-muted); text-decoration: none; margin-bottom: 10px; }
.nx-dash__row { display: flex; align-items: center; gap: 9px; padding: 5px 0; }
.nx-dash__row s {
  width: 20px; height: 20px; border-radius: 6px; flex-shrink: 0;
  background: linear-gradient(135deg, #3b3b52, #23232f); text-decoration: none;
}
.nx-dash__row em { flex: 1; height: 7px; border-radius: 3px; background: rgba(255,255,255,.09); font-style: normal; }

/* the purple tile band — the one strongly saturated element in their frame */
.nx-dash__tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
.nx-dash__tile {
  position: relative; padding: 15px 16px; border-radius: 12px;
  border: 1px solid rgba(139,92,246,.24);
  background: linear-gradient(155deg, #3b1b73 0, #2a1850 52%, #1c1030 100%);
}
.nx-dash__tile u { display: block; font-size: .6875rem; color: #c9b8e8; text-decoration: none; margin-bottom: 8px; }
.nx-dash__tile b { font-size: 1.5rem; font-weight: 700; letter-spacing: -.02em; color: #fff; }
.nx-dash__tile em { display: block; margin-top: 4px; font-size: .6875rem; font-style: normal; color: var(--nx-purple-l); }
.nx-dash__tile i {
  position: absolute; inset-block-start: 14px; inset-inline-end: 14px;
  width: 30px; height: 30px; border-radius: 9px;
  display: flex; align-items: center; justify-content: center;
  background: rgba(140,90,255,.3); border: 1px solid rgba(180,150,255,.35);
  font-size: .75rem; color: #e9d5ff;
}
@media (max-width: 899.98px) {
  .nx-dash { flex-basis: 100%; width: 100%; }
  .nx-dash__side { display: none; }
  .nx-dash__wide, .nx-dash__tiles, .nx-dash__cards { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 599.98px) {
  .nx-dash__wide, .nx-dash__tiles, .nx-dash__cards { grid-template-columns: 1fr; }
  .nx-dash__acts s { display: none; }
}

/* ─── Generic section furniture ─────────────────────────────────────────────
   Every feature section is padding 100px 10px with a centred hairline rule at
   the top, a 28rem blurred orb pinned to the top-right, and the content
   sitting one layer above it. */
.nx-sec { position: relative; padding: 100px 10px; overflow-x: hidden; }
.nx-sec::before {
  content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%);
  width: min(1200px, 100% - 20px); border-top: 1px solid rgba(255,255,255,.06);
}
.nx-sec__orb {
  position: absolute; top: 6%; right: -8%; width: 28rem; height: 28rem;
  max-width: 70vw; pointer-events: none; z-index: 0;
  background: radial-gradient(closest-side, rgba(104,31,209,.16), rgba(104,31,209,0) 72%);
  filter: blur(70px);
}
.nx-sec__in { position: relative; z-index: 1; max-width: 1200px; margin-inline: auto; }
/* The banded sections carry their own 10px gutter; their inner wrapper must
   not add the 24px container padding on top of it, or the content comes out
   narrower than the source. */
.nx-sec__in.nx-wrap,
.nx-features .nx-wrap,
.nx-plugins .nx-wrap { padding-inline: 0; max-width: 1200px; }

/* novax measures -0.02em at this size; see the note on .nx-hero h1 for why an
   Arabic run takes normal tracking instead. */
.nx-sec__title {
  margin: 0 0 .75rem; font-size: 1.5rem; font-weight: 700;
  line-height: 1.2; letter-spacing: normal; word-spacing: -.03em;
  color: #fff; text-align: center;
}
.nx-sec__sub {
  font-size: .875rem; line-height: 1.334em; color: var(--nx-muted);
  text-align: center; margin: 0 auto .75rem; width: 600px; max-width: 100%;
  text-wrap: balance;
}
@media (min-width: 900px) {
  .nx-sec__title { font-size: 2.75rem; }
  .nx-sec__sub { font-size: 1.125rem; }
}

/* 12-column row helper — the source uses MUI Grid with a 24px gutter.
   Below the md breakpoint every cell goes full width, same as MUI's default. */
.nx-row { display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 1.5rem; width: 100%; }
@media (min-width: 900px) { .nx-row { gap: 24px; } }
.nx-row--end { flex-direction: row-reverse; }
.nx-row > .nx-col-4,
.nx-row > .nx-col-6,
.nx-row > .nx-col-8,
.nx-row > .nx-col-12 { width: 100%; }
@media (min-width: 900px) {
  .nx-row > .nx-col-4  { width: calc(100% * 4 / 12 - (24px * 8 / 12)); }
  .nx-row > .nx-col-6  { width: calc(100% * 6 / 12 - (24px * 6 / 12)); }
  .nx-row > .nx-col-8  { width: calc(100% * 8 / 12 - (24px * 4 / 12)); }
  .nx-row > .nx-col-12 { width: 100%; }
}
.nx-row > * { min-width: 0; box-sizing: border-box; }

/* ─── Card ──────────────────────────────────────────────────────────────────
   Two near-identical shells on the source: .mui-1ip3kb8 (full-width band,
   48px padding) and .mui-1ocz0j1 (grid cell, 40px padding, height 100%). */
.nx-card {
  position: relative; overflow: hidden; height: 100%;
  border-radius: 20px; border: 1px solid var(--nx-line);
  background: var(--nx-panel-bg);
  padding: 32px 24px;
}
@media (min-width: 900px) { .nx-card { padding: 40px; } }
.nx-card--band { margin-bottom: 1.5rem; }
@media (min-width: 900px) { .nx-card--band { padding: 48px; } }

.nx-card__head { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
.nx-card__icon {
  display: inline-flex; align-items: center; justify-content: center;
  flex-shrink: 0; width: 32px; height: 32px; border-radius: 9px;
  border: 1px solid rgba(188,146,253,.28); color: var(--nx-violet-2);
}
.nx-card__icon i { font-size: .95rem; }
.nx-card h3 {
  margin: 0; font-size: 1.15rem; font-weight: 600; line-height: 1.167; color: #fff;
}
.nx-card__desc {
  margin: 0; font-size: .875rem; line-height: 1.334em;
  color: var(--nx-muted); max-width: 38rem; text-align: start;
}
.nx-card__mock { margin-top: 22px; }

/* ─── Mockup primitives ────────────────────────────────────────────────────
   The Discord-shaped panels inside the cards. Every one of these numbers was
   read off the source: panel #14141d at 16px, rows at 10px, the purple badge
   at rgba(104,31,209,.22), online dots #57f287 with a 2px panel-coloured
   ring, and skeleton bars at rgba(255,255,255,.12). */
.nx-mock {
  border: 1px solid var(--nx-line); border-radius: 16px;
  background: var(--nx-panel-2); overflow: hidden;
}
.nx-mock--msg { border-radius: 12px; }
.nx-mock__hd {
  display: flex; align-items: center; gap: 9px;
  padding: 13px 16px; border-bottom: 1px solid var(--nx-line-2);
  font-size: .875rem; font-weight: 600; color: #fff;
}
.nx-mock__hd i { color: var(--nx-violet-2); font-size: .9rem; }
.nx-mock__body { padding: 14px 16px; display: flex; flex-direction: column; gap: 9px; }

.nx-row-i {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 12px; border-radius: 10px;
  border: 1px solid var(--nx-line-2); background: var(--nx-fill);
  font-size: .8125rem; color: #d7dae0;
}
.nx-row-i > i:first-child { color: var(--nx-muted); font-size: .85rem; width: 16px; text-align: center; }
.nx-row-i__name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nx-row-i__end { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }

.nx-av {
  width: 22px; height: 22px; border-radius: 50%; flex-shrink: 0;
  background: linear-gradient(135deg, #4b3a72, #241a3d);
  border: 2px solid var(--nx-panel-2);
}
.nx-av--lg { width: 38px; height: 38px; }
.nx-av--bot { background: linear-gradient(135deg, var(--nx-purple), #2a1055); display:flex; align-items:center; justify-content:center; font-size:.7rem; color:#fff; }
.nx-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--nx-green); flex-shrink: 0; }
.nx-stack { display: flex; }
.nx-stack .nx-av + .nx-av { margin-inline-start: -7px; }
.nx-stack .nx-av { width: 18px; height: 18px; }

.nx-pill {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 3px 10px; border-radius: 999px; font-size: .6875rem; font-weight: 600;
  background: rgba(104,31,209,.22); border: 1px solid rgba(188,146,253,.32);
  color: var(--nx-violet-2); white-space: nowrap;
}
.nx-pill--dim { background: rgba(255,255,255,.06); border-color: var(--nx-line); color: var(--nx-muted); }
.nx-pill--warn { background: rgba(255,217,61,.14); border-color: rgba(255,217,61,.32); color: var(--nx-gold); }
.nx-pill--ok   { background: rgba(87,242,135,.12); border-color: rgba(87,242,135,.3); color: var(--nx-green); }

.nx-bar { height: 8px; border-radius: 999px; background: rgba(255,255,255,.08); overflow: hidden; }
.nx-bar__fill {
  height: 100%; border-radius: 999px;
  background: linear-gradient(90deg, var(--nx-purple), var(--nx-purple-l));
}
.nx-line { height: 8px; border-radius: 3px; background: rgba(255,255,255,.12); }
.nx-line--w70 { width: 70%; } .nx-line--w45 { width: 45%; } .nx-line--w30 { width: 30%; }

.nx-meter { display: flex; align-items: center; gap: 14px; }
.nx-meter__ring {
  width: 54px; height: 54px; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: conic-gradient(var(--nx-purple) 0 72%, rgba(255,255,255,.08) 72% 100%);
  position: relative;
}
.nx-meter__ring::after {
  content: ''; position: absolute; inset: 6px; border-radius: 50%; background: var(--nx-panel-2);
}
.nx-meter__ring b { position: relative; z-index: 1; font-size: .8125rem; font-weight: 700; color: #fff; }
.nx-meter__meta { flex: 1; display: flex; flex-direction: column; gap: 7px; min-width: 0; }

.nx-chipset { display: flex; flex-wrap: wrap; gap: 8px; }
.nx-chip {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 6px 12px; border-radius: 999px; font-size: .75rem; font-weight: 600;
  background: var(--nx-fill); border: 1px solid var(--nx-line); color: #d7dae0;
}

/* command list: / ban etc */
.nx-cmd { display: flex; flex-direction: column; gap: 6px; }
.nx-cmd__row {
  display: flex; align-items: center; gap: 10px;
  padding: 9px 12px; border-radius: 10px;
  border: 1px solid var(--nx-line-2); background: var(--nx-fill);
  font-size: .8125rem;
}
.nx-cmd__slash {
  display: inline-flex; align-items: center; justify-content: center;
  min-width: 58px; padding: 2px 9px; border-radius: 6px;
  background: rgba(255,255,255,.06); color: #fff;
  font-family: ui-monospace, 'Cascadia Code', Menlo, monospace;
  font-size: .75rem; font-weight: 600; direction: ltr;
}
.nx-cmd__row span { color: var(--nx-muted); font-size: .75rem; }
.nx-cmd__row--on .nx-cmd__slash { background: rgba(87,242,135,.14); color: var(--nx-green); }

/* embed preview (the blue-bar Discord embed look, in brand purple) */
.nx-embed {
  border-radius: 10px; border: 1px solid var(--nx-line-2);
  background: var(--nx-fill); padding: 13px 15px;
  border-inline-start: 4px solid var(--nx-purple);
}
.nx-embed__tag {
  display: inline-block; font-size: .625rem; font-weight: 700;
  letter-spacing: normal; color: var(--nx-muted); margin-bottom: 7px;
}
.nx-embed__t { font-size: .9375rem; font-weight: 700; color: #fff; margin-bottom: 4px; }
.nx-embed__d { font-size: .8125rem; color: var(--nx-muted); }
.nx-embed__f { display: flex; align-items: center; gap: 7px; margin-top: 9px; font-size: .6875rem; color: #6b7280; }
.nx-embed__f .nx-av { width: 16px; height: 16px; border-width: 0; }

/* message bubble (welcome card) */
.nx-msg { display: flex; gap: 11px; }
.nx-msg__col { flex: 1; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.nx-msg__hd { display: flex; align-items: center; gap: 8px; font-size: .8125rem; }
.nx-msg__hd b { color: #fff; font-weight: 600; }
.nx-msg__hd span { font-size: .6875rem; color: #6b7280; }
.nx-msg__bot { background: rgba(104,31,209,.16); color: var(--nx-violet-2); padding: 0 4px; border-radius: 3px; font-size: .625rem; font-weight: 700; }

/* tictactoe grid */
.nx-ttt { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; width: 150px; }
.nx-ttt span {
  aspect-ratio: 1; display: flex; align-items: center; justify-content: center;
  border-radius: 9px; background: var(--nx-fill); border: 1px solid var(--nx-line-2);
  font-size: 1.05rem; font-weight: 700; color: var(--nx-violet-2);
}
.nx-ttt span.w { color: var(--nx-green); }

/* colour swatches */
.nx-swatches { display: flex; flex-wrap: wrap; gap: 9px; }
.nx-sw {
  width: 38px; height: 38px; border-radius: 10px;
  border: 2px solid transparent; display: flex; align-items: flex-end; justify-content: center;
}
.nx-sw b {
  font-size: .5625rem; font-weight: 700; color: #fff; padding-bottom: 3px;
  text-shadow: 0 1px 2px rgba(0,0,0,.5);
}

/* ─── Analytics band ───────────────────────────────────────────────────────
   The one section that is not built from cards: a copy column carrying a
   2x2 tile grid, beside a two-series line chart. */
.nx-an { display: grid; grid-template-columns: 1fr; gap: 24px; align-items: center; }
@media (min-width: 900px) { .nx-an { grid-template-columns: 445px 1fr; gap: 34px; } }
.nx-an__copy { font-size: .875rem; line-height: 1.334em; color: var(--nx-muted); margin: 0 0 18px; }
.nx-an__chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
.nx-an__tiles { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px 20px; }
.nx-an__tile i { display: block; font-size: 1.15rem; color: #fff; margin-bottom: 9px; }
.nx-an__tile p { margin: 0; font-size: .875rem; line-height: 1.334; color: var(--nx-muted); }
.nx-an__chart { width: 100%; height: auto; overflow: hidden; }
.nx-an__legend { display: flex; gap: 18px; justify-content: center; margin-top: 6px; }
.nx-an__legend span { display: inline-flex; align-items: center; gap: 7px; font-size: .6875rem; color: var(--nx-muted); }
.nx-an__legend s { width: 12px; height: 12px; border-radius: 3px; text-decoration: none; }

/* ─── Features band ──────────────────────────────────────────────────────── */
.nx-features { position: relative; padding: 0 10px 100px; overflow-x: hidden; scroll-margin-top: 110px; }
/* The source's features band opens flush with its section top — there is no
   padding above the first row. All the space below comes from an 80px margin
   inside the grid plus the section's own 100px padding-bottom. */
.nx-features__pad { padding: 0; }
.nx-features__grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 20px; margin-bottom: 80px;
}
.nx-fcard {
  position: relative; padding: 28px 24px; border-radius: 16px;
  border: 1px solid var(--nx-line); background: var(--nx-card-bg);
  transition: transform .3s;
}
.nx-fcard:hover { transform: translateY(-4px); }
.nx-fcard__icon {
  display: inline-flex; align-items: center; justify-content: center;
  width: 44px; height: 44px; flex-shrink: 0; border-radius: 12px; margin-bottom: 1rem;
  background: radial-gradient(120% 120% at 30% 20%, rgba(188,146,253,.28), rgba(104,31,209,.08));
  border: 1px solid rgba(188,146,253,.28); color: var(--nx-violet-2); font-size: 1.1rem;
}
.nx-fcard h3 {
  margin: 0 0 .5rem; font-size: 1rem; font-weight: 700; line-height: 1.2;
  word-break: break-word; color: #fff;
}
.nx-fcard p { margin: 0; font-size: .875rem; line-height: 1.334em; color: var(--nx-muted); text-wrap: balance; }

/* ─── Plugins band ─────────────────────────────────────────────────────────
   A 28rem box masked to a soft radial so three icon strips bleed off both
   edges, with the mark sitting on a 64px plate in the middle. Heading and
   sub sit below it at the source's 48px / 16px rhythm. */
.nx-plugins { position: relative; padding: 128px 10px; overflow-x: hidden; }
.nx-plugins__pad { padding: 0; }
.nx-plugins__box {
  position: relative; overflow: hidden;
  display: flex; flex-direction: column; justify-content: space-between;
  gap: 40px; margin-inline: auto;
  width: 100%; max-width: 28rem; height: 224px;
  background: color-mix(in srgb, #181820 25%, transparent);
  -webkit-mask-image: radial-gradient(50% 50%, #000 70%, transparent 100%);
  mask-image: radial-gradient(50% 50%, #000 70%, transparent 100%);
}
/* ── Plugin marquee ───────────────────────────────────────────────────────
   The three icon strips above the heading scroll continuously. Measured on
   the source: each row is a 448px window over a track that overflows it
   (984 / 840 / 984px), items are fixed 48px boxes with a 24px gap, and the
   strip is faded by the box mask rather than clipped by the row.

   --set is one full set of icons. Script appends a second copy to the
   track, so travelling exactly --set puts that copy where the original
   started and the loop has no seam.

   All three strips travel left, which is "forward" in this RTL page: a strip
   moving right would run against the reading direction. --dur is set per
   row so that every strip covers the same ground per second (~24 px/s)
   despite the middle set being shorter. Matching the speed rather than the
   duration is what makes them read as one system instead of three. */
.nx-plugins__row {
  display: flex; align-items: center;
  height: 48px; flex-shrink: 0; white-space: nowrap; overflow: hidden;
}
.nx-plugins__track {
  display: flex; align-items: center; gap: 24px;
  width: max-content; flex-shrink: 0;
  animation: nxMarquee var(--dur) linear infinite;
}
.nx-plugins__track > i {
  flex: 0 0 48px; width: 48px; height: 48px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.5rem; color: #6d7382;
}
@keyframes nxMarquee {
  from { transform: translateX(0); }
  to   { transform: translateX(calc(-1 * var(--set))); }
}
/*             set     px/s    duration */
.nx-plugins__row:nth-child(1) { --set: 984px; --dur: 41s; } /* 24.0 */
.nx-plugins__row:nth-child(2) { --set: 840px; --dur: 35s; } /* 24.0 */
.nx-plugins__row:nth-child(3) { --set: 984px; --dur: 41s; } /* 24.0 */
.nx-plugins__mark {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  width: 64px; height: 64px; border-radius: 18px;
  display: flex; align-items: center; justify-content: center;
  background: rgba(104, 31, 209, .6);
}
.nx-plugins__mark svg { width: 35px; height: 25px; }
.nx-plugins h2 {
  margin: 48px 0 16px; font-size: 2.125rem; font-weight: 700;
  line-height: 1.167; color: #fff; text-align: center;
}
.nx-plugins p {
  margin: 0 auto 48px; width: 600px; max-width: 100%;
  font-size: .875rem; line-height: 1.334em; color: var(--nx-muted);
  text-align: center; text-wrap: balance;
}
@media (min-width: 900px) { .nx-plugins p { font-size: 1.125rem; } }

/* ─── CTA + Footer ───────────────────────────────────────────────────────── */
.nx-cta { position: relative; padding: 100px 0 0; overflow-x: hidden; }
.nx-cta__top { padding-bottom: 2rem; }
/* 56px / 1.3 = 72.8px and letter-spacing normal, all measured off novax's
   equivalent CTA heading. Their value here is already normal, so this one
   matches the source exactly. */
.nx-cta__title {
  font-size: clamp(1.75rem, 4.4vw, 3.5rem); font-weight: 700; line-height: 1.3;
  letter-spacing: normal; word-spacing: -.04em; color: #fff; text-align: center;
  margin-bottom: 1.5rem;
}
.nx-cta__title span {
  background: linear-gradient(to top, #555, #fff 42%, #fff);
  -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
}
.nx-cta__acts { display: flex; justify-content: center; margin-bottom: 3rem; }

/* the CSS redraw of novax's footer.svg — a purple wave, no planet */
.nx-wave {
  position: relative; height: 400px; overflow: hidden; pointer-events: none;
  -webkit-mask-image: radial-gradient(70% 100% at 50% 100%, #000 40%, transparent 100%);
  mask-image: radial-gradient(70% 100% at 50% 100%, #000 40%, transparent 100%);
}
.nx-wave::before, .nx-wave::after {
  content: ''; position: absolute; left: 50%; transform: translateX(-50%);
  border-radius: 50%;
}
.nx-wave::before {
  width: 1500px; height: 620px; top: 90px;
  background: radial-gradient(closest-side, rgba(104,31,209,.42), rgba(104,31,209,0) 70%);
  filter: blur(70px);
}
.nx-wave::after {
  width: 1100px; height: 420px; top: 210px;
  background: radial-gradient(closest-side, rgba(196,156,255,.22), rgba(196,156,255,0) 72%);
  filter: blur(60px);
}

.nx-footer { position: relative; z-index: 1; padding-bottom: 40px; }
.nx-about { display: flex; gap: 18px; align-items: flex-start; margin-bottom: 3rem; }
.nx-about__mark { width: 56px; height: 56px; flex-shrink: 0; }
.nx-about__mark img, .nx-about__mark svg { width: 100%; height: 100%; }
.nx-about h3 { margin: 0 0 10px; font-size: 1.25rem; font-weight: 700; color: #fff; }
.nx-about p { margin: 0; font-size: .9375rem; line-height: 1.6; color: var(--nx-muted); max-width: 70ch; }

.nx-cols { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px 20px; }
@media (min-width: 900px) { .nx-cols { grid-template-columns: 1.4fr 1fr 1fr 1fr; } }
.nx-col h4 {
  margin: 0 0 14px; font-size: .8125rem; font-weight: 700;
  letter-spacing: normal; text-transform: uppercase; color: #fff;
}
.nx-col ul { display: flex; flex-direction: column; gap: 9px; }
.nx-col a { font-size: .875rem; color: var(--nx-muted); transition: color .2s; }
.nx-col a:hover { color: #fff; }
.nx-col__soc { display: flex; gap: 8px; }
.nx-col__soc a {
  width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center;
  border-radius: 9px; border: 1px solid var(--nx-line); background: var(--nx-fill);
  font-size: .875rem; transition: border-color .2s, background .2s;
}
.nx-col__soc a:hover { border-color: rgba(188,146,253,.4); background: rgba(104,31,209,.14); }

/* Language control. A real button, not an anchor to nowhere: the label always
   reports the active locale and the menu is where new ones get added. */
.nx-lang { position: relative; display: inline-block; }
.nx-lang__btn {
  display: flex; align-items: center; gap: 8px; height: 30px; padding: 0;
  border: 0; border-radius: 11px; background: transparent;
  font-size: .8333rem; font-weight: 500; color: var(--nx-muted);
  cursor: pointer; transition: color .2s;
}
.nx-lang__btn:hover, .nx-lang__btn[aria-expanded="true"] { color: #fff; }
.nx-lang__btn svg { width: 30px; height: 30px; flex-shrink: 0; }
.nx-lang__menu {
  position: absolute; inset-inline-start: 0; top: calc(100% + 8px); z-index: 5;
  min-width: 132px; padding: 5px; border-radius: 11px;
  border: 1px solid var(--nx-line); background: #14141d;
  box-shadow: 0 18px 40px rgba(0,0,0,.5);
  display: none; flex-direction: column; gap: 2px;
}
.nx-lang__menu.is-open { display: flex; }
.nx-lang__opt {
  display: flex; align-items: center; justify-content: space-between; gap: 10px;
  padding: 7px 9px; border: 0; border-radius: 8px; background: transparent;
  font-size: .8125rem; color: #b6bcc8; text-align: start; cursor: pointer;
  transition: background .15s, color .15s;
}
.nx-lang__opt:hover { background: rgba(255,255,255,.05); color: #fff; }
.nx-lang__opt[aria-current="true"] { color: var(--nx-violet-2); }
.nx-lang__opt i { font-size: .7rem; }

.nx-copy {
  margin-top: 2.5rem; padding-top: 20px; border-top: 1px solid var(--nx-line-2);
  font-size: .75rem; color: #6b7280; text-align: center;
}

/* ─── Reveal ────────────────────────────────────────────────────────────────
   Pure keyframes rather than a JS-added class: a scripting failure must not
   be able to leave the page blank. */
.nx-rv { opacity: 0; animation: nxRv .7s cubic-bezier(.4,0,.2,1) forwards; }
.nx-js .nx-rv { animation: none; opacity: 1; }
.nx-js.nx-anim .nx-rv {
  opacity: 0; transform: translateY(26px);
  transition: opacity .7s cubic-bezier(.4,0,.2,1), transform .7s cubic-bezier(.4,0,.2,1);
}
.nx-js.nx-anim .nx-rv.nx-in { opacity: 1; transform: none; }
@keyframes nxRv { to { opacity: 1; } }

/* ─── Maintenance banner (existing feature, class injected by JS) ───────── */
.nx-mnt {
  display: none; position: fixed; left: 0; right: 0; top: 0; z-index: 1200;
  background: linear-gradient(90deg, #3a2a05, #2a1055);
  border-bottom: 1px solid rgba(255,217,61,.3); color: #fff;
}
.nx-mnt.nx-show { display: block; }
.nx-mnt__in {
  display: flex; align-items: center; justify-content: center; gap: 12px;
  padding: 9px 16px; font-size: .8rem; text-align: center;
}
.nx-mnt__in i { color: var(--nx-gold); }
.nx-mnt__t { font-weight: 700; }

/* ─── Responsive ────────────────────────────────────────────────────────── */
@media (max-width: 899.98px) {
  .nx-nav { display: none; }
  .nx-hero { min-height: 0; padding: 64px 0; }
  .nx-hero h1 { margin-bottom: 18px; }
  .nx-hero__sub { font-size: 16px; }
  .nx-hero__glow--1 { width: 640px; height: 460px; }
  .nx-hero__glow--2 { width: 280px; height: 280px; }
  .nx-sec { padding: 64px 10px; }
}
@media (max-width: 639.98px) {
  .nx-hero__acts { flex-direction: column; align-items: stretch; }
  .nx-hero__acts .nx-btn { width: 100%; }
  .nx-header__bar { height: 62px; }
  .nx-logo { width: 42px; height: 42px; }
  .nx-features__grid { grid-template-columns: 1fr; }
  .nx-cols { grid-template-columns: 1fr; }
  .nx-sec__title { font-size: 1.75rem; }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation-duration: .001ms !important; transition-duration: .001ms !important; }
  .nx-js.nx-anim .nx-rv { opacity: 1; transform: none; }
  /* Stop the strips dead. The second copy stays in the DOM but the row
     clips it, so the first set simply sits still. */
  .nx-plugins__track { animation: none !important; }
}
</style>
</head>
<body>

<!-- ══ Header ══════════════════════════════════════════════════════════════ -->

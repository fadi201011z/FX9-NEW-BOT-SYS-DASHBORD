  <script src="/js/main.js"></script>
  <script>
  document.addEventListener('DOMContentLoaded', function () {

    /* ══════════════════════════════════════════════════════════════════
       1. Animated number writer  (single source of truth for metrics)
       ══════════════════════════════════════════════════════════════════ */
    var REDUCED = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function countTo(el, target, suffix, dur) {
      if (!el) return;
      suffix = suffix || '';
      var finalText = target.toLocaleString('en-US') + suffix;

      // لا داعي للتحريك — أو المتصفح في تبويب مخفي (rAF لا تعمل)
      if (REDUCED || document.hidden || typeof requestAnimationFrame !== 'function') {
        el.textContent = finalText;
        return;
      }

      var t0 = performance.now(), ms = dur || 950, done = false;
      function finish() {
        if (done) return;
        done = true;
        el.textContent = finalText;
      }
      function tick(t) {
        if (done) return;
        var p = Math.min(1, (t - t0) / ms);
        var e = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(target * e).toLocaleString('en-US') + suffix;
        if (p < 1) requestAnimationFrame(tick); else finish();
      }
      el.textContent = '0' + suffix;
      requestAnimationFrame(tick);
      // شبكة أمان: التبويبات المخفية قد تُجمّد requestAnimationFrame
      setTimeout(finish, ms + 260);
    }

    /* Sets a metric value with count-up. Pass null to show the dash. */
    function setMetric(id, val, suffix) {
      var el = document.getElementById(id);
      if (!el) return;
      var n = Number(val);
      if (val === null || val === undefined || !isFinite(n)) { el.textContent = '—'; return; }
      countTo(el, n, suffix || '');
    }

    function setText(id, txt) {
      var el = document.getElementById(id);
      if (!el) return;
      el.textContent = txt;
      el.classList.toggle('is-wait', isWaitText(txt));
    }

    /* ══════════════════════════════════════════════════════════════════
       2. Ambient UI — scroll reveal, tilt, magnetic buttons, nav state
       ══════════════════════════════════════════════════════════════════ */

    // Scroll reveal
    var revealTargets = document.querySelectorAll('.fx-reveal');
    if ('IntersectionObserver' in window && revealTargets.length) {
      var ro = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('in'); ro.unobserve(e.target); }
        });
      }, { threshold: 0.12 });
      revealTargets.forEach(function (el) { ro.observe(el); });
    } else {
      revealTargets.forEach(function (el) { el.classList.add('in'); });
    }

    // Nav solidifies on scroll
    var nav = document.getElementById('fxNav');
    function onScroll() {
      if (!nav) return;
      nav.classList.toggle('scrolled', window.scrollY > 24);
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Subtle 3D tilt on the metrics console
    var tilt = document.querySelector('[data-tilt]');
    if (tilt && !REDUCED && window.matchMedia('(hover:hover) and (pointer:fine)').matches) {
      tilt.addEventListener('mousemove', function (e) {
        var r = tilt.getBoundingClientRect();
        var dx = (e.clientX - r.left) / r.width - 0.5;
        var dy = (e.clientY - r.top) / r.height - 0.5;
        tilt.style.transform = 'perspective(1400px) rotateX(' + (-dy * 5).toFixed(2) +
                               'deg) rotateY(' + (dx * 6).toFixed(2) + 'deg) translateY(-3px)';
      });
      tilt.addEventListener('mouseleave', function () { tilt.style.transform = ''; });
    }

    // Magnetic primary CTA
    if (!REDUCED && window.matchMedia('(hover:hover) and (pointer:fine)').matches) {
      document.querySelectorAll('.f-btn-p').forEach(function (b) {
        b.addEventListener('mousemove', function (e) {
          var r = b.getBoundingClientRect();
          b.style.transform = 'translate(' + ((e.clientX - r.left - r.width / 2) * 0.16).toFixed(1) + 'px,' +
                              ((e.clientY - r.top - r.height / 2) * 0.28).toFixed(1) + 'px)';
        });
        b.addEventListener('mouseleave', function () { b.style.transform = ''; });
      });
    }

    /* ══════════════════════════════════════════════════════════════════
       3. Live data
       ══════════════════════════════════════════════════════════════════ */

    function paintPingCard(ping) {
      var card = document.getElementById('pingCard');
      if (!card) return;
      card.classList.remove('q-good', 'q-mid', 'q-bad', 'q-wait');
      if (!isFinite(ping)) { card.classList.add('q-wait'); return; }
      card.classList.add(ping < 200 ? 'q-good' : (ping < 450 ? 'q-mid' : 'q-bad'));
    }

    /* Every sub-label that means "the bot is not reachable", so they all get the
       same pending tone. Kept in one place because reasonText() picks between
       them based on what /api/status reported. */
    var WAIT_TEXTS = ['يتصل بالبوت…', 'البوت لم يُحدَّث بعد', 'المفتاحان غير متطابقين',
                      'الداشبورد بلا مفتاح', 'API_SECRET غير مُعرَّف',
                      'البوت لا يستجيب بعد', 'تعذّر الوصول للبوت'];
    // 'طول المفتاح N' is generated, so match it by prefix.
    function isWaitText(t) {
      return WAIT_TEXTS.indexOf(t) !== -1 || t.indexOf('طول المفتاح ') === 0;
    }

    /* Marks every card as "waiting" while the bot process is unreachable.
       A Render free-tier service sleeps after ~15 min idle, so the bot's
       /api/stats 404s until it wakes and finishes its Discord login. Showing
       a dash forever made the cards look broken. The reason from /api/status
       is surfaced too, because "offline" alone hides whether the cause is a
       stale bot build (404), a secret mismatch (401) or a wrong URL. */
    function reasonText(d) {
      var e = d && d.botApiError;
      if (!e) return 'يتصل بالبوت…';
      if (e === 'HTTP 404') return 'البوت لم يُحدَّث بعد';
      if (e === 'HTTP 401' || e === 'HTTP 403') {
        // The bot rejected our value. Say which side is at fault, because
        // "add the variable" and "make them equal" are different instructions
        // and the visitor cannot see either service's config.
        if (d && d.secretConfigured === false) return 'الداشبورد بلا مفتاح';
        if (d && typeof d.secretLength === 'number' && d.secretLength !== 96) {
          return 'طول المفتاح ' + d.secretLength;
        }
        return 'المفتاحان غير متطابقين';
      }
      if (e === 'HTTP 503') return 'API_SECRET غير مُعرَّف';
      if (e === 'timeout') return 'البوت لا يستجيب بعد';
      if (e === 'network') return 'تعذّر الوصول للبوت';
      return 'يتصل بالبوت…';
    }

    function paintWaiting(d) {
      var why = reasonText(d);
      setText('frameGuildsVal', why);
      setText('frameMembersVal', why);
      setText('framePingVal', why);
      paintPingCard(NaN);
      var lp = document.getElementById('landPill');
      if (lp) lp.innerHTML = '<span class="fx-dot off"></span> KRATOS SYSTEM v1.0.11 — ' + why;
    }

    // Command statistics → metrics + numbers
    fetch('/api/commands/stats')
      .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
      .then(function (s) {
        var per = s.perCategory || {};
        var total = Number(s.total) || 0;
        setMetric('frameCmdCount', total, '');
        setText('frameCmdVal', total > 0 ? 'منفَّذ' : 'لا أوامر بعد');
        setMetric('statTickets', Number(per.ticket) || 0, '');
        setMetric('statVoice', Number(per.voice) || 0, '');
        setMetric('statTotal', total, '');
      })
      .catch(function () {
        setText('frameCmdCount', '—');
        setText('frameCmdVal', 'تعذّر الجلب');
        setText('statTickets', '—');
        setText('statVoice', '—');
        setText('statTotal', '—');
      });

    /* Bot status → servers / members / ping
       Polled instead of fetched once. The bot is a separate process that can
       be sleeping or mid-boot, in which case the dashboard reports
       botOnline:false. Retrying makes the cards fill in as soon as it wakes. */
    var statusTimer = null;
    function pollStatus(first) {
      fetch('/api/status', { cache: 'no-store' })
        .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
        .then(function (d) {
          if (!d) throw new Error();

          if (!d.botOnline) {
            paintWaiting(d);
            // Bot is asleep or still booting — keep trying
            statusTimer = setTimeout(pollStatus, 8000);
            return;
          }

          var lp = document.getElementById('landPill');
          if (lp) {
            lp.innerHTML = '<span class="fx-dot"></span> KRATOS SYSTEM v1.0.11 — شغال';
          }

          setMetric('frameGuilds', d.guildCount, '');
          setText('frameGuildsVal', (d.guildCount || 0) > 0 ? 'متصل' : 'لا سيرفرات');

          setMetric('frameMembers', d.members, '');
          setText('frameMembersVal', (d.members || 0) > 0 ? 'مُسجَّل' : 'لا يوجد أعضاء بعد');

          setMetric('framePing', d.ping, 'ms');
          setText('framePingVal', (d.ping || 0) > 0 ? (d.ping < 200 ? 'ممتاز' : 'جيد') : 'غير متاح');
          paintPingCard(Number(d.ping));

          // Slow background refresh once everything is live
          statusTimer = setTimeout(pollStatus, 30000);
        })
        .catch(function () {
          paintWaiting(null);
          statusTimer = setTimeout(pollStatus, 8000);
        });
    }
    pollStatus(true);
    // Stop polling once the visitor leaves
    window.addEventListener('pagehide', function () { if (statusTimer) clearTimeout(statusTimer); });

    /* ══════════════════════════════════════════════════════════════════
       4. Maintenance mode
       ══════════════════════════════════════════════════════════════════ */
    var mc = document.createElement('div');
    mc.id = 'mntBanner';
    document.body.prepend(mc);

    var md = null, ms = null, me = null, mr = null, mb = false;

    function fmt(t) {
      if (t <= 0) return '0ث';
      var h = Math.floor(t / 3600000),
          m = Math.floor((t % 3600000) / 60000),
          s = Math.floor((t % 60000) / 1000);
      return (h ? h + 'س ' : '') + (m ? m + 'د ' : '') + s + 'ث';
    }

    function bld() {
      mc.innerHTML =
        '<div class="mnt-banner"><div class="mnt-banner-inner">' +
          '<div class="mnt-banner-icon"><i class="fas fa-shield-halved"></i></div>' +
          '<div class="mnt-banner-text">' +
            '<div class="mnt-banner-title">KRATOS SYSTEM Bot v1.0.11 — وضع الصيانة مفعل</div>' +
            '<div class="mnt-banner-desc"><span class="mnt-banner-time"><i class="fas fa-circle"></i> <span id="mntTimer">...</span></span><span id="mntMessage"></span></div>' +
          '</div>' +
        '</div></div>';
      document.body.classList.add('mnt-active');
      mb = true;
      tick();
    }

    function rem() {
      mc.innerHTML = '';
      document.body.classList.remove('mnt-active');
      mb = false;
    }

    function gs(on) {
      var e = document.getElementById('frameGlass');
      if (e) e.classList.toggle('show', !!on);
    }

    function upd() {
      if (!md || !md.enabled) { rem(); gs(false); return; }
      if (!mb) bld();
      var e = document.getElementById('mntMessage');
      if (e) e.textContent = md.message || 'الموقع تحت الصيانة حالياً';
      var gm = document.getElementById('glassMsg');
      if (gm) gm.textContent = md.message || 'الموقع تحت الصيانة حالياً';
      gs(true);
    }

    function tick() {
      var e = document.getElementById('mntTimer'), w = e && e.parentElement;
      if (!e || !w || !md || !md.enabled) return;
      var gt = document.getElementById('glassTimer');
      if (me && mr !== null) {
        w.style.display = '';
        var t = 'متبقي ' + fmt(mr);
        e.textContent = t;
        if (gt) gt.textContent = t;
        if (mr > 0) mr = Math.max(0, mr - 1000);
      } else {
        w.style.display = 'none';
        if (gt) gt.textContent = '—';
      }
    }

    async function chk() {
      try {
        var r = await fetch('/dev/maintenance/status');
        var d = await r.json();
        if (d.enabled) {
          ms = Number(d.startedAt) || Date.now();
          me = d.endTime ? Number(d.endTime) : null;
          mr = typeof d.remainMs === 'number' ? d.remainMs : null;
          md = d;
        } else {
          md = null; me = null; mr = null;
        }
        upd();
      } catch {}
    }

    chk();
    setInterval(chk, 30000);
    setInterval(tick, 1000);
  });
  </script>
</body>
</html>
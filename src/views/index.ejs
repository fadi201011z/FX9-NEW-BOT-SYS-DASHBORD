        <% } else { %>
          <a href="/auth/discord" class="nx-btn nx-btn-p">دخول</a>
        <% } %>
      </div>
    </div>
  </div>
</header>

<!-- ══ Hero ════════════════════════════════════════════════════════════════
     Centred copy, one contained button beside one outlined button, two
     blurred radial orbs behind. The planet artwork that sits behind this
     section on novax.gg is intentionally absent. -->
<section class="nx-hero">

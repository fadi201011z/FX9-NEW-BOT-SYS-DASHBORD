  <style>
    .mnt-banner {
      position: sticky; top: 0; z-index: 10000;
      background: rgba(237,66,69,0.18);
      backdrop-filter: blur(24px) saturate(1.8);
      -webkit-backdrop-filter: blur(24px) saturate(1.8);
      border-bottom: 1px solid rgba(255,255,255,0.06);
      animation: mntSlideDown 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes mntSlideDown {
      from { transform: translateY(-100%); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .mnt-banner-inner {
      max-width: 1100px; margin: 0 auto; padding: 8px 20px;
      display: flex; align-items: center; gap: 12px; direction: rtl;
    }
    .mnt-banner-icon {
      width: 32px; height: 32px; border-radius: 50%;
      background: rgba(237,66,69,0.2); border: 1px solid rgba(237,66,69,0.25);
      display: flex; align-items: center; justify-content: center;
      font-size: 0.85rem; color: #ed4245; flex-shrink: 0;
    }
    .mnt-banner-text { flex: 1; }
    .mnt-banner-title {
      font-weight: 700; font-size: 0.82rem;
      color: rgba(255,255,255,0.85); margin-bottom: 1px;
    }
    .mnt-banner-desc {
      font-size: 0.72rem; color: rgba(255,255,255,0.45);
      display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
    }
    .mnt-banner-time {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 1px 10px; border-radius: 20px;
      background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.06);
      font-family: 'Cairo', monospace; font-size: 0.72rem;
      color: rgba(255,255,255,0.6); direction: ltr;
    }
    .mnt-banner-time i {
      font-size: 0.55rem; color: #ed4245;
      animation: mntBlink 1.2s ease-in-out infinite;
    }
    @keyframes mntBlink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.2; }
    }
    body.mnt-active .x-nav { top: 52px; }
    body.mnt-active .mnt-banner { position: fixed; left: 0; right: 0; }
    @media (max-width: 768px) {
      .mnt-banner-inner { flex-direction: row; text-align: right; padding: 6px 14px; gap: 8px; }
      .mnt-banner-title { font-size: 0.75rem; }
    }
  </style>
  <script src="/js/main.js"></script>
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    function setStatsFallback() {
      var fb = { 'أنظمة حماية': 6, 'أوامر تذاكر': 9, 'أوامر صوتية': 15, 'إجمالي الأوامر': 55 };
      document.querySelectorAll('.lp-stat-num').forEach(function(el) {
        var label = (el.closest('.lp-stat')?.querySelector('.lp-stat-desc')?.textContent || '').trim();
        for (var key in fb) {
          if (label.includes(key)) {
            var val = fb[key];
            el.textContent = val;
            var id = '';
            if (label.includes('أوامر تذاكر')) id = 'statTickets';
            else if (label.includes('أوامر صوتية')) id = 'statVoice';
            else if (label.includes('إجمالي الأوامر')) id = 'statTotal';
            var pg = document.getElementById(id);
            if (pg) pg.textContent = val;
            break;
          }
        }
      });
      var h = document.getElementById('heroCmdCount');
      if (h) h.textContent = '55';
    }
    function setStatsFromApi(map, totalStats) {
      document.querySelectorAll('.lp-stat-num').forEach(function(el) {
        var label = (el.closest('.lp-stat')?.querySelector('.lp-stat-desc')?.textContent || '').trim();
        var val = 0;
        if (label.includes('أوامر تذاكر'))        val = map['ticket'] || 0;
        else if (label.includes('أوامر صوتية'))    val = map['voice'] || 0;
        else if (label.includes('إجمالي الأوامر')) val = totalStats;
        else if (label.includes('أنظمة حماية'))    val = 6;
        el.textContent = val;
        var id = '';
        if (label.includes('أوامر تذاكر')) id = 'statTickets';
        else if (label.includes('أوامر صوتية')) id = 'statVoice';
        else if (label.includes('إجمالي الأوامر')) id = 'statTotal';
        var pg = document.getElementById(id);
        if (pg) pg.textContent = val;
      });
      var h = document.getElementById('heroCmdCount');
      if (h) h.textContent = totalStats || 0;
    }
    fetch('/api/commands/stats')
      .then(function(r) { if (!r.ok) throw new Error(); return r.json(); })
      .then(function(s) { setStatsFromApi(s.perCategory || {}, s.total || 0); })
      .catch(setStatsFallback);
    var mc = document.createElement('div');
    mc.id = 'mntBanner';
    document.body.prepend(mc);
    var md = null, ms = null, me = null, mr = null, mb = false;
    function fmt(t) {
      if (t <= 0) return '0ث';
      var h = Math.floor(t / 3600000), m = Math.floor((t % 3600000) / 60000), s = Math.floor((t % 60000) / 1000);
      return (h ? h + 'س ' : '') + (m ? m + 'د ' : '') + s + 'ث';
    }
    function build() {
      mc.innerHTML = '<div class="mnt-banner"><div class="mnt-banner-inner"><div class="mnt-banner-icon"><i class="fas fa-shield-halved"></i></div><div class="mnt-banner-text"><div class="mnt-banner-title">FADIX9 SYSTEM Bot v1.0.11 — وضع الصيانة مفعل</div><div class="mnt-banner-desc"><span class="mnt-banner-time"><i class="fas fa-circle"></i> <span id="mntTimer">...</span></span><span id="mntMessage"></span></div></div></div></div>';
      document.body.classList.add('mnt-active'); mb = true; tick();
    }
    function remove() { mc.innerHTML = ''; document.body.classList.remove('mnt-active'); mb = false; }
    function upd() { if (!md || !md.enabled) { remove(); return; } if (!mb) build(); var e = document.getElementById('mntMessage'); if (e) e.textContent = md.message || 'الموقع تحت الصيانة حالياً'; }
    function tick() { var e = document.getElementById('mntTimer'), w = e && e.parentElement; if (!e || !w || !md || !md.enabled) return; if (me && mr !== null) { w.style.display = ''; e.textContent = 'متبقي ' + fmt(mr); if (mr > 0) mr = Math.max(0, mr - 1000); } else { w.style.display = 'none'; } }
    async function chk() { try { var r = await fetch('/dev/maintenance/status'), d = await r.json(); if (d.enabled) { ms = Number(d.startedAt) || Date.now(); me = d.endTime ? Number(d.endTime) : null; mr = typeof d.remainMs === 'number' ? d.remainMs : null; md = d; } else { md = null; ms = null; me = null; mr = null; } upd(); } catch {} }
    chk(); setInterval(chk, 30000); setInterval(tick, 1000);
  });
  </script>
</body>
</html>

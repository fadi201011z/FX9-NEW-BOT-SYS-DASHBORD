<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FX9 Dashboard — لوحة تحكم البوت</title>
  <meta name="description" content="FX9 Dashboard — لوحة تحكم متقدمة لإدارة بوت FX9 على ديسكورد">
  <meta property="og:title" content="FX9 Dashboard — لوحة تحكم البوت" />
  <meta property="og:description" content="FX9 Dashboard — لوحة تحكم متقدمة لإدارة بوت FX9 على ديسكورد. إدارة السيرفرات، نظام تذاكر، قنوات صوتية مؤقتة، والمزيد." />
  <meta property="og:image" content="https://fx9-dashboard.onrender.com/og-image.svg" />
  <meta property="og:url" content="https://fx9-dashboard.onrender.com" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="FX9 Dashboard" />
  <meta property="og:locale" content="ar_AR" />
  <meta name="theme-color" content="#f97316" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="FX9 Dashboard — لوحة تحكم البوت" />
  <meta name="twitter:description" content="FX9 Dashboard — لوحة تحكم متقدمة لإدارة بوت FX9 على ديسكورد." />
  <meta name="twitter:image" content="https://fx9-dashboard.onrender.com/og-image.svg" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <style>
:root {
  --dbg: #0b0a0e;
  --dcard: #111115;
  --dborder: rgba(255,255,255,0.04);
  --dtext: rgba(255,255,255,0.88);
  --dmuted: rgba(255,255,255,0.3);
  --dpri: #f97316;
  --dsec: #a855f7;
  --dacc: #fde047;
  --dglow: rgba(249,115,22,0.2);
}

* { margin:0; padding:0; box-sizing:border-box; }
body { font-family:'Cairo',sans-serif; background:var(--dbg); color:var(--dtext); overflow-x:hidden; }
a { text-decoration:none; color:inherit; }

.d-nav {
  position:fixed; top:0; left:0; right:0; z-index:1000;
  display:flex; align-items:center; justify-content:space-between;
  padding:0 28px; height:66px;
  background:rgba(11,10,14,0.75); backdrop-filter:blur(18px) saturate(1.4);
  -webkit-backdrop-filter:blur(18px) saturate(1.4);
  border-bottom:1px solid var(--dborder);
}
.d-brand { display:flex; align-items:center; gap:9px; font-size:1.05rem; font-weight:800; color:white; }
.d-brand-icon {
  width:30px; height:30px; border-radius:7px;
  background:linear-gradient(135deg,var(--dpri),var(--dsec));
  display:flex; align-items:center; justify-content:center; font-size:0.8rem; color:white;
}
.d-nav-btn {
  display:inline-flex; align-items:center; gap:7px;
  padding:8px 20px; border-radius:9px; font-family:'Cairo',sans-serif;
  font-size:0.83rem; font-weight:600; cursor:pointer; transition:all 0.25s; border:none;
}
.d-nav-pri {
  background:linear-gradient(135deg,var(--dpri),#ea580c);
  color:white; box-shadow:0 4px 18px var(--dglow);
}
.d-nav-pri:hover { transform:translateY(-1px); box-shadow:0 6px 28px var(--dglow); }
.d-nav-ghost { background:rgba(255,255,255,0.04); color:var(--dmuted); border:1px solid var(--dborder); }
.d-nav-ghost:hover { background:rgba(255,255,255,0.07); color:white; }
.d-nav-danger { background:rgba(237,66,69,0.12); color:#f87171; border:1px solid rgba(237,66,69,0.15); }
.d-nav-danger:hover { background:rgba(237,66,69,0.18); }

.d-hero {
  position:relative; min-height:100vh; display:flex; align-items:center; justify-content:center;
  background:linear-gradient(180deg, #0b0a0e 0%, #100e18 35%, #0b0a0e 70%, #0b0a0e 100%);
  overflow:hidden;
}
.d-hero-bg {
  position:absolute; inset:0;
  background:
    radial-gradient(ellipse 70% 50% at 30% 0%, rgba(249,115,22,0.07) 0%, transparent 65%),
    radial-gradient(ellipse 50% 40% at 70% 100%, rgba(168,85,247,0.05) 0%, transparent 55%);
}
.d-hero-glow {
  position:absolute; width:400px; height:400px; border-radius:50%;
  filter:blur(140px); opacity:0.12;
  animation: dGlide 18s ease-in-out infinite;
}
.d-hg1 { background:var(--dpri); top:-120px; left:20%; }
.d-hg2 { background:var(--dsec); bottom:-120px; right:20%; animation-delay:-9s; }
@keyframes dGlide {
  0%,100% { transform:translate(0,0) scale(1); }
  50% { transform:translate(40px,-30px) scale(1.15); }
}
.d-hero-wrap {
  position:relative; z-index:1; text-align:center; max-width:700px; margin:0 auto;
  padding:130px 24px 80px;
}
.d-pill {
  display:inline-flex; align-items:center; gap:7px;
  background:rgba(249,115,22,0.07); border:1px solid rgba(249,115,22,0.13);
  padding:5px 16px; border-radius:100px; font-size:0.75rem; font-weight:500;
  color:rgba(249,115,22,0.85); margin-bottom:22px;
}
.d-pill i { font-size:0.5rem; color:#fbbf24; }
.d-hero-wrap h1 {
  font-size:3rem; font-weight:800; line-height:1.25; margin-bottom:14px;
}
.d-hero-wrap h1 em {
  font-style:normal;
  background:linear-gradient(135deg,var(--dpri),var(--dsec),#fbbf24);
  -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
}
.d-hero-wrap p {
  font-size:1rem; color:var(--dmuted); line-height:1.8; margin-bottom:28px; max-width:500px; margin-inline:auto;
}
.d-acts { display:flex; gap:12px; justify-content:center; margin-bottom:50px; }
.d-btn {
  display:inline-flex; align-items:center; gap:8px;
  padding:12px 30px; border-radius:11px; font-family:'Cairo',sans-serif;
  font-size:0.92rem; font-weight:600; cursor:pointer; transition:all 0.3s; border:none;
}
.d-btn-pri {
  background:linear-gradient(135deg,var(--dpri),#ea580c);
  color:white; box-shadow:0 4px 24px var(--dglow);
}
.d-btn-pri:hover { transform:translateY(-2px); box-shadow:0 8px 40px var(--dglow); color:white; }
.d-btn-out {
  background:transparent; color:var(--dmuted); border:1px solid var(--dborder);
}
.d-btn-out:hover { border-color:rgba(255,255,255,0.15); color:white; }
.d-hero-metrics {
  display:flex; gap:50px; justify-content:center;
}
.d-metric { text-align:center; }
.d-metric-num { display:block; font-size:1.6rem; font-weight:800; background:linear-gradient(135deg,var(--dpri),#fbbf24); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
.d-metric-lbl { font-size:0.8rem; color:var(--dmuted); }

.d-divider { height:1px; max-width:900px; margin:0 auto; background:linear-gradient(90deg,transparent,rgba(249,115,22,0.12),transparent); }

.d-sec { padding:90px 24px; }
.d-sec-inner { max-width:1100px; margin:0 auto; }
.d-tag {
  display:inline-flex; align-items:center; gap:5px;
  padding:4px 13px; border-radius:20px; font-size:0.7rem; font-weight:600;
  margin-bottom:10px; letter-spacing:0.3px;
}
.d-tag-pri { background:rgba(249,115,22,0.06); border:1px solid rgba(249,115,22,0.1); color:var(--dpri); }
.d-tag-sec { background:rgba(168,85,247,0.06); border:1px solid rgba(168,85,247,0.1); color:var(--dsec); }
.d-head { text-align:center; margin-bottom:55px; }
.d-head h2 { font-size:2rem; font-weight:800; margin-bottom:8px; }
.d-head h2 em { font-style:normal; background:linear-gradient(135deg,var(--dpri),var(--dsec)); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
.d-head p { color:var(--dmuted); font-size:0.95rem; max-width:480px; margin:0 auto; line-height:1.8; }

.d-grid {
  display:grid; grid-template-columns:repeat(3,1fr); gap:20px;
}
@media (max-width:900px) { .d-grid { grid-template-columns:repeat(2,1fr); } }
@media (max-width:600px) { .d-grid { grid-template-columns:1fr; } }
.d-feat {
  padding:24px 20px; border-radius:12px;
  background:var(--dcard); border:1px solid var(--dborder);
  transition:all 0.35s ease; position:relative; overflow:hidden;
}
.d-feat::before {
  content:''; position:absolute; top:0; left:0; right:0; height:2px;
  opacity:0; transition:opacity 0.35s;
}
.d-feat:hover { transform:translateY(-3px); border-color:rgba(249,115,22,0.12); }
.d-feat:hover::before { opacity:1; }
.d-feat-icon {
  width:38px; height:38px; border-radius:9px;
  display:flex; align-items:center; justify-content:center;
  margin-bottom:12px; font-size:0.95rem;
}
.d-feat h3 { font-size:0.9rem; font-weight:700; margin-bottom:4px; }
.d-feat p { font-size:0.78rem; color:var(--dmuted); line-height:1.7; }

.d-stats-wrap {
  display:flex; justify-content:center; gap:70px; max-width:800px; margin:0 auto;
}
@media (max-width:600px) { .d-stats-wrap { flex-direction:column; gap:24px; align-items:center; } }
.d-stat { text-align:center; }
.d-stat-val {
  font-size:2rem; font-weight:800; display:block;
  background:linear-gradient(135deg,var(--dpri),var(--dsec));
  -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
}
.d-stat-lbl { font-size:0.82rem; color:var(--dmuted); margin-top:2px; }

.d-cta-box {
  max-width:620px; margin:0 auto; text-align:center;
  padding:50px 44px; border-radius:16px;
  background:linear-gradient(135deg, rgba(249,115,22,0.03), rgba(168,85,247,0.03));
  border:1px solid var(--dborder); position:relative; overflow:hidden;
}
.d-cta-box::before {
  content:''; position:absolute; top:0; left:0; right:0; height:1px;
  background:linear-gradient(90deg,transparent,var(--dpri),var(--dsec),#fbbf24,transparent);
  opacity:0.4;
}
.d-cta-box h2 { font-size:1.6rem; font-weight:800; margin-bottom:8px; }
.d-cta-box p { color:var(--dmuted); margin-bottom:24px; font-size:0.9rem; line-height:1.7; }

.d-foot {
  border-top:1px solid var(--dborder); padding:18px 24px;
}
.d-foot-inner {
  display:flex; justify-content:space-between; align-items:center;
  max-width:1100px; margin:0 auto; font-size:0.76rem; color:var(--dmuted);
}
.d-foot-links { display:flex; gap:14px; }
.d-foot-links a { color:var(--dmuted); transition:color 0.3s; }
.d-foot-links a:hover { color:rgba(255,255,255,0.5); }

@media (max-width:768px) {
  .d-nav { padding:0 16px; height:58px; }
  .d-hero-wrap { padding:110px 16px 60px; }
  .d-hero-wrap h1 { font-size:1.9rem; }
  .d-hero-wrap p { font-size:0.88rem; }
  .d-acts { flex-direction:column; align-items:center; }
  .d-hero-metrics { gap:20px; }
  .d-metric-num { font-size:1.2rem; }
  .d-sec { padding:55px 16px; }
  .d-head h2 { font-size:1.4rem; }
  .d-cta-box { padding:30px 18px; }
  .d-cta-box h2 { font-size:1.2rem; }
  .d-foot-inner { flex-direction:column; gap:6px; text-align:center; }
  .d-stats-wrap { gap:20px; }
}

.d-toast {
  position:fixed; bottom:24px; left:50%; transform:translateX(-50%); z-index:9999;
  background:rgba(237,66,69,0.14); backdrop-filter:blur(20px);
  border:1px solid rgba(237,66,69,0.14); border-radius:10px;
  padding:11px 22px; font-size:0.83rem; color:#f87171; direction:rtl;
}
  </style>
</head>
<body>
  <nav class="d-nav">
    <a href="/" class="d-brand">
      <div class="d-brand-icon"><i class="fas fa-bolt"></i></div>
      <span>FX9</span>
    </a>
    <div style="display:flex;align-items:center;gap:8px">
      <% if (locals.user) { %>
        <a href="/home" class="d-nav-btn d-nav-pri">
          <i class="fas fa-th-large"></i> لوحة التحكم
        </a>
        <a href="/auth/logout" class="d-nav-btn d-nav-danger">
          <i class="fas fa-sign-out-alt"></i> خروج
        </a>
      <% } else { %>
        <a href="/auth/discord" class="d-nav-btn d-nav-pri">
          <i class="fab fa-discord"></i> Login with Discord
        </a>
      <% } %>
    </div>
  </nav>

  <% if (locals.error) { %>
    <div class="d-toast">
      <i class="fas fa-circle-exclamation"></i>
      <%= error === 'auth_failed' ? 'فشل تسجيل الدخول — تحقق من Redirect URI في Discord Developer Portal' : error === 'no_code' ? 'لم يتم استلام رمز التوثيق — حاول مرة أخرى' : error %>
    </div>
  <% } %>

  <section class="d-hero">
    <div class="d-hero-bg"></div>
    <div class="d-hero-glow d-hg1"></div>
    <div class="d-hero-glow d-hg2"></div>
    <div class="d-hero-wrap">
      <div class="d-pill">
        <i class="fas fa-circle"></i>
        FADIX9 SYSTEM v1.0.11 — البوت活跃
      </div>
      <h1>منصة متكاملة<br>لإدارة <em>سيرفر ديسكورد</em></h1>
      <p>الحماية، التذاكر، الغرف الصوتية، الإشعارات — كلها في لوحة واحدة بمزامنة فورية وتجربة استخدام احترافية</p>
      <div class="d-acts">
        <% if (locals.user) { %>
          <a href="/home" class="d-btn d-btn-pri">
            <i class="fas fa-th-large"></i> ادخل للوحة
          </a>
          <a href="/auth/logout" class="d-btn d-btn-out">
            <i class="fas fa-sign-out-alt"></i> خروج
          </a>
        <% } else { %>
          <a href="/auth/discord" class="d-btn d-btn-pri">
            <i class="fab fa-discord"></i> ابدأ — سجل بدقيقة
          </a>
          <a href="/invite-dev" class="d-btn d-btn-out">
            <i class="fas fa-code-branch"></i> أضف البوت
          </a>
        <% } %>
      </div>
      <div class="d-hero-metrics">
        <div class="d-metric">
          <span class="d-metric-num">6</span>
          <span class="d-metric-lbl">أنظمة أمان</span>
        </div>
        <div class="d-metric">
          <span class="d-metric-num" id="heroCmdCount">—</span>
          <span class="d-metric-lbl">إجمالي الأوامر</span>
        </div>
        <div class="d-metric">
          <span class="d-metric-num">100%</span>
          <span class="d-metric-lbl">تحكم ويب</span>
        </div>
      </div>
    </div>
  </section>

  <div class="d-divider"></div>

  <section class="d-sec">
    <div class="d-sec-inner">
      <div class="d-head">
        <div class="d-tag d-tag-pri"><i class="fas fa-cubes"></i> إمكانيات متقدمة</div>
        <h2>أدوات <em>احترافية</em> لسيرفرك</h2>
        <p>مجموعة متكاملة من الأنظمة المصممة لتسهيل الإدارة وتحسين تجربة الأعضاء</p>
      </div>
      <div class="d-grid">
        <div class="d-feat">
          <div class="d-feat-icon" style="background:rgba(249,115,22,0.08);color:var(--dpri)"><i class="fas fa-robot"></i></div>
          <h3>حماية ذكية</h3>
          <p>نظام كشف تلقائي للهجمات والروابط الضارة مع فلترة ذكية وإعدادات أمان مرنة لكل سيرفر</p>
        </div>
        <div class="d-feat" style="--accent:var(--dsec)">
          <div class="d-feat-icon" style="background:rgba(168,85,247,0.08);color:var(--dsec)"><i class="fas fa-headset"></i></div>
          <h3>نظام تذاكر</h3>
          <p>فريق دعم منظم بصلاحيات مخصصة وتقييم أداء ونظام إدارة متكامل للتذاكر والاستفسارات</p>
        </div>
        <div class="d-feat">
          <div class="d-feat-icon" style="background:rgba(253,224,71,0.08);color:#fbbf24"><i class="fas fa-wave-square"></i></div>
          <h3>غرف ديناميكية</h3>
          <p>قنوات صوتية مؤقتة بضغطة زر مع توليد تلقائي وخيارات تخصيص وتحكم كامل بالصلاحيات</p>
        </div>
        <div class="d-feat">
          <div class="d-feat-icon" style="background:rgba(248,113,113,0.08);color:#f87171"><i class="fas fa-gavel"></i></div>
          <h3>إشراف متكامل</h3>
          <p>أوامر مراقبة متقدمة مع سجل مخالفات ونظام تحذيرات تدريجي وأدوات إدارة شاملة للأعضاء</p>
        </div>
        <div class="d-feat">
          <div class="d-feat-icon" style="background:rgba(52,211,153,0.08);color:#34d399"><i class="fas fa-broadcast-tower"></i></div>
          <h3>متابعة منصات</h3>
          <p>اشتراكات فورية ليوتيوب، تويتر، تويتش، كيك مع إشعارات لحظية وإدارة متابعة ذكية</p>
        </div>
        <div class="d-feat">
          <div class="d-feat-icon" style="background:rgba(96,165,250,0.08);color:#60a5fa"><i class="fas fa-chart-pie"></i></div>
          <h3>تحليلات وبيانات</h3>
          <p>لوحة تفاعلية مع رسوم بيانية وإحصائيات دورية عن أداء السيرفر ونشاط البوت والتقارير</p>
        </div>
      </div>
    </div>
  </section>

  <div class="d-divider"></div>

  <section class="d-sec">
    <div class="d-sec-inner">
      <div class="d-head">
        <div class="d-tag d-tag-sec"><i class="fas fa-chart-simple"></i> إحصائيات</div>
        <h2>البوت <em>بأرقام</em></h2>
        <p>إحصائيات حية تعكس أداء وانتشار البوت</p>
      </div>
      <div class="lp-stats" style="display:none">
        <div class="lp-stat">
          <span class="lp-stat-num">6</span>
          <span class="lp-stat-desc">أنظمة حماية</span>
        </div>
        <div class="lp-stat">
          <span class="lp-stat-num">—</span>
          <span class="lp-stat-desc">أوامر تذاكر</span>
        </div>
        <div class="lp-stat">
          <span class="lp-stat-num">—</span>
          <span class="lp-stat-desc">أوامر صوتية</span>
        </div>
        <div class="lp-stat">
          <span class="lp-stat-num">—</span>
          <span class="lp-stat-desc">إجمالي الأوامر</span>
        </div>
      </div>
      <div class="d-stats-wrap">
        <div class="d-stat">
          <span class="d-stat-val">6</span>
          <span class="d-stat-lbl">أنظمة أمان</span>
        </div>
        <div class="d-stat">
          <span class="d-stat-val" id="statTickets">—</span>
          <span class="d-stat-lbl">تذاكر</span>
        </div>
        <div class="d-stat">
          <span class="d-stat-val" id="statVoice">—</span>
          <span class="d-stat-lbl">أوامر صوتية</span>
        </div>
        <div class="d-stat">
          <span class="d-stat-val" id="statTotal">—</span>
          <span class="d-stat-lbl">إجمالي الأوامر</span>
        </div>
      </div>
    </div>
  </section>

  <div class="d-divider"></div>

  <section class="d-sec">
    <div class="d-sec-inner">
      <div class="d-cta-box">
        <h2>جهز سيرفرك مع FX9</h2>
        <p>أقوى أدوات الإدارة والحماية والتذاكر — كل شيء جاهز للانطلاق بدون أي تعقيد</p>
        <% if (locals.user) { %>
          <a href="/home" class="d-btn d-btn-pri">
            <i class="fas fa-th-large"></i> ابدأ الإدارة
          </a>
        <% } else { %>
          <a href="/auth/discord" class="d-btn d-btn-pri">
            <i class="fab fa-discord"></i> سجل وانطلق
          </a>
        <% } %>
      </div>
    </div>
  </section>

  <footer class="d-foot">
    <div class="d-foot-inner">
      <span>© 2026 FX9 — جميع الحقوق محفوظة</span>
      <div class="d-foot-links">
        <a href="#"><i class="fab fa-discord"></i></a>
        <a href="#"><i class="fab fa-github"></i></a>
      </div>
    </div>
  </footer>

  <style>
    .mnt-banner {
      position: sticky; top: 0; z-index: 10000;
      background: rgba(237,66,69,0.18);
      backdrop-filter: blur(24px) saturate(1.8);
      -webkit-backdrop-filter: blur(24px) saturate(1.8);
      border-bottom: 1px solid rgba(255,255,255,0.06);
      animation: mntSlideDown 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes mntSlideDown {
      from { transform: translateY(-100%); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .mnt-banner-inner {
      max-width: 1100px; margin: 0 auto; padding: 8px 20px;
      display: flex; align-items: center; gap: 12px; direction: rtl;
    }
    .mnt-banner-icon {
      width: 32px; height: 32px; border-radius: 50%;
      background: rgba(237,66,69,0.2); border: 1px solid rgba(237,66,69,0.25);
      display: flex; align-items: center; justify-content: center;
      font-size: 0.85rem; color: #ed4245; flex-shrink: 0;
    }
    .mnt-banner-text { flex: 1; }
    .mnt-banner-title {
      font-weight: 700; font-size: 0.82rem;
      color: rgba(255,255,255,0.85); margin-bottom: 1px;
    }
    .mnt-banner-desc {
      font-size: 0.72rem; color: rgba(255,255,255,0.45);
      display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
    }
    .mnt-banner-time {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 1px 10px; border-radius: 20px;
      background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.06);
      font-family: 'Cairo', monospace; font-size: 0.72rem;
      color: rgba(255,255,255,0.6); direction: ltr;
    }
    .mnt-banner-time i {
      font-size: 0.55rem; color: #ed4245;
      animation: mntBlink 1.2s ease-in-out infinite;
    }
    @keyframes mntBlink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.2; }
    }
    body.mnt-active .d-nav { top: 52px; }
    body.mnt-active .mnt-banner { position: fixed; left: 0; right: 0; }
    @media (max-width: 768px) {
      .mnt-banner-inner { flex-direction: row; text-align: right; padding: 6px 14px; gap: 8px; }
      .mnt-banner-title { font-size: 0.75rem; }
    }
  </style>
  <script src="/js/main.js"></script>
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    function setStatsFallback() {
      var fb = { 'أنظمة حماية': 6, 'أوامر تذاكر': 9, 'أوامر صوتية': 15, 'إجمالي الأوامر': 55 };
      document.querySelectorAll('.lp-stat-num').forEach(function(el) {
        var label = (el.closest('.lp-stat')?.querySelector('.lp-stat-desc')?.textContent || '').trim();
        for (var key in fb) {
          if (label.includes(key)) {
            var val = fb[key];
            el.textContent = val;
            var id = '';
            if (label.includes('أوامر تذاكر')) id = 'statTickets';
            else if (label.includes('أوامر صوتية')) id = 'statVoice';
            else if (label.includes('إجمالي الأوامر')) id = 'statTotal';
            var pg = document.getElementById(id);
            if (pg) pg.textContent = val;
            break;
          }
        }
      });
      var h = document.getElementById('heroCmdCount');
      if (h) h.textContent = '55';
    }

    function setStatsFromApi(map, totalStats) {
      document.querySelectorAll('.lp-stat-num').forEach(function(el) {
        var label = (el.closest('.lp-stat')?.querySelector('.lp-stat-desc')?.textContent || '').trim();
        var val = 0;
        if (label.includes('أوامر تذاكر'))        val = map['ticket'] || 0;
        else if (label.includes('أوامر صوتية'))    val = map['voice'] || 0;
        else if (label.includes('إجمالي الأوامر')) val = totalStats;
        else if (label.includes('أنظمة حماية'))    val = 6;
        el.textContent = val;
        var id = '';
        if (label.includes('أوامر تذاكر')) id = 'statTickets';
        else if (label.includes('أوامر صوتية')) id = 'statVoice';
        else if (label.includes('إجمالي الأوامر')) id = 'statTotal';
        var pg = document.getElementById(id);
        if (pg) pg.textContent = val;
      });
      var h = document.getElementById('heroCmdCount');
      if (h) h.textContent = totalStats || 0;
    }

    fetch('/api/commands/stats')
      .then(function(r) { if (!r.ok) throw new Error(); return r.json(); })
      .then(function(s) { setStatsFromApi(s.perCategory || {}, s.total || 0); })
      .catch(setStatsFallback);

    var mc = document.createElement('div');
    mc.id = 'mntBanner';
    document.body.prepend(mc);
    var md = null, ms = null, me = null, mr = null, mb = false;
    function fmt(t) {
      if (t <= 0) return '0ث';
      var h = Math.floor(t / 3600000), m = Math.floor((t % 3600000) / 60000), s = Math.floor((t % 60000) / 1000);
      return (h ? h + 'س ' : '') + (m ? m + 'د ' : '') + s + 'ث';
    }
    function build() {
      mc.innerHTML = '<div class="mnt-banner"><div class="mnt-banner-inner"><div class="mnt-banner-icon"><i class="fas fa-shield-halved"></i></div><div class="mnt-banner-text"><div class="mnt-banner-title">FADIX9 SYSTEM Bot v1.0.11 — وضع الصيانة مفعل</div><div class="mnt-banner-desc"><span class="mnt-banner-time"><i class="fas fa-circle"></i> <span id="mntTimer">...</span></span><span id="mntMessage"></span></div></div></div></div>';
      document.body.classList.add('mnt-active');
      mb = true;
      tick();
    }
    function remove() { mc.innerHTML = ''; document.body.classList.remove('mnt-active'); mb = false; }
    function upd() { if (!md || !md.enabled) { remove(); return; } if (!mb) build(); var e = document.getElementById('mntMessage'); if (e) e.textContent = md.message || 'الموقع تحت الصيانة حالياً'; }
    function tick() { var e = document.getElementById('mntTimer'), w = e && e.parentElement; if (!e || !w || !md || !md.enabled) return; if (me && mr !== null) { w.style.display = ''; e.textContent = 'متبقي ' + fmt(mr); if (mr > 0) mr = Math.max(0, mr - 1000); } else { w.style.display = 'none'; } }
    async function chk() { try { var r = await fetch('/dev/maintenance/status'), d = await r.json(); if (d.enabled) { ms = Number(d.startedAt) || Date.now(); me = d.endTime ? Number(d.endTime) : null; mr = typeof d.remainMs === 'number' ? d.remainMs : null; md = d; } else { md = null; ms = null; me = null; mr = null; } upd(); } catch {} }
    chk();
    setInterval(chk, 30000);
    setInterval(tick, 1000);
  });
  </script>
</body>
</html>

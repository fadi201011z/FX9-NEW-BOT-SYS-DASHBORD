<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FX9 Dashboard — لوحة تحكم البوت</title>
  <meta name="description" content="FX9 Dashboard — لوحة تحكم متقدمة لإدارة بوت FX9 على ديسكورد">
  <meta property="og:title" content="FX9 Dashboard — لوحة تحكم البوت" />
  <meta property="og:description" content="FX9 Dashboard — لوحة تحكم متقدمة لإدارة بوت FX9 على ديسكورد. إدارة السيرفرات، نظام تذاكر، قنوات صوتية مؤقتة، والمزيد." />
  <meta property="og:image" content="https://fx9-dashboard.onrender.com/og-image.svg" />
  <meta property="og:url" content="https://fx9-dashboard.onrender.com" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="FX9 Dashboard" />
  <meta property="og:locale" content="ar_AR" />
  <meta name="theme-color" content="#FF0000" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="FX9 Dashboard — لوحة تحكم البوت" />
  <meta name="twitter:description" content="FX9 Dashboard — لوحة تحكم متقدمة لإدارة بوت FX9 على ديسكورد." />
  <meta name="twitter:image" content="https://fx9-dashboard.onrender.com/og-image.svg" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body class="landing-page">
  <nav class="navbar glass landing-nav">
    <div class="nav-left">
      <a href="/" class="nav-brand">
        <i class="fas fa-bolt"></i>
        <span>FX9 Dashboard</span>
      </a>
    </div>
    <div class="nav-right">
      <% if (locals.user) { %>
        <a href="/home" class="btn-discord" style="margin-left:8px">
          <i class="fas fa-th-large"></i>
          الصفحة الرئيسية
        </a>
        <a href="/auth/logout" class="btn-discord" style="background:#ed4245;">
          <i class="fas fa-sign-out-alt"></i>
          تسجيل الخروج
        </a>
      <% } else { %>
        <a href="/auth/discord" class="btn-discord">
          <i class="fab fa-discord"></i>
          Login with Discord
        </a>
      <% } %>
    </div>
  </nav>

  <% if (locals.error) { %>
    <div class="toast-container">
      <div class="toast glass fade-in-up" style="background:var(--danger);color:white">
        ⚠️ <%= error === 'auth_failed' ? 'فشل تسجيل الدخول — تحقق من Redirect URI في Discord Developer Portal' : error === 'no_code' ? 'لم يتم استلام رمز التوثيق — حاول مرة أخرى' : error %>
      </div>
    </div>
  <% } %>

  <section class="hero">
    <div class="hero-bg">
      <div class="hero-shape shape-1"></div>
      <div class="hero-shape shape-2"></div>
      <div class="hero-shape shape-3"></div>
    </div>
    <div class="hero-content">
      <div class="hero-badge">
        <i class="fas fa-bolt"></i>
        FADIX9 SYSTEM  Bot v1.0.11
      </div>
      <h1>لوحة تحكم متكاملة<br>لإدارة <span class="gradient-text">بوتك بالكامل</span></h1>
      <p>تحكم بجميع أنظمة البوت — الإدارة، التذاكر، الصوت المؤقت، الحماية — من لوحة واحدة احترافية مع مزامنة فورية</p>
      <div class="hero-buttons">
        <% if (locals.user) { %>
          <a href="/home" class="btn-primary btn-glow">
            <i class="fas fa-th-large"></i>
            الصفحة الرئيسية
          </a>
          <a href="/auth/logout" class="btn-secondary">
            <i class="fas fa-sign-out-alt"></i>
            تسجيل الخروج
          </a>
        <% } else { %>
          <a href="/auth/discord" class="btn-primary btn-glow">
            <i class="fab fa-discord"></i>
            ابدأ الآن — سجل دخولك
          </a>
          <a href="/invite-dev" class="btn-secondary">
            <i class="fas fa-code-branch"></i>
            الإضافة قيد التطوير
          </a>
        <% } %>
      </div>
      <div class="hero-stats">
        <div class="hero-stat">
          <span class="stat-value">6</span>
          <span class="stat-label">أنظمة</span>
        </div>
        <div class="hero-stat">
          <span class="stat-value" id="heroCmdCount">—</span>
          <span class="stat-label">أمر</span>
        </div>
        <div class="hero-stat">
          <span class="stat-value">100%</span>
          <span class="stat-label">تحكم عبر الويب</span>
        </div>
      </div>
    </div>
  </section>

  <section class="features" id="features">
    <div class="section-header">
      <h2>كل ما تحتاجه في <span class="gradient-text">لوحة واحدة</span></h2>
      <p>أنظمة متكاملة مع واجهة استخدام احترافية وسهلة</p>
    </div>
    <div class="features-grid">
      <div class="feature-card glass">
        <div class="feature-icon" style="--icon-color: #5865f2">
          <i class="fas fa-shield-alt"></i>
        </div>
        <h3>الحماية</h3>
        <p>نظام حماية متكامل ضد السبام، النيوك، الرايد، واللينكات</p>
      </div>
      <div class="feature-card glass">
        <div class="feature-icon" style="--icon-color: #57f287">
          <i class="fas fa-ticket-alt"></i>
        </div>
        <h3>التذاكر</h3>
        <p>نظام تذاكر دعم فني متكامل مع تقييم وإدارة متقدمة</p>
      </div>
      <div class="feature-card glass">
        <div class="feature-icon" style="--icon-color: #fee75c">
          <i class="fas fa-microphone"></i>
        </div>
        <h3>الرومات المؤقتة</h3>
        <p>قنوات صوتية مؤقتة بنظام Join-to-Create مع لوحة تحكم خاصة</p>
      </div>
      <div class="feature-card glass">
        <div class="feature-icon" style="--icon-color: #ed4245">
          <i class="fas fa-gavel"></i>
        </div>
        <h3>الإشراف</h3>
        <p>أوامر إشراف متكاملة مع سجلات ونظام تحذيرات</p>
      </div>
      <div class="feature-card glass">
        <div class="feature-icon" style="--icon-color: #eb459e">
          <i class="fas fa-music"></i>
        </div>
        <h3>الموسيقى</h3>
        <p>مشغل موسيقى متكامل مع يوتيوب وقائمة تشغيل</p>
      </div>
      <div class="feature-card glass">
        <div class="feature-icon" style="--icon-color: #5865f2">
          <i class="fas fa-chart-line"></i>
        </div>
        <h3>الإحصائيات</h3>
        <p>إحصائيات ورسوم بيانية لأداء السيرفر والبوت</p>
      </div>
    </div>
  </section>

  <section class="stats-section">
    <div class="stats-container">
      <div class="stat-item">
        <i class="fas fa-shield-alt"></i>
        <span class="stat-number" data-target="0">0</span>
        <span class="stat-desc">أنظمة حماية</span>
      </div>
      <div class="stat-item">
        <i class="fas fa-ticket-alt"></i>
        <span class="stat-number" data-target="0">0</span>
        <span class="stat-desc">أوامر تذاكر</span>
      </div>
      <div class="stat-item">
        <i class="fas fa-microphone"></i>
        <span class="stat-number" data-target="0">0</span>
        <span class="stat-desc">أوامر صوتية</span>
      </div>
      <div class="stat-item">
        <i class="fas fa-terminal"></i>
        <span class="stat-number" data-target="0">0</span>
        <span class="stat-desc">إجمالي الأوامر</span>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="cta-content glass">
      <h2>هل أنت مستعد؟</h2>
      <p>ابدأ بإدارة سيرفرك بشكل احترافي مع FX9 Dashboard</p>
      <% if (locals.user) { %>
        <a href="/home" class="btn-primary btn-glow">
          <i class="fas fa-th-large"></i>
          الصفحة الرئيسية
        </a>
      <% } else { %>
        <a href="/auth/discord" class="btn-primary btn-glow">
          <i class="fab fa-discord"></i>
          سجل دخولك الآن
        </a>
      <% } %>
    </div>
  </section>

  <footer class="footer landing-footer">
    <div class="footer-content">
      <span>© 2026 FX9 Dashboard — جميع الحقوق محفوظة</span>
    </div>
  </footer>

  <style>
    .mnt-banner {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 9999;
      background: linear-gradient(135deg, rgba(237,66,69,0.95), rgba(200,40,40,0.95));
      backdrop-filter: blur(12px);
      border-bottom: 2px solid rgba(255,255,255,0.1);
      animation: mntSlideDown 0.4s ease;
    }
    @keyframes mntSlideDown {
      from { transform: translateY(-100%); }
      to { transform: translateY(0); }
    }
    .mnt-banner-inner {
      max-width: 1100px;
      margin: 0 auto;
      padding: 10px 20px;
      display: flex;
      align-items: center;
      gap: 14px;
      direction: rtl;
    }
    .mnt-banner-icon {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: rgba(255,255,255,0.12);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      color: #fff;
      flex-shrink: 0;
    }
    .mnt-banner-text { flex: 1; }
    .mnt-banner-title {
      font-weight: 700;
      font-size: 0.9rem;
      color: #fff;
      margin-bottom: 2px;
    }
    .mnt-banner-desc {
      font-size: 0.78rem;
      color: rgba(255,255,255,0.75);
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }
    .mnt-banner-desc i { font-size: 0.7rem; }
    @media (max-width: 768px) {
      .mnt-banner-inner { flex-direction: column; text-align: center; padding: 10px 16px; }
      .mnt-banner-desc { justify-content: center; }
    }
  </style>
  <script src="/js/main.js"></script>
  <script>
  document.addEventListener('DOMContentLoaded', () => {
    fetch('/api/commands/stats')
      .then(r => r.json())
      .then(stats => {
        const map = stats.perCategory || {};
        const totalStats = stats.total || 0;
        document.querySelectorAll('.stat-number[data-target]').forEach(el => {
          const label = el.closest('.stat-item')?.querySelector('.stat-desc')?.textContent || '';
          let val = 0;
          if (label.includes('أوامر تذاكر'))        val = map['ticket'] || 0;
          else if (label.includes('أوامر صوتية'))    val = map['voice'] || 0;
          else if (label.includes('إجمالي الأوامر')) val = totalStats;
          else if (label.includes('أنظمة حماية'))    val = 6;
          el.dataset.target = val;
          el.textContent = '0';
          if (typeof animateCount === 'function') animateCount(el);
        });
        const heroEl = document.getElementById('heroCmdCount');
        if (heroEl) heroEl.textContent = totalStats || 0;
      })
      .catch(() => {});

    // Maintenance status check
    const mntContainer = document.createElement('div');
    mntContainer.id = 'mntBanner';
    document.body.prepend(mntContainer);

    async function checkMaintenance() {
      try {
        const res = await fetch('/dev/maintenance/status');
        const data = await res.json();
        if (data.enabled) {
          const remain = data.remainMs || 0;
          let timeStr = '';
          if (data.durationMinutes > 0) {
            const h = Math.floor(data.durationMinutes / 60);
            const m = data.durationMinutes % 60;
            timeStr = h > 0 ? h + ' ساعة و ' + m + ' دقيقة' : m + ' دقيقة';
          } else if (remain > 0) {
            const min = Math.ceil(remain / 60000);
            timeStr = min + ' دقيقة';
          } else {
            timeStr = 'غير محدد';
          }
          mntContainer.innerHTML = `
            <div class="mnt-banner">
              <div class="mnt-banner-inner">
                <div class="mnt-banner-icon"><i class="fas fa-shield-halved"></i></div>
                <div class="mnt-banner-text">
                  <div class="mnt-banner-title">FADIX9 SYSTEM Bot v1.0.11 — وضع الصيانة مفعل</div>
                  <div class="mnt-banner-desc">
                    <i class="fas fa-clock"></i> مدة الصيانة: ${timeStr} &middot; ${data.message || 'الموقع تحت الصيانة حالياً'}
                  </div>
                </div>
              </div>
            </div>
          `;
        } else {
          mntContainer.innerHTML = '';
        }
      } catch {}
    }
    checkMaintenance();
    setInterval(checkMaintenance, 30000);
  });
  </script>
</body>
</html>
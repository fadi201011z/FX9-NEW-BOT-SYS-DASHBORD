<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Kratos Dashboard — لوحة تحكم البوت</title>
<meta name="description" content="لوحة تحكم متكاملة لإدارة سيرفرك على ديسكورد — إشراف، تذاكر، غرف صوتية، حماية، وأدوات.">
<meta name="theme-color" content="#08080f">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">

<meta property="og:type" content="website">
<meta property="og:title" content="Kratos System — لوحة تحكم البوت">
<meta property="og:description" content="أدر سيرفرك، تواصل مع مجتمعك، وافتح كل الإمكانات — كل ذلك في مكان واحد.">
<meta property="og:site_name" content="Kratos System">
<meta name="twitter:card" content="summary">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&amp;family=IBM+Plex+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>
/* ═══════════════════════════════════════════════════════════════════════════
   Kratos System — landing page
   Full structural copy of novax.gg, rebuilt from measurements rather than
   copied markup. Every value below was read off that page with
   getComputedStyle / the shipped stylesheets.

   Deviations from the source, all deliberate:
     - no planet artwork. novax paints assets/images/landing/hero.svg across the
       hero; that file is not reproduced and nothing references it.
     - the footer wave is drawn with CSS radial gradients instead of their
       footer.svg.
     - copy is Arabic, set in IBM Plex Sans Arabic rather than the source's
       stack. Latin and numerals still run in IBM Plex Sans: one superfamily,
        cut for both scripts at once, so the two never disagree on shape.
   ═══════════════════════════════════════════════════════════════════════════ */

:root {
  /* sampled off novax.gg */
  --nx-purple:   #681fd1;
  --nx-purple-l: #8c5aff;
  --nx-rim:      rgba(188,146,253,.59);
  --nx-gold:     #ffd93d;
  --nx-ink:      #08080f;
  --nx-bar:      #12131c;
  --nx-panel:    #0d0d14;
  --nx-panel-2:  #14141d;
  --nx-muted:    #8890a1;
  --nx-line:     rgba(255,255,255,.08);
  --nx-line-2:   rgba(255,255,255,.06);
  --nx-fill:     rgba(255,255,255,.03);
  --nx-violet-2: #d8b4fe;
  --nx-green:    #57f287;

  --nx-card-bg: linear-gradient(rgba(255,255,255,.035), rgba(255,255,255,0) 55%), var(--nx-panel);
  --nx-panel-bg: linear-gradient(rgba(255,255,255,.03), rgba(255,255,255,0) 45%), var(--nx-panel);
}

*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  font-family: 'IBM Plex Sans', 'IBM Plex Sans Arabic', system-ui, sans-serif;
  background: var(--nx-ink);
  color: #fff;
  line-height: 1.6;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}
a { text-decoration: none; color: inherit; }
h1, h2, h3, h4, p { margin: 0; }
ul { margin: 0; padding: 0; list-style: none; }
button { font-family: inherit; }
::selection { background: rgba(104,31,209,.4); color: #fff; }

::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(104,31,209,.4); border-radius: 8px; }
::-webkit-scrollbar-thumb:hover { background: rgba(104,31,209,.65); }

.nx-wrap { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 24px; }
@media (max-width: 599.98px) { .nx-wrap { padding: 0 16px; } }

/* ─── Buttons ──────────────────────────────────────────────────────────────
   novax uses four distinct treatments. .nx-btn-p is the contained purple
   with the inset bottom rim light; .nx-btn-o the dark outlined sibling;
   .nx-btn-d the dark outlined button that still carries the purple rim, which
   is what the closing call to action uses; .nx-btn-g the gold "Plus" button,
   which carries its own sweep.

   Icons are laid out the way MUI lays them out, not with flex gap. Measured on
   the source, every one of these buttons reports gap: normal and instead
   carries a real icon box: a 30x30 flex span holding a 30x30 graphic on the
   end of the label. The single exception is the header's own call to action,
   which uses a 24x24 box on the start with margin-inline-start -4px and
   margin-inline-end 8px. Reproducing the box rather than the glyph is the
   point — the box is what sets the button's width. */
.nx-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 0;
  border: 1px solid transparent; border-radius: 11px; cursor: pointer;
  font-family: inherit; text-transform: capitalize; line-height: 1.75;
  white-space: nowrap; transition: .3s ease-out, background-color .2s, border-color .2s, transform .16s;
}
.nx-btn i { font-size: 1.05rem; }
.nx-btn .nx-ico {
  display: inline-flex; align-items: center; justify-content: center;
  width: 30px; height: 30px; font-size: 1.375rem; flex: none;
}
.nx-btn .nx-sico {
  display: inline-flex; align-items: center; justify-content: center;
  width: 24px; height: 24px; font-size: 1.05rem; flex: none;
  margin-inline-start: -4px; margin-inline-end: 8px;
}

.nx-btn-p {
  padding: 8px 22px; min-height: 48px; font-size: 15px; font-weight: 500;
  background: var(--nx-purple); color: #fff;
  border-color: var(--nx-rim);
  box-shadow: inset 0 -4px 10px 0 var(--nx-rim), 0 10px 30px rgba(104,31,209,.35);
}
.nx-btn-p:hover {
  background: #5e1cbe; border-color: #8b4dff; transform: translateY(-1px);
  filter: brightness(1.2);
}

.nx-btn-o {
  padding: 7px 21px; min-height: 46px; font-size: 15px; font-weight: 500;
  background: #181820; color: #fff; border-color: rgba(139,139,143,.26);
}
.nx-btn-o:hover { background: #201f2b; border-color: rgba(139,139,143,.5); }

/* The closing CTA's button. Measured on novax: 144x46, padding 7px 21px,
   background #181820, and a border plus inset rim that are still purple
   (rgba(188,146,253,.59)) — so it reads as the dark outlined button wearing the
   primary's rim rather than as a second contained button. */
.nx-btn-d {
  padding: 7px 21px; min-height: 46px; font-size: 15px; font-weight: 500;
  background: #181820; color: #fff; border-color: var(--nx-rim);
  box-shadow: inset 0 -4px 10px 0 var(--nx-rim);
}
.nx-btn-d:hover { background: #201f2b; border-color: #8b4dff; }

/* Trailing arrow slides on hover, matching the source's endIcon timing. */
.nx-btn i:last-child { transition: transform .2s cubic-bezier(.23,1,.32,1); }
.nx-btn:hover i:last-child { transform: translateX(-3px); }

/* The gold "Plus" item: the word in gold on nothing at all. Measured on the
   source — background transparent, color rgb(255,217,61), border 0, radius
   11px, padding 8px 16px, gap 8px, 13px/500, and a word plus an 18px trailing
   plus icon. Filling it was wrong and has been reverted: a solid pill made it
   read as a second, louder call to action sitting next to the real one.
   Everything below is the source's own values, read out of its stylesheet
   rather than guessed.

   Selector runs through .nx-nav a because the nav's own link rule (.nx-nav a,
   0-1-1) outranks a bare class (0-1-0) and was forcing the colour to white
   and the padding to the nav's. border is 0 explicitly because the shared
   .nx-btn base asks for 1px of transparent border, and the source has none. */
.nx-nav a.nx-btn-g {
  position: relative; overflow: hidden;
  padding: 8px 16px; gap: 8px; line-height: 1.4;
  border: 0; font-size: .8125rem; font-weight: 500;
  background: transparent; color: var(--nx-gold);
}
.nx-btn-g::before {
  content: ''; position: absolute; inset: 0 auto 0 0; width: 60%; height: 100%;
  background: linear-gradient(115deg, transparent, rgba(255,217,61,.35), transparent);
  transform: translateX(-150%) skewX(-20deg);
  transition: transform .6s cubic-bezier(.23,1,.32,1); pointer-events: none;
}
.nx-btn-g:hover {
  background: rgba(101,86,23,.5); transform: translateY(-1px);
  box-shadow: 0 0 0 1px rgba(255,217,61,.25), 0 6px 18px rgba(255,217,61,.18);
}
.nx-btn-g:hover::before { transform: translateX(220%) skewX(-20deg); }
.nx-btn-g:hover i { transform: scale(1.15) rotate(15deg); }
.nx-btn-g i { transition: transform .2s cubic-bezier(.23,1,.32,1); }

/* ─── Header ────────────────────────────────────────────────────────────── */
/* The bar is transparent in every scroll state, not just at the top: measured
   on novax at scrollY 0 and 3000 both give background-color rgba(0,0,0,0),
   background-image none, box-shadow none, border 0 and no backdrop-filter.
   The starfield behind the hero reads straight through it. The 82px total is
   8px of padding over the 66px bar, matching their 82px outer box and 66px
   inner container. Nothing ever toggles the background, so the .3s
   background transition that used to sit here was dead CSS. */
.nx-header {
  position: fixed; top: 0; left: 0; right: 0; z-index: 1001;
  width: 100%; padding-top: 16px; background: transparent; color: #fff;
}
/* The source is not a bar. Measured on novax, their <header> is an invisible
   full-width 82px wrapper and the visible part is a floating pill inside it:
   920x66 at left 24 and top 16, border-radius 9999px, background
   rgba(60,60,73,.3), backdrop-filter blur(10px), padding 0 24px, no border
   and no shadow.

   That pill is glass at rest, not only after a scroll, which is why there is
   no .is-stuck state here any more. The wrapper stays transparent so the pill
   is the only thing visible, and .nx-wrap already supplies their 24px inset —
   max-width 1200 with 24px padding gives exactly 920 of pill at a 968
   viewport. 16px of top padding over the 66px pill lands on the same 82px. */
.nx-header__bar {
  display: flex; align-items: center; justify-content: space-between;
  gap: 1rem; height: 66px; width: 100%; padding-inline: 24px;
  border-radius: 9999px;
  background: rgba(60,60,73,.3);
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
}
.nx-header__left { display: flex; align-items: center; gap: 1.1rem; min-width: 0; }
.nx-logo { display: inline-flex; flex-shrink: 0; width: 50px; height: 50px; }
.nx-logo img, .nx-logo svg { width: 100%; height: 100%; display: block; }
.nx-nav { display: flex; align-items: center; gap: .35rem; }
.nx-nav a {
  display: inline-flex; align-items: center; justify-content: center;
  min-width: 64px; padding: 1rem .5rem; border: 0;
  font-family: inherit; font-size: .8125rem; font-weight: 500; line-height: 0;
  text-transform: capitalize; color: #fff; border-radius: 11px;
  transition: background-color .2s;
}
.nx-nav a:hover { background: #36363d; }
.nx-header__right { display: flex; align-items: center; gap: .55rem; }
/* The header's call to action is the source's 112x42, not the hero's 146x48 —
   padding 7px 21px rather than 8px 22px. Measured on novax. */
.nx-header__right .nx-btn { padding: 7px 21px; min-height: 42px; }
.nx-lang {
  display: flex; align-items: center; gap: .5rem;
  padding: 0; border: 0; background: transparent; cursor: pointer;
  font-family: inherit; font-size: .8125rem; font-weight: 500;
  color: var(--nx-muted); border-radius: 11px; transition: color .15s;
}
.nx-lang:hover { color: #fff; }
.nx-lang i { font-size: .8rem; transition: transform .2s; }

/* ─── Hero ────────────────────────────────────────────────────────────────
   64.8px/700 IBM Plex Sans with a background-clip shine, 18px #8890a1 body at
   768px, 11px-radius buttons, two blurred radial orbs, and a wrapper that
   fades up from translateY(-10px). The planet SVG that sits behind this on
   novax is deliberately absent; the orbs replace it. */
.nx-hero {
  position: relative; z-index: 1; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  min-height: 657px; padding: 80px 0;
  width: 100%;
}
.nx-hero__glow { position: absolute; z-index: 0; pointer-events: none; border-radius: 50%; }
.nx-hero__glow--1 {
  width: 900px; height: 608px; top: 50%; left: 50%; transform: translate(-50%,-50%);
  background: radial-gradient(closest-side, rgba(104,31,209,.28), rgba(104,31,209,0) 70%);
  filter: blur(60px);
}
.nx-hero__glow--2 {
  width: 352px; height: 352px; top: 14%; right: 11%;
  background: radial-gradient(closest-side, rgba(140,90,255,.16), rgba(140,90,255,0) 70%);
  filter: blur(50px);
}
/* ─── Starfield ───────────────────────────────────────────────────────────
   The one thing on the source page that genuinely moves: a canvas of ~34
   slow-drifting white points behind the hero. Measured there — 968x724
   backing store, 0.1% of pixels lit, every particle pure white, peak alpha
   176, drifting slowly enough that two consecutive frames differ by ~40
   pixels. Those numbers drive the constants below.

   Drawn, not shipped as a bitmap, and it stands on its own: the planet image
   that shares their container is deliberately not used. */
.nx-sky {
  position: absolute; inset: 0; z-index: 0;
  width: 100%; height: 100%; pointer-events: none;
}

/* Header sparkles. Keyframes and colour lifted from the source's own
   novaSparkleTwinkle; only the duration and size are randomised per load,
   which is what keeps the three from pulsing in lockstep. */
@keyframes nxSparkle {
  0%, 100% { opacity: 0; transform: scale(.3) rotate(0deg); }
  50%      { opacity: 1; transform: scale(1) rotate(20deg); }
}
.nx-sparks { display: inline-flex; align-items: center; gap: 2px; }
.nx-spark {
  display: inline-block; color: #ffe27a; line-height: 1;
  animation: nxSparkle 3s ease-in-out infinite;
}

/* The hero copy column is 920px on novax — their Grid container inside a 968px
   viewport — with the sub copy capped at 768px inside it. Matching the measure
   matters here: at 66px type a full-bleed line is long enough that the Arabic
   breaks in a different place than the Latin did. */
.nx-hero__in {
  position: relative; z-index: 2; width: 100%;
  max-width: 920px; margin-inline: auto; text-align: center;
}
.nx-hero__row { width: 100%; animation: nxFadeUp .8s cubic-bezier(.4,0,.2,1) both; }
.nx-hero__row + .nx-hero__row { animation-delay: .1s; }
@keyframes nxFadeUp { from { opacity: 0; transform: translateY(-10px); } }

/* Size, weight, line-height and the gradient are all off novax's h1: 64.8 /
   700 / 81px and linear-gradient(to top, #555, #fff 42%, #fff) behind a
   transparent text fill.

   Tracking is not. novax measures -0.03em here, and that value is tuned for
   the Latin face they set it in — a grotesque whose letters carry real
   sidebearings and can be pinched together. Arabic is cursive: the shaper emits joined glyph
   clusters and letter-spacing is inserted between those clusters, so any
   non-zero value opens the connecting stroke. -1.98px between Arabic letters
   is not tight type, it is broken joins. Tracking therefore goes to normal on
   every Arabic run on this page, and the display tightness is rebuilt from
   word-spacing, which closes the word gaps without separating the letters.
   Latin runs keep their measured tracking. */
.nx-hero h1 {
  margin: 0 0 22px;
  font-size: clamp(2rem, 1rem + 5vw, 4.05rem);
  font-weight: 700; line-height: 1.25;
  letter-spacing: normal; word-spacing: -.05em;
  background: linear-gradient(to top, #555, #fff 42%, #fff);
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
}
.nx-hero__sub {
  margin: -20px auto 0; max-width: 768px;
  font-size: 18px; line-height: 1.334; color: var(--nx-muted);
}
.nx-hero__acts {
  display: flex; align-items: flex-end; justify-content: center;
  gap: 16px; flex-wrap: wrap; margin-top: 40px;
}

/* ─── Dashboard showcase ───────────────────────────────────────────────────
   novax drops a screenshot of their dashboard in here. Measured off their
   page: a 1160px-wide image inside a 968px wrapper with padding 70px 0, so
   the picture runs off both sides and only its content column stays on
   screen. The image itself carries no radius, no border and no shadow — the
   stacked gradient layers below are what dissolve whatever edge is left.

   The picture inside is a CSS rendering of OUR dashboard, laid out to the
   proportions read off their file: a full-width topbar carrying the brand at
   the start, a 180px sidebar, then a 2-up band of wide cards, a 3-up band of
   purple gradient tiles, and a second 3-up band. Palette is sampled from
   their pixels — page #090a11, sidebar #08090f, card #12131c, tiles running
   #3b1b73 → #2a1850 → #1c1030, brand #681fd1. */
.nx-shot { position: relative; padding: 0; overflow: hidden; }
@media (min-width: 900px) { .nx-shot { padding: 70px 0; } }
.nx-shot__bleed { position: absolute; inset: -128px; pointer-events: none; }
.nx-shot__bleed--a { background: linear-gradient(in oklab, rgba(8,8,15,.14) 0, rgba(8,8,15,.08) 50%, rgba(8,8,15,.59) 100%); }
.nx-shot__bleed--b { background: linear-gradient(to right, rgba(8,8,15,.89) 0, #08080f 50%, rgba(8,8,15,.91) 100%); }
.nx-shot__bleed--c {
  background:
    linear-gradient(to right, rgba(255,255,255,.2) 1px, transparent 1px) 0 0 / 60px 100%,
    linear-gradient(to bottom, rgba(255,255,255,.2) 1px, transparent 1px) 0 0 / 100% 60px;
  opacity: .25;
}
.nx-shot__vig {
  position: absolute; inset: 0; pointer-events: none;
  background: radial-gradient(125% 125% at 50% 10%, rgba(0,0,0,0) 40%, #09090b 100%);
}
.nx-shot__fade {
  position: absolute; inset: 0; pointer-events: none;
  background: linear-gradient(to left, #08080f 0, transparent 100%);
}
/* Centred with flex rather than auto margins: the panel is wider than this
   wrapper on a laptop, and flex overflows both edges evenly where auto
   margins would pin it to one side. The min-height is theirs — a 654px
   content box around a 466px screenshot, which lands the whole band at the
   794px the source measures. */
.nx-shot__in {
  position: relative; z-index: 1;
  display: flex; justify-content: center; align-items: center;
  max-width: none; padding-inline: 0;
}
@media (min-width: 900px) { .nx-shot__in { min-height: 654px; } }

/* the dashboard itself, drawn in CSS */
.nx-dash {
  flex: 0 0 1160px; width: 1160px;
  display: flex; flex-direction: column; overflow: hidden;
  background: #090a11; border: 0; border-radius: 0; box-shadow: none;
  text-align: start;
}
.nx-dash__bar {
  flex: 0 0 64px; display: flex; align-items: center; gap: 14px;
  padding-inline: 20px; background: #0b0c13;
  border-block-end: 1px solid var(--nx-line-2);
}
.nx-dash__brand { display: flex; align-items: center; gap: 9px; font-size: .875rem; font-weight: 700; color: #fff; }
.nx-dash__brand i {
  width: 26px; height: 26px; border-radius: 8px;
  background: linear-gradient(150deg, var(--nx-purple-l), var(--nx-purple));
  box-shadow: 0 0 18px rgba(104,31,209,.55);
}
.nx-dash__crumb { display: flex; align-items: center; gap: 8px; font-size: .75rem; color: var(--nx-muted); }
.nx-dash__crumb em {
  width: 6px; height: 6px; border-radius: 50%; font-style: normal;
  background: var(--nx-green); box-shadow: 0 0 8px rgba(87,242,135,.8);
}
.nx-dash__acts { margin-inline-start: auto; display: flex; align-items: center; gap: 10px; }
.nx-dash__acts s { width: 84px; height: 26px; border-radius: 7px; background: rgba(255,255,255,.07); text-decoration: none; }
.nx-dash__acts b { width: 30px; height: 26px; border-radius: 7px; background: var(--nx-purple); }

.nx-dash__body { flex: 1; display: flex; min-height: 0; }
.nx-dash__side {
  flex: 0 0 180px; padding: 14px 10px;
  background: #08090f; border-inline-end: 1px solid var(--nx-line-2);
  display: flex; flex-direction: column; gap: 3px;
}
.nx-dash__grp {
  padding: 12px 9px 5px; font-size: .625rem; font-weight: 700;
  letter-spacing: normal; color: #5b6270;
}
.nx-dash__link {
  display: flex; align-items: center; gap: 9px;
  padding: 6px 9px; border-radius: 7px; font-size: .75rem; color: var(--nx-muted);
}
.nx-dash__link i { width: 14px; text-align: center; font-size: .6875rem; opacity: .7; }
.nx-dash__link.is-on { background: rgba(104,31,209,.2); color: #fff; }
.nx-dash__link.is-on i { color: var(--nx-violet-2); opacity: 1; }

.nx-dash__main {
  flex: 1; min-width: 0; padding: 18px 20px 22px;
  display: flex; flex-direction: column; gap: 14px;
}
.nx-dash__head { display: flex; align-items: baseline; gap: 10px; }
.nx-dash__head b { font-size: 1rem; font-weight: 700; color: #fff; }
.nx-dash__head span { font-size: .6875rem; color: #5b6270; }

.nx-dash__wide { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.nx-dash__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
.nx-dash__card {
  padding: 14px 16px; border-radius: 12px;
  border: 1px solid var(--nx-line-2); background: var(--nx-bar);
}
.nx-dash__card u { display: block; font-size: .6875rem; color: var(--nx-muted); text-decoration: none; margin-bottom: 10px; }
.nx-dash__row { display: flex; align-items: center; gap: 9px; padding: 5px 0; }
.nx-dash__row s {
  width: 20px; height: 20px; border-radius: 6px; flex-shrink: 0;
  background: linear-gradient(135deg, #3b3b52, #23232f); text-decoration: none;
}
.nx-dash__row em { flex: 1; height: 7px; border-radius: 3px; background: rgba(255,255,255,.09); font-style: normal; }

/* the purple tile band — the one strongly saturated element in their frame */
.nx-dash__tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
.nx-dash__tile {
  position: relative; padding: 15px 16px; border-radius: 12px;
  border: 1px solid rgba(139,92,246,.24);
  background: linear-gradient(155deg, #3b1b73 0, #2a1850 52%, #1c1030 100%);
}
.nx-dash__tile u { display: block; font-size: .6875rem; color: #c9b8e8; text-decoration: none; margin-bottom: 8px; }
.nx-dash__tile b { font-size: 1.5rem; font-weight: 700; letter-spacing: -.02em; color: #fff; }
.nx-dash__tile em { display: block; margin-top: 4px; font-size: .6875rem; font-style: normal; color: var(--nx-purple-l); }
.nx-dash__tile i {
  position: absolute; inset-block-start: 14px; inset-inline-end: 14px;
  width: 30px; height: 30px; border-radius: 9px;
  display: flex; align-items: center; justify-content: center;
  background: rgba(140,90,255,.3); border: 1px solid rgba(180,150,255,.35);
  font-size: .75rem; color: #e9d5ff;
}
@media (max-width: 899.98px) {
  .nx-dash { flex-basis: 100%; width: 100%; }
  .nx-dash__side { display: none; }
  .nx-dash__wide, .nx-dash__tiles, .nx-dash__cards { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 599.98px) {
  .nx-dash__wide, .nx-dash__tiles, .nx-dash__cards { grid-template-columns: 1fr; }
  .nx-dash__acts s { display: none; }
}

/* ─── Generic section furniture ─────────────────────────────────────────────
   Every feature section is padding 100px 10px with a centred hairline rule at
   the top, a 28rem blurred orb pinned to the top-right, and the content
   sitting one layer above it. */
.nx-sec { position: relative; padding: 100px 10px; overflow-x: hidden; }
.nx-sec::before {
  content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%);
  width: min(1200px, 100% - 20px); border-top: 1px solid rgba(255,255,255,.06);
}
.nx-sec__orb {
  position: absolute; top: 6%; right: -8%; width: 28rem; height: 28rem;
  max-width: 70vw; pointer-events: none; z-index: 0;
  background: radial-gradient(closest-side, rgba(104,31,209,.16), rgba(104,31,209,0) 72%);
  filter: blur(70px);
}
.nx-sec__in { position: relative; z-index: 1; max-width: 1200px; margin-inline: auto; }
/* The banded sections carry their own 10px gutter; their inner wrapper must
   not add the 24px container padding on top of it, or the content comes out
   narrower than the source. */
.nx-sec__in.nx-wrap,
.nx-features .nx-wrap,
.nx-plugins .nx-wrap { padding-inline: 0; max-width: 1200px; }

/* novax measures -0.02em at this size; see the note on .nx-hero h1 for why an
   Arabic run takes normal tracking instead. */
.nx-sec__title {
  margin: 0 0 .75rem; font-size: 1.5rem; font-weight: 700;
  line-height: 1.2; letter-spacing: normal; word-spacing: -.03em;
  color: #fff; text-align: center;
}
.nx-sec__sub {
  font-size: .875rem; line-height: 1.334em; color: var(--nx-muted);
  text-align: center; margin: 0 auto .75rem; width: 600px; max-width: 100%;
  text-wrap: balance;
}
@media (min-width: 900px) {
  .nx-sec__title { font-size: 2.75rem; }
  .nx-sec__sub { font-size: 1.125rem; }
}

/* 12-column row helper — the source uses MUI Grid with a 24px gutter.
   Below the md breakpoint every cell goes full width, same as MUI's default. */
.nx-row { display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 1.5rem; width: 100%; }
@media (min-width: 900px) { .nx-row { gap: 24px; } }
.nx-row--end { flex-direction: row-reverse; }
.nx-row > .nx-col-4,
.nx-row > .nx-col-6,
.nx-row > .nx-col-8,
.nx-row > .nx-col-12 { width: 100%; }
@media (min-width: 900px) {
  .nx-row > .nx-col-4  { width: calc(100% * 4 / 12 - (24px * 8 / 12)); }
  .nx-row > .nx-col-6  { width: calc(100% * 6 / 12 - (24px * 6 / 12)); }
  .nx-row > .nx-col-8  { width: calc(100% * 8 / 12 - (24px * 4 / 12)); }
  .nx-row > .nx-col-12 { width: 100%; }
}
.nx-row > * { min-width: 0; box-sizing: border-box; }

/* ─── Card ──────────────────────────────────────────────────────────────────
   Two near-identical shells on the source: .mui-1ip3kb8 (full-width band,
   48px padding) and .mui-1ocz0j1 (grid cell, 40px padding, height 100%). */
.nx-card {
  position: relative; overflow: hidden; height: 100%;
  border-radius: 20px; border: 1px solid var(--nx-line);
  background: var(--nx-panel-bg);
  padding: 32px 24px;
}
@media (min-width: 900px) { .nx-card { padding: 40px; } }
.nx-card--band { margin-bottom: 1.5rem; }
@media (min-width: 900px) { .nx-card--band { padding: 48px; } }

.nx-card__head { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
.nx-card__icon {
  display: inline-flex; align-items: center; justify-content: center;
  flex-shrink: 0; width: 32px; height: 32px; border-radius: 9px;
  border: 1px solid rgba(188,146,253,.28); color: var(--nx-violet-2);
}
.nx-card__icon i { font-size: .95rem; }
.nx-card h3 {
  margin: 0; font-size: 1.15rem; font-weight: 600; line-height: 1.167; color: #fff;
}
.nx-card__desc {
  margin: 0; font-size: .875rem; line-height: 1.334em;
  color: var(--nx-muted); max-width: 38rem; text-align: start;
}
.nx-card__mock { margin-top: 22px; }

/* ─── Split cards ────────────────────────────────────────────────────────────
   The Utility & automation band is the one place the source stands the copy
   and its mock side by side rather than stacking them, and the heading runs
   larger there (30.4px rather than 18.4px) with no icon beside it. The shell
   is untouched — same 48px padding, #0d0d14, radius 20px — so inside it sits
   a 32px flex row with justify-content: space-between and align-items: center,
   flipping to row-reverse on the second and fourth card to move the mock to
   the opposite side. Under RTL the flip mirrors on its own, which is the same
   design read the other way round. */
.nx-card--split { margin-bottom: 1.5rem; }
.nx-card--split > .nx-card__row > .nx-card__copy > h3 {
  margin: 0 0 8px; font-size: 1.9rem; font-weight: 600; line-height: 1.167;
}
@media (min-width: 900px) {
  .nx-card--split { padding: 48px; }
  .nx-card--split > .nx-card__row {
    display: flex; gap: 32px; align-items: center; justify-content: space-between;
  }
  .nx-card--split--flip > .nx-card__row { flex-direction: row-reverse; }
  .nx-card--split .nx-card__copy { flex: 0 1 368px; min-width: 0; }
  .nx-card--split .nx-card__mock { flex: 0 1 auto; min-width: 0; margin-top: 0; }
}
@media (max-width: 899px) {
  .nx-card--split > .nx-card__row { display: block; }
  .nx-card--split .nx-card__copy > .nx-card__desc { max-width: none; }
}

/* The panel on the mock side: 20px padding, 10px between rows, and rows that
   are inset surfaces (rgba(255,255,255,.03) inside a 1px .06 border at radius
   10px) rather than the flat strips the stacked cards use. Content width, not
   stretched — the source sizes these panels to what they hold. */
.nx-mock--flow {
  display: flex; flex-direction: column;
  width: fit-content; min-width: 420px; max-width: 100%;
  padding: 20px; gap: 10px;
}
.nx-mock__lbl {
  display: flex; align-items: center; gap: 8px;
  font-size: .875rem; font-weight: 500; color: #e8ddff;
}
.nx-mock__lbl i { font-size: .8125rem; }
.nx-inset {
  display: flex; align-items: center; gap: 8px;
  padding: 10px 14px; border-radius: 10px;
  border: 1px solid var(--nx-line-2); background: var(--nx-fill);
}
.nx-inset i { color: var(--nx-muted); font-size: .8125rem; }
.nx-inset__k { flex-shrink: 0; font-size: .8125rem; color: var(--nx-muted); }
.nx-inset__v { font-size: .8125rem; color: #fff; }
.nx-inset__act {
  margin-inline-start: auto; flex-shrink: 0; padding: 3px 12px; border-radius: 999px;
  background: rgba(104,31,209,.22); color: var(--nx-violet-2);
  font-size: .75rem; font-weight: 600;
}
.nx-arrow { display: flex; align-items: center; justify-content: center; color: #a78bd6; font-size: .8125rem; }
.nx-out {
  display: flex; align-items: center; gap: 10px;
  font-size: .8125rem; color: #fff;
}
.nx-out__who { font-weight: 700; }
.nx-out__line { color: var(--nx-muted); }
.nx-pairs { display: flex; align-items: center; gap: 16px; font-size: .8125rem; color: #fff; }
.nx-pairs span { display: inline-flex; align-items: center; gap: 6px; }
.nx-pairs i { color: var(--nx-muted); font-size: .75rem; }
.nx-tags { display: flex; align-items: center; gap: 8px; font-size: .8125rem; color: #fff; }
.nx-tags span {
  padding: 4px 11px; border-radius: 999px;
  border: 1px solid var(--nx-line-2); background: var(--nx-fill);
}

/* Trigger grid on the automation card. Two columns 16px apart; each cell pads
   12px vertically so the rules between rows come from the row gap, and the
   heading is a 16px/600 weight over a 14px body in the muted grey. */
.nx-trg {
  display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px; margin: 32px 0 0; padding: 0; list-style: none;
}
.nx-trg__c { padding: 12px 0; min-width: 0; }
.nx-trg__h { display: flex; align-items: center; gap: 5px; }
.nx-trg__h i { flex-shrink: 0; width: 24px; height: 24px; color: var(--nx-violet-2); font-size: .8125rem; }
.nx-trg__h h4 {
  margin: 0; font-size: 1rem; font-weight: 600; line-height: 1.235; color: #fff;
}
.nx-trg__c p {
  margin: 12px 0 0; font-size: .875rem; line-height: 1.334; color: var(--nx-muted);
}

/* Orbit graphic standing in for the automation flow illustration: the same
   450x364 footprint and the same concentric-ring silhouette, drawn here in CSS
   with our palette rather than lifted from the source's artwork. Each trigger
   is a transparent square of a given diameter, centred and then rotated, with
   the dot parked at its top edge — so the dot sits at that angle on a circle
   whose size tracks the box, and turning the square walks the dot round it. */
.nx-orbit {
  position: relative; width: 450px; max-width: 100%; aspect-ratio: 450 / 364;
  display: grid; place-items: center;
}
.nx-orbit__ring {
  position: absolute; top: 50%; left: 50%; border-radius: 50%;
  translate: -50% -50%;
  border: 1px solid rgba(168,85,247,.22);
}
.nx-orbit__ring--3 { width: 100%; height: 100%; }
.nx-orbit__ring--2 { width: 72%; height: 72%; border-color: rgba(168,85,247,.3); }
.nx-orbit__ring--1 { width: 44%; height: 44%; border-color: rgba(168,85,247,.4); }
.nx-orbit__hub {
  position: relative; display: grid; place-items: center;
  width: 74px; height: 74px; border-radius: 50%;
  background: radial-gradient(circle, rgba(104,31,209,.42), rgba(104,31,209,0) 72%);
  color: var(--nx-violet-2); font-size: 1.5rem;
}
/* translate and rotate are separate properties and translate is applied first,
   so the square is centred before it turns — putting both on `transform` would
   rotate the element and then shove it sideways along the rotated axes. */
.nx-orbit__dot {
  position: absolute; top: 50%; left: 50%;
  width: var(--r); aspect-ratio: 1;
  translate: -50% -50%; rotate: var(--a);
  display: grid; place-items: start center;
  pointer-events: none;
}
.nx-orbit__dot i {
  width: 11px; height: 11px; margin-top: -5.5px; border-radius: 50%;
  background: var(--nx-violet-2); box-shadow: 0 0 0 4px rgba(168,85,247,.16);
}
@media (prefers-reduced-motion: no-preference) {
  .nx-orbit__dot { animation: nxOrbit 40s linear infinite; }
}
@media (max-width: 479.98px) {
  /* The 420px floor on .nx-mock--flow has to go before the card is narrower
     than it: min-width outranks max-width, so the floor would push the panel
     past the card edge rather than being clamped. A percentage cannot rescue
     it either — 100% there resolves against a shrink-to-fit flex item and
     comes back indeterminate. */
  .nx-mock--flow { min-width: 0; }
  .nx-trg { grid-template-columns: minmax(0, 1fr); }
}
@keyframes nxOrbit {
  from { rotate: var(--a); }
  to   { rotate: calc(var(--a) + 360deg); }
}

/* ─── Mockup primitives ────────────────────────────────────────────────────
   The Discord-shaped panels inside the cards. Every one of these numbers was
   read off the source: panel #14141d at 16px, rows at 10px, the purple badge
   at rgba(104,31,209,.22), online dots #57f287 with a 2px panel-coloured
   ring, and skeleton bars at rgba(255,255,255,.12). */
.nx-mock {
  border: 1px solid var(--nx-line); border-radius: 16px;
  background: var(--nx-panel-2); overflow: hidden;
}
.nx-mock--msg { border-radius: 12px; }
.nx-mock__hd {
  display: flex; align-items: center; gap: 9px;
  padding: 13px 16px; border-bottom: 1px solid var(--nx-line-2);
  font-size: .875rem; font-weight: 600; color: #fff;
}
.nx-mock__hd i { color: var(--nx-violet-2); font-size: .9rem; }
.nx-mock__body { padding: 14px 16px; display: flex; flex-direction: column; gap: 9px; }

.nx-row-i {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 12px; border-radius: 10px;
  border: 1px solid var(--nx-line-2); background: var(--nx-fill);
  font-size: .8125rem; color: #d7dae0;
}
.nx-row-i > i:first-child { color: var(--nx-muted); font-size: .85rem; width: 16px; text-align: center; }
.nx-row-i__name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nx-row-i__end { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }

.nx-av {
  width: 22px; height: 22px; border-radius: 50%; flex-shrink: 0;
  background: linear-gradient(135deg, #4b3a72, #241a3d);
  border: 2px solid var(--nx-panel-2);
}
.nx-av--lg { width: 38px; height: 38px; }
.nx-av--bot { background: linear-gradient(135deg, var(--nx-purple), #2a1055); display:flex; align-items:center; justify-content:center; font-size:.7rem; color:#fff; }
.nx-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--nx-green); flex-shrink: 0; }
.nx-stack { display: flex; }
.nx-stack .nx-av + .nx-av { margin-inline-start: -7px; }
.nx-stack .nx-av { width: 18px; height: 18px; }

.nx-pill {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 3px 10px; border-radius: 999px; font-size: .6875rem; font-weight: 600;
  background: rgba(104,31,209,.22); border: 1px solid rgba(188,146,253,.32);
  color: var(--nx-violet-2); white-space: nowrap;
}
.nx-pill--dim { background: rgba(255,255,255,.06); border-color: var(--nx-line); color: var(--nx-muted); }
.nx-pill--warn { background: rgba(255,217,61,.14); border-color: rgba(255,217,61,.32); color: var(--nx-gold); }
.nx-pill--ok   { background: rgba(87,242,135,.12); border-color: rgba(87,242,135,.3); color: var(--nx-green); }

.nx-bar { height: 8px; border-radius: 999px; background: rgba(255,255,255,.08); overflow: hidden; }
.nx-bar__fill {
  height: 100%; border-radius: 999px;
  background: linear-gradient(90deg, var(--nx-purple), var(--nx-purple-l));
}
.nx-line { height: 8px; border-radius: 3px; background: rgba(255,255,255,.12); }
.nx-line--w70 { width: 70%; } .nx-line--w45 { width: 45%; } .nx-line--w30 { width: 30%; }

.nx-meter { display: flex; align-items: center; gap: 14px; }
.nx-meter__ring {
  width: 54px; height: 54px; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: conic-gradient(var(--nx-purple) 0 72%, rgba(255,255,255,.08) 72% 100%);
  position: relative;
}
.nx-meter__ring::after {
  content: ''; position: absolute; inset: 6px; border-radius: 50%; background: var(--nx-panel-2);
}
.nx-meter__ring b { position: relative; z-index: 1; font-size: .8125rem; font-weight: 700; color: #fff; }
.nx-meter__meta { flex: 1; display: flex; flex-direction: column; gap: 7px; min-width: 0; }

/* Role chips. Measured on the source: 46px tall pills at padding 9px 16px
   9px 10px, 8px between the emoji, the label and the tick, bordered
   1px rgba(188,146,253,.4), labels 13px/600 at #e5e7eb, 10px apart in the
   wrap. Two of the five are picked — the first and the third — carrying
   rgba(104,31,209,.16) and a tick; the rest sit at rgba(255,255,255,.03).
   The hint above them is 12.5px/400 at #8890a1 on the source, and the panel
   is 560px wide, centred in the band card exactly as the source centres its
   560px panel in an 852px content box. */
.nx-role__hint { font-size: .78125rem; color: var(--nx-muted); }
.nx-mock--role { max-width: 560px; margin-inline: auto; }
.nx-chipset { display: flex; flex-wrap: wrap; gap: 10px; }
.nx-chip {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 9px 16px 9px 10px; border-radius: 999px;
  font-size: .8125rem; font-weight: 600;
  background: rgba(255,255,255,.03); border: 1px solid rgba(188,146,253,.4);
  color: #e5e7eb;
}
.nx-chip--on { background: rgba(104,31,209,.16); }
.nx-chip__emo {
  display: inline-flex; align-items: center; justify-content: center;
  width: 26px; height: 26px; flex-shrink: 0; font-size: 1.05rem;
}
.nx-chip > i { color: var(--nx-violet-2); font-size: .75rem; }

/* ── Command list: /ban etc ─────────────────────────────────────────────────
   Measured on the source. The rows there are not pills and the command is not
   in a badge: a flat strip 466x56 inside a body padded 6px with no gap
   between rows, radius 8px, no border, and no background of its own except
   the selected row at rgba(104,31,209,.16). Each row is a 30x30 icon at
   #d8b4fe followed by a column with the command at 13px/700 over its
   description at 11.5px/400, the two separated by 1px.

   What was here before was a monospace slash badge on one line with the
   description beside it, which is why it read as a code sample rather than a
   command palette. max-width 480px with auto margins because the source
   centres a 480px panel in a 500px slot inside its 948px band, while this
   panel was stretched across the whole card. */
.nx-mock--cmd { max-width: 480px; margin-inline: auto; }
.nx-mock--cmd .nx-mock__body { padding: 6px; }
.nx-cmd { display: flex; flex-direction: column; }
.nx-cmd__row {
  display: flex; align-items: center; gap: 12px;
  padding: 9px 10px; border-radius: 8px; background: transparent;
  font-size: .8125rem;
}
.nx-cmd__row--on { background: rgba(104,31,209,.16); }
.nx-cmd__ico {
  display: inline-flex; align-items: center; justify-content: center;
  width: 30px; height: 30px; flex-shrink: 0; border-radius: 8px;
  color: var(--nx-violet-2);
}
.nx-cmd__col { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.nx-cmd__name { font-size: .8125rem; font-weight: 700; color: #fff; }
/* direction:ltr so the leading slash survives bidi — inside the RTL page it
   would otherwise flip to "ban/". text-align:right, not left, so the command
   still sits against the icon on the same edge as the Arabic line under it. */
.nx-cmd__name { direction: ltr; text-align: right; }
.nx-cmd__desc { font-size: .71875rem; line-height: 1.3; color: var(--nx-muted); }

/* embed preview (the blue-bar Discord embed look, in brand purple) */
.nx-embed {
  border-radius: 10px; border: 1px solid var(--nx-line-2);
  background: var(--nx-fill); padding: 13px 15px;
  border-inline-start: 4px solid var(--nx-purple);
}
.nx-embed__tag {
  display: inline-block; font-size: .625rem; font-weight: 700;
  letter-spacing: normal; color: var(--nx-muted); margin-bottom: 7px;
}
.nx-embed__t { font-size: .9375rem; font-weight: 700; color: #fff; margin-bottom: 4px; }
.nx-embed__d { font-size: .8125rem; color: var(--nx-muted); }
.nx-embed__f { display: flex; align-items: center; gap: 7px; margin-top: 9px; font-size: .6875rem; color: #6b7280; }
.nx-embed__f .nx-av { width: 16px; height: 16px; border-width: 0; }

/* message bubble (welcome card) */
.nx-msg { display: flex; gap: 11px; }
.nx-msg__col { flex: 1; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.nx-msg__hd { display: flex; align-items: center; gap: 8px; font-size: .8125rem; }
.nx-msg__hd b { color: #fff; font-weight: 600; }
.nx-msg__hd span { font-size: .6875rem; color: #6b7280; }
.nx-msg__bot { background: rgba(104,31,209,.16); color: var(--nx-violet-2); padding: 0 4px; border-radius: 3px; font-size: .625rem; font-weight: 700; }

/* tictactoe grid */
.nx-ttt { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; width: 150px; }
.nx-ttt span {
  aspect-ratio: 1; display: flex; align-items: center; justify-content: center;
  border-radius: 9px; background: var(--nx-fill); border: 1px solid var(--nx-line-2);
  font-size: 1.05rem; font-weight: 700; color: var(--nx-violet-2);
}
.nx-ttt span.w { color: var(--nx-green); }

/* Colour panel. Measured on the source: the colours are not a wrapping row of
   squares. The panel stacks a preview strip over a vertical list, 10px apart,
   and each list row is a 12px round dot plus the name at 12.5px, 35px tall,
   with the selected row carrying rgba(104,31,209,.16), its name lifted to
   #e5e7eb and a tick appearing at #d8b4fe. The list rows are square-cornered —
   only the list itself clips them — so the selected colour reads as a
   full-width band rather than a floating pill. The five hexes were already
   right. */
.nx-sw__preview, .nx-sw__row {
  display: flex; align-items: center; gap: 8px;
  padding: 9px 12px; border-radius: 8px; background: rgba(255,255,255,.03);
}
.nx-sw__preview .nx-sw__dot { width: 14px; height: 14px; }
.nx-sw__preview > span:nth-child(2) { flex: 1; font-size: .8125rem; font-weight: 600; color: #e5e7eb; }
.nx-sw__preview > i { color: var(--nx-muted); font-size: .8rem; }
.nx-sw__dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; }
.nx-mock--sw .nx-mock__body { gap: 10px; }
.nx-sw__list { display: flex; flex-direction: column; border-radius: 8px; overflow: hidden; }
.nx-sw__row { padding: 8px 12px; gap: 10px; background: transparent; border-radius: 0; }
.nx-sw__row--on { background: rgba(104,31,209,.16); }
.nx-sw__row > span:nth-child(2) { flex: 1; font-size: .78125rem; color: var(--nx-muted); }
.nx-sw__row--on > span:nth-child(2) { color: #e5e7eb; }
.nx-sw__row > i { color: var(--nx-violet-2); font-size: .75rem; }

/* ─── Analytics band ───────────────────────────────────────────────────────
   The one section that is not built from cards: a copy column carrying a
   2x2 tile grid, beside a two-series line chart. */
.nx-an { display: grid; grid-template-columns: 1fr; gap: 24px; align-items: center; }
@media (min-width: 900px) { .nx-an { grid-template-columns: 445px 1fr; gap: 34px; } }
.nx-an__copy { font-size: .875rem; line-height: 1.334em; color: var(--nx-muted); margin: 0 0 18px; }
.nx-an__chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
.nx-an__tiles { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px 20px; }
.nx-an__tile i { display: block; font-size: 1.15rem; color: #fff; margin-bottom: 9px; }
.nx-an__tile p { margin: 0; font-size: .875rem; line-height: 1.334; color: var(--nx-muted); }
.nx-an__chart { width: 100%; height: auto; overflow: hidden; }
.nx-an__legend { display: flex; gap: 18px; justify-content: center; margin-top: 6px; }
.nx-an__legend span { display: inline-flex; align-items: center; gap: 7px; font-size: .6875rem; color: var(--nx-muted); }
.nx-an__legend s { width: 12px; height: 12px; border-radius: 3px; text-decoration: none; }

/* ─── Features band ──────────────────────────────────────────────────────── */
.nx-features { position: relative; padding: 0 10px 100px; overflow-x: hidden; scroll-margin-top: 110px; }
/* The source's features band opens flush with its section top — there is no
   padding above the first row. All the space below comes from an 80px margin
   inside the grid plus the section's own 100px padding-bottom. */
.nx-features__pad { padding: 0; }
.nx-features__grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 20px; margin-bottom: 80px;
}
.nx-fcard {
  position: relative; padding: 28px 24px; border-radius: 16px;
  border: 1px solid var(--nx-line); background: var(--nx-card-bg);
  transition: transform .3s;
}
.nx-fcard:hover { transform: translateY(-4px); }
.nx-fcard__icon {
  display: inline-flex; align-items: center; justify-content: center;
  width: 44px; height: 44px; flex-shrink: 0; border-radius: 12px; margin-bottom: 1rem;
  background: radial-gradient(120% 120% at 30% 20%, rgba(188,146,253,.28), rgba(104,31,209,.08));
  border: 1px solid rgba(188,146,253,.28); color: var(--nx-violet-2); font-size: 1.1rem;
}
.nx-fcard h3 {
  margin: 0 0 .5rem; font-size: 1rem; font-weight: 700; line-height: 1.2;
  word-break: break-word; color: #fff;
}
.nx-fcard p { margin: 0; font-size: .875rem; line-height: 1.334em; color: var(--nx-muted); text-wrap: balance; }

/* ─── Plugins band ─────────────────────────────────────────────────────────
   A 28rem box masked to a soft radial so three icon strips bleed off both
   edges, with the mark sitting on a 64px plate in the middle. Heading and
   sub sit below it at the source's 48px / 16px rhythm. */
.nx-plugins { position: relative; padding: 128px 10px; overflow-x: hidden; }
.nx-plugins__pad { padding: 0; }
.nx-plugins__box {
  position: relative; overflow: hidden;
  display: flex; flex-direction: column; justify-content: space-between;
  gap: 40px; margin-inline: auto;
  width: 100%; max-width: 28rem; height: 224px;
  background: color-mix(in srgb, #181820 25%, transparent);
  -webkit-mask-image: radial-gradient(50% 50%, #000 70%, transparent 100%);
  mask-image: radial-gradient(50% 50%, #000 70%, transparent 100%);
}
/* ── Plugin marquee ───────────────────────────────────────────────────────
   The three icon strips above the heading scroll continuously. Measured on
   the source: each row is a 448px window over a track that overflows it
   (984 / 840 / 984px), items are fixed 48px boxes with a 24px gap, and the
   strip is faded by the box mask rather than clipped by the row.

   --set is one full set of icons. Script appends a second copy to the
   track, so travelling one set plus one gap lands that copy precisely where
   the original started. The gap has to be inside the travel distance: it used
   to travel exactly --set, which parked the 24px gap under the window at the
   top of every loop and produced a 24px jump once per cycle.

   Direction is set with animation-direction, never with a negative --travel,
   and that is not a style preference. This row is RTL, so the track's inline
   start sits at the row's right edge and the track overflows to the left:
   measured, the row spans 294..742 and the track -1250..742. Writing local u
   for distance leftward from the track's right edge, an icon at u is drawn at
   row-right - u + T, so the 448px window shows exactly u in [T, T+448].

   That means a negative T asks for content at negative u, which is off the
   front of the track and does not exist. Animating the middle strip to
   translateX(-864) therefore empties the window outright: sampled at 55%
   through, zero of its 24 icons were on screen. A third copy of the icons
   would not help either, because the missing content is at u < 0 while every
   copy of the track sits at u > 0.

   So T has to stay inside [0, travel] for all three strips, and the direction
   has to come from how the keyframes are played. Normal playback walks
   0 -> travel, which reads rightward; reverse playback walks travel -> 0, which
   reads leftward while still never going negative. --dir picks between them.

   --dur is set per row so that every strip covers the same ground per second
   (~24 px/s) despite the travel distances being 1008 / 864 / 1008. Matching
   the speed rather than the duration is what makes them read as one system. */
.nx-plugins__row {
  display: flex; align-items: center;
  height: 48px; flex-shrink: 0; white-space: nowrap; overflow: hidden;
}
.nx-plugins__track {
  --gap: 24px;
  --travel: calc(var(--set) + var(--gap));
  display: flex; align-items: center; gap: var(--gap);
  width: max-content; flex-shrink: 0;
  animation: nxMarquee var(--dur) linear infinite;
  animation-direction: var(--dir, normal);
}
.nx-plugins__track > i {
  flex: 0 0 48px; width: 48px; height: 48px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.5rem; color: #6d7382;
}
@keyframes nxMarquee {
  from { transform: translateX(0); }
  to   { transform: translateX(var(--travel)); }
}
/*             set     dur     dir        travel  px/s  reads */
.nx-plugins__row:nth-child(1) { --set: 984px; --dur: 42s;                 } /* 1008  24.00  right */
.nx-plugins__row:nth-child(2) { --set: 840px; --dur: 36s; --dir: reverse; } /*  864  24.00  left  */
.nx-plugins__row:nth-child(3) { --set: 984px; --dur: 42s;                 } /* 1008  24.00  right */
.nx-plugins__mark {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  width: 64px; height: 64px; border-radius: 18px;
  display: flex; align-items: center; justify-content: center;
  background: rgba(104, 31, 209, .6);
}
.nx-plugins__mark svg { width: 35px; height: 25px; }
.nx-plugins h2 {
  margin: 48px 0 16px; font-size: 2.125rem; font-weight: 700;
  line-height: 1.167; color: #fff; text-align: center;
}
.nx-plugins p {
  margin: 0 auto 48px; width: 600px; max-width: 100%;
  font-size: .875rem; line-height: 1.334em; color: var(--nx-muted);
  text-align: center; text-wrap: balance;
}
@media (min-width: 900px) { .nx-plugins p { font-size: 1.125rem; } }

/* ─── CTA + Footer ───────────────────────────────────────────────────────── */
/* The source runs a -100px bottom margin on both the closing call to action and
   the wave, which is what makes the footer ride up into the foot of the glow
   instead of starting below it. Reproduced, including the clip that keeps the
   bleed off the horizontal axis.

   clip rather than hidden matters here: hidden on one axis forces the other to
   auto, which turns this section into a scroll container and the negative
   margins would be swallowed by it. The hidden line stays as the fallback for
   anything that does not understand clip. */
.nx-cta {
  position: relative; padding: 100px 0 0;
  overflow-x: hidden; overflow-x: clip;
}
.nx-cta__top { padding-bottom: 0; margin-bottom: -100px; }
/* 56px / 1.3 = 72.8px and letter-spacing normal, all measured off novax's
   equivalent CTA heading. Their value here is already normal, so this one
   matches the source exactly.

   Their heading is a flat 56px, not a clamp — a clamp was reading 45.9px at a
   1036px viewport, which made the whole band 66px shorter than theirs. Below
   900px it steps down by hand instead, so the desktop value is the measured
   one and not whatever the viewport happens to divide down to. */
.nx-cta__title {
  font-size: 2rem; font-weight: 700; line-height: 1.3;
  letter-spacing: normal; word-spacing: -.04em; color: #fff; text-align: center;
  margin-bottom: .85rem;
}
@media (min-width: 900px) { .nx-cta__title { font-size: 3.5rem; } }
.nx-cta__title span {
  background: linear-gradient(to top, #555, #fff 42%, #fff);
  -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
}
.nx-cta__acts { display: flex; justify-content: center; margin-bottom: 0; }

/* the CSS redraw of novax's footer.svg — a purple wave, no planet */
.nx-wave {
  position: relative; height: 400px; margin-bottom: -100px;
  overflow: hidden; pointer-events: none;
  -webkit-mask-image: radial-gradient(70% 100% at 50% 100%, #000 40%, transparent 100%);
  mask-image: radial-gradient(70% 100% at 50% 100%, #000 40%, transparent 100%);
}
.nx-wave::before, .nx-wave::after {
  content: ''; position: absolute; left: 50%; transform: translateX(-50%);
  border-radius: 50%;
}
.nx-wave::before {
  width: 1500px; height: 620px; top: 90px;
  background: radial-gradient(closest-side, rgba(104,31,209,.42), rgba(104,31,209,0) 70%);
  filter: blur(70px);
}
.nx-wave::after {
  width: 1100px; height: 420px; top: 210px;
  background: radial-gradient(closest-side, rgba(196,156,255,.22), rgba(196,156,255,0) 72%);
  filter: blur(60px);
}

/* ─── Footer ─────────────────────────────────────────────────────────────────
   Measured on the source, and it is not the four-column link farm this used
   to be. There the about block is a narrow 25% column carrying the heading,
   the paragraph at 14px/21px in rgba(255,255,255,.6) and the language control
   16px beneath it — the language switch is part of the about column, not a
   fourth link module. The three link modules sit to the right, 16px apart,
   each headed by a 20px/700 h3 with its list 16px below, and the items are
   12.8px/400 rather than 14px, 20px apart.

   The copyright is not centred text either: a 2px #141422 rule at radius 50px
   and opacity .6 spanning the column, then the notice at 12.8px/19.2px on the
   left with 40px circular social buttons on the right. */
/* The source frames its footer, and the frame is the whole trick: a 2px
   transparent border carrying two background layers that are clipped
   differently.

   The upper layer is clipped to padding-box and runs from almost clear at the
   top to #0f0f19 by 55%, which is what gives the footer a body colour one step
   lighter than the page. The lower layer is clipped to border-box, so the only
   part of it that is ever visible is the 2px band the transparent border leaves
   free — a purple rim, brightest across the top and fading down the sides,
   because its own gradient reaches transparent at 47% of the height.

   Corners are 28px at the top and square at the bottom, where the footer meets
   the end of the page. The 2px border also pulls the content 2px in, which is
   what puts the grid at x26 rather than x24 — the source's measured inset. */
.nx-footer {
  position: relative; z-index: 1;
  padding-top: 80px;
  border: 2px solid transparent;
  border-bottom: 0;
  border-radius: 28px 28px 0 0;
  background-origin: padding-box, border-box;
  background-clip: padding-box, border-box;
  background-image:
    linear-gradient(rgba(247, 33, 33, .01) -52%, #0f0f19 55%),
    linear-gradient(#681fd1 -9%, rgba(0, 0, 0, 0) 47%);
}
/* align-items: start is the source's own setting on this row and it matters:
   the link modules stop at their content height instead of being stretched down
   to the about column, which is roughly 155px taller and leaves that much air
   beneath them. Stretching them left the columns reading as one solid block.

   The two columns are flush, not guttered, and they are inset 39px inside the
   container on top of its own 24px. Both measured: on the source the about
   column runs 65..300 and the link area 300..927 inside a grid that starts at
   26, so the columns touch and the whole thing sits 39px in from the page
   gutter. The split is 235:627 of that 862, which is why the columns are
   27/73 rather than the 25/75 the grid spans suggest. */
.nx-foot__grid { display: grid; grid-template-columns: 1fr; gap: 40px; align-items: start; }
@media (min-width: 900px) {
  .nx-foot__grid { grid-template-columns: 27.26% 72.74%; gap: 0; padding-inline: 39px; }
}
/* ---------------------------------------------------------------- about card
   The about column is a frosted card with neon dividers rather than bare text
   on the page. The ambient bloom is done with box-shadow and an inset radial
   wash instead of a blurred pseudo-element on a negative inset, because that
   would need overflow: hidden to clip — and overflow: hidden here would also
   swallow the language menu, which hangs below the card. */

.nx-foot__about {
  position: relative;
  padding: 22px 20px 20px;
  border-radius: 16px;
  border: 1px solid rgba(139, 92, 246, .17);
  background: rgba(18, 13, 36, .62);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  box-shadow:
    0 0 26px rgba(124, 58, 237, .26),
    0 0 64px rgba(59, 130, 246, .14),
    0 22px 50px rgba(0, 0, 0, .5),
    inset 0 1px 0 rgba(255, 255, 255, .045);
}
.nx-foot__about::before {
  content: "";
  position: absolute; inset: 0; z-index: 0;
  border-radius: inherit;
  background:
    radial-gradient(120% 62% at 82% -8%, rgba(139, 92, 246, .30), transparent 62%),
    radial-gradient(110% 55% at 10% 108%, rgba(59, 130, 246, .20), transparent 64%);
  pointer-events: none;
}
/* Lift the content above the wash. The language menu is a child of .nx-lang, so
   it inherits this stacking context and still escapes the card — there is no
   clipping here to trap it. */
.nx-foot__about > * { position: relative; z-index: 1; }

/* The heading is a row: mark, then 5px, then the word, over a neon divider. */
.nx-foot__head {
  position: relative; /* anchors the ::after divider */
  display: flex; align-items: center; gap: 5px; padding-bottom: 15px;
}
.nx-foot__head svg { width: 25px; height: 25px; flex: none; display: block; }
.nx-foot__about h3 {
  margin: 0; font-size: 1.25rem; font-weight: 700;
  line-height: 1.167; color: #fff;
}
.nx-foot__about p {
  margin: 16px 0 0; font-size: .875rem; line-height: 21px;
  color: rgba(255,255,255,.62);
}

/* Two dividers: one closing the heading, one opening the language row. Both
   fade out at the ends so they read as light leaking sideways rather than as
   rules, and both carry their own bloom. */
.nx-foot__head::after,
.nx-foot__about .nx-lang::before {
  content: "";
  position: absolute;
  inset-inline: 0;
  height: 1px;
  background: linear-gradient(90deg,
    transparent, rgba(139, 92, 246, .85) 20%, rgba(59, 130, 246, .8) 55%, transparent);
  box-shadow: 0 0 10px rgba(139, 92, 246, .5), 0 0 20px rgba(59, 130, 246, .28);
  pointer-events: none;
}
.nx-foot__head::after { bottom: 0; }
.nx-foot__about .nx-lang::before { top: 0; }
.nx-foot__about .nx-lang { margin-top: 18px; padding-top: 18px; }

/* The three modules are fixed-basis and pushed to the far end of their column,
   which is what the source does — its own stylesheet sets justify-content on
   this row, leaving about a fifth of the column empty between the about text
   and the first module. Spreading them across the full width, as this used to,
   erased that gap and is the single biggest reason the two did not match.

   flex-end is the right value to carry over: in their LTR it reads as the right
   edge, and RTL flips it to the left, which is the same position mirrored. */
.nx-foot__links { display: flex; flex-wrap: wrap; gap: 16px; justify-content: flex-end; }
.nx-foot__mod { flex: 0 1 145px; min-width: 0; }
@media (max-width: 899.98px) {
  .nx-foot__links { justify-content: flex-start; }
  .nx-foot__mod { flex: 1 1 132px; }
}
.nx-foot__mod h3 { margin: 0 0 16px; font-size: 1.25rem; font-weight: 700; line-height: 1.167; color: #fff; }
.nx-foot__mod ul { display: flex; flex-direction: column; gap: 20px; margin: 0; padding: 0; list-style: none; }
/* display: block is load-bearing. Left inline, the anchor's own 17.0752px line
   height loses to the li's strut (16px * 1.6 = 25.6px), so every row came out
   26px tall and the modules read 25px deeper than the source's 131px. The
   source gets the same result by putting a block-level p inside the anchor. */
.nx-foot__mod a { display: block; font-size: .8rem; line-height: 1.334; color: rgba(255,255,255,.6); transition: color .2s; }
.nx-foot__mod a:hover { color: #fff; }

/* Language control. A real button, not an anchor to nowhere: the label always
   reports the active locale and the menu is where new ones get added. */
.nx-lang { position: relative; display: block; }
.nx-lang__btn {
  display: flex; align-items: center; gap: 10px; width: 100%;
  height: 38px; padding: 0 12px;
  border: 1px solid rgba(139, 92, 246, .18); border-radius: 10px;
  background: rgba(255,255,255,.03);
  font-size: .8125rem; font-weight: 500; color: #b6bcc8;
  cursor: pointer;
  transition: border-color .2s, background .2s, color .2s;
}
.nx-lang__btn:hover, .nx-lang__btn[aria-expanded="true"] {
  color: #fff; border-color: rgba(139, 92, 246, .45); background: rgba(139, 92, 246, .1);
}
/* The globe is the locale indicator, so it is green rather than the muted grey
   it inherited from the bare-text version, and small enough not to compete
   with the label. */
.nx-lang__ico { display: flex; flex: none; }
.nx-lang__btn svg { width: 17px; height: 17px; flex: none; display: block; }
/* Caret on the far end of the row, so the control reads as a dropdown. */
.nx-lang__caret {
  width: 6px; height: 6px; flex: none;
  margin-inline-start: auto; opacity: .65;
  border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor;
  transform: rotate(45deg) translate(-1px, -1px);
  transition: transform .2s;
}
.nx-lang__btn[aria-expanded="true"] .nx-lang__caret { transform: rotate(225deg) translate(-1px, -1px); }
.nx-lang__menu {
  position: absolute; inset-inline-start: 0; top: calc(100% + 8px); z-index: 5;
  min-width: 132px; padding: 5px; border-radius: 11px;
  border: 1px solid rgba(139, 92, 246, .22); background: #14121f;
  box-shadow: 0 0 24px rgba(124, 58, 237, .3), 0 18px 40px rgba(0,0,0,.5);
  display: none; flex-direction: column; gap: 2px;
}
.nx-lang__menu.is-open { display: flex; }
.nx-lang__opt {
  display: flex; align-items: center; justify-content: space-between; gap: 10px;
  padding: 7px 9px; border: 0; border-radius: 8px; background: transparent;
  font-size: .8125rem; color: #b6bcc8; text-align: start; cursor: pointer;
  transition: background .15s, color .15s;
}
.nx-lang__opt:hover { background: rgba(255,255,255,.05); color: #fff; }
.nx-lang__opt[aria-current="true"] { color: var(--nx-violet-2); }
.nx-lang__opt i { font-size: .7rem; }

/* The copyright block sits 100px clear of the about/link row. That clearance
   is the source's own `padding: 100px 24px 0` on its closing container, and it
   is deliberately generous: the source leaves roughly 145px of air under its
   link modules before the hairline because its about column runs 145px taller
   than they do. Reproducing the 100px and not the 21px this used to carry. */
.nx-foot__rule {
  margin: 100px 0 10px; border: 0; border-top: 2px solid #141422;
  border-radius: 50px; opacity: .6;
}
/* The row carries the source's 50px closing padding. On the source that lives
   on the grid, but only because the copyright block is a child of it there;
   here the copyright sits beside the grid, so the padding moves with it or the
   50px would land above the rule instead of below the notice. */
.nx-foot__row {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16px; padding-bottom: 50px;
}
.nx-foot__note { font-size: .8rem; line-height: 19.2px; color: #fff; }
.nx-foot__soc { display: flex; gap: 8px; }
.nx-foot__soc a {
  width: 40px; height: 40px; padding: 5px;
  display: inline-flex; align-items: center; justify-content: center;
  border-radius: 50%; color: #fff; font-size: 1.25rem;
  transition: background-color .15s cubic-bezier(.4,0,.2,1);
}
.nx-foot__soc a:hover { background-color: rgba(255,255,255,.08); }

/* ─── Reveal ────────────────────────────────────────────────────────────────
   Pure keyframes rather than a JS-added class: a scripting failure must not
   be able to leave the page blank. */
.nx-rv { opacity: 0; animation: nxRv .7s cubic-bezier(.4,0,.2,1) forwards; }
.nx-js .nx-rv { animation: none; opacity: 1; }
.nx-js.nx-anim .nx-rv {
  opacity: 0; transform: translateY(26px);
  transition: opacity .7s cubic-bezier(.4,0,.2,1), transform .7s cubic-bezier(.4,0,.2,1);
}
.nx-js.nx-anim .nx-rv.nx-in { opacity: 1; transform: none; }
@keyframes nxRv { to { opacity: 1; } }

/* ─── Maintenance banner (existing feature, class injected by JS) ───────── */
.nx-mnt {
  display: none; position: fixed; left: 0; right: 0; top: 0; z-index: 1200;
  background: linear-gradient(90deg, #3a2a05, #2a1055);
  border-bottom: 1px solid rgba(255,217,61,.3); color: #fff;
}
.nx-mnt.nx-show { display: block; }
.nx-mnt__in {
  display: flex; align-items: center; justify-content: center; gap: 12px;
  padding: 9px 16px; font-size: .8rem; text-align: center;
}
.nx-mnt__in i { color: var(--nx-gold); }
.nx-mnt__t { font-weight: 700; }

/* ─── Responsive ────────────────────────────────────────────────────────── */
@media (max-width: 899.98px) {
  .nx-nav { display: none; }
  .nx-hero { min-height: 0; padding: 64px 0; }
  .nx-hero h1 { margin-bottom: 18px; }
  .nx-hero__sub { font-size: 16px; }
  .nx-hero__glow--1 { width: 640px; height: 460px; }
  .nx-hero__glow--2 { width: 280px; height: 280px; }
  .nx-sec { padding: 64px 10px; }
}
@media (max-width: 639.98px) {
  .nx-hero__acts { flex-direction: column; align-items: stretch; }
  .nx-hero__acts .nx-btn { width: 100%; }
  .nx-header__bar { height: 62px; }
  .nx-logo { width: 42px; height: 42px; }
  .nx-features__grid { grid-template-columns: 1fr; }
  .nx-foot__mod { flex: 1 1 120px; }
  .nx-sec__title { font-size: 1.75rem; }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation-duration: .001ms !important; transition-duration: .001ms !important; }
  .nx-js.nx-anim .nx-rv { opacity: 1; transform: none; }
  /* Stop the strips dead. The second copy stays in the DOM but the row
     clips it, so the first set simply sits still. */
  .nx-plugins__track { animation: none !important; }
}
</style>
</head>
<body>

<!-- ══ Header ══════════════════════════════════════════════════════════════ -->
<header class="nx-header" id="nxHeader">
  <div class="nx-wrap">
    <div class="nx-header__bar">
      <div class="nx-header__left">
        <a href="/" class="nx-logo" aria-label="Kratos System">
          <svg viewBox="0 0 64 64" role="img" aria-hidden="true">
            <defs>
              <linearGradient id="nxlg" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#8c5aff"/>
                <stop offset="100%" stop-color="#681fd1"/>
              </linearGradient>
            </defs>
            <rect x="2" y="2" width="60" height="60" rx="16" fill="#12131c" stroke="url(#nxlg)" stroke-width="3"/>

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FX9 Dashboard — لوحة تحكم البوت</title>
  <meta name="description" content="FX9 Dashboard — لوحة تحكم متقدمة لإدارة بوت FX9 على ديسكورد">
  <meta property="og:title" content="FX9 Dashboard — لوحة تحكم البوت" />
  <meta property="og:description" content="FX9 Dashboard — لوحة تحكم متقدمة لإدارة بوت FX9 على ديسكورد. إدارة السيرفرات، نظام تذاكر، قنوات صوتية مؤقتة، والمزيد." />
  <meta property="og:image" content="https://fx9-dashboard.onrender.com/og-image.svg" />
  <meta property="og:url" content="https://fx9-dashboard.onrender.com" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="FX9 Dashboard" />
  <meta property="og:locale" content="ar_AR" />
  <meta name="theme-color" content="#FF0000" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="FX9 Dashboard — لوحة تحكم البوت" />
  <meta name="twitter:description" content="FX9 Dashboard — لوحة تحكم متقدمة لإدارة بوت FX9 على ديسكورد." />
  <meta name="twitter:image" content="https://fx9-dashboard.onrender.com/og-image.svg" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body class="landing-page">
  <nav class="navbar glass landing-nav">
    <div class="nav-left">
      <a href="/" class="nav-brand">
        <i class="fas fa-bolt"></i>
        <span>FX9 Dashboard</span>
      </a>
    </div>
    <div class="nav-right">
      <% if (locals.user) { %>
        <a href="/home" class="btn-discord" style="margin-left:8px">
          <i class="fas fa-th-large"></i>
          الصفحة الرئيسية
        </a>
        <a href="/auth/logout" class="btn-discord" style="background:#ed4245;">
          <i class="fas fa-sign-out-alt"></i>
          تسجيل الخروج
        </a>
      <% } else { %>
        <a href="/auth/discord" class="btn-discord">
          <i class="fab fa-discord"></i>
          Login with Discord
        </a>
      <% } %>
    </div>
  </nav>

  <% if (locals.error) { %>
    <div class="toast-container">
      <div class="toast glass fade-in-up" style="background:var(--danger);color:white">
        ⚠️ <%= error === 'auth_failed' ? 'فشل تسجيل الدخول — تحقق من Redirect URI في Discord Developer Portal' : error === 'no_code' ? 'لم يتم استلام رمز التوثيق — حاول مرة أخرى' : error %>
      </div>
    </div>
  <% } %>

  <section class="hero">
    <div class="hero-bg">
      <div class="hero-shape shape-1"></div>
      <div class="hero-shape shape-2"></div>
      <div class="hero-shape shape-3"></div>
    </div>
    <div class="hero-content">
      <div class="hero-badge">
        <i class="fas fa-bolt"></i>
        FADIX9 SYSTEM  Bot v1.0.11
      </div>
      <h1>لوحة تحكم متكاملة<br>لإدارة <span class="gradient-text">بوتك بالكامل</span></h1>
      <p>تحكم بجميع أنظمة البوت — الإدارة، التذاكر، الصوت المؤقت، الحماية — من لوحة واحدة احترافية مع مزامنة فورية</p>
      <div class="hero-buttons">
        <% if (locals.user) { %>
          <a href="/home" class="btn-primary btn-glow">
            <i class="fas fa-th-large"></i>
            الصفحة الرئيسية
          </a>
          <a href="/auth/logout" class="btn-secondary">
            <i class="fas fa-sign-out-alt"></i>
            تسجيل الخروج
          </a>
        <% } else { %>
          <a href="/auth/discord" class="btn-primary btn-glow">
            <i class="fab fa-discord"></i>
            ابدأ الآن — سجل دخولك
          </a>
          <a href="/invite-dev" class="btn-secondary">
            <i class="fas fa-code-branch"></i>
            الإضافة قيد التطوير
          </a>
        <% } %>
      </div>
      <div class="hero-stats">
        <div class="hero-stat">
          <span class="stat-value">6</span>
          <span class="stat-label">أنظمة</span>
        </div>
        <div class="hero-stat">
          <span class="stat-value" id="heroCmdCount">—</span>
          <span class="stat-label">أمر</span>
        </div>
        <div class="hero-stat">
          <span class="stat-value">100%</span>
          <span class="stat-label">تحكم عبر الويب</span>
        </div>
      </div>
    </div>
  </section>

  <section class="features" id="features">
    <div class="section-header">
      <h2>كل ما تحتاجه في <span class="gradient-text">لوحة واحدة</span></h2>
      <p>أنظمة متكاملة مع واجهة استخدام احترافية وسهلة</p>
    </div>
    <div class="features-grid">
      <div class="feature-card glass">
        <div class="feature-icon" style="--icon-color: #5865f2">
          <i class="fas fa-shield-alt"></i>
        </div>
        <h3>الحماية</h3>
        <p>نظام حماية متكامل ضد السبام، النيوك، الرايد، واللينكات</p>
      </div>
      <div class="feature-card glass">
        <div class="feature-icon" style="--icon-color: #57f287">
          <i class="fas fa-ticket-alt"></i>
        </div>
        <h3>التذاكر</h3>
        <p>نظام تذاكر دعم فني متكامل مع تقييم وإدارة متقدمة</p>
      </div>
      <div class="feature-card glass">
        <div class="feature-icon" style="--icon-color: #fee75c">
          <i class="fas fa-microphone"></i>
        </div>
        <h3>الرومات المؤقتة</h3>
        <p>قنوات صوتية مؤقتة بنظام Join-to-Create مع لوحة تحكم خاصة</p>
      </div>
      <div class="feature-card glass">
        <div class="feature-icon" style="--icon-color: #ed4245">
          <i class="fas fa-gavel"></i>
        </div>
        <h3>الإشراف</h3>
        <p>أوامر إشراف متكاملة مع سجلات ونظام تحذيرات</p>
      </div>
      <div class="feature-card glass">
        <div class="feature-icon" style="--icon-color: #eb459e">
          <i class="fas fa-music"></i>
        </div>
        <h3>الموسيقى</h3>
        <p>مشغل موسيقى متكامل مع يوتيوب وقائمة تشغيل</p>
      </div>
      <div class="feature-card glass">
        <div class="feature-icon" style="--icon-color: #5865f2">
          <i class="fas fa-chart-line"></i>
        </div>
        <h3>الإحصائيات</h3>
        <p>إحصائيات ورسوم بيانية لأداء السيرفر والبوت</p>
      </div>
    </div>
  </section>

  <section class="stats-section">
    <div class="stats-container">
      <div class="stat-item">
        <i class="fas fa-shield-alt"></i>
        <span class="stat-number">—</span>
        <span class="stat-desc">أنظمة حماية</span>
      </div>
      <div class="stat-item">
        <i class="fas fa-ticket-alt"></i>
        <span class="stat-number">—</span>
        <span class="stat-desc">أوامر تذاكر</span>
      </div>
      <div class="stat-item">
        <i class="fas fa-microphone"></i>
        <span class="stat-number">—</span>
        <span class="stat-desc">أوامر صوتية</span>
      </div>
      <div class="stat-item">
        <i class="fas fa-terminal"></i>
        <span class="stat-number">—</span>
        <span class="stat-desc">إجمالي الأوامر</span>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="cta-content glass">
      <h2>هل أنت مستعد؟</h2>
      <p>ابدأ بإدارة سيرفرك بشكل احترافي مع FX9 Dashboard</p>
      <% if (locals.user) { %>
        <a href="/home" class="btn-primary btn-glow">
          <i class="fas fa-th-large"></i>
          الصفحة الرئيسية
        </a>
      <% } else { %>
        <a href="/auth/discord" class="btn-primary btn-glow">
          <i class="fab fa-discord"></i>
          سجل دخولك الآن
        </a>
      <% } %>
    </div>
  </section>

  <footer class="footer landing-footer">
    <div class="footer-content">
      <span>© 2026 FX9 Dashboard — جميع الحقوق محفوظة</span>
    </div>
  </footer>

  <style>
    .mnt-banner {
      position: sticky;
      top: 0;
      z-index: 10000;
      background: rgba(237,66,69,0.18);
      backdrop-filter: blur(24px) saturate(1.8);
      -webkit-backdrop-filter: blur(24px) saturate(1.8);
      border-bottom: 1px solid rgba(255,255,255,0.06);
      animation: mntSlideDown 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes mntSlideDown {
      from { transform: translateY(-100%); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .mnt-banner-inner {
      max-width: 1100px;
      margin: 0 auto;
      padding: 8px 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      direction: rtl;
    }
    .mnt-banner-icon {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: rgba(237,66,69,0.2);
      border: 1px solid rgba(237,66,69,0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      color: #ed4245;
      flex-shrink: 0;
    }
    .mnt-banner-text { flex: 1; }
    .mnt-banner-title {
      font-weight: 700;
      font-size: 0.82rem;
      color: rgba(255,255,255,0.85);
      margin-bottom: 1px;
    }
    .mnt-banner-desc {
      font-size: 0.72rem;
      color: rgba(255,255,255,0.45);
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }
    .mnt-banner-time {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 1px 10px;
      border-radius: 20px;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.06);
      font-family: 'Cairo', monospace;
      font-size: 0.72rem;
      color: rgba(255,255,255,0.6);
      direction: ltr;
    }
    .mnt-banner-time i {
      font-size: 0.55rem;
      color: #ed4245;
      animation: mntBlink 1.2s ease-in-out infinite;
    }
    @keyframes mntBlink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.2; }
    }
    body.mnt-active .landing-nav {
      top: 52px;
    }
    body.mnt-active .mnt-banner {
      position: fixed;
      left: 0;
      right: 0;
    }
    @media (max-width: 768px) {
      .mnt-banner-inner { flex-direction: row; text-align: right; padding: 6px 14px; gap: 8px; }
      .mnt-banner-title { font-size: 0.75rem; }
    }
    @media (max-width: 480px) {
      .mnt-banner-inner { flex-wrap: wrap; gap: 4px; }
      .mnt-banner-icon { width: 26px; height: 26px; font-size: 0.7rem; }
    }
  </style>
  <script src="/js/main.js"></script>
  <script>
  document.addEventListener('DOMContentLoaded', () => {
    // ─── Stats (no data-target in HTML — observer in main.js won't conflict) ─
    function setStatsFallback() {
      var fb = { 'أنظمة حماية': 6, 'أوامر تذاكر': 9, 'أوامر صوتية': 15, 'إجمالي الأوامر': 55 };
      document.querySelectorAll('.stat-number').forEach(function(el) {
        var label = (el.closest('.stat-item')?.querySelector('.stat-desc')?.textContent || '').trim();
        for (var key in fb) {
          if (label.includes(key)) { el.dataset.target = fb[key]; el.textContent = '0'; if (typeof animateCount === 'function') animateCount(el); break; }
        }
      });
      var heroEl = document.getElementById('heroCmdCount');
      if (heroEl) heroEl.textContent = '55';
    }

    function setStatsFromApi(map, totalStats) {
      document.querySelectorAll('.stat-number').forEach(function(el) {
        var label = (el.closest('.stat-item')?.querySelector('.stat-desc')?.textContent || '').trim();
        var val = 0;
        if (label.includes('أوامر تذاكر'))        val = map['ticket'] || 0;
        else if (label.includes('أوامر صوتية'))    val = map['voice'] || 0;
        else if (label.includes('إجمالي الأوامر')) val = totalStats;
        else if (label.includes('أنظمة حماية'))    val = 6;
        el.dataset.target = val;
        el.textContent = '0';
        if (typeof animateCount === 'function') animateCount(el);
      });
      var heroEl = document.getElementById('heroCmdCount');
      if (heroEl) heroEl.textContent = totalStats || 0;
    }

    fetch('/api/commands/stats')
      .then(function(r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
      .then(function(stats) { setStatsFromApi(stats.perCategory || {}, stats.total || 0); })
      .catch(setStatsFallback);

    // ─── Maintenance banner ──────────────────────────────────────────────
    const mntContainer = document.createElement('div');
    mntContainer.id = 'mntBanner';
    document.body.prepend(mntContainer);

    let mntData = null;
    let mntStartTime = null;
    let mntEndTime = null;
    let mntRemainMs = null;
    let mntBannerBuilt = false;

    function formatDuration(ms) {
      if (ms <= 0) return '0ث';
      const h = Math.floor(ms / 3600000);
      const m = Math.floor((ms % 3600000) / 60000);
      const s = Math.floor((ms % 60000) / 1000);
      if (h > 0) return h + 'س ' + m + 'د ' + s + 'ث';
      if (m > 0) return m + 'د ' + s + 'ث';
      return s + 'ث';
    }

    function buildBanner() {
      mntContainer.innerHTML = `
        <div class="mnt-banner">
          <div class="mnt-banner-inner">
            <div class="mnt-banner-icon"><i class="fas fa-shield-halved"></i></div>
            <div class="mnt-banner-text">
              <div class="mnt-banner-title">FADIX9 SYSTEM Bot v1.0.11 — وضع الصيانة مفعل</div>
              <div class="mnt-banner-desc">
                <span class="mnt-banner-time"><i class="fas fa-circle"></i> <span id="mntTimer">...</span></span>
                <span id="mntMessage"></span>
              </div>
            </div>
          </div>
        </div>
      `;
      document.body.classList.add('mnt-active');
      mntBannerBuilt = true;
      tickTimer();
    }

    function removeBanner() {
      mntContainer.innerHTML = '';
      document.body.classList.remove('mnt-active');
      mntBannerBuilt = false;
    }

    function updateBanner() {
      if (!mntData || !mntData.enabled) {
        removeBanner();
        return;
      }
      if (!mntBannerBuilt) buildBanner();
      const msgEl = document.getElementById('mntMessage');
      if (msgEl) msgEl.textContent = mntData.message || 'الموقع تحت الصيانة حالياً';
    }

    function tickTimer() {
      const el = document.getElementById('mntTimer');
      const timeWrap = el && el.parentElement;
      if (!el || !timeWrap || !mntData || !mntData.enabled) return;
      if (mntEndTime && mntRemainMs !== null) {
        timeWrap.style.display = '';
        el.textContent = 'متبقي ' + formatDuration(mntRemainMs);
        if (mntRemainMs > 0) mntRemainMs = Math.max(0, mntRemainMs - 1000);
      } else {
        timeWrap.style.display = 'none';
      }
    }

    async function checkMaintenance() {
      try {
        const res = await fetch('/dev/maintenance/status');
        const data = await res.json();
        if (data.enabled) {
          mntStartTime = Number(data.startedAt) || Date.now();
          mntEndTime = data.endTime ? Number(data.endTime) : null;
          mntRemainMs = typeof data.remainMs === 'number' ? data.remainMs : null;
          mntData = data;
        } else {
          mntData = null;
          mntStartTime = null;
          mntEndTime = null;
          mntRemainMs = null;
        }
        updateBanner();
      } catch {}
    }
    checkMaintenance();
    setInterval(checkMaintenance, 30000);
    setInterval(tickTimer, 1000);
  });
  </script>
</body>
</html>
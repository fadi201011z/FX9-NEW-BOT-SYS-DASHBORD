<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Kratos Dashboard — لوحة تحكم البوت</title>
<meta name="description" content="لوحة تحكم متكاملة لإدارة سيرفرك على ديسكورد — إشراف، تذاكر، غرف صوتية، حماية، وأدوات.">
<meta name="theme-color" content="#090713">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">

<meta property="og:type" content="website">
<meta property="og:title" content="Kratos System — لوحة تحكم البوت">
<meta property="og:description" content="أدر سيرفرك، تواصل مع مجتمعك، وافتح كل الإمكانات — كل ذلك في مكان واحد.">
<meta property="og:site_name" content="Kratos System">
<meta name="twitter:card" content="summary">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<link rel="stylesheet" href="/css/landing.css">
</head>
<body>

<%- include('partials/landing-head') %>

<!-- ══ Hero ════════════════════════════════════════════════════════════════
     Centred copy, one contained button beside one outlined button, two
     blurred radial orbs behind. The planet artwork that sits behind this
     section on novax.gg is intentionally absent. -->
<section class="nx-hero">
  <canvas class="nx-sky" id="nxSky" aria-hidden="true"></canvas>
  <div class="nx-hero__glow nx-hero__glow--1" aria-hidden="true"></div>
  <div class="nx-hero__glow nx-hero__glow--2" aria-hidden="true"></div>
  <div class="nx-hero__in">
    <div class="nx-hero__row">
      <h1>مغامرتك على ديسكورد تبدأ من بين النجوم</h1>
      <p class="nx-hero__sub">أدِر سيرفرك، تواصل مع مجتمعك، وافتح كل الإمكانات — كل ذلك في مكان واحد.</p>
    </div>
    <div class="nx-hero__row">
      <div class="nx-hero__acts">
        <a href="/invite" class="nx-btn nx-btn-p">دعوة البوت <i class="fas fa-arrow-left nx-ico"></i></a>
        <a href="#features" class="nx-btn nx-btn-o">استكشف المزيد <i class="fas fa-arrow-left nx-ico"></i></a>
      </div>
    </div>
  </div>
</section>

<!-- ══ Dashboard showcase ═════════════════════════════════════════════════
     Our own dashboard, drawn in CSS at the proportions measured off the
     source's screenshot: topbar, sidebar, wide card band, purple tile band,
     and a second card band. The panel is borderless and wider than the
     wrapper, so it bleeds off both sides the way theirs does. -->
<section class="nx-shot">
  <div class="nx-shot__bleed nx-shot__bleed--a" aria-hidden="true"></div>
  <div class="nx-shot__bleed nx-shot__bleed--b" aria-hidden="true"></div>
  <div class="nx-shot__bleed nx-shot__bleed--c" aria-hidden="true"></div>
  <div class="nx-shot__vig" aria-hidden="true"></div>
  <div class="nx-shot__fade" aria-hidden="true"></div>

  <div class="nx-shot__in nx-wrap">
    <div class="nx-dash">
      <div class="nx-dash__bar">
        <div class="nx-dash__brand"><i></i> كراتوس</div>
        <div class="nx-dash__crumb"><em></em> متصل</div>
        <div class="nx-dash__acts"><s></s><s></s><b></b></div>
      </div>

      <div class="nx-dash__body">
        <aside class="nx-dash__side">
          <div class="nx-dash__grp">الرئيسية</div>
          <span class="nx-dash__link is-on"><i class="fas fa-star"></i> نظرة عامة</span>
          <span class="nx-dash__link"><i class="fas fa-gauge-high"></i> لوحة التحكم</span>
          <span class="nx-dash__link"><i class="fas fa-server"></i> السيرفرات</span>
          <div class="nx-dash__grp">سيرفرك</div>
          <span class="nx-dash__link"><i class="fas fa-sliders"></i> الإعدادات</span>
          <span class="nx-dash__link"><i class="fas fa-terminal"></i> الأوامر</span>
          <span class="nx-dash__link"><i class="fas fa-ticket-alt"></i> التذاكر</span>
          <span class="nx-dash__link"><i class="fas fa-volume-high"></i> الغرف المؤقتة</span>
          <span class="nx-dash__link"><i class="fas fa-clipboard-list"></i> سجل النشاط</span>
          <span class="nx-dash__link"><i class="fas fa-bell"></i> الإشعارات</span>
          <span class="nx-dash__link"><i class="fas fa-shield-halved"></i> الحماية</span>
          <span class="nx-dash__link"><i class="fas fa-crown"></i> البريميوم</span>
        </aside>

        <div class="nx-dash__main">
          <div class="nx-dash__head">
            <b>نظرة عامة على السيرفر</b>
            <span>آخر تحديث منذ لحظات</span>
          </div>

          <div class="nx-dash__wide">
            <div class="nx-dash__card">
              <u>أحدث النشاطات</u>
              <div class="nx-dash__row"><s></s><em></em></div>
              <div class="nx-dash__row"><s></s><em></em></div>
              <div class="nx-dash__row"><s></s><em></em></div>
            </div>
            <div class="nx-dash__card">
              <u>حالة البوت</u>
              <div class="nx-dash__row"><s></s><em></em></div>
              <div class="nx-dash__row"><s></s><em></em></div>
              <div class="nx-dash__row"><s></s><em></em></div>
            </div>
          </div>

          <div class="nx-dash__tiles">
            <div class="nx-dash__tile">
              <u>الأعضاء</u><b>52</b><em>+4 هذا الشهر</em>
              <i class="fas fa-users"></i>
            </div>
            <div class="nx-dash__tile">
              <u>الأوامر المنفذة</u><b>41</b><em>نشطة</em>
              <i class="fas fa-bolt"></i>
            </div>
            <div class="nx-dash__tile">
              <u>التذاكر المفتوحة</u><b>9</b><em>بانتظار الرد</em>
              <i class="fas fa-ticket-alt"></i>
            </div>
          </div>

          <div class="nx-dash__cards">
            <div class="nx-dash__card">
              <u>الغرف الصوتية</u>
              <div class="nx-dash__row"><s></s><em></em></div>
              <div class="nx-dash__row"><s></s><em></em></div>
            </div>
            <div class="nx-dash__card">
              <u>الإعدادات النشطة</u>
              <div class="nx-dash__row"><s></s><em></em></div>
              <div class="nx-dash__row"><s></s><em></em></div>
            </div>
            <div class="nx-dash__card">
              <u>الحماية</u>
              <div class="nx-dash__row"><s></s><em></em></div>
              <div class="nx-dash__row"><s></s><em></em></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══ Features ════════════════════════════════════════════════════════════ -->
<section class="nx-features" id="features">
  <div class="nx-features__pad">
    <div class="nx-wrap">
      <div class="nx-features__grid">
        <div class="nx-fcard">
          <div class="nx-fcard__icon"><i class="fas fa-bolt"></i></div>
          <h3>سرعة فائقة</h3>
          <p>يستجيب فورًا ليبقي سيرفرك حيًا ونشطًا.</p>
        </div>
        <div class="nx-fcard">
          <div class="nx-fcard__icon"><i class="fas fa-shield-halved"></i></div>
          <h3>آمن</h3>
          <p>مبني على أفضل الممارسات لحماية مجتمعك.</p>
        </div>
        <div class="nx-fcard">
          <div class="nx-fcard__icon"><i class="fas fa-layer-group"></i></div>
          <h3>مزايا متكاملة</h3>
          <p>مليء بالإشراف والمرح والأدوات والمزيد من الإضافات.</p>
        </div>
        <div class="nx-fcard">
          <div class="nx-fcard__icon"><i class="fas fa-sliders"></i></div>
          <h3>قابل للتخصيص بالكامل</h3>
          <p>كيّف البوت بسهولة ليناسب احتياجات سيرفرك.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══ Plugins ════════════════════════════════════════════════════════════ -->
<section class="nx-plugins">
  <div class="nx-plugins__pad">
    <div class="nx-wrap">
      <div class="nx-plugins__box">
        <div class="nx-plugins__row" aria-hidden="true">
          <div class="nx-plugins__track">
            <i class="fas fa-user-shield"></i><i class="fas fa-gavel"></i><i class="fas fa-volume-high"></i>
            <i class="fas fa-ticket-alt"></i><i class="fas fa-chart-line"></i><i class="fas fa-gamepad"></i>
            <i class="fas fa-gift"></i><i class="fas fa-robot"></i><i class="fas fa-hashtag"></i>
            <i class="fas fa-crown"></i><i class="fas fa-palette"></i><i class="fas fa-smile"></i>
            <i class="fas fa-bell"></i><i class="fas fa-users"></i>
          </div>
        </div>
        <div class="nx-plugins__row" aria-hidden="true">
          <div class="nx-plugins__track">
            <i class="fas fa-database"></i><i class="fas fa-wand-magic-sparkles"></i><i class="fas fa-code"></i>
            <i class="fas fa-music"></i><i class="fas fa-calendar-check"></i><i class="fas fa-clipboard-list"></i>
            <i class="fas fa-shield"></i><i class="fas fa-microphone"></i><i class="fas fa-handshake"></i>
            <i class="fas fa-lock"></i><i class="fas fa-key"></i><i class="fas fa-envelope"></i>
          </div>
        </div>
        <div class="nx-plugins__row" aria-hidden="true">
          <div class="nx-plugins__track">
            <i class="fas fa-comments"></i><i class="fas fa-thumbs-up"></i><i class="fas fa-lightbulb"></i>
            <i class="fas fa-tools"></i><i class="fas fa-server"></i><i class="fas fa-plug"></i>
            <i class="fas fa-power-off"></i><i class="fas fa-clock"></i><i class="fas fa-eye"></i>
            <i class="fas fa-filter"></i><i class="fas fa-book"></i><i class="fas fa-layer-group"></i>
            <i class="fas fa-bolt"></i><i class="fas fa-sliders"></i>
          </div>
        </div>
        <div class="nx-plugins__mark">
          <svg viewBox="0 0 64 64" role="img" aria-hidden="true">
            <path d="M20 22 L32 32 L20 42" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M34 42 L46 42" fill="none" stroke="#f5e625" stroke-width="6" stroke-linecap="round"/>
          </svg>
        </div>
      </div>
      <h2>إضافات لكل ذوق</h2>
      <p>كل سيرفر مختلف. اختر الإضافات التي تناسب ذوقك واجعل مجتمعك مميزًا.</p>
    </div>
  </div>
</section>

<!-- ══ Section renderer ═══════════════════════════════════════════════════
     Every feature band below is the same shape: an optional full-width band
     card, then a series of 8/4 and 4/8 grid rows. Markup is written out per
     section rather than data-driven because each mockup is bespoke. -->

<!-- ── User management ─────────────────────────────────────────────────── -->
<section class="nx-sec">
  <div class="nx-sec__orb" aria-hidden="true"></div>
  <div class="nx-sec__in nx-wrap">
    <h2 class="nx-sec__title">إدارة الأعضاء</h2>
    <p class="nx-sec__sub">أدر المستخدمين بسهولة، تابع نشاطهم، وحافظ على سيرفرك منظمًا ونشطًا ومحبّبًا للجميع.</p>

    <div class="nx-card nx-card--band">
      <div class="nx-card__head">
        <div class="nx-card__icon"><i class="fas fa-volume-high"></i></div>
        <h3>المتصلون بالصوت</h3>
      </div>
      <p class="nx-card__desc">يعرض العدد الحالي للأعضاء المتصلين بقناة صوتية.</p>
      <div class="nx-card__mock">
        <div class="nx-mock">
          <div class="nx-mock__hd"><i class="fas fa-volume-high"></i><span>القنوات الصوتية</span></div>
          <div class="nx-mock__body">
            <div class="nx-row-i">
              <i class="fas fa-hashtag"></i><span class="nx-row-i__name">عام</span>
              <span class="nx-row-i__end"><span class="nx-stack"><span class="nx-av"></span><span class="nx-av"></span><span class="nx-av"></span><span class="nx-av"></span></span><span class="nx-pill">4 متصل</span></span>
            </div>
            <div class="nx-row-i">
              <i class="fas fa-hashtag"></i><span class="nx-row-i__name">ألعاب</span>
              <span class="nx-row-i__end"><span class="nx-stack"><span class="nx-av"></span><span class="nx-av"></span><span class="nx-av"></span></span><span class="nx-pill">3 متصل</span></span>
            </div>
            <div class="nx-row-i">
              <i class="fas fa-hashtag"></i><span class="nx-row-i__name">موسيقى</span>
              <span class="nx-row-i__end"><span class="nx-av"></span><span class="nx-pill">1 متصل</span></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="nx-row">
      <div class="nx-col-8">
        <div class="nx-card">
          <div class="nx-card__head">
            <div class="nx-card__icon"><i class="fas fa-arrow-trend-up"></i></div>
            <h3>المستويات</h3>
          </div>
          <p class="nx-card__desc">يتابع مستويات المستخدمين ونشاطهم، مع أوامر لإعادة التعيين وعرض الترتيب.</p>
          <div class="nx-card__mock">
            <div class="nx-mock">
              <div class="nx-mock__hd"><i class="fas fa-arrow-trend-up"></i><span>ارتقاء المستوى</span></div>
              <div class="nx-mock__body">
                <div class="nx-meter">
                  <div class="nx-meter__ring"><b>12</b></div>
                  <div class="nx-meter__meta">
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;">
                      <span style="font-size:.8125rem;color:#d7dae0;">2,450 / 3,400 XP</span>
                      <span class="nx-pill">+250 XP</span>
                    </div>
                    <div class="nx-bar"><div class="nx-bar__fill" style="width:72%"></div></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="nx-col-4">
        <div class="nx-card">
          <div class="nx-card__head">
            <div class="nx-card__icon"><i class="fas fa-hand-wave"></i></div>
            <h3>الترحيب والوداع</h3>
          </div>
          <p class="nx-card__desc">يرحب بالأعضاء الجدد برسالة ترحيب مخصصة.</p>
          <div class="nx-card__mock">
            <div class="nx-mock nx-mock--msg">
              <div class="nx-mock__body">
                <div class="nx-msg">
                  <span class="nx-av nx-av--lg nx-av--bot"><i class="fas fa-robot"></i></span>
                  <div class="nx-msg__col">
                    <div class="nx-msg__hd"><b>Kratos</b><span class="nx-msg__bot">بوت</span><span>اليوم 2:30 م</span></div>
                    <div style="font-size:.8125rem;color:#fff;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">أهلًا بك في كراتوس! <span class="nx-pill">#4,201</span></div>
                    <div class="nx-line nx-line--w70"></div>
                    <div class="nx-line nx-line--w45"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="nx-row nx-row--end">
      <div class="nx-col-4">
        <div class="nx-card">
          <div class="nx-card__head">
            <div class="nx-card__icon"><i class="fas fa-ticket-alt"></i></div>
            <h3>التذاكر</h3>
          </div>
          <p class="nx-card__desc">يتيح للمستخدمين إنشاء تذاكر خاصة للدعم أو الاستفسارات، لتسهيل إدارة المشرفين.</p>
          <div class="nx-card__mock">
            <div class="nx-mock">
              <div class="nx-mock__hd"><i class="fas fa-ticket-alt"></i><span>افتح تذكرة</span></div>
              <div class="nx-mock__body">
                <div class="nx-row-i"><span class="nx-av nx-av--bot"><i class="fas fa-robot" style="font-size:.6rem"></i></span><span class="nx-row-i__name">اختر تصنيفًا للبدء</span></div>
                <div class="nx-chipset">
                  <span class="nx-pill">الدعم</span>
                  <span class="nx-chip">الفوترة</span>
                  <span class="nx-chip">بلاغ خطأ</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="nx-col-8">
        <div class="nx-card">
          <div class="nx-card__head">
            <div class="nx-card__icon"><i class="fas fa-random"></i></div>
            <h3>القنوات المؤقتة</h3>
          </div>
          <p class="nx-card__desc">ينشئ قنوات صوتية مؤقتة تختفي تلقائيًا عندما لا يستخدمها أحد.</p>
          <div class="nx-card__mock">
            <div class="nx-mock">
              <div class="nx-mock__hd"><i class="fas fa-random"></i><span>القنوات المؤقتة</span></div>
              <div class="nx-mock__body">
                <div class="nx-row-i"><i class="fas fa-plus"></i><span class="nx-row-i__name">+ انضم للإنشاء</span></div>
                <div class="nx-row-i">
                  <i class="fas fa-hashtag"></i><i class="fas fa-lock"></i>
                  <span class="nx-row-i__name">قناة كراتوس</span>
                  <span class="nx-row-i__end"><span class="nx-pill">أُنشئت تلقائيًا</span></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ── Moderation ──────────────────────────────────────────────────────── -->
<section class="nx-sec">
  <div class="nx-sec__orb" aria-hidden="true"></div>
  <div class="nx-sec__in nx-wrap">
    <h2 class="nx-sec__title">الإشراف</h2>
    <p class="nx-sec__sub">حافظ على السيطرة بأدوات إشراف قوية، وسجلات مفصلة، وميزات حماية، ونظام بلاغات سهل.</p>

    <div class="nx-card nx-card--band">
      <div class="nx-card__head">
        <div class="nx-card__icon"><i class="fas fa-gavel"></i></div>
        <h3>أدوات الإشراف</h3>
      </div>
      <p class="nx-card__desc">أدوات لإدارة السيرفر والإشراف عليه، تشمل الحظر والكتم والإشراف التلقائي وغيرها.</p>
      <div class="nx-card__mock">
        <div class="nx-mock nx-mock--cmd">
          <div class="nx-mock__hd"><i class="fas fa-gavel"></i><span>الإشراف</span></div>
          <div class="nx-mock__body">
            <div class="nx-cmd">
              <div class="nx-cmd__row nx-cmd__row--on">
                <span class="nx-cmd__ico"><i class="fas fa-ban"></i></span>
                <div class="nx-cmd__col">
                  <span class="nx-cmd__name">/ban</span>
                  <span class="nx-cmd__desc">حظر عضو نهائيًا</span>
                </div>
              </div>
              <div class="nx-cmd__row">
                <span class="nx-cmd__ico"><i class="fas fa-user-minus"></i></span>
                <div class="nx-cmd__col">
                  <span class="nx-cmd__name">/kick</span>
                  <span class="nx-cmd__desc">إزالة عضو من السيرفر</span>
                </div>
              </div>
              <div class="nx-cmd__row">
                <span class="nx-cmd__ico"><i class="fas fa-hourglass-half"></i></span>
                <div class="nx-cmd__col">
                  <span class="nx-cmd__name">/timeout</span>
                  <span class="nx-cmd__desc">تقييد عضو مؤقتًا</span>
                </div>
              </div>
              <div class="nx-cmd__row">
                <span class="nx-cmd__ico"><i class="fas fa-triangle-exclamation"></i></span>
                <div class="nx-cmd__col">
                  <span class="nx-cmd__name">/warn</span>
                  <span class="nx-cmd__desc">إصدار تحذير لعضو</span>
                </div>
              </div>
              <div class="nx-cmd__row">
                <span class="nx-cmd__ico"><i class="fas fa-comment-slash"></i></span>
                <div class="nx-cmd__col">
                  <span class="nx-cmd__name">/mute</span>
                  <span class="nx-cmd__desc">منع عضو من الإرسال</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="nx-row">
      <div class="nx-col-6">
        <div class="nx-card">
          <div class="nx-card__head">
            <div class="nx-card__icon"><i class="fas fa-clipboard-list"></i></div>
            <h3>السجلات</h3>
          </div>
          <p class="nx-card__desc">يتتبع أحداث السيرفر المهمة مثل حذف الرسائل وإجراءات الأعضاء.</p>
          <div class="nx-card__mock">
            <div class="nx-mock">
              <div class="nx-mock__hd"><i class="fas fa-clipboard-list"></i><span>سجل التدقيق</span></div>

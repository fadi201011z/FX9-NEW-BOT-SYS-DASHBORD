<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>تحت الصيانة — FX9 Dashboard</title>
  <meta name="description" content="FX9 Dashboard تحت الصيانة حالياً. سنعود قريباً!">
  <meta property="og:title" content="FX9 Dashboard — تحت الصيانة" />
  <meta property="og:description" content="FX9 Dashboard تحت الصيانة حالياً. سنعود قريباً!" />
  <meta property="og:image" content="https://fx9-dashboard.onrender.com/og-image.svg" />
  <meta property="og:url" content="https://fx9-dashboard.onrender.com" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="FX9 Dashboard" />
  <meta property="og:locale" content="ar_AR" />
  <meta name="theme-color" content="#FF0000" />
  <meta name="twitter:card" content="summary_large_image" />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body { margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg,#0f0f1a,#1a1a2e); direction:rtl; font-family:'Cairo',sans-serif; }
    .mnt-box { width:100%; max-width:480px; padding:20px; }
    .mnt-card { background:rgba(255,255,255,.04); backdrop-filter:blur(20px); border:1px solid rgba(255,255,255,.06); border-radius:20px; padding:48px 32px; text-align:center; }
    .mnt-icon { width:80px; height:80px; border-radius:20px; background:rgba(250,166,26,.15); display:flex; align-items:center; justify-content:center; margin:0 auto 20px; font-size:2.5rem; color:#faa61a; animation:spin 4s linear infinite; }
    @keyframes spin { 0%{transform:rotate(0deg)} 100%{transform:rotate(360deg)} }
    .mnt-card h1 { margin:0 0 8px; font-size:1.5rem; font-weight:700; color:#fff; }
    .mnt-card p { margin:0 0 4px; color:rgba(255,255,255,.6); line-height:1.8; font-size:.9rem; }
    .mnt-divider { height:1px; background:rgba(255,255,255,.06); margin:24px 0; }
    .mnt-countdown { display:flex; gap:12px; justify-content:center; margin:20px 0; }
    .mnt-countdown > div { background:rgba(255,255,255,.06); border-radius:12px; padding:12px 16px; min-width:70px; }
    .mnt-countdown > div span:first-child { display:block; font-size:1.6rem; font-weight:700; color:#fff; }
    .mnt-countdown > div span:last-child { display:block; font-size:.7rem; color:rgba(255,255,255,.4); margin-top:2px; }
    .mnt-actions { display:flex; flex-direction:column; gap:8px; }
    .mnt-actions a,.mnt-actions button { display:flex; align-items:center; justify-content:center; gap:8px; padding:12px 20px; border-radius:10px; text-decoration:none; font-weight:600; font-size:.9rem; transition:.2s; cursor:pointer; border:none; }
    .mnt-actions .btn-discord { background:#5865f2; color:#fff; }
    .mnt-actions .btn-discord:hover { background:#4752c4; }
    .mnt-actions .btn-ghost { background:rgba(255,255,255,.04); color:rgba(255,255,255,.7); border:1px solid rgba(255,255,255,.08); }
    .mnt-actions .btn-ghost:hover { background:rgba(255,255,255,.08); }
    .mnt-actions .btn-skip { background:rgba(88,101,242,.15); color:#5865f2; border:1px solid rgba(88,101,242,.3); }
    .mnt-actions .btn-skip:hover { background:rgba(88,101,242,.25); }
    .mnt-footer { margin-top:20px; font-size:.75rem; color:rgba(255,255,255,.3); }
  </style>
</head>
<body>
  <div class="mnt-box">
    <div class="mnt-card">
      <div class="mnt-icon"><i class="fas fa-screwdriver-wrench"></i></div>
      <h1>⚠️ الموقع تحت الصيانة</h1>
      <p id="mntMessage"><%= maintenance.message %></p>
      <p style="font-size:.82rem;color:rgba(255,255,255,.4)">نعمل على تحسين تجربتك — شكراً لصبرك</p>

      <div class="mnt-divider"></div>
      <% var hasEndTime = maintenance.enabled && maintenance.endTime != null; %>
      <% var hasStartTime = maintenance.enabled && maintenance.startedAt > 0; %>
      <div id="mntTimerSection" style="display:<%= hasEndTime ? '' : 'none' %>">
        <div style="font-size:.82rem;color:rgba(255,255,255,.5);margin-bottom:8px">الوقت المتبقي</div>
        <div class="mnt-countdown" id="mntClock">
          <div><span id="cdDays">00</span><span>أيام</span></div>
          <div><span id="cdHours">00</span><span>ساعات</span></div>
          <div><span id="cdMins">00</span><span>دقائق</span></div>
          <div><span id="cdSecs">00</span><span>ثواني</span></div>
        </div>
      </div>

      <div id="mntElapsedSection" style="display:<%= (maintenance.enabled && !hasEndTime) ? '' : 'none' %>">
        <div style="font-size:.82rem;color:rgba(255,255,255,.5);margin-bottom:8px">مدة الصيانة</div>
        <div style="font-size:1.4rem;font-weight:700;color:#faa61a" id="mntElapsedTimer">...</div>
      </div>

      <div id="mntExpiredMsg" style="display:none">
        <div style="background:rgba(76,175,80,.12);border-radius:12px;padding:16px;margin:16px 0">
          <div style="font-size:2rem;margin-bottom:4px">✅</div>
          <div style="color:#4caf50;font-weight:700;font-size:.95rem">انتهت الصيانة! يتم إعادة التوجيه...</div>
        </div>
      </div>

      <script>
      (function(){
        var hasEndTime = <%= hasEndTime ? 'true' : 'false' %>;
        var remainMs = <%= hasEndTime ? Math.max(0, maintenance.endTime - Date.now()) : 0 %>;
        var elapsedFrom = <%= hasStartTime ? maintenance.startedAt : 'null' %>;

        if (hasEndTime) {
          document.getElementById('mntTimerSection').style.display = '';
          var clock = { days: document.getElementById('cdDays'), hours: document.getElementById('cdHours'), mins: document.getElementById('cdMins'), secs: document.getElementById('cdSecs') };
          function show(ms) {
            if (ms < 1) { end(); return; }
            var d = Math.floor(ms / 86400000);
            var h = Math.floor((ms % 86400000) / 3600000);
            var m = Math.floor((ms % 3600000) / 60000);
            var s = Math.floor((ms % 60000) / 1000);
            clock.days.textContent = String(d).padStart(2,'0');
            clock.hours.textContent = String(h).padStart(2,'0');
            clock.mins.textContent = String(m).padStart(2,'0');
            clock.secs.textContent = String(s).padStart(2,'0');
          }
          var lastServerMs = remainMs;
          var lastSync = Date.now();
          show(lastServerMs);
          var timer = setInterval(function() {
            var elapsed = Date.now() - lastSync;
            var cur = Math.max(0, lastServerMs - elapsed);
            show(cur);
            if (cur < 1) end();
          }, 200);
          var syncTimer = setInterval(function() {
            fetch('/dev/maintenance/status').then(function(r) { return r.json(); }).then(function(d) {
              if (!d.enabled) { end(); return; }
              if (d.remainMs < 1) { end(); return; }
              lastServerMs = d.remainMs;
              lastSync = Date.now();
            }).catch(function(){});
          }, 15000);
        } else {
          document.getElementById('mntElapsedSection').style.display = '';
          var elapsedEl = document.getElementById('mntElapsedTimer');
          if (elapsedFrom === null) elapsedFrom = Date.now();
          function fmtElapsed(ms) {
            if (ms <= 0) return '0ث';
            var h = Math.floor(ms / 3600000);
            var m = Math.floor((ms % 3600000) / 60000);
            var s = Math.floor((ms % 60000) / 1000);
            if (h > 0) return h + 'س ' + m + 'د ' + s + 'ث';
            if (m > 0) return m + 'د ' + s + 'ث';
            return s + 'ث';
          }
          function tickElapsed() {
            var dur = Date.now() - elapsedFrom;
            if (dur < 0) dur = 0;
            elapsedEl.textContent = fmtElapsed(dur);
          }
          tickElapsed();
          setInterval(tickElapsed, 1000);
        }

        function end() {
          document.getElementById('mntTimerSection').style.display = 'none';
          document.getElementById('mntElapsedSection').style.display = 'none';
          document.getElementById('mntExpiredMsg').style.display = '';
          setTimeout(function() { window.location.href = '/'; }, 2000);
          fetch('/maintenance/autoend', { method: 'POST' }).catch(function(){});
        }
      })();
      </script>

      <div class="mnt-divider"></div>
      <div class="mnt-actions">
        <a href="https://discord.gg/ENQut4HHKb" class="btn-discord" target="_blank"><i class="fab fa-discord"></i> سيرفر الدعم</a>
        <% if (user) { %><a href="/auth/logout" class="btn-ghost"><i class="fas fa-sign-out-alt"></i> تسجيل الخروج</a><% } %>
        <% if (canBypass) { %>
          <a href="/maintenance?bypass=1" class="btn-skip"><i class="fas fa-rocket"></i> تخطي — أنا مطور</a>
        <% } %>
      </div>
      <div class="mnt-footer">FX9 Dashboard &copy; 2026</div>
    </div>
  </div>
</body>
</html>
<% currentPage = 'admins' %>
<div class="page-header">
  <h1><i class="fas fa-users-cog"></i> إدارة المدراء — <%= guild.name %></h1>
  <p>عدد المدراء: <%= admins.length %> • الرتب الإدارية: <%= adminRoles.length %></p>
  <div class="header-actions" style="margin-top:8px">
    <button class="btn-sm btn-primary" onclick="syncAdmins(event)">
      <i class="fas fa-sync-alt"></i> مزامنة المدراء
    </button>
  </div>
</div>

<% if (guildRoles && guildRoles.length > 0) { %>
<div class="card glass">
  <div class="card-header">
    <h3><i class="fas fa-user-tag"></i> الرتب الإدارية في السيرفر</h3>
    <span class="text-muted" style="font-size:0.8rem">الرتب التي تمنح صلاحية الدخول للوحة التحكم</span>
  </div>
  <div class="maintenance-banner">
    <i class="fas fa-tools"></i> إضافة المدراء من الرتب قيد الصيانة — الرتب الحالية مستمرة في التحديث تلقائياً
  </div>
  <div class="admin-roles-grid">
    <% guildRoles.forEach(r => { %>
      <% const isLinked = adminRoles.some(ar => ar.role_id === r.id) %>
      <% const linkedRole = adminRoles.find(ar => ar.role_id === r.id) %>
      <div class="admin-role-card <%= isLinked ? 'active' : '' %> disabled">
        <div class="role-color-dot" style="background:<%= r.color ? '#' + Number(r.color).toString(16).padStart(6,'0') : '#99aab5' %>"></div>
        <div class="role-info">
          <div class="role-name"><%= r.name %></div>
          <div class="role-meta"><%= r.members_count || 0 %> عضو</div>
        </div>
        <div class="role-check"><i class="fas fa-check"></i></div>
      </div>
    <% }) %>
  </div>
</div>
<% } %>

<% if (adminRoleMembers && adminRoleMembers.length > 0) { %>
<div class="card glass">
  <div class="card-header">
    <h3><i class="fas fa-users"></i> الأعضاء المرتبطون بالرتب الإدارية</h3>
    <div class="admin-members-sync">
      <span id="syncStatus"><%= adminRoleMembers.length %> عضو</span>
    </div>
  </div>
  <div class="admins-table">
    <table>
      <thead>
        <tr>
          <th>العضو</th>
          <th>الرتبة في الداشبورد</th>
          <th>الحالة</th>
        </tr>
      </thead>
      <tbody>
        <% adminRoleMembers.forEach(m => { %>
          <% const dbAdmin = admins.find(a => a.userId === m.id) %>
          <tr>
            <td class="admin-user">
              <img src="https://cdn.discordapp.com/avatars/<%= m.id %>/<%= m.avatar %>.png" alt="" onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
              <span><%= m.globalName || m.username || m.id %></span>
            </td>
            <td><span class="role-badge role-<%= m.highestLevel %>"><%= m.highestLevel %></span></td>
            <td><span class="badge badge-<%= dbAdmin ? 'success' : 'warning' %>"><%= dbAdmin ? 'مضاف' : 'غير مضاف' %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<hr style="border-color:var(--border);margin:24px 0">

<div class="card glass">
  <div class="card-header">
    <h3><i class="fas fa-user-plus"></i> إضافة مدير يدوي</h3>
  </div>
  <form class="admin-add-form" onsubmit="addAdmin(event)">
    <div class="form-row">
      <div class="form-group">
        <label>ID أو اسم المستخدم</label>
        <input type="text" id="adminUserId" required placeholder="Discord ID أو اليوزرنيم">
      </div>
      <div class="form-group">
        <label>الرتبة</label>
        <select id="adminRole">
          <option value="manager">مدير</option>
          <option value="admin">آدمن</option>
          <option value="moderator">مشرف</option>
          <option value="support">دعم فني</option>
        </select>
      </div>
      <button type="submit" class="btn-primary"><i class="fas fa-plus"></i> إضافة</button>
    </div>
  </form>
</div>

<div class="card glass">
  <div class="card-header">
    <h3><i class="fas fa-list"></i> قائمة المدراء الحالية</h3>
    <div class="admin-search">
      <i class="fas fa-search"></i>
      <input type="text" id="adminSearch" placeholder="بحث عن مدير..." oninput="filterAdmins()">
    </div>
  </div>
  <div class="admins-table">
    <% if (admins && admins.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>العضو</th>
            <th>الرتبة</th>
            <th>النوع</th>
            <th>تاريخ الإضافة</th>
            <th>إجراءات</th>
          </tr>
        </thead>
        <tbody id="adminsTableBody">
          <% admins.forEach(a => { %>
            <tr class="admin-row" data-name="<%= (a.username || a.userId).toLowerCase() %>" data-id="<%= a.userId %>">
              <td class="admin-user">
                <img src="https://cdn.discordapp.com/avatars/<%= a.userId %>/<%= a.avatar %>.png" alt="" onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
                <span><%= a.username || a.userId %></span>
              </td>
              <td><span class="role-badge role-<%= a.role %>"><%= a.role %></span></td>
              <td><span class="badge badge-<%= a.addedBy === 'role_sync' ? 'info' : 'default' %>"><%= a.addedBy === 'role_sync' ? 'تلقائي' : 'يدوي' %></span></td>
              <td><%= new Date(a.addedAt).toLocaleString('ar-SA') %></td>
              <td class="actions">
                <select class="role-select" onchange="updateRole('<%= a.userId %>', this.value)">
                  <option value="manager" <%= a.role === 'manager' ? 'selected' : '' %>>مدير</option>
                  <option value="admin" <%= a.role === 'admin' ? 'selected' : '' %>>آدمن</option>
                  <option value="moderator" <%= a.role === 'moderator' ? 'selected' : '' %>>مشرف</option>
                  <option value="support" <%= a.role === 'support' ? 'selected' : '' %>>دعم</option>
                </select>
                <button class="btn-sm btn-danger" onclick="removeAdmin('<%= a.userId %>')">
                  <i class="fas fa-trash"></i>
                </button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <div class="empty-state"><i class="fas fa-users"></i><p>لا يوجد مدراء بعد — أضف رتب إدارية من الأعلى</p></div>
    <% } %>
  </div>
</div>

<script>
const GUILD_ID = '<%= guild.id %>';

function filterAdmins() {
  const q = document.getElementById('adminSearch').value.toLowerCase();
  document.querySelectorAll('.admin-row').forEach(row => {
    const match = row.dataset.name.includes(q) || row.dataset.id.includes(q);
    row.style.display = match ? '' : 'none';
  });
}

async function addAdmin(e) {
  e.preventDefault();
  const userId = document.getElementById('adminUserId').value.trim();
  const role = document.getElementById('adminRole').value;
  const btn = e.target.querySelector('button[type="submit"]');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
  try {
    const res = await fetch(`/admins/${GUILD_ID}/add`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ userId, role }),
    });
    const data = await res.json();
    showToast(data.success ? '✅ تمت الإضافة' : '❌ ' + (data.error || data.message));
    if (data.success) location.reload();
  } catch { showToast('❌ فشل الاتصال'); }
  btn.disabled = false;
  btn.innerHTML = '<i class="fas fa-plus"></i> إضافة';
}

async function removeAdmin(userId) {
  if (!confirm('إزالة المدير؟')) return;
  const res = await fetch(`/admins/${GUILD_ID}/remove`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ userId }),
  });
  if (res.ok) { showToast('✅ تمت الإزالة'); location.reload(); }
  else { const d = await res.json(); showToast('❌ ' + (d.error || d.message)); }
}

async function updateRole(userId, role) {
  const res = await fetch(`/admins/${GUILD_ID}/update-role`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ userId, role }),
  });
  const data = await res.json();
  showToast(data.success ? '✅ تم التحديث' : '❌ ' + (data.error || data.message));
}

async function syncAdmins(e) {
  const btn = e.currentTarget;
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري المزامنة...';
  try {
    const res = await fetch(`/admins/${GUILD_ID}/sync`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
    });
    const data = await res.json();
    showToast(data.success ? `✅ ${data.message}` : '❌ ' + (data.message || data.error));
    if (data.success) setTimeout(() => location.reload(), 1500);
  } catch { showToast('❌ فشلت المزامنة'); }
  btn.disabled = false;
  btn.innerHTML = '<i class="fas fa-sync-alt"></i> مزامنة المدراء';
}
</script>
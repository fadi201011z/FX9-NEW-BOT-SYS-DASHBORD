<% currentPage = 'admins' %>
<%
  // رتب اللوحة الست، مرتّبة من الأعلى صلاحية إلى الأدنى. المصدر واحد:
  // services/capabilities.js — نفس الملف الذي تقرأ منه الحرّاس، فلا تعرض الصفحة
  // صلاحية لا يمنحها الحارس فعلاً.
  const LV = { manager: 'مدير', admin: 'آدمن', supervisor: 'مشرف أول', moderator: 'مشرف', support: 'دعم', viewer: 'مراقب' };
  const ROLE_ORDER = ['manager', 'admin', 'supervisor', 'moderator', 'support', 'viewer'];
  const catalog = (typeof roleCatalog !== 'undefined' && Array.isArray(roleCatalog) && roleCatalog.length) ? roleCatalog : [];
  const matrix = (typeof roleMatrix !== 'undefined' && roleMatrix) ? roleMatrix : { roles: [], rows: [] };

  const activeRoles = (adminRoles || []).length;
  const totalRoles = (guildRoles || []).length;
  const linkedMembers = (adminRoleMembers || []).length;
  const autoAdmins = (admins || []).filter(a => a.addedBy === 'role_sync').length;
%>

<div class="page-header">
  <h1><i class="fas fa-users-gear"></i> المدراء والصلاحيات</h1>
  <p>التحكم بالمدراء والرتب الإدارية — في سيرفر <strong><%= guild.name %></strong></p>
  <div class="header-actions" style="margin-top:8px">
    <button class="btn-sm btn-primary" onclick="syncAdmins(event)">
      <i class="fas fa-sync-alt"></i> مزامنة المدراء
    </button>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #d000ff"><i class="fas fa-users-gear" aria-hidden="true"></i></div>
    <div class="stat-info">
      <span class="stat-value"><%= admins.length %></span>
      <span class="stat-label">مدير مسجّل</span>
    </div>
  </div>
  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #00c8ff"><i class="fas fa-user-tag" aria-hidden="true"></i></div>
    <div class="stat-info">
      <span class="stat-value"><%= activeRoles %>/<%= totalRoles %></span>
      <span class="stat-label">رتب إدارية مفعّلة</span>
    </div>
  </div>
  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #00a8ff"><i class="fas fa-user-check" aria-hidden="true"></i></div>
    <div class="stat-info">
      <span class="stat-value"><%= linkedMembers %></span>
      <span class="stat-label">عضو مرتبط برتب إدارية</span>
    </div>
  </div>
  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: var(--nx-gold)"><i class="fas fa-bolt" aria-hidden="true"></i></div>
    <div class="stat-info">
      <span class="stat-value" style="font-size:1.05rem"><%= autoAdmins %> تلقائي</span>
      <span class="stat-label">من إجمالي المدراء</span>
    </div>
  </div>
</div>

<!-- ═══ الرتب الإدارية الست ═══ -->
<section class="ad-sec">
  <div class="ad-sec-head">
    <div>
      <h2><i class="fas fa-layer-group"></i> الرتب الإدارية الست</h2>
      <p>كل رتبة تمنح مجموعة صلاحيات محددة داخل اللوحة. الرتبة الأعلى تورّث صلاحيات ما دونها.
        اضغط <strong>«عرض الصلاحيات»</strong> لقراءة تفاصيل أي رتبة قبل منحها.</p>
    </div>
  </div>

  <% if (catalog.length) { %>
  <div class="ad-role-cat">
    <% catalog.forEach((r, i) => { %>
      <article class="ad-role-card" style="--rc:<%= r.color %>" data-role="<%= r.id %>">
        <span class="ad-rc-stripe" aria-hidden="true"></span>
        <div class="ad-rc-top">
          <span class="ad-rc-rank" title="ترتيب الرتبة"><%= catalog.length - i %></span>
          <span class="ad-rc-icon"><i class="fas fa-<%= r.icon %>"></i></span>
          <div class="ad-rc-name">
            <strong><%= r.label %></strong>
            <small><%= r.en %></small>
          </div>
        </div>
        <p class="ad-rc-tag"><%= r.tagline %></p>
        <div class="ad-rc-meta">
          <span title="عدد الصلاحيات الممنوحة"><i class="fas fa-key"></i> <%= r.permissions.length %> صلاحية</span>
          <span title="رتب ديسكورد المرتبطة بهذه الرتبة"><i class="fas fa-user-tag"></i> <%= r.linkedRoles %> رتبة مرتبطة</span>
        </div>
        <button type="button" class="ad-rc-btn" onclick="openRoleDetails('<%= r.id %>')">
          <i class="fas fa-circle-info"></i> عرض الصلاحيات
        </button>
      </article>
    <% }) %>
  </div>
  <% } %>
</section>

<!-- ═══ جدول مقارنة الصلاحيات ═══ -->
<% if (matrix.rows.length) { %>
<section class="ad-sec">
  <div class="ad-sec-head">
    <div>
      <h2><i class="fas fa-table-list"></i> جدول مقارنة الصلاحيات</h2>
      <p>نظرة سريعة ومقارنة دقيقة على ما تمنحه كل رتبة.</p>
    </div>
    <button type="button" class="btn-sm btn-secondary ad-mx-toggle" onclick="toggleMatrix(this)">
      <i class="fas fa-chevron-down"></i> إظهار الجدول
    </button>
  </div>
  <div class="ad-matrix-wrap" id="adMatrixWrap" hidden>
    <table class="ad-matrix">
      <thead>
        <tr>
          <th class="ad-mx-cap-h">الصلاحية</th>
          <% matrix.roles.forEach(r => { %>
            <th style="--rc:<%= r.color %>"><i class="fas fa-<%= r.icon %>"></i><span><%= r.label %></span></th>
          <% }) %>
        </tr>
      </thead>
      <tbody>
        <% matrix.rows.forEach(row => { %>
          <tr>
            <td class="ad-mx-cap"><%= row.label %></td>
            <% matrix.roles.forEach(r => { %>
              <td>
                <% if (row.has[r.id]) { %><i class="fas fa-check ad-yes" title="ممنوحة"></i><% } else { %><i class="fas fa-minus ad-no" title="غير ممنوحة"></i><% } %>
              </td>
            <% }) %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<% } %>

<!-- ═══ ربط رتب ديسكورد ═══ -->
<div class="card glass">
  <div class="card-header">
    <h3><i class="fas fa-user-tag"></i> ربط رتب ديسكورد بالرتب الإدارية</h3>
    <div class="role-search">
      <i class="fas fa-search"></i>
      <input type="text" id="roleSearch" placeholder="بحث عن رتبة..." oninput="filterRoles()">
    </div>
  </div>
  <p class="ad-roles-note">
    <i class="fas fa-info-circle"></i>
    فعّل أي رتبة ديسكورد ثم اختر لها رتبة إدارية — فيصبح كل أعضائها مدراء في اللوحة بصلاحيات تلك الرتبة.
    القائمة تتحدّث تلقائياً عند منح/سحب الرتبة لأي عضو.
  </p>
  <div class="roles-grid">
    <% (guildRoles || []).forEach(r => {
      const ar = (adminRoles || []).find(a => a.roleId === r.id);
      const col = r.color ? '#' + Number(r.color).toString(16).padStart(6, '0') : 'var(--border)';
    %>
    <div class="admin-role-card <%= ar ? 'active' : '' %>" data-role-id="<%= r.id %>" data-role-name="<%= r.name %>" data-level="<%= ar ? ar.level : '' %>" onclick="selectRole(this, event)">
      <span class="role-color-dot" style="background:<%= col %>"></span>
      <div class="role-info">
        <div class="role-name" title="<%= r.name %>"><%= r.name %></div>
        <div class="role-meta">
          <% if (ar) { %>
            <span class="role-badge role-<%= ar.level %> role-level-badge"><%= LV[ar.level] || ar.level %></span>
          <% } else { %>
            <span style="color:var(--text-muted)">غير مفعّلة</span>
          <% } %>
        </div>
      </div>
      <div class="role-right">
        <span class="role-count" title="عدد أعضاء الرتبة"><i class="fas fa-users"></i> <%= typeof r.members_count === 'number' ? r.members_count : '—' %></span>
        <label class="toggle role-toggle" onclick="event.stopPropagation()">
          <input type="checkbox" <%= ar ? 'checked' : '' %> onchange="toggleRole(this)">
          <span class="toggle-slider"></span>
        </label>
      </div>
    </div>
    <% }) %>
    <% if (!guildRoles || guildRoles.length === 0) { %>
      <div class="roles-empty"><i class="fas fa-users-slash"></i><p>لا توجد رتب معروضة</p></div>
    <% } %>
  </div>
</div>

<% if (adminRoleMembers && adminRoleMembers.length > 0) { %>
<div class="card glass">
  <div class="card-header">
    <h3><i class="fas fa-users"></i> الأعضاء المرتبطون بالرتب الإدارية</h3>
    <div class="admin-members-sync">
      <span id="syncStatus"><%= adminRoleMembers.length %> عضو</span>
    </div>
  </div>
  <div class="admins-table">
    <table>
      <thead>
        <tr>
          <th>العضو</th>
          <th>الرتبة في الداشبورد</th>
          <th>الحالة</th>
        </tr>
      </thead>
      <tbody>
        <% adminRoleMembers.forEach(m => { %>
          <% const dbAdmin = admins.find(a => a.userId === m.id) %>
          <tr>
            <td class="admin-user">
              <img src="https://cdn.discordapp.com/avatars/<%= m.id %>/<%= m.avatar %>.png" alt="" onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
              <span><%= m.globalName || m.username || m.id %></span>
            </td>
            <td><span class="role-badge role-<%= m.highestLevel %>"><%= LV[m.highestLevel] || m.highestLevel %></span></td>
            <td><span class="badge badge-<%= dbAdmin ? 'success' : 'warning' %>"><%= dbAdmin ? 'مضاف' : 'غير مضاف' %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<div class="card glass">
  <div class="card-header">
    <h3><i class="fas fa-user-plus"></i> إضافة مدير يدوي</h3>
  </div>
  <form class="admin-add-form">
    <div class="add-grid">
      <div class="ad-field">
        <label>معرّف العضو أو اسمه</label>
        <input type="text" id="adminUserId" placeholder="User ID أو اسم المستخدم">
      </div>
      <div class="ad-field">
        <label>الرتبة</label>
        <select id="adminRole">
          <% ROLE_ORDER.forEach(role => { %>
            <option value="<%= role %>"><%= LV[role] %></option>
          <% }) %>
        </select>
      </div>
      <button type="button" class="btn-primary ad-add-btn" onclick="addAdmin(event)">
        <i class="fas fa-plus"></i> إضافة
      </button>
    </div>
  </form>
</div>

<div class="card glass">
  <div class="card-header">
    <h3><i class="fas fa-list"></i> قائمة المدراء الحالية</h3>
    <div class="admin-search">
      <i class="fas fa-search"></i>
      <input type="text" id="adminSearch" placeholder="بحث عن مدير..." oninput="filterAdmins()">
    </div>
  </div>
  <div class="admins-table">
    <% if (admins && admins.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>العضو</th>
            <th>الرتبة</th>
            <th>النوع</th>
            <th>تاريخ الإضافة</th>
            <th>إجراءات</th>
          </tr>
        </thead>
        <tbody id="adminsTableBody">
          <% admins.forEach(a => { %>
            <tr class="admin-row" data-name="<%= (a.username || a.userId).toLowerCase() %>" data-id="<%= a.userId %>">
              <td class="admin-user">
                <img src="https://cdn.discordapp.com/avatars/<%= a.userId %>/<%= a.avatar %>.png" alt="" onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
                <span><%= a.globalName || a.username || a.userId %></span>
              </td>
              <td><span class="role-badge role-<%= a.role %>"><%= LV[a.role] || a.role %></span></td>
              <td><span class="badge badge-<%= a.addedBy === 'role_sync' ? 'info' : 'default' %>"><%= a.addedBy === 'role_sync' ? 'تلقائي' : 'يدوي' %></span></td>
              <td><%= new Date(a.addedAt).toLocaleString('ar-SA') %></td>
              <td class="actions">
                <select class="role-select" onchange="updateRole('<%= a.userId %>', this.value)">
                  <% ROLE_ORDER.forEach(role => { %>
                    <option value="<%= role %>" <%= a.role === role ? 'selected' : '' %>><%= LV[role] %></option>
                  <% }) %>
                </select>
                <button class="btn-sm btn-danger" onclick="removeAdmin('<%= a.userId %>')">
                  <i class="fas fa-trash"></i>
                </button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <div class="empty-state"><i class="fas fa-users"></i><p>لا يوجد مدراء بعد — أضف رتب إدارية من الأعلى</p></div>
    <% } %>
  </div>
</div>

<!-- ═══ نافذة تحديد صلاحية الرتبة ═══ -->
<div id="roleModal" class="modal-overlay" style="display:none" onclick="if(event.target===this)closeRoleModal()">
  <div class="modal-box ad-level-modal" onclick="event.stopPropagation()">
    <div class="modal-header">
      <h3 id="roleModalTitle">تحديد صلاحية الرتبة</h3>
      <button class="modal-close" onclick="closeRoleModal()">&times;</button>
    </div>
    <div class="modal-body">
      <p id="roleModalDesc" class="ad-modal-lead">اختر الرتبة الإدارية لهذه الرتبة داخل لوحة التحكم.</p>
      <div class="role-levels">
        <% (catalog.length ? catalog : ROLE_ORDER.map(id => ({ id, label: LV[id], icon: 'circle', color: 'var(--border)', tagline: '', permissions: [] }))).forEach(r => { %>
          <label class="role-level-option" style="--rc:<%= r.color %>">
            <input type="radio" name="roleLevel" value="<%= r.id %>">
            <div class="role-level-card">
              <div class="role-level-head">
                <span class="role-level-icon"><i class="fas fa-<%= r.icon %>"></i></span>
                <span class="role-level-name"><%= r.label %></span>
                <button type="button" class="role-level-more" onclick="event.preventDefault();event.stopPropagation();openRoleDetails('<%= r.id %>')" title="قراءة تفاصيل الرتبة">
                  <i class="fas fa-circle-info"></i> التفاصيل
                </button>
              </div>
              <span class="role-level-desc"><%= r.tagline %></span>
              <ul class="role-perms">
                <% (r.permissions || []).slice(0, 6).forEach(p => { %>
                  <li><i class="fas fa-check"></i> <%= p %></li>
                <% }) %>
                <% if ((r.permissions || []).length > 6) { %>
                  <li class="role-perms-more"><i class="fas fa-ellipsis"></i> و<%= r.permissions.length - 6 %> صلاحيات أخرى…</li>
                <% } %>
              </ul>
            </div>
          </label>
        <% }) %>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-sm btn-secondary" onclick="closeRoleModal()">إلغاء</button>
      <button class="btn-sm btn-primary" id="roleModalConfirm" onclick="confirmRole()">تأكيد</button>
    </div>
  </div>
</div>

<!-- ═══ نافذة تفاصيل الرتبة ═══ -->
<div id="roleDetailsModal" class="modal-overlay" style="display:none" onclick="if(event.target===this)closeRoleDetails()">
  <div class="modal-box ad-details-modal" onclick="event.stopPropagation()">
    <div class="modal-header">
      <h3 id="rdTitle">تفاصيل الرتبة</h3>
      <button class="modal-close" onclick="closeRoleDetails()">&times;</button>
    </div>
    <div class="modal-body">
      <div class="ad-rd-head" id="rdHead"></div>
      <p class="ad-rd-desc" id="rdDesc"></p>
      <div class="ad-rd-perms-title"><i class="fas fa-key"></i> الصلاحيات الممنوحة لهذه الرتبة</div>
      <ul class="ad-rd-perms" id="rdPerms"></ul>
      <p class="ad-rd-foot"><i class="fas fa-circle-info"></i> الرتبة الأعلى تورّث صلاحيات ما دونها تلقائياً داخل اللوحة.</p>
    </div>
    <div class="modal-footer">
      <button class="btn-sm btn-primary" onclick="closeRoleDetails()">تم</button>
    </div>
  </div>
</div>

<style>
  /* ── أقسام الصفحة ── */
  .ad-sec { margin-bottom: 22px; }
  .ad-sec-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin-bottom: 14px; }
  .ad-sec-head h2 { margin: 0 0 4px; font-size: 1.12rem; display: flex; align-items: center; gap: 9px; color: var(--text); }
  .ad-sec-head h2 i { color: var(--primary); }
  .ad-sec-head p { margin: 0; color: var(--text-muted); font-size: .84rem; line-height: 1.85; max-width: 760px; }

  /* ── بطاقات الرتب ── */
  .ad-role-cat { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr)); gap: 14px; }
  .ad-role-card {
    position: relative; overflow: hidden; padding: 16px 16px 14px;
    border-radius: 16px; border: 1px solid var(--border);
    background: linear-gradient(180deg, color-mix(in srgb, var(--rc) 8%, transparent), transparent 60%), var(--card-bg, rgba(255,255,255,.02));
    transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
  }
  .ad-role-card:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--rc) 55%, var(--border)); box-shadow: 0 14px 34px -20px var(--rc); }
  .ad-rc-stripe { position: absolute; inset-inline-start: 0; top: 0; bottom: 0; width: 4px; background: var(--rc); opacity: .9; }
  .ad-rc-top { display: flex; align-items: center; gap: 11px; }
  .ad-rc-rank { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font-size: .72rem; font-weight: 700; color: var(--rc); background: color-mix(in srgb, var(--rc) 16%, transparent); border: 1px solid color-mix(in srgb, var(--rc) 40%, transparent); }
  .ad-rc-icon { width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; font-size: 1.05rem; color: var(--rc); background: color-mix(in srgb, var(--rc) 14%, transparent); border: 1px solid color-mix(in srgb, var(--rc) 34%, transparent); flex: none; }
  .ad-rc-name { display: flex; flex-direction: column; line-height: 1.25; }
  .ad-rc-name strong { font-size: 1.02rem; color: var(--text); }
  .ad-rc-name small { color: var(--text-muted); font-size: .72rem; letter-spacing: .4px; }
  .ad-rc-tag { margin: 12px 0; color: var(--text-muted); font-size: .82rem; line-height: 1.85; min-height: 44px; }
  .ad-rc-meta { display: flex; flex-wrap: wrap; gap: 8px 14px; font-size: .76rem; color: var(--text-muted); margin-bottom: 13px; }
  .ad-rc-meta i { color: var(--rc); margin-inline-end: 4px; }
  .ad-rc-btn {
    width: 100%; border: 1px solid color-mix(in srgb, var(--rc) 42%, var(--border)); cursor: pointer;
    background: color-mix(in srgb, var(--rc) 10%, transparent); color: var(--text);
    border-radius: 10px; padding: 9px 10px; font-family: inherit; font-size: .82rem; font-weight: 600;
    display: flex; align-items: center; justify-content: center; gap: 7px; transition: background .16s ease, border-color .16s ease;
  }
  .ad-rc-btn:hover { background: color-mix(in srgb, var(--rc) 20%, transparent); border-color: var(--rc); }

  /* ── جدول المقارنة ── */
  .ad-matrix-wrap { overflow-x: auto; border-radius: 14px; border: 1px solid var(--border); background: var(--card-bg, rgba(255,255,255,.02)); }
  .ad-matrix { width: 100%; min-width: 680px; border-collapse: collapse; font-size: .82rem; }
  .ad-matrix th, .ad-matrix td { padding: 11px 12px; text-align: center; border-bottom: 1px solid var(--border); }
  .ad-matrix thead th { color: var(--rc, var(--text)); font-weight: 700; background: color-mix(in srgb, var(--rc, var(--primary)) 9%, transparent); }
  .ad-matrix thead th i { display: block; margin-bottom: 5px; font-size: .95rem; }
  .ad-matrix thead th span { font-size: .8rem; }
  .ad-matrix tbody tr:hover { background: rgba(255,255,255,.02); }
  .ad-mx-cap-h, .ad-mx-cap { text-align: start !important; color: var(--text); font-weight: 600; white-space: nowrap; }
  .ad-yes { color: #00e0a4; }
  .ad-no { color: color-mix(in srgb, var(--text-muted) 55%, transparent); }
  .ad-mx-toggle { white-space: nowrap; }

  /* ── ملاحظة الربط ── */
  .ad-roles-note {
    color: var(--text-muted); font-size: .82rem; line-height: 1.85;
    margin: -4px 0 16px; padding: 10px 14px; border-radius: 10px;
    background: rgba(208,0,255,0.07); border: 1px solid rgba(208,0,255,0.2);
  }
  .ad-roles-note i { color: var(--primary); margin-inline-end: 6px; }

  /* ── إضافة مدير ── */
  .admin-add-form { margin: 0; }
  .add-grid { display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; }
  .ad-field { flex: 1 1 220px; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .ad-field label { font-size: .8rem; color: var(--text-muted); }
  .ad-field input, .ad-field select, .admin-add-form select {
    width: 100%; padding: 10px 12px; border-radius: 10px; font-family: inherit; outline: none;
    background: rgba(255,255,255,.03); color: var(--text); border: 1px solid var(--border);
  }
  .ad-field input:focus, .ad-field select:focus { border-color: var(--primary); }
  .ad-add-btn { flex: none; padding: 10px 20px; border-radius: 10px; }

  /* ── نوافذ ── */
  .ad-modal-lead { color: var(--text-muted); font-size: .84rem; margin: 0 0 14px; }
  /* نافذة قصيرة على الشاشات الصغيرة: الرأس والرأس السفلي ثابتان والجسم فقط يمرّر. */
  .ad-level-modal, .ad-details-modal { display: flex; flex-direction: column; max-height: calc(100vh - 48px); max-height: calc(100dvh - 48px); }
  .ad-level-modal .modal-body, .ad-details-modal .modal-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; }
  .ad-level-modal .modal-header, .ad-level-modal .modal-footer,
  .ad-details-modal .modal-header, .ad-details-modal .modal-footer { flex: none; }
  .role-levels { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(210px, 100%), 1fr)); gap: 10px; }
  .role-level-option { cursor: pointer; }
  .role-level-option input { position: absolute; opacity: 0; pointer-events: none; }
  .role-level-card {
    position: relative; height: 100%; padding: 12px; border-radius: 13px; border: 1px solid var(--border);
    background: var(--card-bg, rgba(255,255,255,.02)); transition: border-color .15s ease, background .15s ease;
  }
  .role-level-option input:checked + .role-level-card { border-color: var(--rc); background: color-mix(in srgb, var(--rc) 10%, transparent); box-shadow: 0 0 0 2px color-mix(in srgb, var(--rc) 28%, transparent) inset; }
  .role-level-head { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
  .role-level-icon { width: 30px; height: 30px; border-radius: 9px; display: grid; place-items: center; color: var(--rc); background: color-mix(in srgb, var(--rc) 14%, transparent); flex: none; }
  .role-level-name { font-weight: 700; color: var(--text); }
  .role-level-more { margin-inline-start: auto; border: 0; cursor: pointer; background: transparent; color: var(--text-muted); font-family: inherit; font-size: .72rem; display: inline-flex; gap: 4px; align-items: center; }
  .role-level-more:hover { color: var(--rc); }
  .role-level-desc { display: block; color: var(--text-muted); font-size: .74rem; line-height: 1.6; margin-bottom: 8px; }
  .role-perms { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .role-perms li { font-size: .73rem; color: var(--text-muted); display: flex; gap: 6px; align-items: flex-start; line-height: 1.5; }
  .role-perms li i { color: #00e0a4; font-size: .68rem; margin-top: 3px; }
  .role-perms-more { color: var(--text-muted); font-style: italic; }
  .role-perms-more i { color: var(--text-muted) !important; }

  .ad-details-modal .modal-body { padding-top: 6px; }
  .ad-rd-head { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
  .ad-rd-head .rd-icon { width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center; font-size: 1.15rem; color: var(--rc); background: color-mix(in srgb, var(--rc) 15%, transparent); border: 1px solid color-mix(in srgb, var(--rc) 38%, transparent); }
  .ad-rd-head .rd-titles { display: flex; flex-direction: column; gap: 3px; }
  .ad-rd-head .rd-titles strong { font-size: 1.15rem; color: var(--text); }
  .ad-rd-head .rd-pill { align-self: flex-start; font-size: .68rem; padding: 2px 9px; border-radius: 999px; color: var(--rc); background: color-mix(in srgb, var(--rc) 14%, transparent); border: 1px solid color-mix(in srgb, var(--rc) 35%, transparent); }
  .ad-rd-desc { color: var(--text-muted); font-size: .86rem; line-height: 1.95; margin: 0 0 16px; }
  .ad-rd-perms-title { font-weight: 700; color: var(--text); font-size: .88rem; margin-bottom: 10px; display: flex; align-items: center; gap: 7px; }
  .ad-rd-perms-title i { color: var(--rc); }
  .ad-rd-perms { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(230px, 100%), 1fr)); gap: 8px; }
  .ad-rd-perms li { display: flex; gap: 8px; align-items: center; font-size: .82rem; color: var(--text); padding: 8px 11px; border-radius: 10px; background: rgba(255,255,255,.03); border: 1px solid var(--border); }
  .ad-rd-perms li i { color: #00e0a4; }
  .ad-rd-foot { margin: 16px 0 0; color: var(--text-muted); font-size: .76rem; display: flex; gap: 7px; align-items: center; }

  @media (max-width: 560px) {
    .ad-rc-tag { min-height: 0; }
    .ad-matrix { font-size: .76rem; }
  }
</style>

<script>
const GUILD_ID = '<%= guild.id %>';
const LEVEL_NAMES = <%- JSON.stringify(LV) %>;
const ROLE_CATALOG = <%- JSON.stringify((catalog.length ? catalog : []).map(r => ({
  id: r.id, label: r.label, en: r.en, icon: r.icon, color: r.color,
  tagline: r.tagline, description: r.description, permissions: r.permissions || [],
}))) %>;
const ROLE_BY_ID = Object.fromEntries(ROLE_CATALOG.map(r => [r.id, r]));
let pendingRoleData = null;

function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c])); }

/* ── نافذة تحديد الرتبة ── */
function openRoleModal(guildId, roleId, roleName, currentLevel, el) {
  pendingRoleData = { guildId, roleId, roleName, currentLevel, el, wasActive: el.classList.contains('active') };
  document.getElementById('roleModalTitle').textContent = 'صلاحية الرتبة: ' + roleName;
  document.getElementById('roleModalDesc').textContent = 'اختر الرتبة الإدارية التي سيحصل عليها أعضاء «' + roleName + '» داخل لوحة التحكم.';
  document.querySelectorAll('input[name="roleLevel"]').forEach(r => { r.checked = r.value === currentLevel; });
  document.getElementById('roleModal').style.display = 'flex';
}

function closeRoleModal() {
  document.getElementById('roleModal').style.display = 'none';
  if (pendingRoleData && !pendingRoleData.wasActive) {
    pendingRoleData.el.classList.remove('active');
    const cb = pendingRoleData.el.querySelector('.role-toggle input');
    if (cb) cb.checked = false;
  }
  pendingRoleData = null;
}

function selectRole(card, event) {
  if (event.target.closest('.role-toggle')) return;
  openRoleModal(GUILD_ID, card.dataset.roleId, card.dataset.roleName, card.dataset.level || '', card);
}

async function toggleRole(input) {
  const card = input.closest('.admin-role-card');
  const roleId = card.dataset.roleId;
  const name = card.dataset.roleName;

  if (input.checked) {
    openRoleModal(GUILD_ID, roleId, name, card.dataset.level || '', card);
    return;
  }

  if (!confirm('إلغاء ربط الدور «' + name + '»؟ سيتم إزالة أعضائه من قائمة المدراء تلقائياً.')) {
    input.checked = true;
    return;
  }
  try {
    const res = await fetch(`/admins/${GUILD_ID}/unlink`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ roleId }),
    });
    const data = await res.json();
    if (data.success) {
      showToast('✅ تم إلغاء الربط والمزامنة');
      setTimeout(() => location.reload(), 1000);
    } else {
      showToast('❌ ' + (data.error || data.message));
      input.checked = true;
    }
  } catch {
    showToast('❌ فشل الاتصال');
    input.checked = true;
  }
}

async function confirmRole() {
  if (!pendingRoleData) return;
  const { guildId, roleId, roleName, el, wasActive } = pendingRoleData;
  const selected = document.querySelector('input[name="roleLevel"]:checked');
  if (!selected) { showToast('❌ اختر رتبة إدارية'); return; }
  const level = selected.value;
  const btn = document.getElementById('roleModalConfirm');
  let succeeded = false;
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

  try {
    el.classList.add('active');
    const res = await fetch(`/admins/${guildId}/set-role`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ roleId, level }),
    });
    const data = await res.json();
    if (data.success) {
      succeeded = true;
      const n = data.memberCount != null ? data.memberCount : (data.added || 0);
      showToast(data.warning
        ? `✅ تم ربط الرتبة — ⚠️ ${data.warning}`
        : `✅ ${n} عضو من ${roleName} أصبحوا مدراء بصلاحيات "${LEVEL_NAMES[level] || level}"`);
    } else {
      showToast('❌ ' + (data.error || data.message));
    }
    if (data.success) setTimeout(() => location.reload(), 1000);
  } catch (err) {
    showToast('❌ فشلت العملية');
    if (!pendingRoleData.wasActive) pendingRoleData.el.classList.remove('active');
  }
  const btn2 = document.getElementById('roleModalConfirm');
  btn2.disabled = false;
  btn2.innerHTML = 'تأكيد';
  if (!succeeded && pendingRoleData && !pendingRoleData.wasActive) pendingRoleData.el.classList.remove('active');
  if (succeeded) closeRoleModal();
}

function openRoleDetails(id) {
  const r = ROLE_CATALOG.find(x => x.id === id);
  if (!r) return;
  const head = document.getElementById('rdHead');
  head.style.setProperty('--rc', r.color);
  head.innerHTML =
    '<div class="rd-icon"><i class="fas fa-' + r.icon + '"></i></div>' +
    '<div class="rd-titles"><strong>' + r.label + '</strong>' +
    '<span class="rd-pill">' + (r.en || '') + '</span></div>';
  document.getElementById('rdDesc').textContent = r.description || r.tagline || '';
  const perms = document.getElementById('rdPerms');
  perms.innerHTML = (r.permissions || []).map(p =>
    '<li><i class="fas fa-check"></i> ' + p + '</li>').join('') ||
    '<li><i class="fas fa-circle-info"></i> لا توجد صلاحيات إضافية.</li>';
  perms.style.setProperty('--rc', r.color);
  document.getElementById('roleDetailsModal').style.display = 'flex';
}

function closeRoleDetails() {
  document.getElementById('roleDetailsModal').style.display = 'none';
}

function toggleMatrix(btn) {
  const wrap = document.getElementById('adMatrixWrap');
  const open = wrap.hasAttribute('hidden');
  if (open) wrap.removeAttribute('hidden'); else wrap.setAttribute('hidden', '');
  btn.innerHTML = open
    ? '<i class="fas fa-chevron-up"></i> إخفاء الجدول'
    : '<i class="fas fa-chevron-down"></i> إظهار الجدول';
}

function filterRoles() {
  const q = (document.getElementById('roleSearch').value || '').trim().toLowerCase();
  document.querySelectorAll('.admin-role-card').forEach(card => {
    const name = (card.dataset.roleName || '').toLowerCase();
    card.style.display = !name || name.includes(q) ? '' : 'none';
  });
}

function filterAdmins() {
  const q = document.getElementById('adminSearch').value.trim().toLowerCase();
  document.querySelectorAll('.admin-row').forEach(row => {
    const hit = (row.dataset.name || '').includes(q) || (row.dataset.id || '').includes(q);
    row.style.display = hit ? '' : 'none';
  });
}

async function addAdmin(event) {
  const input = document.getElementById('adminUserId');
  const userId = (input.value || '').trim();
  const role = document.getElementById('adminRole').value;
  if (!userId) { showToast('❌ أدخل معرّف العضو'); return; }
  const btn = document.querySelector('.ad-add-btn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
  try {
    const res = await fetch(`/admins/${GUILD_ID}/add`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ userId, role }),
    });
    const data = await res.json();
    showToast(data.success ? '✅ تمت الإضافة' : '❌ ' + (data.error || data.message));
    if (data.success) location.reload();
  } catch { showToast('❌ فشل الاتصال'); }
  btn.disabled = false;
  btn.innerHTML = '<i class="fas fa-plus"></i> إضافة';
}

async function removeAdmin(userId) {
  if (!confirm('إزالة المدير؟')) return;
  const res = await fetch(`/admins/${GUILD_ID}/remove`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ userId }),
  });
  if (res.ok) { showToast('✅ تمت الإزالة'); location.reload(); }
  else { const d = await res.json(); showToast('❌ ' + (d.error || d.message)); }
}

async function updateRole(userId, role) {
  const res = await fetch(`/admins/${GUILD_ID}/update-role`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ userId, role }),
  });
  const data = await res.json();
  showToast(data.success ? '✅ تم التحديث' : '❌ ' + (data.error || data.message));
}

async function syncAdmins(e) {
  const btn = e.currentTarget;
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري المزامنة...';
  try {
    const res = await fetch(`/admins/${GUILD_ID}/sync`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
    });
    const data = await res.json();
    showToast(data.success ? `✅ ${data.message}` : '❌ ' + (data.message || data.error));
    if (data.success) setTimeout(() => location.reload(), 1500);
  } catch { showToast('❌ فشلت المزامنة'); }
  btn.disabled = false;
  btn.innerHTML = '<i class="fas fa-sync-alt"></i> مزامنة المدراء';
}
</script>

<% currentPage = 'voice' %>
<div class="page-header">
  <h1><i class="fas fa-microphone"></i> القنوات الصوتية المؤقتة — <%= guild.name %></h1>
  <p>عدد القنوات النشطة: <%= voiceChannels.length %></p>
</div>

<div class="card glass">
  <div class="card-header"><h3><i class="fas fa-list"></i> القنوات النشطة حالياً</h3></div>
  <div class="voice-list">
    <% if (voiceChannels && voiceChannels.length > 0) { %>
      <% voiceChannels.forEach(vc => { %>
        <div class="voice-item">
          <div class="voice-info">
            <i class="fas fa-microphone"></i>
            <div>
              <strong><%= vc.name || vc.vcId %></strong>
              <span>👑 <%- vc.ownerId %></span>
            </div>
          </div>
          <div class="voice-meta">
            <span><i class="fas fa-clock"></i> <%= new Date(vc.createdAt || Date.now()).toLocaleString('ar-SA') %></span>
            <button class="btn-sm btn-danger" onclick="deleteVoice('<%= vc.vcId %>')">
              <i class="fas fa-trash"></i>
            </button>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="empty-state">
        <i class="fas fa-microphone-slash"></i>
        <p>لا توجد قنوات صوتية مؤقتة نشطة حالياً</p>
      </div>
    <% } %>
  </div>
</div>

<script>
async function deleteVoice(channelId) {
  if (!confirm('هل أنت متأكد من حذف هذه القناة الصوتية؟')) return;
  const res = await fetch('/voice/<%= guild.id %>/delete', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ channelId }),
  });
  if (res.ok) {
    showToast('✅ تم حذف القناة');
    location.reload();
  }
}
</script>

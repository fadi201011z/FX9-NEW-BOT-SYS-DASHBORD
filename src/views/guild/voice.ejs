<% currentPage = 'voice' %>
<div class="page-header">
  <h1><i class="fas fa-microphone"></i> القنوات الصوتية المؤقتة — <%= guild.name %></h1>
  <p>عدد القنوات النشطة: <%= voiceChannels.length %></p>
</div>

<div class="card glass">
  <div class="card-header"><h3><i class="fas fa-list"></i> القنوات النشطة حالياً</h3></div>
  <div class="voice-list">
    <% if (voiceChannels && voiceChannels.length > 0) { %>
      <% voiceChannels.forEach(vc => { %>
        <div class="voice-item">
          <div class="voice-info">
            <i class="fas fa-microphone"></i>
            <div>
              <strong><%= vc.name || vc.vcId %></strong>
              <span class="voice-owner">👑 المالك: <%- vc.ownerId ? `<@${vc.ownerId}>` : 'غير معروف' %></span>
            </div>
          </div>
          <div class="voice-meta">
            <span><i class="fas fa-clock"></i> <%= new Date(vc.createdAt || Date.now()).toLocaleString('ar-SA') %></span>
            <button class="btn-sm btn-danger" onclick="deleteVoice('<%= vc.vcId %>', '<%= vc.name || vc.vcId %>')" title="حذف القناة من السيرفر">
              <i class="fas fa-trash"></i> حذف
            </button>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="empty-state">
        <i class="fas fa-microphone-slash"></i>
        <p>لا توجد قنوات صوتية مؤقتة نشطة حالياً</p>
      </div>
    <% } %>
  </div>
</div>

<script>
async function deleteVoice(channelId, name) {
  if (!confirm(`هل أنت متأكد من حذف "${name}" من السيرفر؟`)) return;
  const btn = event.target.closest('button');
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
  try {
    const res = await fetch('/voice/<%= guild.id %>/delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ channelId }),
    });
    const data = await res.json();
    if (data.success) {
      showToast('✅ تم حذف القناة من السيرفر');
      location.reload();
    } else {
      showToast('❌ ' + (data.error || 'فشل الحذف'));
      btn.disabled = false; btn.innerHTML = '<i class="fas fa-trash"></i> حذف';
    }
  } catch {
    showToast('❌ فشل الاتصال');
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-trash"></i> حذف';
  }
}
</script>

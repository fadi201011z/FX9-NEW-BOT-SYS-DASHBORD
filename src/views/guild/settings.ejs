      <span class="progress-line"></span>
      <div class="ticket-progress-item" data-for="ticket_category">
        <span class="step-ic"><i class="fas fa-folder-open"></i></span>
        <span class="step-name">التصنيف</span>
        <span class="step-check"><i class="fas fa-check"></i></span>
      </div>
      <span class="progress-line"></span>
      <div class="ticket-progress-item" data-for="admin_category">
        <span class="step-ic"><i class="fas fa-folder-tree"></i></span>
        <span class="step-name">التصنيف الداخلي</span>
        <span class="step-check"><i class="fas fa-check"></i></span>

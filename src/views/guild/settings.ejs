              <button type="button" class="btn-sm btn-save-img" data-img-save="voice_panel_image"><i class="fas fa-save"></i> حفظ</button>
              <button type="button" class="btn-sm btn-view-img" data-img-view="voice_panel_image" title="عرض الصورة الحالية"><i class="fas fa-eye"></i> عرض الصورة الحالية</button>
              <button type="button" class="btn-delete-sm" data-img-delete="voice_panel_image" title="استعادة الصورة الافتراضية"><i class="fas fa-trash"></i></button>
              <span class="ticket-field-state" data-state-of="voice_panel_image"><i class="fas fa-check-circle"></i><span>افتراضي</span></span>
            </div>
          </div>
        </div>
        </div>

        <div class="ci-pane ci-pane-embed" data-ci-pane="voice_panel_image" data-ci-kind="embed" hidden>
          <div class="ci-embed-card">
            <div class="em-preview ci-embed-preview" data-ci-preview="voice_panel_image"></div>
            <div class="ci-embed-actions">
              <button type="button" class="btn-save-img" data-ci-edit="voice_panel_image"><i class="fas fa-pen-ruler" aria-hidden="true"></i> تخصيص الإمبد</button>
              <span class="ci-embed-state" data-ci-state="voice_panel_image">لا يوجد امبد بعد — اضغط «تخصيص الإمبد»</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ⑦ البريميوم -->
  <% if (premium) { %>
    <div class="card glass st-prem">
      <div class="st-prem-icon"><i class="fas fa-gem"></i></div>
      <div class="st-prem-text">
        <strong>باقة <span><%= premium.plan %></span> مفعّلة <span class="st-prem-days"><%= premium.daysLeft %> يوم</span> متبقية</strong>
        <span>سيرفرك يستفيد من كل مزايا النظام — أدر الباقة أو جدّدها من صفحة البريميوم.</span>
      </div>
      <a href="/premium/<%= guild.id %>" class="btn-sm">إدارة الباقة <i class="fas fa-arrow-left" aria-hidden="true"></i></a>
    </div>
  <% } else { %>
    <div class="card glass st-prem is-cta">
      <div class="st-prem-icon"><i class="fas fa-gem"></i></div>
      <div class="st-prem-text">
        <strong>فعّل البريميوم لفتح كل الأنظمة</strong>
        <span>إحصائيات متقدمة وأولوية معالجة وتخصيص أعمق — اكتشف الباقات المتاحة.</span>
      </div>
      <a href="/premium/<%= guild.id %>" class="btn-sm">تصفح البريميوم <i class="fas fa-arrow-left" aria-hidden="true"></i></a>
    </div>
  <% } %>

  <!-- ⑧ أنظمة أخرى تُدار من هنا -->
  <div class="card glass st-sys">
    <div class="card-header">
      <h3><i class="fas fa-layer-group"></i> أنظمة أخرى لسيرفرك</h3>
      <span class="badge badge-default">6 أنظمة</span>
    </div>
    <p class="card-desc">هذه الصفحة هي مركز الإعدادات — وبقية الأنظمة تُضبط في صفحاتها المخصصة:</p>
    <div class="st-sysgrid">
      <% sysTiles.forEach(t => { %>
        <a class="st-systile" href="<%= t[0] %>">
          <span class="st-systile-icon"><i class="fas <%= t[1] %>" aria-hidden="true"></i></span>
          <span class="st-systile-body"><strong><%= t[2] %></strong><small><%= t[3] %></small></span>
          <i class="fas fa-arrow-left st-systile-go" aria-hidden="true"></i>
        </a>
      <% }) %>
    </div>
  </div>

  <div class="actions-bar">
    <button type="submit" class="btn-primary" id="saveBtn">
      <i class="fas fa-save"></i> حفظ جميع الإعدادات
    </button>
    <button type="button" class="btn-secondary" onclick="syncNow()">
      <i class="fas fa-sync-alt"></i> مزامنة البوت الآن
    </button>
  </div>
</form>


<% currentPage = 'settings' %>
<%
  // — مركز الإعدادات: دليل موجّه يشرح كل خاصية ومتى/كيف تستخدمها،
  //   مع الحفاظ على كل خطافات الحفظ والتفاعل كما هي.
  const ticketReady = ['panel_channel', 'ticket_category', 'admin_category', 'log_channel_id'].filter(k => config[k]).length;
  const logReady = ['log_channel', 'modlog_channel', 'botlog_channel'].filter(k => config[k]).length;
  const statsReady = ['stats_total', 'stats_online', 'stats_bots'].filter(k => config[k]).length;
  const welcomeSet = !!config.welcome_channel;
  const supportCount = (supportRoleArray || []).length;
  const premExp = Number(config.premium_expires_at) || 0;
  const premium = (config.premium_plan && premExp > Date.now())
    ? { plan: config.premium_plan, daysLeft: Math.max(1, Math.ceil((premExp - Date.now()) / 86400000)) }
    : null;
  const imgCustom = ['welcome_image', 'ticket_panel_image', 'voice_panel_image'].filter(k => config[k]).length;

  // مُهيّئات محرر صورة الترحيب: الموضع/الحجم/الإطار الافتراضية + صورة العضو التجريبية.
  const waNum = (v, d) => {
    const n = Number(v);
    return (v === undefined || v === null || v === '' || !Number.isFinite(n)) ? d : n;
  };
  const waInit = {
    x: waNum(config.welcome_avatar_x, 1340),
    y: waNum(config.welcome_avatar_y, 527),
    size: waNum(config.welcome_avatar_size, 512),
    ring: config.welcome_avatar_ring === undefined ? true : String(config.welcome_avatar_ring) === '1',
    ringColor: /^#[0-9a-f]{6}$/i.test(config.welcome_avatar_ring_color || '') ? config.welcome_avatar_ring_color : '#ffffff',
    ringWidth: waNum(config.welcome_avatar_ring_width, 5),
  };
  const waAvatarUrl = (user && user.avatar && user.id)
    ? 'https://cdn.discordapp.com/avatars/' + user.id + '/' + user.avatar + '.png?size=256'
    : 'https://cdn.discordapp.com/embed/avatars/' + (Number(user && user.discriminator) % 5) + '.png';

  // خطوات دليل البدء: ما تفعله كل خاصية ولماذا تفيدك — مبنية من نفس الإعدادات.
  const stSteps = [
    { id: 'st-welcome', icon: 'fa-door-open', name: 'تفعيل بطاقة الترحيب', desc: 'بطاقة باسم العضو وصورته ورقمه تُرسل تلقائياً عند دخوله السيرفر', done: welcomeSet, label: welcomeSet ? 'مفعّلة' : 'لم تُفعّل بعد' },
    { id: 'st-logs', icon: 'fa-clipboard-list', name: 'توجيه قنوات السجلات', desc: 'السجلات العامة والإشراف والبوت — لكل نوع قناة خاصة به (أو واحدة للجميع)', done: logReady >= 1, label: logReady + ' من 3 قنوات' },
    { id: 'st-stats', icon: 'fa-chart-line', name: 'إنشاء رومات الإحصائيات', desc: 'رومات صوتية تعرض الأعداد في الاسم وتتحدث تلقائياً كل دقيقة', done: statsReady >= 1, label: statsReady + ' من 3 رومات' },
    { id: 'st-tickets', icon: 'fa-ticket', name: 'استكمال نظام التذاكر', desc: 'بنل + تصنيف التذاكر + تصنيفها الداخلي + سجلها — أربع خطوات مرتبطة', done: ticketReady >= 3, label: ticketReady + ' من 4 خطوات' },
    { id: 'st-support', icon: 'fa-headset', name: 'اختيار فريق الدعم', desc: 'الرتب التي تتسلم التذاكر الجديدة وترد عليها وتديرها', done: supportCount > 0, label: supportCount > 0 ? supportCount + ' رتبة' : 'لا رتب بعد' },
    { id: 'st-images', icon: 'fa-images', name: 'تخصيص صور النظام', desc: 'خلفية الترحيب وبنل التذاكر وبنل الصوتيات — صور افتراضية تصلك فوراً', done: imgCustom > 0, label: imgCustom > 0 ? imgCustom + ' مخصصة' : 'الافتراضية' },
  ];
  const statusCells = [
    { icon: 'fa-door-open', name: 'الترحيب', v: welcomeSet, sub: welcomeSet ? 'مفعّل' : 'متوقف' },
    { icon: 'fa-clipboard-list', name: 'السجلات', v: logReady, max: 3, sub: logReady + '/3' },
    { icon: 'fa-chart-line', name: 'الإحصائيات', v: statsReady, max: 3, sub: statsReady + '/3' },
    { icon: 'fa-ticket', name: 'التذاكر', v: ticketReady, max: 4, sub: ticketReady + '/4' },
    { icon: 'fa-headset', name: 'الدعم', v: supportCount, sub: supportCount + (supportCount === 1 ? ' رتبة' : ' رتب') },
  ];
  const sysTiles = [
    ['/protection/' + guild.id, 'fa-shield-halved', 'نظام الحماية', '5 أنظمة ضد الهجمات وسبام'],
    ['/commands/' + guild.id, 'fa-terminal', 'الأوامر', 'إدارة وتفعيل أوامر البوت'],
    ['/voice/' + guild.id, 'fa-microphone', 'الرومات المؤقتة', 'غرف صوتية تُنشأ عند دخول العضو'],
    ['/notifications/' + guild.id, 'fa-bell', 'الإشعارات والإمبد', 'إشعارات تنبيه صوت نصي للمتابعة'],
    ['/backup/' + guild.id, 'fa-database', 'النسخ الاحتياطي', 'نسخ احتياطية لإعدادات السيرفر'],
    ['/admins/' + guild.id, 'fa-users-gear', 'المدراء', 'من يستطيع التحكم في اللوحة'],
  ];
%>

<div class="page-header st-header">
  <div>
    <h1><i class="fas fa-sliders"></i> إعدادات سيرفر <span class="st-guild"><%= guild.name %></span></h1>
    <p>المركز الذي تُدار منه كل أنظمة البوت — كل تعديل يُحفظ في القاعدة ويُطبَّق على البوت خلال ثوانٍ.</p>
  </div>
  <% if (premium) { %>
    <a href="/premium/<%= guild.id %>" class="st-prem-chip"><i class="fas fa-gem" aria-hidden="true"></i> باقة <%= premium.plan %> — متبقي <%= premium.daysLeft %> يوم</a>
  <% } %>
</div>

<!-- ─── دليل البدء السريع: فهم الصفحة قبل الضبط ─── -->
<div class="card glass st-guide">
  <div class="card-header">
    <h3><i class="fas fa-route"></i> كيف تبدأ؟ — دليل تفعيل الأنظمة خطوة بخطوة</h3>
    <span class="badge badge-default"><%= stSteps.filter(s => s.done).length %>/<%= stSteps.length %> مكتملة</span>
  </div>
  <p class="card-desc">اضغط أي خطوة للانتقال إلى إعدادها بالأسفل — كل خطوة تشرح ما تفعله الخاصية لماذا تستخدمها.</p>
  <div class="st-guide-grid">
    <% stSteps.forEach((s, i) => { %>
      <a class="st-guide-step <%= s.done ? 'is-done' : '' %>" href="#<%= s.id %>">
        <span class="st-guide-num"><i class="fas <%= s.icon %>" aria-hidden="true"></i></span>
        <span class="st-guide-body">
          <strong><%= s.name %></strong>
          <span><%= s.desc %></span>
        </span>
        <span class="st-guide-pill <%= s.done ? 'ok' : '' %>"><i class="fas <%= s.done ? 'fa-check' : 'fa-hourglass-half' %>" aria-hidden="true"></i> <%= s.label %></span>
      </a>
    <% }) %>
  </div>
</div>

<!-- ─── شريط الحالة السريعة ─── -->
<div class="st-status-strip">
  <% statusCells.forEach(c => { %>
    <div class="st-status-cell <%= (c.v && c.v >= (c.max || 1)) ? 'ok' : (c.v > 0 ? 'mid' : 'no') %>">
      <i class="fas <%= c.icon %>" aria-hidden="true"></i>
      <span class="st-status-name"><%= c.name %></span>
      <span class="st-status-sub"><%= c.sub %></span>
    </div>
  <% }) %>
</div>

<div class="card glass sync-bar">
  <div class="sync-bar-info">
    <i class="fas fa-bolt"></i>
    <div>
      <strong>المزامنة الفورية</strong>
      <p>كل تعديل يُحفظ في قاعدة البيانات ويُطبَّق على البوت خلال ثوانٍ — أو فورياً عبر زر المزامنة.</p>
    </div>
  </div>
  <div class="sync-bar-actions">
    <span id="syncStatus" class="sync-idle"><i class="fas fa-circle"></i> مزامنة تلقائية عند كل حفظ</span>
    <button type="button" class="btn-primary" onclick="syncNow()">
      <i class="fas fa-sync-alt"></i> مزامنة الآن
    </button>
  </div>
</div>

<form id="settingsForm" onsubmit="saveSettings(event)">

  <!-- ① الترحيب -->
  <div class="card glass welcome-card st-section" id="st-welcome">
    <div class="card-header st-sec-head">
      <span class="st-sec-num">1</span>
      <h3><i class="fas fa-door-open"></i> نظام الترحيب</h3>
      <span class="ticket-status" id="welcomeStatusBadge"><span class="ticket-status-dot"></span><span id="welcomeStatusText">—</span></span>
    </div>
    <p class="card-desc">بطاقة ترحيب مخصصة (صورة) تُرسل تلقائياً عند انضمام كل عضو جديد إلى السيرفر.</p>

    <div class="st-steps">
      <span><b>1</b>اختر قناة الترحيب من القائمة</span>
      <span><b>2</b>احفظ — تُرسل بطاقة فورية لكل عضو جديد</span>
      <span><b>3</b>الترحيب يكتشف موجات الانضمام والحسابات الجديدة</span>
    </div>

    <div class="welcome-main">
      <div class="welcome-preview">
        <div class="preview-card">
          <div class="preview-banner">
            <span class="preview-badge"><%= guild.name %></span>
            <i class="fas fa-camera preview-cam"></i>
          </div>
          <div class="preview-body">
            <span class="preview-avatar"><img src="<%= waAvatarUrl %>" alt=""></span>
            <div class="preview-text">
              <strong>أهلاً بك في سيرفرنا!</strong>
              <span>أنت العضو رقم <b>#8b0000</b></span>
            </div>
          </div>
          <div class="preview-footer">✦ Welcome <b>Nyaorox</b> To <%= guild.name %> ✨</div>
        </div>
      </div>

      <div class="welcome-config">
        <div class="stat-voice-item item-lg-general" data-for="welcome_channel">
          <div class="stat-voice-icon"><i class="fas fa-paper-plane"></i></div>
          <div class="stat-voice-info">
            <strong>قناة الترحيب</strong>
            <small>القناة التي تُرسل إليها بطاقة الترحيب — اختر قناة نصية ظاهرة للأعضاء</small>
          </div>
          <div class="stat-voice-control">
            <select data-key="welcome_channel" class="ticket-select">
              <option value="">— بدون (معطّل) —</option>
              <% (channels.text || []).forEach(ch => { %>
                <option value="<%= ch.id %>" <%= String(config.welcome_channel || '') === String(ch.id) ? 'selected' : '' %>><%= ch.name %></option>
              <% }) %>
            </select>
            <div class="stat-voice-tools">
              <span class="ticket-field-state" data-state-of="welcome_channel"><i class="fas fa-check-circle"></i><span>مضبوط</span></span>
              <button type="button" class="btn-delete-sm" onclick="deleteSetting('welcome_channel')" title="إلغاء هذا الإعداد"><i class="fas fa-trash"></i></button>
            </div>
          </div>
        </div>

        <div class="welcome-notice">
          <i class="fas fa-magic"></i>
          <div>
            <strong>تُنشأ البطاقة تلقائياً</strong>
            <span>باسم العضو وصورته ورقمه التسلسلي — مع كشف موجات الانضمام (Raid) وحسابات جديدة</span>
          </div>
        </div>
        <small class="field-hint st-ex"><i class="fas fa-lightbulb"></i> مثال: اختر قناة «الترحيب» — سيرى كل عضو جديد بطاقة باسمه وصورته عند دخوله أول مرة.</small>
      </div>
    </div>
  </div>

  <!-- ② قنوات السجلات -->
  <div class="card glass log-card st-section" id="st-logs">
    <div class="card-header st-sec-head">
      <span class="st-sec-num">2</span>
      <h3><i class="fas fa-clipboard-list"></i> قنوات السجلات</h3>
      <span class="ticket-status" id="logStatusBadge"><span class="ticket-status-dot"></span><span id="logStatusText">—</span></span>
    </div>
    <p class="card-desc">ثلاثة أنواع من السجلات، ولكل نوع أحداثه الخاصة — اختر قناة لكل نوع، أو استخدم قناة واحدة للثلاثة معاً.</p>

    <div class="stats-voice-grid log-grid">
      <div class="stat-voice-item item-lg-general" data-for="log_channel">
        <div class="stat-voice-icon"><i class="fas fa-list"></i></div>
        <div class="stat-voice-info">
          <strong>السجلات العامة</strong>
          <small>كل حركة النشاط في السيرفر</small>
          <span class="st-events"><i>انضمام</i><i>مغادرة</i><i>رسائل</i><i>صوت</i></span>
        </div>
        <div class="stat-voice-control">
          <select data-key="log_channel" class="ticket-select">
            <option value="">— بدون (معطّل) —</option>
            <% (channels.text || []).forEach(ch => { %>
              <option value="<%= ch.id %>" <%= String(config.log_channel || '') === String(ch.id) ? 'selected' : '' %>><%= ch.name %></option>
            <% }) %>
          </select>
          <div class="stat-voice-tools">
            <span class="ticket-field-state" data-state-of="log_channel"><i class="fas fa-check-circle"></i><span>مضبوط</span></span>
            <button type="button" class="btn-delete-sm" onclick="deleteSetting('log_channel')" title="إلغاء هذا الإعداد"><i class="fas fa-trash"></i></button>
          </div>
        </div>
      </div>

      <div class="stat-voice-item item-lg-mod" data-for="modlog_channel">
        <div class="stat-voice-icon"><i class="fas fa-gavel"></i></div>
        <div class="stat-voice-info">
          <strong>سجلات الإشراف</strong>
          <small>كل إجراءات فريق الإشراف</small>
          <span class="st-events"><i>Ban</i><i>Kick</i><i>Timeout</i><i>Warn</i><i>الأدوار</i></span>
        </div>
        <div class="stat-voice-control">
          <select data-key="modlog_channel" class="ticket-select">
            <option value="">— بدون (معطّل) —</option>
            <% (channels.text || []).forEach(ch => { %>
              <option value="<%= ch.id %>" <%= String(config.modlog_channel || '') === String(ch.id) ? 'selected' : '' %>><%= ch.name %></option>
            <% }) %>
          </select>
          <div class="stat-voice-tools">
            <span class="ticket-field-state" data-state-of="modlog_channel"><i class="fas fa-check-circle"></i><span>مضبوط</span></span>
            <button type="button" class="btn-delete-sm" onclick="deleteSetting('modlog_channel')" title="إلغاء هذا الإعداد"><i class="fas fa-trash"></i></button>
          </div>
        </div>
      </div>

      <div class="stat-voice-item item-lg-bot" data-for="botlog_channel">
        <div class="stat-voice-icon"><i class="fas fa-heartbeat"></i></div>
        <div class="stat-voice-info">
          <strong>سجل البوت</strong>
          <small>حالة البوت نفسه وتشخيصه</small>
          <span class="st-events"><i>تشغيل</i><i>إيقاف</i><i>أخطاء</i><i>تقرير دوري</i></span>
        </div>
        <div class="stat-voice-control">
          <select data-key="botlog_channel" class="ticket-select">
            <option value="">— بدون (معطّل) —</option>
            <% (channels.text || []).forEach(ch => { %>
              <option value="<%= ch.id %>" <%= String(config.botlog_channel || '') === String(ch.id) ? 'selected' : '' %>><%= ch.name %></option>
            <% }) %>
          </select>
          <div class="stat-voice-tools">
            <span class="ticket-field-state" data-state-of="botlog_channel"><i class="fas fa-check-circle"></i><span>مضبوط</span></span>
            <button type="button" class="btn-delete-sm" onclick="deleteSetting('botlog_channel')" title="إلغاء هذا الإعداد"><i class="fas fa-trash"></i></button>
          </div>
        </div>
      </div>
    </div>

    <small class="field-hint role-picker-hint">
      <i class="fas fa-info-circle"></i>
      يمكنك إرسال جميع السجلات إلى قناة واحدة باستخدام نفس القناة في الأنواع الثلاثة — خيار مثالي للسيرفرات الصغيرة.
    </small>
  </div>

  <!-- ③ الإحصائيات الصوتية -->
  <div class="card glass stats-card st-section" id="st-stats">
    <div class="card-header st-sec-head">
      <span class="st-sec-num">3</span>
      <h3><i class="fas fa-chart-line"></i> الإحصائيات الصوتية</h3>
      <span class="ticket-status" id="statsStatusBadge"><span class="ticket-status-dot"></span><span id="statsStatusText">—</span></span>
    </div>
    <p class="card-desc">رومات صوتية تعرض الأعداد مباشرة في اسم الروم وتتحدث تلقائياً كل دقيقة — أنشئ روم صوتياً واختره هنا.</p>

    <div class="stats-voice-grid voice-grid">
      <div class="stat-voice-item" data-for="stats_total">
        <div class="stat-voice-icon"><i class="fas fa-users"></i></div>
        <div class="stat-voice-info">
          <strong>روم العدد الكلي</strong>
          <small>يعرض إجمالي عدد أعضاء السيرفر</small>
        </div>
        <div class="stat-voice-control">
          <select data-key="stats_total" class="ticket-select">
            <option value="">— بدون (معطّل) —</option>
            <% (channels.voice || []).forEach(ch => { %>
              <option value="<%= ch.id %>" <%= String(config.stats_total || '') === String(ch.id) ? 'selected' : '' %>><%= ch.name %></option>
            <% }) %>
          </select>
          <div class="stat-voice-tools">
            <span class="ticket-field-state" data-state-of="stats_total"><i class="fas fa-check-circle"></i><span>مضبوط</span></span>
            <button type="button" class="btn-delete-sm" onclick="deleteSetting('stats_total')" title="إلغاء هذا الإعداد"><i class="fas fa-trash"></i></button>
          </div>
        </div>
      </div>

      <div class="stat-voice-item" data-for="stats_online">
        <div class="stat-voice-icon"><i class="fas fa-user-check"></i></div>
        <div class="stat-voice-info">
          <strong>روم المتواجدون</strong>
          <small>يعرض عدد الأعضاء المتصلين حالياً</small>
        </div>
        <div class="stat-voice-control">
          <select data-key="stats_online" class="ticket-select">
            <option value="">— بدون (معطّل) —</option>
            <% (channels.voice || []).forEach(ch => { %>
              <option value="<%= ch.id %>" <%= String(config.stats_online || '') === String(ch.id) ? 'selected' : '' %>><%= ch.name %></option>
            <% }) %>
          </select>
          <div class="stat-voice-tools">
            <span class="ticket-field-state" data-state-of="stats_online"><i class="fas fa-check-circle"></i><span>مضبوط</span></span>
            <button type="button" class="btn-delete-sm" onclick="deleteSetting('stats_online')" title="إلغاء هذا الإعداد"><i class="fas fa-trash"></i></button>
          </div>
        </div>
      </div>

      <div class="stat-voice-item" data-for="stats_bots">
        <div class="stat-voice-icon"><i class="fas fa-robot"></i></div>
        <div class="stat-voice-info">
          <strong>روم البوتات</strong>
          <small>يعرض عدد البوتات في السيرفر</small>
        </div>
        <div class="stat-voice-control">
          <select data-key="stats_bots" class="ticket-select">
            <option value="">— بدون (معطّل) —</option>
            <% (channels.voice || []).forEach(ch => { %>
              <option value="<%= ch.id %>" <%= String(config.stats_bots || '') === String(ch.id) ? 'selected' : '' %>><%= ch.name %></option>
            <% }) %>
          </select>
          <div class="stat-voice-tools">
            <span class="ticket-field-state" data-state-of="stats_bots"><i class="fas fa-check-circle"></i><span>مضبوط</span></span>
            <button type="button" class="btn-delete-sm" onclick="deleteSetting('stats_bots')" title="إلغاء هذا الإعداد"><i class="fas fa-trash"></i></button>
          </div>
        </div>
      </div>
    </div>

    <small class="field-hint role-picker-hint st-ex">
      <i class="fas fa-lightbulb"></i>
      مثال: أنشئ روم صوتي باسم «👥 الأعضاء» واختره في «روم العدد الكلي» — سيسميه البوت تلقائياً «👥 الأعضاء: 1,234» ويحدّثه كل دقيقة.
    </small>
  </div>

  <!-- ④ نظام التذاكر -->
  <div class="card glass ticket-card st-section" id="st-tickets">
    <div class="card-header st-sec-head">
      <span class="st-sec-num">4</span>
      <h3><i class="fas fa-ticket-alt"></i> نظام التذاكر</h3>
      <span class="ticket-status" id="ticketStatusBadge"><span class="ticket-status-dot"></span><span id="ticketStatusText">—</span></span>
    </div>
    <p class="card-desc">التذاكر نظام متكامل من 4 خطوات مرتبطة: بنل الطلبات، تصنيف لتذاكر الأعضاء، تصنيف داخلي للمشرفين، وسجل لكل الأحداث.</p>

    <div class="ticket-progress">
      <div class="ticket-progress-item" data-for="panel_channel">

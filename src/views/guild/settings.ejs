<% currentPage = 'settings' %>
<div class="page-header">
  <h1><i class="fas fa-sliders-h"></i> إعدادات <%= guild.name %></h1>
  <p>ضبط جميع إعدادات البوت في السيرفر بمزامنة فورية مع البوت</p>
</div>

<div class="card glass sync-bar">
  <div class="sync-bar-info">
    <i class="fas fa-bolt"></i>
    <div>
      <strong>المزامنة الفورية</strong>
      <p>كل تعديل يُحفظ في قاعدة البيانات ويُطبَّق على البوت خلال ثوانٍ — أو فورياً عبر زر المزامنة.</p>
    </div>
  </div>
  <div class="sync-bar-actions">
    <span id="syncStatus" class="sync-idle"><i class="fas fa-circle"></i> مزامنة تلقائية عند كل حفظ</span>
    <button type="button" class="btn-primary" onclick="syncNow()">
      <i class="fas fa-sync-alt"></i> مزامنة الآن
    </button>
  </div>
</div>

<form id="settingsForm" onsubmit="saveSettings(event)">
  <%
    const sections = [
      {
        title: 'الترحيب بالسيرفر',
        icon: 'fa-door-open',
        desc: 'بطاقة ترحيب تُرسل تلقائياً عند انضمام كل عضو جديد',
        fields: [
          { key: 'welcome_channel', label: 'قناة الترحيب', type: 'text' },
        ],
      },
      {
        title: 'قنوات السجلات',
        icon: 'fa-clipboard-list',
        desc: 'سجلات النشاط العام والإشراف وحالة البوت',
        fields: [
          { key: 'log_channel', label: 'السجلات العامة', type: 'text', hint: 'انضمام / مغادرة / رسائل / صوت' },
          { key: 'modlog_channel', label: 'سجلات الإشراف', type: 'text', hint: 'ban / kick / timeout / warn والأدوار' },
          { key: 'botlog_channel', label: 'سجل البوت', type: 'text', hint: 'تشغيل / إيقاف / أخطاء / نبض البوت' },
        ],
      },
    ];
  %>

  <% sections.forEach(s => { %>
    <div class="card glass">
      <div class="card-header">
        <h3><i class="fas <%= s.icon %>"></i> <%= s.title %></h3>
      </div>
      <% if (s.desc) { %>
        <p class="card-desc"><%= s.desc %></p>
      <% } %>
      <div class="form-grid">
        <% s.fields.forEach(f => { %>
          <div class="form-group">
            <label><%= f.label %></label>
            <div class="field-row">
              <select data-key="<%= f.key %>">
                <option value="">— بدون (معطّل) —</option>
                <% (channels[f.type] || []).forEach(ch => { %>
                  <option value="<%= ch.id %>" <%= String(config[f.key] || '') === String(ch.id) ? 'selected' : '' %>><%= ch.name %></option>
                <% }) %>
              </select>
              <button type="button" class="btn-delete-sm" onclick="deleteSetting('<%= f.key %>')" title="إلغاء هذا الإعداد">
                <i class="fas fa-trash"></i>
              </button>
            </div>
            <% if (f.hint) { %>
              <small class="field-hint"><%= f.hint %></small>
            <% } %>
          </div>
        <% }) %>
      </div>
    </div>
  <% }) %>

  <div class="card glass stats-card">
    <div class="card-header">
      <h3><i class="fas fa-chart-line"></i> الإحصائيات الصوتية</h3>
      <span class="ticket-status" id="statsStatusBadge"><span class="ticket-status-dot"></span><span id="statsStatusText">—</span></span>
    </div>
    <p class="card-desc">رومات صوتية تعرض الأعداد مباشرة في اسم الروم وتتحدث تلقائياً كل دقيقة</p>

    <div class="stats-voice-grid">
      <div class="stat-voice-item" data-for="stats_total">
        <div class="stat-voice-icon"><i class="fas fa-users"></i></div>
        <div class="stat-voice-info">
          <strong>روم العدد الكلي</strong>
          <small>يعرض إجمالي عدد أعضاء السيرفر</small>
        </div>
        <div class="stat-voice-control">
          <select data-key="stats_total" class="ticket-select">
            <option value="">— بدون (معطّل) —</option>
            <% (channels.voice || []).forEach(ch => { %>
              <option value="<%= ch.id %>" <%= String(config.stats_total || '') === String(ch.id) ? 'selected' : '' %>><%= ch.name %></option>
            <% }) %>
          </select>
          <div class="stat-voice-tools">
            <span class="ticket-field-state" data-state-of="stats_total"><i class="fas fa-check-circle"></i><span>مضبوط</span></span>
            <button type="button" class="btn-delete-sm" onclick="deleteSetting('stats_total')" title="إلغاء هذا الإعداد"><i class="fas fa-trash"></i></button>
          </div>
        </div>
      </div>

      <div class="stat-voice-item" data-for="stats_online">
        <div class="stat-voice-icon"><i class="fas fa-user-check"></i></div>
        <div class="stat-voice-info">
          <strong>روم المتواجدون</strong>
          <small>يعرض عدد الأعضاء المتصلين حالياً</small>
        </div>
        <div class="stat-voice-control">
          <select data-key="stats_online" class="ticket-select">
            <option value="">— بدون (معطّل) —</option>
            <% (channels.voice || []).forEach(ch => { %>
              <option value="<%= ch.id %>" <%= String(config.stats_online || '') === String(ch.id) ? 'selected' : '' %>><%= ch.name %></option>
            <% }) %>
          </select>
          <div class="stat-voice-tools">
            <span class="ticket-field-state" data-state-of="stats_online"><i class="fas fa-check-circle"></i><span>مضبوط</span></span>
            <button type="button" class="btn-delete-sm" onclick="deleteSetting('stats_online')" title="إلغاء هذا الإعداد"><i class="fas fa-trash"></i></button>
          </div>
        </div>
      </div>

      <div class="stat-voice-item" data-for="stats_bots">
        <div class="stat-voice-icon"><i class="fas fa-robot"></i></div>
        <div class="stat-voice-info">
          <strong>روم البوتات</strong>
          <small>يعرض عدد البوتات في السيرفر</small>
        </div>
        <div class="stat-voice-control">
          <select data-key="stats_bots" class="ticket-select">
            <option value="">— بدون (معطّل) —</option>
            <% (channels.voice || []).forEach(ch => { %>
              <option value="<%= ch.id %>" <%= String(config.stats_bots || '') === String(ch.id) ? 'selected' : '' %>><%= ch.name %></option>
            <% }) %>
          </select>
          <div class="stat-voice-tools">
            <span class="ticket-field-state" data-state-of="stats_bots"><i class="fas fa-check-circle"></i><span>مضبوط</span></span>
            <button type="button" class="btn-delete-sm" onclick="deleteSetting('stats_bots')" title="إلغاء هذا الإعداد"><i class="fas fa-trash"></i></button>
          </div>
        </div>
      </div>
    </div>

    <small class="field-hint role-picker-hint">
      <i class="fas fa-sync-alt"></i>
      تُحدَّث الأعداد تلقائياً كل دقيقة ويعيد البوت تسمية الروم — يمكنك استخدام روم واحد لأكثر من إحصائية أو رومات منفصلة
    </small>
  </div>

  <div class="card glass ticket-card">
    <div class="card-header">
      <h3><i class="fas fa-ticket-alt"></i> نظام التذاكر</h3>
      <span class="ticket-status" id="ticketStatusBadge"><span class="ticket-status-dot"></span><span id="ticketStatusText">—</span></span>
    </div>

    <div class="ticket-progress">
      <div class="ticket-progress-item" data-for="panel_channel">
        <span class="step-ic"><i class="fas fa-clipboard-list"></i></span>
        <span class="step-name">بنل التذاكر</span>
        <span class="step-check"><i class="fas fa-check"></i></span>
      </div>
      <span class="progress-line"></span>
      <div class="ticket-progress-item" data-for="ticket_category">
        <span class="step-ic"><i class="fas fa-folder-open"></i></span>
        <span class="step-name">التصنيف</span>
        <span class="step-check"><i class="fas fa-check"></i></span>
      </div>
      <span class="progress-line"></span>
      <div class="ticket-progress-item" data-for="admin_category">
        <span class="step-ic"><i class="fas fa-folder-tree"></i></span>
        <span class="step-name">التصنيف الداخلي</span>
        <span class="step-check"><i class="fas fa-check"></i></span>
      </div>
      <span class="progress-line"></span>
      <div class="ticket-progress-item" data-for="log_channel_id">
        <span class="step-ic"><i class="fas fa-scroll"></i></span>
        <span class="step-name">سجل التذاكر</span>
        <span class="step-check"><i class="fas fa-check"></i></span>
      </div>
    </div>

    <div class="ticket-fields">
      <div class="ticket-field">
        <div class="ticket-field-head">
          <div class="ticket-field-title">
            <i class="fas fa-clipboard-list"></i>
            <div>
              <strong>بنل التذاكر</strong>
              <small>القناة التي يُعرض فيها بنل إنشاء التذاكر</small>
            </div>
          </div>
          <div class="ticket-field-tools">
            <span class="ticket-field-state" data-state-of="panel_channel"><i class="fas fa-check-circle"></i><span>مضبوط</span></span>
            <button type="button" class="btn-delete-sm" onclick="deleteSetting('panel_channel')" title="إلغاء هذا الإعداد"><i class="fas fa-trash"></i></button>
          </div>
        </div>
        <select data-key="panel_channel" class="ticket-select">
          <option value="">— بدون (معطّل) —</option>
          <% (channels.text || []).forEach(ch => { %>
            <option value="<%= ch.id %>" <%= String(config.panel_channel || '') === String(ch.id) ? 'selected' : '' %>><%= ch.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="ticket-field">
        <div class="ticket-field-head">
          <div class="ticket-field-title">
            <i class="fas fa-scroll"></i>
            <div>
              <strong>سجل التذاكر</strong>
              <small>قناة تُسجل فيها أحداث التذاكر (فتح/إغلاق/سحب...) </small>
            </div>
          </div>
          <div class="ticket-field-tools">
            <span class="ticket-field-state" data-state-of="log_channel_id"><i class="fas fa-check-circle"></i><span>مضبوط</span></span>
            <button type="button" class="btn-delete-sm" onclick="deleteSetting('log_channel_id')" title="إلغاء هذا الإعداد"><i class="fas fa-trash"></i></button>
          </div>
        </div>
        <select data-key="log_channel_id" class="ticket-select">
          <option value="">— بدون (معطّل) —</option>
          <% (channels.text || []).forEach(ch => { %>
            <option value="<%= ch.id %>" <%= String(config.log_channel_id || '') === String(ch.id) ? 'selected' : '' %>><%= ch.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="ticket-field">
        <div class="ticket-field-head">
          <div class="ticket-field-title">
            <i class="fas fa-folder-open"></i>
            <div>
              <strong>تصنيف التذاكر</strong>
              <small>التصنيف الذي تُنشأ فيه تذاكر الأعضاء</small>
            </div>
          </div>
          <div class="ticket-field-tools">
            <span class="ticket-field-state" data-state-of="ticket_category"><i class="fas fa-check-circle"></i><span>مضبوط</span></span>
            <button type="button" class="btn-delete-sm" onclick="deleteSetting('ticket_category')" title="إلغاء هذا الإعداد"><i class="fas fa-trash"></i></button>
          </div>
        </div>
        <select data-key="ticket_category" class="ticket-select">
          <option value="">— بدون (معطّل) —</option>
          <% (channels.category || []).forEach(ch => { %>
            <option value="<%= ch.id %>" <%= String(config.ticket_category || '') === String(ch.id) ? 'selected' : '' %>><%= ch.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="ticket-field">
        <div class="ticket-field-head">
          <div class="ticket-field-title">
            <i class="fas fa-folder-tree"></i>
            <div>
              <strong>التصنيف الداخلي</strong>
              <small>تصنيف خاص بالتذاكر الداخلية (المشرفون)</small>
            </div>
          </div>
          <div class="ticket-field-tools">
            <span class="ticket-field-state" data-state-of="admin_category"><i class="fas fa-check-circle"></i><span>مضبوط</span></span>
            <button type="button" class="btn-delete-sm" onclick="deleteSetting('admin_category')" title="إلغاء هذا الإعداد"><i class="fas fa-trash"></i></button>
          </div>
        </div>
        <select data-key="admin_category" class="ticket-select">
          <option value="">— بدون (معطّل) —</option>
          <% (channels.category || []).forEach(ch => { %>
            <option value="<%= ch.id %>" <%= String(config.admin_category || '') === String(ch.id) ? 'selected' : '' %>><%= ch.name %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <small class="field-hint role-picker-hint">
      <i class="fas fa-info-circle"></i>
      الجاهزية الكاملة للبوت تتطلب: <b>تصنيف التذاكر</b> + <b>رتبة دعم واحدة على الأقل</b> (من قسم فريق الدعم بالأسفل)
    </small>
  </div>

  <div class="card glass support-card">
    <div class="card-header">
      <h3><i class="fas fa-headset"></i> فريق الدعم والعدادات</h3>
      <span class="card-badge" id="supportCountBadge">0 رتب</span>
    </div>

    <div class="support-summary">
      <div class="summary-item">
        <i class="fas fa-users"></i>
        <div>
          <strong id="supportMembersStat">0</strong>
          <span>عضو يرتبط برتب الدعم</span>
        </div>
      </div>
      <div class="summary-item">
        <i class="fas fa-tags"></i>
        <div>
          <strong id="supportRolesStat">0</strong>
          <span>رتبة دعم محددة</span>
        </div>
      </div>
    </div>

    <div class="chips-wrap" id="selectedSupportChips"></div>

    <div class="role-picker">
      <div class="picker-toolbar">
        <div class="search-box">
          <i class="fas fa-search"></i>
          <input type="text" id="supportRoleSearch" placeholder="ابحث عن رتبة..." oninput="filterSupportRoles(this.value)">
        </div>
        <span class="picker-count"><b id="visibleRoleCount">0</b> رتبة</span>
      </div>
      <div class="role-grid" id="supportRoleGrid">
        <% roles.filter(r => r.name !== '@everyone' && !r.managed).forEach(r => { %>
        <button type="button" class="role-item<%= supportRoleArray.includes(String(r.id)) ? ' selected' : '' %>"
          data-role-id="<%= r.id %>" data-role-name="<%= r.name %>" data-role-count="<%= r.members_count ?? 0 %>"
          title="اضغط للتبديل" onclick="toggleSupportRole(this)">
          <span class="role-dot" style="background-color:#<%= (r.color || 0).toString(16).padStart(6, '0') %>"></span>
          <span class="role-name"><%= r.name %></span>
          <span class="role-members"><%= r.members_count ?? 0 %> <i class="fas fa-user"></i></span>
          <span class="role-check"><i class="fas fa-check"></i></span>
        </button>
        <% }) %>
      </div>
      <% if (!roles || roles.filter(r => r.name !== '@everyone' && !r.managed).length === 0) { %>
        <div class="empty-state" style="padding: 28px 10px;">
          <i class="fas fa-user-tag"></i>
          <p>لا توجد رتب متاحة — تأكد من اتصال البوت وتوكنه الصحيح</p>
        </div>
      <% } %>
      <small class="field-hint role-picker-hint"><i class="fas fa-info-circle"></i> الرتب المحددة يمكنها الرد على التذاكر (الدعم الفني) وتستلم التذاكر الجديدة تلقائياً</small>
    </div>

    <div class="ticket-counter">
      <div>
        <label for="ticketCounterInput"><i class="fas fa-hashtag"></i> عداد التذاكر</label>
        <small class="field-hint">يُستخدم في ترقيم التذاكر الجديدة — كل تذكرة برقم جديد +1</small>
      </div>
      <div class="stepper">
        <button type="button" class="stepper-btn minus" onclick="stepCounter(-1)" title="إنقاص"><i class="fas fa-minus"></i></button>
        <input type="number" id="ticketCounterInput" data-key="ticket_counter" min="0" value="<%= config.ticket_counter || 0 %>">
        <button type="button" class="stepper-btn plus" onclick="stepCounter(1)" title="زيادة"><i class="fas fa-plus"></i></button>
      </div>
    </div>

    <input type="hidden" id="supportRoleState">
  </div>

  <div class="actions-bar">
    <button type="submit" class="btn-primary" id="saveBtn">
      <i class="fas fa-save"></i> حفظ جميع الإعدادات
    </button>
    <button type="button" class="btn-secondary" onclick="syncNow()">
      <i class="fas fa-sync-alt"></i> مزامنة البوت الآن
    </button>
  </div>
</form>

<style>
  .sync-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 18px 22px;
    margin-bottom: 20px;
    border: 1px solid rgba(88, 101, 242, .3);
  }
  .sync-bar-info { display: flex; align-items: center; gap: 12px; }
  .sync-bar-info i { font-size: 1.8rem; color: #5865f2; }
  .sync-bar-info strong { display: block; margin-bottom: 2px; }
  .sync-bar-info p { margin: 0; color: var(--text-muted); font-size: .83rem; line-height: 1.5; }
  .sync-bar-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .sync-idle { font-size: .82rem; color: var(--text-muted); }
  .sync-idle i { color: #57f287; }
  #syncStatus.sync-ok { color: #57f287; }
  #syncStatus.sync-ok i { color: #57f287; }
  #syncStatus.sync-warn { color: #fee75c; }
  #syncStatus.sync-warn i { color: #fee75c; }
  .field-row { display: flex; gap: 8px; align-items: stretch; }
  .field-row select, .field-row input {
    flex: 1;
    min-width: 0;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-secondary);
    color: var(--text);
    font-family: inherit;
  }
  .field-row input[type="number"] { width: 120px; flex: 0 0 120px; }
  .btn-delete-sm {
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    border-radius: 10px;
    border: 1px solid rgba(237, 66, 69, .3);
    background: rgba(237, 66, 69, .12);
    color: #ed4245;
    cursor: pointer;
    font-size: .9rem;
  }
  .btn-delete-sm:hover { background: rgba(237, 66, 69, .25); }
  .field-hint { display: block; margin-top: 6px; color: var(--text-muted); font-size: .78rem; }
  .card-desc { margin: 0 20px 16px; color: var(--text-muted); font-size: .85rem; }
  .actions-bar {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin: 22px 2px 10px;
  }
  .btn-secondary {
    padding: 12px 22px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text);
    cursor: pointer;
    font-family: inherit;
    font-size: .95rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .btn-secondary:hover { background: rgba(255, 255, 255, .06); }
  .support-card { overflow: hidden; }
  .card-badge { background: #5865f2; color: #fff; border-radius: 999px; padding: 4px 12px; font-size: .78rem; font-weight: 600; margin-left: 20px; }
  .support-summary { display: flex; gap: 12px; margin: 0 20px 18px; flex-wrap: wrap; }
  .summary-item { display: flex; align-items: center; gap: 12px; background: #0b0b0f; border: 1px solid var(--border); border-radius: 14px; padding: 12px 18px; min-width: 170px; }
  .summary-item i { font-size: 1.4rem; color: var(--primary); }
  .summary-item strong { font-size: 1.25rem; display: block; line-height: 1.1; }
  .summary-item span { font-size: .75rem; color: var(--text-muted); }
  .chips-wrap { display: flex; flex-wrap: wrap; gap: 8px; padding: 0 20px 14px; }
  .chip { display: inline-flex; align-items: center; gap: 8px; background: rgba(88, 101, 242, .15); border: 1px solid rgba(88, 101, 242, .35); color: var(--text); border-radius: 999px; padding: 6px 10px; font-size: .8rem; }
  .chip-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; flex-shrink: 0; }
  .chip-name { white-space: nowrap; }
  .chip-x { background: none; border: none; color: var(--text-muted); cursor: pointer; padding: 0; font-size: .75rem; display: flex; }
  .chip-x:hover { color: #ed4245; }
  .role-picker { padding: 0 20px 20px; }
  .picker-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; flex-wrap: wrap; }
  .search-box { display: flex; align-items: center; gap: 8px; background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; padding: 8px 12px; flex: 1; min-width: 200px; }
  .search-box i { color: var(--text-muted); font-size: .85rem; }
  .search-box input { background: none; border: none; outline: none; color: var(--text); font-family: inherit; width: 100%; }
  .picker-count { font-size: .78rem; color: var(--text-muted); white-space: nowrap; }
  .picker-count b { color: var(--primary); }
  .role-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 10px; }
  .role-item { display: flex; align-items: center; gap: 10px; background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 12px; padding: 10px 12px; cursor: pointer; font-family: inherit; color: var(--text); transition: all .18s ease; text-align: right; }
  .role-item:hover { border-color: var(--primary); background: var(--bg-glass-hover); transform: translateY(-1px); }
  .role-item.selected { border-color: var(--primary); background: rgba(88, 101, 242, .14); }
  .role-item.hidden { display: none; }
  .role-dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; box-shadow: 0 0 0 2px rgba(255, 255, 255, .08); }
  .role-name { flex: 1; font-size: .83rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .role-members { font-size: .72rem; color: var(--text-muted); white-space: nowrap; }
  .role-members i { margin-left: 3px; }
  .role-check { width: 20px; height: 20px; border-radius: 50%; border: 2px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: .6rem; color: transparent; flex-shrink: 0; transition: all .18s ease; }
  .role-item.selected .role-check { background: var(--primary); border-color: var(--primary); color: #fff; box-shadow: 0 0 10px var(--primary-glow); }
  .role-picker-hint { padding: 0 20px; margin-top: 10px; display: block; }
  .ticket-counter { display: flex; align-items: center; justify-content: space-between; gap: 16px; border-radius: 14px; border: 1px solid rgba(88, 101, 242, .3); margin: 0 20px 8px; padding: 14px 18px; flex-wrap: wrap; }
  .ticket-counter label { font-weight: 600; display: flex; align-items: center; gap: 8px; }
  .ticket-counter label i { color: var(--primary); }
  .stepper { display: inline-flex; align-items: center; gap: 6px; }
  .stepper input { width: 96px; text-align: center; padding: 9px 12px; border-radius: 10px; border: 1px solid var(--border); background: var(--bg-secondary); color: var(--text); font-family: inherit; font-size: 1rem; font-weight: 700; }
  .stepper-btn { width: 38px; height: 38px; border-radius: 10px; border: 1px solid var(--border); background: var(--bg-secondary); color: var(--text); cursor: pointer; transition: all .18s ease; }
  .stepper-btn:hover { background: var(--primary); border-color: var(--primary); color: #fff; }
  .stepper-btn.minus:hover { background: #ed4245; border-color: #ed4245; }

  .ticket-card { overflow: hidden; }
  .ticket-status { display: inline-flex; align-items: center; gap: 8px; border-radius: 999px; padding: 5px 14px; font-size: .78rem; font-weight: 600; margin-left: 20px; border: 1px solid var(--border); background: var(--bg-secondary); color: var(--text-muted); }
  .ticket-status .ticket-status-dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
  .ticket-status.ready { background: rgba(87, 242, 135, .12); color: #57f287; border-color: rgba(87, 242, 135, .4); }
  .ticket-status.partial { background: rgba(254, 231, 92, .1); color: #fee75c; border-color: rgba(254, 231, 92, .35); }
  .ticket-status.empty { background: rgba(237, 66, 69, .1); color: #ed4245; border-color: rgba(237, 66, 69, .35); }

  .ticket-progress { display: flex; align-items: flex-start; gap: 0; padding: 6px 20px 24px; }
  .ticket-progress-item { display: flex; flex-direction: column; align-items: center; gap: 6px; min-width: 88px; position: relative; }
  .step-ic { width: 42px; height: 42px; border-radius: 12px; background: var(--bg-secondary); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 1rem; color: var(--text-muted); transition: all .2s ease; }
  .step-name { font-size: .7rem; color: var(--text-muted); white-space: nowrap; }
  .step-check { position: absolute; top: -6px; left: -6px; width: 18px; height: 18px; border-radius: 50%; background: #2b2b31; border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: .55rem; color: transparent; transition: all .2s ease; }
  .ticket-progress-item.done .step-ic { background: rgba(87, 242, 135, .1); border-color: rgba(87, 242, 135, .4); color: #57f287; box-shadow: 0 0 12px rgba(87, 242, 135, .15); }
  .ticket-progress-item.done .step-name { color: #57f287; font-weight: 600; }
  .ticket-progress-item.done .step-check { background: #57f287; border-color: #57f287; color: #0b0b0f; }
  .progress-line { flex: 1; height: 2px; background: var(--border); margin: 20px 8px 0; border-radius: 2px; }
  @media (max-width: 640px) {
    .ticket-progress { flex-wrap: wrap; justify-content: center; }
    .progress-line { flex: 0 0 14px; }
  }
  .ticket-fields { padding: 0 20px; display: grid; gap: 14px; }
  .ticket-field { background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 14px; padding: 14px 16px; transition: border-color .2s ease; }
  .ticket-field:focus-within { border-color: rgba(88, 101, 242, .5); }
  .ticket-field-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; flex-wrap: wrap; }
  .ticket-field-title { display: flex; align-items: center; gap: 12px; }
  .ticket-field-title > i { font-size: 1rem; color: var(--primary); width: 34px; height: 34px; border-radius: 10px; background: rgba(88, 101, 242, .12); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .ticket-field-title strong { display: block; font-size: .88rem; }
  .ticket-field-title small { color: var(--text-muted); font-size: .74rem; display: block; }
  .ticket-field-tools { display: flex; align-items: center; gap: 8px; }
  .ticket-field-state { display: inline-flex; align-items: center; gap: 6px; font-size: .72rem; color: var(--text-muted); background: var(--bg-secondary); padding: 4px 10px; border-radius: 999px; border: 1px solid var(--border); transition: all .2s ease; }
  .ticket-field-state.on { color: #57f287; border-color: rgba(87, 242, 135, .4); background: rgba(87, 242, 135, .08); }
  .ticket-select { width: 100%; padding: 10px 14px; border-radius: 10px; border: 1px solid var(--border); background: var(--bg-secondary); color: var(--text); font-family: inherit; font-size: .85rem; cursor: pointer; }
  .ticket-select:focus { outline: none; border-color: var(--primary); }

  .stats-card { overflow: hidden; }
  .stats-voice-grid { padding: 0 20px; display: grid; gap: 12px; }
  .stat-voice-item {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 14px 16px;
    transition: border-color .2s ease, background .2s ease;
  }
  .stat-voice-item:focus-within { border-color: rgba(88, 101, 242, .5); }
  .stat-voice-item.done { border-color: rgba(87, 242, 135, .35); background: rgba(87, 242, 135, .05); }
  .stat-voice-icon { width: 44px; height: 44px; border-radius: 12px; background: rgba(88, 101, 242, .12); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; transition: all .2s ease; }
  .stat-voice-item.done .stat-voice-icon { background: rgba(87, 242, 135, .15); color: #57f287; }
  .stat-voice-info { flex: 1; min-width: 0; }
  .stat-voice-info strong { display: block; font-size: .88rem; }
  .stat-voice-info small { color: var(--text-muted); font-size: .74rem; display: block; }
  .stat-voice-control { min-width: 0; width: 100%; max-width: 360px; display: flex; flex-direction: column; gap: 8px; }
  .stat-voice-tools { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }
  @media (max-width: 760px) {
    .stat-voice-item { flex-wrap: wrap; }
    .stat-voice-control { max-width: none; }
  }

  @media (max-width: 640px) { .role-grid { grid-template-columns: 1fr; } .ticket-counter { justify-content: center; } }
</style>

<script>
const FIELDS = [
  'welcome_channel', 'log_channel', 'modlog_channel', 'botlog_channel',
  'stats_total', 'stats_online', 'stats_bots',
  'panel_channel', 'log_channel_id', 'ticket_category', 'admin_category',
];

function collectSettings() {
  const data = {};
  for (const key of FIELDS) {
    const el = document.querySelector('[data-key="' + key + '"]');
    data[key] = el ? el.value : '';
  }
  const sr = document.getElementById('supportRoleState');
  data.support_role = sr ? sr.value : '';
  const tc = document.querySelector('[data-key="ticket_counter"]');
  data.ticket_counter = tc ? tc.value : '';
  return data;
}

// ─── Professional support-role picker ──────────────────────────────────────

const SUPPORT_ROLES = <%- JSON.stringify((roles || []).filter(r => r.name !== '@everyone' && !r.managed)).replace(/</g, '\\u003c') %>;
const selectedSupport = new Set();

function initSupport() {
  document.querySelectorAll('.role-item.selected').forEach(b => selectedSupport.add(b.dataset.roleId));
  syncSupportState();
}

function toggleSupportRole(btn) {
  const id = btn.dataset.roleId;
  if (selectedSupport.has(id)) {
    selectedSupport.delete(id);
    btn.classList.remove('selected');
  } else {
    selectedSupport.add(id);
    btn.classList.add('selected');
  }
  syncSupportState();
  const r = SUPPORT_ROLES.find(x => x.id === id);
  showToast((r ? r.name : 'الرتبة') + (selectedSupport.has(id) ? ' أُضيفت لفريق الدعم ✅' : ' أُزيلت من فريق الدعم'), 'success');
}

function syncSupportState() {
  document.getElementById('supportRoleState').value = [...selectedSupport].join(',');

  document.getElementById('supportRolesStat').textContent = selectedSupport.size;
  document.getElementById('supportCountBadge').textContent = selectedSupport.size + ' رتب';

  let members = 0;
  selectedSupport.forEach(id => {
    const r = SUPPORT_ROLES.find(x => x.id === id);
    if (r && r.members_count) members += r.members_count;
  });
  document.getElementById('supportMembersStat').textContent = members;

  const wrap = document.getElementById('selectedSupportChips');
  wrap.innerHTML = '';
  selectedSupport.forEach(id => {
    const r = SUPPORT_ROLES.find(x => x.id === id);
    const name = r ? r.name : id;
    const color = r ? (r.color || 0) : 0;
    const chip = document.createElement('span');
    chip.className = 'chip';
    chip.innerHTML =
      '<span class="chip-dot" style="background-color:#' + color.toString(16).padStart(6, '0') + '"></span>' +
      '<span class="chip-name"></span>' +
      '<button type="button" class="chip-x" title="إزالة"><i class="fas fa-times"></i></button>';
    chip.querySelector('.chip-name').textContent = name;
    chip.querySelector('.chip-x').onclick = (ev) => {
      ev.stopPropagation();
      removeSupportRole(id);
    };
    wrap.appendChild(chip);
  });

  document.getElementById('visibleRoleCount').textContent = document.querySelectorAll('.role-item:not(.hidden)').length;
}

function removeSupportRole(id) {
  selectedSupport.delete(id);
  const btn = document.querySelector('.role-item[data-role-id="' + id + '"]');
  if (btn) btn.classList.remove('selected');
  syncSupportState();
}

function filterSupportRoles(q) {
  const query = q.toLowerCase();
  let visible = 0;
  document.querySelectorAll('.role-item').forEach(b => {
    const show = !query || b.dataset.roleName.toLowerCase().includes(query);
    b.classList.toggle('hidden', !show);
    if (show) visible++;
  });
  document.getElementById('visibleRoleCount').textContent = visible;
}

function stepCounter(d) {
  const el = document.getElementById('ticketCounterInput');
  el.value = Math.max(0, (parseInt(el.value, 10) || 0) + d);
}

// ─── Ticket system status ───────────────────────────────────────────────────

function updateTicketStatus() {
  const checks = ['panel_channel', 'log_channel_id', 'ticket_category', 'admin_category'];
  let done = 0;
  checks.forEach(key => {
    const sel = document.querySelector('[data-key="' + key + '"]');
    const isSet = sel && sel.value;
    const step = document.querySelector('.ticket-progress-item[data-for="' + key + '"]');
    if (step) step.classList.toggle('done', !!isSet);
    const state = document.querySelector('.ticket-field-state[data-state-of="' + key + '"]');
    if (state) {
      state.classList.toggle('on', !!isSet);
      state.querySelector('span').textContent = isSet ? 'مضبوط' : 'غير مضبوط';
    }
    if (isSet) done++;
  });

  const badge = document.getElementById('ticketStatusBadge');
  const text = document.getElementById('ticketStatusText');
  if (done === 4) {
    badge.className = 'ticket-status ready';
    text.textContent = 'جاهز بالكامل';
  } else if (done > 0) {
    badge.className = 'ticket-status partial';
    text.textContent = done + ' من 4 مضبوطة';
  } else {
    badge.className = 'ticket-status empty';
    text.textContent = 'غير مضبوط';
  }
}

document.querySelectorAll('.ticket-select').forEach(el => el.addEventListener('change', updateTicketStatus));
updateTicketStatus();

// ─── Voice stats status ─────────────────────────────────────────────────────

function updateVoiceStatus() {
  const keys = ['stats_total', 'stats_online', 'stats_bots'];
  let done = 0;
  keys.forEach(key => {
    const sel = document.querySelector('[data-key="' + key + '"]');
    const isSet = sel && sel.value;
    const item = document.querySelector('.stat-voice-item[data-for="' + key + '"]');
    if (item) item.classList.toggle('done', !!isSet);
    const st = document.querySelector('.ticket-field-state[data-state-of="' + key + '"]');
    if (st) {
      st.classList.toggle('on', !!isSet);
      st.querySelector('span').textContent = isSet ? 'مضبوط' : 'غير مضبوط';
    }
    if (isSet) done++;
  });

  const badge = document.getElementById('statsStatusBadge');
  const text = document.getElementById('statsStatusText');
  if (done === 3) {
    badge.className = 'ticket-status ready';
    text.textContent = 'مفعل بالكامل';
  } else if (done > 0) {
    badge.className = 'ticket-status partial';
    text.textContent = done + ' من 3 مضبوطة';
  } else {
    badge.className = 'ticket-status empty';
    text.textContent = 'غير مضبوط';
  }
}

document.querySelectorAll('.stat-voice-item select').forEach(el => el.addEventListener('change', updateVoiceStatus));
updateVoiceStatus();

initSupport();

function updateSyncUi(ok, msg) {
  const el = document.getElementById('syncStatus');
  if (ok === true) { el.className = 'sync-ok'; el.innerHTML = '<i class="fas fa-check-circle"></i> متزامن مع البوت الآن'; }
  else if (ok === false) { el.className = 'sync-warn'; el.innerHTML = '<i class="fas fa-circle"></i> البوت غير متصل — ستُطبق الإعدادات تلقائياً خلال ثوانٍ'; }
  else if (msg) { el.innerHTML = '<i class="fas fa-circle"></i> ' + msg; el.className = 'sync-idle'; }
}

async function saveSettings(e) {
  e.preventDefault();
  const btn = document.getElementById('saveBtn');
  const orig = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جارٍ الحفظ...';
  try {
    const res = await fetch('/settings/<%= guild.id %>/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ settings: collectSettings() }),
    });
    const data = await res.json();
    if (res.ok && data.success) {
      showToast('✅ تم حفظ الإعدادات' + (data.synced ? ' — مزامنة فورية مع البوت' : ' — ستُطبَّق تلقائياً خلال ثوانٍ'), 'success');
      updateSyncUi(data.synced);
    } else {
      showToast('❌ ' + (data.error || 'فشل الحفظ'), 'error');
    }
  } catch (err) {
    showToast('❌ حدث خطأ في الاتصال', 'error');
  } finally {
    btn.disabled = false;
    btn.innerHTML = orig;
  }
}

async function syncNow() {
  const el = document.getElementById('syncStatus');
  el.className = 'sync-idle';
  el.innerHTML = '<i class="fas fa-sync-alt fa-spin"></i> جارٍ المزامنة...';
  try {
    const res = await fetch('/settings/<%= guild.id %>/sync', { method: 'POST' });
    const data = await res.json();
    updateSyncUi(data.success);
    showToast(data.message, data.success ? 'success' : 'warning');
  } catch {
    updateSyncUi(false);
    showToast('لا يمكن الوصول للبوت — مزامنة تلقائية خلال ثوانٍ', 'warning');
  }
}

async function deleteSetting(key) {
  if (!confirm('هل تريد إلغاء هذا الإعداد؟')) return;
  const res = await fetch('/settings/<%= guild.id %>/delete', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ key }),
  });
  if (res.ok) {
    showToast('✅ تم إلغاء الإعداد');
    setTimeout(() => location.reload(), 900);
  } else {
    showToast('❌ فشل الحذف', 'error');
  }
}
</script>
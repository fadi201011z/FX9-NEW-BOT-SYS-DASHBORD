<% layout = 'layouts/main' %>
<% currentPage = 'notifications' %>
<%
const platformLogos = {
  youtube: 'https://www.google.com/s2/favicons?domain=youtube.com&sz=64',
  kick:    'https://www.google.com/s2/favicons?domain=kick.com&sz=64',
  twitter: 'https://www.google.com/s2/favicons?domain=twitter.com&sz=64',
};
const subs = subscriptions || [];
const platCount = new Set(subs.map(s => s.platform).filter(Boolean)).size;
const platNames = { youtube: 'YouTube', kick: 'Kick', twitter: 'Twitter/X' };
const activeCh = new Set(subs.map(s => s.discordChannelId).filter(Boolean)).size;
%>
<div class="page-header fade-in-up">
  <h1><i class="fas fa-bell"></i> الإشعارات والإعلانات</h1>
  <p>إشتراكات يوتيوب وكيك وتويتر يراقبها البوت تلقائياً + إرسال إعلانات احترافية — في سيرفر <strong><%= guild.name %></strong></p>
</div>

<div class="stats-grid fade-in-up">
  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #ed4245"><i class="fas fa-bell" aria-hidden="true"></i></div>
    <div class="stat-info">
      <span class="stat-value"><%= subs.length %></span>
      <span class="stat-label">إشتراك نشط</span>
    </div>
  </div>
  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #5a9bff"><i class="fas fa-tower-broadcast" aria-hidden="true"></i></div>
    <div class="stat-info">
      <span class="stat-value"><%= platCount %></span>
      <span class="stat-label">منصات مراقَبة</span>
    </div>
  </div>
  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #57f287"><i class="fas fa-hashtag" aria-hidden="true"></i></div>
    <div class="stat-info">
      <span class="stat-value"><%= activeCh %></span>
      <span class="stat-label">قناة إشعارات</span>
    </div>
  </div>
</div>

<div class="nt-card glass fade-in-up">
  <div class="nt-card-head">
    <h3><i class="fas fa-plus-circle"></i> إضافة إشتراك جديد</h3>
  </div>
  <form id="addForm" class="nt-add-grid">
    <div class="nt-field">
      <select id="platform" required>
        <option value="">— المنصة —</option>
        <option value="youtube">YouTube</option>
        <option value="kick">Kick</option>
        <option value="twitter">Twitter/X</option>
      </select>
      <img id="platformIcon" src="" alt="" class="nt-plat-icon">
    </div>
    <input type="url" id="url" required placeholder="رابط القناة (مثل https://youtube.com/@...)">
    <select id="discordChannelId" required>
      <option value="">— قناة الإشعارات —</option>
      <% (guildChannels || []).forEach(ch => { %>
        <option value="<%= ch.id %>">#<%= ch.name %></option>
      <% }) %>
    </select>
    <input type="text" id="customMessage" placeholder="رسالة إضافية (اختياري)">
    <button type="submit" class="btn-primary nt-add-submit"><i class="fas fa-plus"></i> إضافة</button>
  </form>
</div>

<div class="nt-card glass fade-in-up nt-announce">
  <div class="nt-announce-head">
    <span class="nt-announce-icon"><i class="fas fa-bullhorn" aria-hidden="true"></i></span>
    <div>
      <h3>إرسال إعلان</h3>
      <p>أنشئ وأرسل إعلاناً احترافياً لأعضاء السيرفر</p>
    </div>
  </div>
  <form id="announceForm" class="nt-ann-body">
    <div class="nt-field">
      <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:6px;color:var(--text-muted)">عنوان الإعلان</label>
      <input type="text" id="announceTitle" required placeholder="اكتب عنواناً واضحاً للإعلان...">
    </div>
    <div class="nt-field">
      <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:6px;color:var(--text-muted)">نص الإعلان</label>
      <textarea id="announceMessage" required placeholder="اكتب محتوى الإعلان هنا..."></textarea>
    </div>
    <div class="nt-grid-2">
      <div class="nt-field">
        <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:6px;color:var(--text-muted)">📣 القناة المستهدفة</label>
        <select id="announceChannel" required>
          <option value="">اختر القناة...</option>
          <% (guildChannels || []).forEach(ch => { %>
            <option value="<%= ch.id %>">#<%= ch.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="nt-field">
        <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:6px;color:var(--text-muted)">📢 المنشن</label>
        <select id="announceMention">
          <option value="none">بدون منشن</option>
          <option value="everyone">@everyone</option>
          <option value="here">@here</option>
        </select>
      </div>
    </div>
    <div class="nt-grid-2">
      <div class="nt-field">
        <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:6px;color:var(--text-muted)">🏷️ نوع الإعلان</label>
        <select id="announceType">
          <option value="general">📢 إعلان عام</option>
          <option value="maintenance">🔧 صيانة</option>
          <option value="update">✅ تحديث</option>
          <option value="warning">🚨 تحذير</option>
          <option value="rules">📋 قواعد</option>
        </select>
      </div>
      <div class="nt-field">
        <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:6px;color:var(--text-muted)">🎨 لون الإعلان</label>
        <div class="nt-colors">
          <% const colorOpts = {blue:'#1a6fff',red:'#e53935',gold:'#ffd700',green:'#00c853',purple:'#7c4dff',orange:'#ff9800',black:'#333'}; %>
          <% Object.entries(colorOpts).forEach(([k,v]) => { %>
            <label class="color-option" data-value="<%= k %>" style="background:<%= v %>">
              <input type="radio" name="announceColor" value="<%= k %>" style="display:none" <%= k === 'blue' ? 'checked' : '' %>>
              <span style="font-size:.6rem;color:<%= ['gold','orange'].includes(k) ? '#333' : '#fff' %>;opacity:0">✓</span>
            </label>
          <% }) %>
        </div>
      </div>
    </div>
    <div class="nt-grid-2">
      <input type="url" id="announceImage" placeholder="رابط صورة (اختياري)">
      <input type="text" id="announceFooter" placeholder="نص التذييل (اختياري)">
    </div>
    <div class="nt-ann-actions">
      <button type="submit" class="btn-primary nt-send"><i class="fas fa-bullhorn"></i> إرسال الإعلان</button>
      <button type="button" id="previewBtn" class="nt-preview"><i class="fas fa-eye"></i> معاينة</button>
    </div>
  </form>
  <div id="announcePreview" class="nt-preview-box" style="display:none">
    <div class="nt-preview-bar">
      <span>👁️</span>
      <span>معاينة الإعلان — كيف سيظهر في ديسكورد</span>
    </div>
    <div id="previewContent"></div>
  </div>
</div>

<div class="nt-card glass fade-in-up">
  <div class="nt-card-head">
    <h3><i class="fas fa-list"></i> الإشتراكات الحالية <span class="nt-count">(<%= subs.length %>)</span></h3>
  </div>

  <% if (subs.length === 0) { %>
    <div class="empty-state">
      <i class="fas fa-bell-slash"></i>
      <p>لا يوجد أي إشتراكات بعد — أضف واحداً من الأعلى</p>
    </div>
  <% } else { %>
    <div class="nt-subs-list">
      <% subs.forEach(sub => { %>
        <div class="sub-item nt-sub-item">
          <img src="https://www.google.com/s2/favicons?domain=<%= sub.platform === 'youtube' ? 'youtube.com' : sub.platform === 'kick' ? 'kick.com' : 'twitter.com' %>&sz=64" alt="<%= sub.platform %>" class="nt-sub-fav" title="<%= platNames[sub.platform] || sub.platform %>">
          <div class="nt-sub-avatar-wrap">
            <img class="channel-avatar" data-channelid="<%= sub.channelId %>" data-platform="<%= sub.platform %>" src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(sub.channelName || sub.channelId || '?') %>&size=32&background=random&color=fff" alt="" onerror="this.parentElement.innerHTML='<span style=font-size:14px;color:var(--text-muted)>?</span>'">
          </div>
          <div class="nt-sub-info">
            <div class="nt-sub-name"><%= sub.channelName || sub.channelId || '—' %></div>
            <div class="nt-sub-url">
              <a href="<%= sub.channelUrl %>" target="_blank"><%= sub.channelUrl %></a>
              <span>→</span>
              <code><%= (guildChannels && guildChannels.find(c => c.id === sub.discordChannelId)) ? '#' + guildChannels.find(c => c.id === sub.discordChannelId).name : '#' + sub.discordChannelId %></code>
            </div>
          </div>
          <% if (sub.customMessage) { %>
            <span class="nt-sub-msg" title="<%= sub.customMessage %>">"<%= sub.customMessage %>"</span>
          <% } %>
          <div class="nt-sub-actions">
            <button class="checknow-btn nt-check" data-id="<%= sub._id %>">🔍 فحص الآن</button>
            <button class="resend-btn nt-resend" data-id="<%= sub._id %>">🔄 إعادة إرسال</button>
            <button class="delete-btn nt-delete" data-id="<%= sub._id %>"><i class="fas fa-xmark"></i></button>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<style>
  .nt-card { padding: 22px; border-radius: var(--radius, 12px); margin-bottom: 20px; }
  .nt-card-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
  .nt-card-head h3 { font-size: 1rem; font-weight: 700; display: flex; align-items: center; gap: 8px; }
  .nt-count { color: var(--text-muted); font-size: .8rem; }

  .nt-add-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; align-items: center; }
  .nt-field { position: relative; }
  .nt-plat-icon { position: absolute; inset-inline-start: 12px; top: 50%; transform: translateY(-50%); width: 20px; height: 20px; display: none; pointer-events: none; }
  .nt-add-grid select { padding-inline-start: 40px; }
  .nt-add-submit { justify-self: start; }

  .nt-card select, .nt-card input[type="text"], .nt-card input[type="url"], .nt-card textarea {
    width: 100%; padding: 12px 14px; box-sizing: border-box;
    border-radius: 10px; border: 1px solid var(--nx-line, rgba(255, 255, 255, .1));
    background: rgba(255, 255, 255, .03); color: var(--text, #eee);
    font-family: inherit; font-size: .88rem; outline: none;
    transition: border-color .18s var(--nx-ease, ease), box-shadow .18s var(--nx-ease, ease);
  }
  .nt-card textarea { min-height: 140px; resize: vertical; line-height: 1.7; }
  .nt-card select:focus, .nt-card input:focus, .nt-card textarea:focus {
    border-color: var(--primary, #a855f7); box-shadow: 0 0 0 3px rgba(168, 85, 247, .14);
  }

  .nt-announce { overflow: hidden; }
  .nt-announce-head {
    display: flex; align-items: center; gap: 12px; margin: -22px -22px 18px; padding: 18px 22px;
    background: linear-gradient(135deg, var(--primary), #0d47a1); color: #fff;
  }
  .nt-announce-icon {
    width: 40px; height: 40px; flex: 0 0 40px; display: grid; place-items: center;
    border-radius: 10px; background: rgba(255, 255, 255, .2); font-size: 1.15rem;
  }
  .nt-announce-head h3 { margin: 0; font-size: 1rem; color: #fff; }
  .nt-announce-head p { margin: 2px 0 0; color: rgba(255, 255, 255, .75); font-size: .78rem; }
  .nt-ann-body { display: flex; flex-direction: column; gap: 16px; }
  .nt-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .nt-colors { display: flex; gap: 6px; flex-wrap: wrap; }
  .color-option {
    width: 30px; height: 30px; border-radius: 8px; cursor: pointer;
    border: 2px solid transparent; display: flex; align-items: center; justify-content: center;
    transition: border-color .18s var(--nx-ease, ease), transform .18s var(--nx-ease, ease);
  }
  .color-option:hover { transform: scale(1.08); }
  .nt-ann-actions { display: flex; gap: 12px; }
  .nt-send { flex: 1; padding: 13px 24px; font-size: .9rem; cursor: pointer; }
  .nt-preview {
    padding: 13px 20px; border-radius: 10px; cursor: pointer; font-weight: 600; font-size: .85rem;
    background: rgba(255, 255, 255, .05); border: 1px solid var(--nx-line, rgba(255, 255, 255, .12)); color: var(--text, #eee);
    display: inline-flex; align-items: center; gap: 6px;
  }
  .nt-preview-box {
    margin-top: 20px; padding: 18px; background: rgba(255, 255, 255, .02);
    border-radius: 12px; border: 1px solid var(--nx-line, rgba(255, 255, 255, .09));
  }
  .nt-preview-bar { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--nx-line, rgba(255,255,255,.08)); font-size: .8rem; color: var(--text-muted); }

  .nt-subs-list { display: flex; flex-direction: column; gap: 10px; }
  .nt-sub-item {
    display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    padding: 12px 16px; border-radius: 12px;
    border: 1px solid var(--nx-line, rgba(255, 255, 255, .07)); background: rgba(255, 255, 255, .015);
    transition: border-color .18s var(--nx-ease, ease), background .18s var(--nx-ease, ease);
  }
  .nt-sub-item:hover { border-color: rgba(168, 85, 247, .4); background: rgba(168, 85, 247, .04); }
  .nt-sub-fav { width: 22px; height: 22px; border-radius: 5px; flex-shrink: 0; }
  .nt-sub-avatar-wrap { width: 34px; height: 34px; flex-shrink: 0; border-radius: 50%; overflow: hidden; background: rgba(255, 255, 255, .06); display: flex; align-items: center; justify-content: center; }
  .nt-sub-avatar-wrap img { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; }
  .nt-sub-info { flex: 1; min-width: 0; }
  .nt-sub-name { font-weight: 600; font-size: .9rem; }
  .nt-sub-url { font-size: .77rem; color: var(--text-muted); display: flex; align-items: center; gap: 4px; overflow: hidden; white-space: nowrap; }
  .nt-sub-url a { color: var(--primary); overflow: hidden; text-overflow: ellipsis; }
  .nt-sub-url code { direction: ltr; unicode-bidi: isolate; font-size: .74rem; background: rgba(255,255,255,.05); padding: 1px 7px; border-radius: 6px; color: var(--text-muted); flex-shrink: 0; }
  .nt-sub-msg { font-size: .76rem; color: var(--text-muted); max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .nt-sub-actions { display: flex; gap: 8px; }
  .nt-check, .nt-resend, .nt-delete {
    border: none; padding: 6px 12px; border-radius: 8px; cursor: pointer; font-size: .75rem; font-weight: 600;
  }
  .nt-check { background: var(--primary, #a855f7); color: #fff; }
  .nt-resend { background: #fbbf24; color: #000; }
  .nt-delete { background: var(--danger, #ed4245); color: #fff; }
  @media (max-width: 620px) { .nt-grid-2 { grid-template-columns: 1fr; } .nt-ann-actions { flex-direction: column; } }
</style>

<script>
// Show platform logo next to select
const platSelect = document.getElementById('platform');
const platIcon = document.getElementById('platformIcon');
const platLogos = { youtube: '<%= platformLogos.youtube %>', kick: '<%= platformLogos.kick %>', twitter: '<%= platformLogos.twitter %>' };
platSelect?.addEventListener('change', function() {
  const logo = platLogos[this.value];
  if (logo) { platIcon.src = logo; platIcon.style.display = 'block'; }
  else platIcon.style.display = 'none';
});

// Fetch actual channel avatars asynchronously
document.querySelectorAll('.channel-avatar').forEach(img => {
  const platform = img.dataset.platform;
  const channelId = img.dataset.channelid;
  if (!channelId) return;

  let url;
  if (platform === 'youtube') {
    url = `https://www.youtube.com/channel/${channelId}`;
    fetch(url, { headers: { 'User-Agent': 'Mozilla/5.0' } })
      .then(r => r.text())
      .then(html => {
        const m = html.match(/"avatar":\s*\[\s*\{\s*"url":\s*"([^"]+)"/);
        if (m) img.src = m[1].replace(/\\u0026/g, '&');
      }).catch(() => {});
  } else if (platform === 'kick') {
    fetch(`https://kick.com/api/v2/channels/${channelId}`, { headers: { 'User-Agent': 'Mozilla/5.0' } })
      .then(r => r.json())
      .then(d => { if (d?.user?.profile_pic) img.src = d.user.profile_pic; })
      .catch(() => {});
  } else if (platform === 'twitter') {
    const instances = ['nitter.net', 'nitter.privacydev.net', 'nitter.lqdev.tech'];
    for (const inst of instances) {
      fetch(`https://${inst}/${channelId}`, { headers: { 'User-Agent': 'Mozilla/5.0' } })
        .then(r => r.text())
        .then(html => {
          const m = html.match(/<img[^>]*class="avatar"[^>]*src="([^"]+)"/);
          if (m) {
            const src = m[1].startsWith('http') ? m[1] : `https://${inst}${m[1]}`;
            img.src = src;
          }
        }).catch(() => {});
      break;
    }
  }
});

document.getElementById('addForm')?.addEventListener('submit', async e => {
  e.preventDefault();
  const btn = e.target.querySelector('button[type=submit]');
  btn.disabled = true; btn.textContent = '⏳ جاري الإضافة...';

  const body = {
    platform: document.getElementById('platform').value,
    url: document.getElementById('url').value,
    discordChannelId: document.getElementById('discordChannelId').value,
    customMessage: document.getElementById('customMessage').value,
  };

  try {
    const res = await fetch('/notifications/<%= guild.id %>/add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const data = await res.json();
    if (data.success) {
      location.reload();
    } else {
      alert('❌ ' + (data.error || 'فشل الإضافة'));
    }
  } catch (err) {
    alert('❌ خطأ في الإتصال');
  }
  btn.disabled = false; btn.textContent = '➕ إضافة';
});

document.querySelectorAll('.delete-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    if (!confirm('تأكيد حذف هذا الإشتراك؟')) return;
    const id = btn.dataset.id;
    btn.disabled = true; btn.textContent = '⏳';
    try {
      const res = await fetch('/notifications/<%= guild.id %>/' + id, { method: 'DELETE' });
      if (res.ok) location.reload();
      else alert('❌ فشل الحذف');
    } catch { alert('❌ خطأ في الإتصال'); }
  });
});

document.querySelectorAll('.checknow-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    const id = btn.dataset.id;
    const orig = btn.textContent;
    btn.disabled = true; btn.textContent = '⏳';
    try {
      const res = await fetch('/notifications/<%= guild.id %>/checknow/' + id, { method: 'POST' });
      const data = await res.json();
      if (data.found) {
        alert('✅ تم إرسال الإشعار: ' + (data.title || data.text || data.videoId));
      } else if (data.offline) {
        alert('ℹ️ ' + (data.message || 'القناة غير متصلة حالياً — سيرسل الإشعار تلقائياً عند دخول البث'));
      } else if (data.message) {
        alert(data.message);
      } else {
        alert('❌ ' + (data.error || 'فشل التحقق'));
      }
    } catch { alert('❌ البوت غير متصل'); }
    btn.disabled = false; btn.textContent = orig;
  });
});

document.querySelectorAll('.resend-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    const id = btn.dataset.id;
    const orig = btn.textContent;
    btn.disabled = true; btn.textContent = '⏳';
    try {
      const res = await fetch('/notifications/<%= guild.id %>/resend/' + id, { method: 'POST' });
      const data = await res.json();
      if (data.sent) {
        alert('✅ تمت إعادة الإرسال: ' + (data.title || data.text || ''));
      } else if (data.offline) {
        alert('ℹ️ ' + (data.message || 'القناة غير متصلة حالياً'));
      } else {
        alert('❌ ' + (data.error || 'فشل الإرسال'));
      }
    } catch { alert('❌ البوت غير متصل'); }
    btn.disabled = false; btn.textContent = orig;
  });
});

// ── Color radio buttons ───────────────────────────────────────────────
document.querySelectorAll('.color-option').forEach(el => {
  el.addEventListener('click', function() {
    document.querySelectorAll('.color-option').forEach(o => {
      o.style.borderColor = 'transparent';
      o.querySelector('span').style.opacity = '0';
    });
    this.style.borderColor = '#fff';
    this.querySelector('span').style.opacity = '1';
    this.querySelector('input[type=radio]').checked = true;
    updatePreview();
  });
});
// Set default blue
document.querySelector('.color-option[data-value=blue]')?.click();

// ── Announcement ──────────────────────────────────────────────────────
const announceForm = document.getElementById('announceForm');
const previewBtn = document.getElementById('previewBtn');
const previewDiv = document.getElementById('announcePreview');
const previewContent = document.getElementById('previewContent');
const announceColors = { blue: '#1a6fff', red: '#e53935', gold: '#ffd700', green: '#00c853', purple: '#7c4dff', orange: '#ff9800', black: '#333' };
const announceEmojis = { general: '📢', maintenance: '🔧', update: '✅', warning: '🚨', rules: '📋' };
const announceLabels = { general: 'إعلان عام', maintenance: 'صيانة', update: 'تحديث', warning: 'تحذير', rules: 'قواعد' };

function getColor() {
  const checked = document.querySelector('input[name=announceColor]:checked');
  return checked ? checked.value : 'blue';
}

function updatePreview() {
  const title = document.getElementById('announceTitle').value;
  const msg = document.getElementById('announceMessage').value;
  const type = document.getElementById('announceType').value;
  const color = getColor();
  const img = document.getElementById('announceImage').value;
  const footer = document.getElementById('announceFooter').value || `${announceLabels[type]} • Kratos Dashboard`;
  if (!title && !msg) { previewDiv.style.display = 'none'; return; }
  previewDiv.style.display = 'block';
  previewContent.innerHTML = `
    <div style="background:var(--bg-secondary);border-radius:12px;overflow:hidden;border:1px solid var(--border)">
      <div style="height:4px;background:${announceColors[color] || '#1a6fff'}"></div>
      <div style="padding:16px">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;font-size:.8rem;color:var(--text-muted)">
          <span>${announceEmojis[type] || '📢'} ${announceLabels[type] || 'إعلان'}</span>
          <span>•</span>
          <span>📅 ${new Date().toLocaleDateString('ar-SA')}</span>
        </div>
        <div style="font-weight:700;font-size:1.15rem;margin-bottom:10px;color:var(--text)">${escapeHtml(title) || 'عنوان الإعلان'}</div>
        <div style="font-size:.9rem;line-height:1.8;color:var(--text);white-space:pre-wrap">${escapeHtml(msg) || 'نص الإعلان...'}</div>
        ${img ? `<div style="margin-top:12px;border-radius:8px;overflow:hidden;background:var(--bg-primary)"><img src="${escapeHtml(img)}" style="max-width:100%;max-height:300px;display:block;margin:auto" onerror="this.parentElement.innerHTML='<div style=padding:20px;text-align:center;color:var(--text-muted);font-size:.8rem>⚠️ فشل تحميل الصورة</div>'"></div>` : ''}
        <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--border);font-size:.78rem;color:var(--text-muted);display:flex;gap:12px">
          <span>${escapeHtml(footer)}</span>
        </div>
      </div>
    </div>
  `;
}

function escapeHtml(str) {
  if (!str) return '';
  return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

['announceTitle','announceMessage','announceType'].forEach(id => {
  document.getElementById(id)?.addEventListener('input', updatePreview);
  document.getElementById(id)?.addEventListener('change', updatePreview);
});
document.getElementById('announceImage')?.addEventListener('input', updatePreview);
document.getElementById('announceFooter')?.addEventListener('input', updatePreview);
previewBtn?.addEventListener('click', updatePreview);

announceForm?.addEventListener('submit', async e => {
  e.preventDefault();
  const btn = e.target.querySelector('button[type=submit]');
  btn.disabled = true; btn.innerHTML = '⏳ جاري الإرسال...';

  const body = {
    channelId: document.getElementById('announceChannel').value,
    title: document.getElementById('announceTitle').value,
    message: document.getElementById('announceMessage').value,
    mention: document.getElementById('announceMention').value,
    type: document.getElementById('announceType').value,
    color: getColor(),
    image: document.getElementById('announceImage').value || undefined,
    footer: document.getElementById('announceFooter').value || undefined,
  };

  if (!body.channelId) { alert('❌ اختر القناة المستهدفة'); btn.disabled = false; btn.innerHTML = '📢 إرسال الإعلان'; return; }

  try {
    const res = await fetch('/notifications/<%= guild.id %>/announce', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const data = await res.json();
    if (data.success) {
      alert('✅ تم إرسال الإعلان بنجاح');
      announceForm.reset();
      previewDiv.style.display = 'none';
    } else {
      alert('❌ ' + (data.error || 'فشل الإرسال'));
    }
  } catch (err) {
    alert('❌ خطأ في الإتصال');
  }
  btn.disabled = false; btn.innerHTML = '📢 إرسال الإعلان';
});
</script>
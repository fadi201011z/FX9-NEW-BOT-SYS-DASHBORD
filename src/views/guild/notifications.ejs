<% layout = 'layouts/main' %>
<% currentPage = 'notifications' %>
<%
const platformLogos = {
  youtube: 'https://www.google.com/s2/favicons?domain=youtube.com&sz=64',
  kick:    'https://www.google.com/s2/favicons?domain=kick.com&sz=64',
  twitter: 'https://www.google.com/s2/favicons?domain=twitter.com&sz=64',
};
%>
<div class="page-header fade-in-up">
  <div>
    <h1><i class="fas fa-bell"></i> الإشعارات</h1>
    <p>إشتراكات إشعارات يوتيوب، كيك، وتويتر — يراقبها البوت تلقائياً</p>
  </div>
</div>

<div class="glass-card fade-in-up" style="padding:24px;margin-bottom:20px">
  <h3 style="margin:0 0 16px">➕ إضافة إشتراك جديد</h3>
  <form id="addForm" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px">
    <div style="position:relative">
      <select id="platform" required style="padding:10px 14px 10px 40px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);appearance:none;width:100%">
        <option value="">— المنصة —</option>
        <option value="youtube">YouTube</option>
        <option value="kick">Kick</option>
        <option value="twitter">Twitter/X</option>
      </select>
      <img id="platformIcon" src="" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);width:20px;height:20px;display:none;pointer-events:none">
    </div>
    <input type="url" id="url" required placeholder="رابط القناة (مثل https://youtube.com/@...)">
    <select id="discordChannelId" required style="padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text)">
      <option value="">— قناة الإشعارات —</option>
      <% (guildChannels || []).forEach(ch => { %>
        <option value="<%= ch.id %>">#<%= ch.name %></option>
      <% }) %>
    </select>
    <input type="text" id="customMessage" placeholder="رسالة إضافية (اختياري)">
    <button type="submit" class="btn-primary" style="grid-column:1/-1">➕ إضافة</button>
  </form>
</div>

<div class="glass-card fade-in-up" style="padding:24px;margin-bottom:20px">
  <h3 style="margin:0 0 16px">📢 إرسال إعلان</h3>
  <form id="announceForm" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px">
    <input type="text" id="announceTitle" required placeholder="عنوان الإعلان" style="grid-column:1/-1;padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text)">
    <textarea id="announceMessage" required placeholder="نص الإعلان..." style="grid-column:1/-1;padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);min-height:120px;resize:vertical"></textarea>
    <select id="announceChannel" required style="padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text)">
      <option value="">— القناة المستهدفة —</option>
      <% (guildChannels || []).forEach(ch => { %>
        <option value="<%= ch.id %>">#<%= ch.name %></option>
      <% }) %>
    </select>
    <select id="announceMention" style="padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text)">
      <option value="none">لا منشن</option>
      <option value="everyone">@everyone</option>
      <option value="here">@here</option>
    </select>
    <select id="announceType" style="padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text)">
      <option value="general">📢 إعلان عام</option>
      <option value="maintenance">🔧 صيانة</option>
      <option value="update">✅ تحديث</option>
      <option value="warning">🚨 تحذير</option>
      <option value="rules">📋 قواعد</option>
    </select>
    <select id="announceColor" style="padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text)">
      <option value="blue">🔵 أزرق</option>
      <option value="red">🔴 أحمر</option>
      <option value="gold">🟡 ذهبي</option>
      <option value="green">🟢 أخضر</option>
      <option value="purple">🟣 بنفسجي</option>
      <option value="orange">🟠 برتقالي</option>
      <option value="black">⚫ أسود</option>
    </select>
    <input type="url" id="announceImage" placeholder="رابط صورة (اختياري)" style="padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text)">
    <input type="text" id="announceFooter" placeholder="نص التذييل (اختياري)" style="padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text)">
    <div style="grid-column:1/-1;display:flex;gap:12px">
      <button type="submit" class="btn-primary" style="flex:1">📢 إرسال الإعلان</button>
      <button type="button" id="previewBtn" style="flex:0;padding:10px 20px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);cursor:pointer">👁️ معاينة</button>
    </div>
  </form>
  <div id="announcePreview" style="display:none;margin-top:16px;padding:16px;background:var(--bg-primary);border-radius:12px;border:1px solid var(--border)">
    <div style="font-size:.85rem;color:var(--text-muted);margin-bottom:8px">👁️ المعاينة:</div>
    <div id="previewContent"></div>
  </div>
</div>

<div class="glass-card fade-in-up" style="padding:24px">
  <h3 style="margin:0 0 16px">📋 الإشتراكات الحالية (<%= subscriptions.length %>)</h3>

  <% if (subscriptions.length === 0) { %>
    <p style="color:var(--text-muted);text-align:center;padding:40px 0">لا يوجد أي إشتراكات بعد. أضف واحداً من الأعلى.</p>
  <% } else { %>
    <div style="display:grid;gap:12px">
      <% subscriptions.forEach(sub => { %>
        <div class="sub-item" style="display:flex;align-items:center;gap:16px;padding:14px 18px;background:var(--bg-secondary);border-radius:12px;border:1px solid var(--border)">
          <img src="https://www.google.com/s2/favicons?domain=<%= sub.platform === 'youtube' ? 'youtube.com' : sub.platform === 'kick' ? 'kick.com' : 'twitter.com' %>&sz=64" alt="<%= sub.platform %>" style="width:22px;height:22px;border-radius:4px;flex-shrink:0">
          <div class="channel-avatar-wrap" style="width:34px;height:34px;border-radius:50%;flex-shrink:0;overflow:hidden;background:var(--bg-primary);display:flex;align-items:center;justify-content:center">
            <img class="channel-avatar" data-channelid="<%= sub.channelId %>" data-platform="<%= sub.platform %>" src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(sub.channelName || sub.channelId || '?') %>&size=32&background=random&color=fff" style="width:32px;height:32px;border-radius:50%;object-fit:cover" onerror="this.parentElement.innerHTML='<span style=font-size:14px;color:var(--text-muted)>?</span>'">
          </div>
          <div style="flex:1;min-width:0">
            <div style="font-weight:600;font-size:.9rem"><%= sub.channelName || sub.channelId || '—' %></div>
            <div style="font-size:.78rem;color:var(--text-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
              <a href="<%= sub.channelUrl %>" target="_blank" style="color:var(--primary)"><%= sub.channelUrl %></a>
              &nbsp;→&nbsp; <code style="font-size:.75rem"><%= guildChannels.find(c => c.id === sub.discordChannelId)?.name || '#' + sub.discordChannelId %></code>
            </div>
          </div>
          <% if (sub.customMessage) { %>
            <span style="font-size:.78rem;color:var(--text-muted);max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">"<%= sub.customMessage %>"</span>
          <% } %>
          <button class="delete-btn" data-id="<%= sub._id %>" style="background:var(--danger);color:#fff;border:none;padding:6px 14px;border-radius:8px;cursor:pointer;font-size:.78rem">✕ حذف</button>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<script>
// Show platform logo next to select
const platSelect = document.getElementById('platform');
const platIcon = document.getElementById('platformIcon');
const platLogos = { youtube: '<%= platformLogos.youtube %>', kick: '<%= platformLogos.kick %>', twitter: '<%= platformLogos.twitter %>' };
platSelect?.addEventListener('change', function() {
  const logo = platLogos[this.value];
  if (logo) { platIcon.src = logo; platIcon.style.display = 'block'; }
  else platIcon.style.display = 'none';
});

// Fetch actual channel avatars asynchronously
document.querySelectorAll('.channel-avatar').forEach(img => {
  const platform = img.dataset.platform;
  const channelId = img.dataset.channelid;
  if (!channelId) return;

  let url;
  if (platform === 'youtube') {
    url = `https://www.youtube.com/channel/${channelId}`;
    fetch(url, { headers: { 'User-Agent': 'Mozilla/5.0' } })
      .then(r => r.text())
      .then(html => {
        const m = html.match(/"avatar":\s*\[\s*\{\s*"url":\s*"([^"]+)"/);
        if (m) img.src = m[1].replace(/\\u0026/g, '&');
      }).catch(() => {});
  } else if (platform === 'kick') {
    fetch(`https://kick.com/api/v2/channels/${channelId}`, { headers: { 'User-Agent': 'Mozilla/5.0' } })
      .then(r => r.json())
      .then(d => { if (d?.user?.profile_pic) img.src = d.user.profile_pic; })
      .catch(() => {});
  } else if (platform === 'twitter') {
    const instances = ['nitter.net', 'nitter.privacydev.net', 'nitter.lqdev.tech'];
    for (const inst of instances) {
      fetch(`https://${inst}/${channelId}`, { headers: { 'User-Agent': 'Mozilla/5.0' } })
        .then(r => r.text())
        .then(html => {
          const m = html.match(/<img[^>]*class="avatar"[^>]*src="([^"]+)"/);
          if (m) {
            const src = m[1].startsWith('http') ? m[1] : `https://${inst}${m[1]}`;
            img.src = src;
          }
        }).catch(() => {});
      break;
    }
  }
});

document.getElementById('addForm')?.addEventListener('submit', async e => {
  e.preventDefault();
  const btn = e.target.querySelector('button[type=submit]');
  btn.disabled = true; btn.textContent = '⏳ جاري الإضافة...';

  const body = {
    platform: document.getElementById('platform').value,
    url: document.getElementById('url').value,
    discordChannelId: document.getElementById('discordChannelId').value,
    customMessage: document.getElementById('customMessage').value,
  };

  try {
    const res = await fetch('/notifications/<%= guild.id %>/add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const data = await res.json();
    if (data.success) {
      location.reload();
    } else {
      alert('❌ ' + (data.error || 'فشل الإضافة'));
    }
  } catch (err) {
    alert('❌ خطأ في الإتصال');
  }
  btn.disabled = false; btn.textContent = '➕ إضافة';
});

document.querySelectorAll('.delete-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    if (!confirm('تأكيد حذف هذا الإشتراك؟')) return;
    const id = btn.dataset.id;
    btn.disabled = true; btn.textContent = '⏳';
    try {
      const res = await fetch('/notifications/<%= guild.id %>/' + id, { method: 'DELETE' });
      if (res.ok) location.reload();
      else alert('❌ فشل الحذف');
    } catch { alert('❌ خطأ في الإتصال'); }
  });
});

// ── Announcement ──────────────────────────────────────────────────────
const announceForm = document.getElementById('announceForm');
const previewBtn = document.getElementById('previewBtn');
const previewDiv = document.getElementById('announcePreview');
const previewContent = document.getElementById('previewContent');
const announceColors = { blue: '#1a6fff', red: '#e53935', gold: '#ffd700', green: '#00c853', purple: '#7c4dff', orange: '#ff9800', black: '#0d0d0d' };
const announceEmojis = { general: '📢', maintenance: '🔧', update: '✅', warning: '🚨', rules: '📋' };
const announceLabels = { general: 'إعلان عام', maintenance: 'صيانة', update: 'تحديث', warning: 'تحذير', rules: 'قواعد' };

function updatePreview() {
  const title = document.getElementById('announceTitle').value;
  const msg = document.getElementById('announceMessage').value;
  const type = document.getElementById('announceType').value;
  const color = document.getElementById('announceColor').value;
  if (!title && !msg) { previewDiv.style.display = 'none'; return; }
  previewDiv.style.display = 'block';
  previewContent.innerHTML = `
    <div style="border-right:4px solid ${announceColors[color] || '#1a6fff'};padding:12px;background:var(--bg-secondary);border-radius:8px">
      <div style="font-size:.85rem;color:var(--text-muted);margin-bottom:4px">${announceEmojis[type] || '📢'} ${announceLabels[type] || 'إعلان'}</div>
      <div style="font-weight:700;font-size:1.1rem;margin-bottom:8px">${escapeHtml(title) || 'عنوان الإعلان'}</div>
      <div style="font-size:.9rem;line-height:1.6;white-space:pre-wrap">${escapeHtml(msg) || 'نص الإعلان...'}</div>
      <div style="font-size:.75rem;color:var(--text-muted);margin-top:8px">━━━━━━━━━━━━━━━</div>
    </div>
  `;
}

function escapeHtml(str) {
  if (!str) return '';
  return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

['announceTitle','announceMessage','announceType','announceColor'].forEach(id => {
  document.getElementById(id)?.addEventListener('input', updatePreview);
  document.getElementById(id)?.addEventListener('change', updatePreview);
});
previewBtn?.addEventListener('click', updatePreview);

announceForm?.addEventListener('submit', async e => {
  e.preventDefault();
  const btn = e.target.querySelector('button[type=submit]');
  btn.disabled = true; btn.textContent = '⏳ جاري الإرسال...';

  const body = {
    channelId: document.getElementById('announceChannel').value,
    title: document.getElementById('announceTitle').value,
    message: document.getElementById('announceMessage').value,
    mention: document.getElementById('announceMention').value,
    type: document.getElementById('announceType').value,
    color: document.getElementById('announceColor').value,
    image: document.getElementById('announceImage').value || undefined,
    footer: document.getElementById('announceFooter').value || undefined,
  };

  if (!body.channelId) { alert('❌ اختر القناة المستهدفة'); btn.disabled = false; btn.textContent = '📢 إرسال الإعلان'; return; }

  try {
    const res = await fetch('/notifications/<%= guild.id %>/announce', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const data = await res.json();
    if (data.success) {
      alert('✅ تم إرسال الإعلان بنجاح');
      announceForm.reset();
      previewDiv.style.display = 'none';
    } else {
      alert('❌ ' + (data.error || 'فشل الإرسال'));
    }
  } catch (err) {
    alert('❌ خطأ في الإتصال');
  }
  btn.disabled = false; btn.textContent = '📢 إرسال الإعلان';
});
</script>

<% layout = 'layouts/main' %>
<% currentPage = 'notifications' %>
<%
const platformLogos = {
  youtube: 'https://www.google.com/s2/favicons?domain=youtube.com&sz=64',
  kick:    'https://www.google.com/s2/favicons?domain=kick.com&sz=64',
  twitter: 'https://www.google.com/s2/favicons?domain=twitter.com&sz=64',
};
%>
<div class="page-header fade-in-up">
  <div>
    <h1><i class="fas fa-bell"></i> الإشعارات</h1>
    <p>إشتراكات إشعارات يوتيوب، كيك، وتويتر — يراقبها البوت تلقائياً</p>
  </div>
</div>

<div class="glass-card fade-in-up" style="padding:24px;margin-bottom:20px">
  <h3 style="margin:0 0 16px">➕ إضافة إشتراك جديد</h3>
  <form id="addForm" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px">
    <div style="position:relative">
      <select id="platform" required style="padding:10px 14px 10px 40px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);appearance:none;width:100%">
        <option value="">— المنصة —</option>
        <option value="youtube">YouTube</option>
        <option value="kick">Kick</option>
        <option value="twitter">Twitter/X</option>
      </select>
      <img id="platformIcon" src="" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);width:20px;height:20px;display:none;pointer-events:none">
    </div>
    <input type="url" id="url" required placeholder="رابط القناة (مثل https://youtube.com/@...)">
    <select id="discordChannelId" required style="padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text)">
      <option value="">— قناة الإشعارات —</option>
      <% (guildChannels || []).forEach(ch => { %>
        <option value="<%= ch.id %>">#<%= ch.name %></option>
      <% }) %>
    </select>
    <input type="text" id="customMessage" placeholder="رسالة إضافية (اختياري)">
    <button type="submit" class="btn-primary" style="grid-column:1/-1">➕ إضافة</button>
  </form>
</div>

<div class="glass-card fade-in-up" style="padding:0;margin-bottom:20px;overflow:hidden">
  <div style="background:linear-gradient(135deg,var(--primary),var(--primary-dark, #0d47a1));padding:20px 24px">
    <div style="display:flex;align-items:center;gap:12px">
      <div style="width:40px;height:40px;border-radius:10px;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:1.3rem">📢</div>
      <div>
        <h3 style="margin:0;color:#fff;font-size:1rem">إرسال إعلان</h3>
        <p style="margin:2px 0 0;color:rgba(255,255,255,.7);font-size:.78rem">أنشئ وأرسل إعلاناً احترافياً لأعضاء السيرفر</p>
      </div>
    </div>
  </div>
  <div style="padding:20px 24px">
    <form id="announceForm">
      <div style="margin-bottom:16px">
        <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:6px;color:var(--text-muted)">عنوان الإعلان</label>
        <input type="text" id="announceTitle" required placeholder="اكتب عنواناً واضحاً للإعلان..." style="width:100%;padding:12px 16px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);font-size:.9rem;box-sizing:border-box">
      </div>
      <div style="margin-bottom:16px">
        <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:6px;color:var(--text-muted)">نص الإعلان</label>
        <textarea id="announceMessage" required placeholder="اكتب محتوى الإعلان هنا..." style="width:100%;padding:12px 16px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);min-height:140px;resize:vertical;font-size:.9rem;box-sizing:border-box;line-height:1.7"></textarea>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px">
        <div>
          <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:6px;color:var(--text-muted)">
            <span style="display:inline-flex;align-items:center;gap:4px">📣 القناة المستهدفة</span>
          </label>
          <select id="announceChannel" required style="width:100%;padding:12px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);font-size:.85rem;box-sizing:border-box">
            <option value="">اختر القناة...</option>
            <% (guildChannels || []).forEach(ch => { %>
              <option value="<%= ch.id %>">#<%= ch.name %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:6px;color:var(--text-muted)">
            <span style="display:inline-flex;align-items:center;gap:4px">📢 المنشن</span>
          </label>
          <select id="announceMention" style="width:100%;padding:12px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);font-size:.85rem;box-sizing:border-box">
            <option value="none">بدون منشن</option>
            <option value="everyone">@everyone</option>
            <option value="here">@here</option>
          </select>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px">
        <div>
          <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:6px;color:var(--text-muted)">
            <span style="display:inline-flex;align-items:center;gap:4px">🏷️ نوع الإعلان</span>
          </label>
          <select id="announceType" style="width:100%;padding:12px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);font-size:.85rem;box-sizing:border-box">
            <option value="general">📢 إعلان عام</option>
            <option value="maintenance">🔧 صيانة</option>
            <option value="update">✅ تحديث</option>
            <option value="warning">🚨 تحذير</option>
            <option value="rules">📋 قواعد</option>
          </select>
        </div>
        <div>
          <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:6px;color:var(--text-muted)">
            <span style="display:inline-flex;align-items:center;gap:4px">🎨 لون الإعلان</span>
          </label>
          <div style="display:flex;gap:6px;flex-wrap:wrap">
            <% const colorOpts = {blue:'#1a6fff',red:'#e53935',gold:'#ffd700',green:'#00c853',purple:'#7c4dff',orange:'#ff9800',black:'#333'}; %>
            <% Object.entries(colorOpts).forEach(([k,v]) => { %>
              <label style="width:32px;height:32px;border-radius:8px;background:<%= v %>;cursor:pointer;border:2px solid transparent;display:flex;align-items:center;justify-content:center;transition:.2s" class="color-option" data-value="<%= k %>">
                <input type="radio" name="announceColor" value="<%= k %>" style="display:none" <%= k === 'blue' ? 'checked' : '' %>>
                <span style="font-size:.6rem;color:<%= ['gold','orange'].includes(k) ? '#333' : '#fff' %>;opacity:0">✓</span>
              </label>
            <% }) %>
          </div>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px">
        <input type="url" id="announceImage" placeholder="رابط صورة (اختياري)" style="width:100%;padding:12px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);font-size:.85rem;box-sizing:border-box">
        <input type="text" id="announceFooter" placeholder="نص التذييل (اختياري)" style="width:100%;padding:12px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);font-size:.85rem;box-sizing:border-box">
      </div>
      <div style="display:flex;gap:12px;align-items:stretch">
        <button type="submit" class="btn-primary" style="flex:1;padding:14px 24px;font-size:.9rem;border:none;border-radius:10px;cursor:pointer;font-weight:600;display:flex;align-items:center;justify-content:center;gap:8px;background:linear-gradient(135deg,var(--primary),var(--primary-dark, #0d47a1));color:#fff">
          📢 إرسال الإعلان
        </button>
        <button type="button" id="previewBtn" style="padding:14px 20px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);cursor:pointer;font-weight:600;display:flex;align-items:center;gap:6px;font-size:.85rem">
          👁️ معاينة
        </button>
      </div>
    </form>
    <div id="announcePreview" style="display:none;margin-top:20px;padding:20px;background:var(--bg-primary);border-radius:12px;border:1px solid var(--border)">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid var(--border);font-size:.82rem;color:var(--text-muted)">
        <span>👁️</span>
        <span>معاينة الإعلان — كيف سيظهر في ديسكورد</span>
      </div>
      <div id="previewContent"></div>
    </div>
  </div>
</div>

<div class="glass-card fade-in-up" style="padding:24px">
  <h3 style="margin:0 0 16px">📋 الإشتراكات الحالية (<%= subscriptions.length %>)</h3>

  <% if (subscriptions.length === 0) { %>
    <p style="color:var(--text-muted);text-align:center;padding:40px 0">لا يوجد أي إشتراكات بعد. أضف واحداً من الأعلى.</p>
  <% } else { %>
    <div style="display:grid;gap:12px">
      <% subscriptions.forEach(sub => { %>
        <div class="sub-item" style="display:flex;align-items:center;gap:16px;padding:14px 18px;background:var(--bg-secondary);border-radius:12px;border:1px solid var(--border)">
          <img src="https://www.google.com/s2/favicons?domain=<%= sub.platform === 'youtube' ? 'youtube.com' : sub.platform === 'kick' ? 'kick.com' : 'twitter.com' %>&sz=64" alt="<%= sub.platform %>" style="width:22px;height:22px;border-radius:4px;flex-shrink:0">
          <div class="channel-avatar-wrap" style="width:34px;height:34px;border-radius:50%;flex-shrink:0;overflow:hidden;background:var(--bg-primary);display:flex;align-items:center;justify-content:center">
            <img class="channel-avatar" data-channelid="<%= sub.channelId %>" data-platform="<%= sub.platform %>" src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(sub.channelName || sub.channelId || '?') %>&size=32&background=random&color=fff" style="width:32px;height:32px;border-radius:50%;object-fit:cover" onerror="this.parentElement.innerHTML='<span style=font-size:14px;color:var(--text-muted)>?</span>'">
          </div>
          <div style="flex:1;min-width:0">
            <div style="font-weight:600;font-size:.9rem"><%= sub.channelName || sub.channelId || '—' %></div>
            <div style="font-size:.78rem;color:var(--text-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
              <a href="<%= sub.channelUrl %>" target="_blank" style="color:var(--primary)"><%= sub.channelUrl %></a>
              &nbsp;→&nbsp; <code style="font-size:.75rem"><%= guildChannels.find(c => c.id === sub.discordChannelId)?.name || '#' + sub.discordChannelId %></code>
            </div>
          </div>
          <% if (sub.customMessage) { %>
            <span style="font-size:.78rem;color:var(--text-muted);max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">"<%= sub.customMessage %>"</span>
          <% } %>
          <% if (sub.platform === 'youtube') { %>
            <button class="checknow-btn" data-id="<%= sub._id %>" style="background:var(--primary);color:#fff;border:none;padding:6px 14px;border-radius:8px;cursor:pointer;font-size:.78rem">🔍 فحص الآن</button>
          <% } %>
          <button class="delete-btn" data-id="<%= sub._id %>" style="background:var(--danger);color:#fff;border:none;padding:6px 14px;border-radius:8px;cursor:pointer;font-size:.78rem">✕ حذف</button>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<script>
// Show platform logo next to select
const platSelect = document.getElementById('platform');
const platIcon = document.getElementById('platformIcon');
const platLogos = { youtube: '<%= platformLogos.youtube %>', kick: '<%= platformLogos.kick %>', twitter: '<%= platformLogos.twitter %>' };
platSelect?.addEventListener('change', function() {
  const logo = platLogos[this.value];
  if (logo) { platIcon.src = logo; platIcon.style.display = 'block'; }
  else platIcon.style.display = 'none';
});

// Fetch actual channel avatars asynchronously
document.querySelectorAll('.channel-avatar').forEach(img => {
  const platform = img.dataset.platform;
  const channelId = img.dataset.channelid;
  if (!channelId) return;

  let url;
  if (platform === 'youtube') {
    url = `https://www.youtube.com/channel/${channelId}`;
    fetch(url, { headers: { 'User-Agent': 'Mozilla/5.0' } })
      .then(r => r.text())
      .then(html => {
        const m = html.match(/"avatar":\s*\[\s*\{\s*"url":\s*"([^"]+)"/);
        if (m) img.src = m[1].replace(/\\u0026/g, '&');
      }).catch(() => {});
  } else if (platform === 'kick') {
    fetch(`https://kick.com/api/v2/channels/${channelId}`, { headers: { 'User-Agent': 'Mozilla/5.0' } })
      .then(r => r.json())
      .then(d => { if (d?.user?.profile_pic) img.src = d.user.profile_pic; })
      .catch(() => {});
  } else if (platform === 'twitter') {
    const instances = ['nitter.net', 'nitter.privacydev.net', 'nitter.lqdev.tech'];
    for (const inst of instances) {
      fetch(`https://${inst}/${channelId}`, { headers: { 'User-Agent': 'Mozilla/5.0' } })
        .then(r => r.text())
        .then(html => {
          const m = html.match(/<img[^>]*class="avatar"[^>]*src="([^"]+)"/);
          if (m) {
            const src = m[1].startsWith('http') ? m[1] : `https://${inst}${m[1]}`;
            img.src = src;
          }
        }).catch(() => {});
      break;
    }
  }
});

document.getElementById('addForm')?.addEventListener('submit', async e => {
  e.preventDefault();
  const btn = e.target.querySelector('button[type=submit]');
  btn.disabled = true; btn.textContent = '⏳ جاري الإضافة...';

  const body = {
    platform: document.getElementById('platform').value,
    url: document.getElementById('url').value,
    discordChannelId: document.getElementById('discordChannelId').value,
    customMessage: document.getElementById('customMessage').value,
  };

  try {
    const res = await fetch('/notifications/<%= guild.id %>/add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const data = await res.json();
    if (data.success) {
      location.reload();
    } else {
      alert('❌ ' + (data.error || 'فشل الإضافة'));
    }
  } catch (err) {
    alert('❌ خطأ في الإتصال');
  }
  btn.disabled = false; btn.textContent = '➕ إضافة';
});

document.querySelectorAll('.delete-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    if (!confirm('تأكيد حذف هذا الإشتراك؟')) return;
    const id = btn.dataset.id;
    btn.disabled = true; btn.textContent = '⏳';
    try {
      const res = await fetch('/notifications/<%= guild.id %>/' + id, { method: 'DELETE' });
      if (res.ok) location.reload();
      else alert('❌ فشل الحذف');
    } catch { alert('❌ خطأ في الإتصال'); }
  });
});

document.querySelectorAll('.checknow-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    const id = btn.dataset.id;
    const orig = btn.textContent;
    btn.disabled = true; btn.textContent = '⏳';
    try {
      const res = await fetch('/notifications/<%= guild.id %>/checknow/' + id, { method: 'POST' });
      const data = await res.json();
      if (data.success) alert('✅ تم إرسال الإشعار: ' + (data.title || data.videoId));
      else alert('❌ ' + (data.error || 'فشل'));
    } catch { alert('❌ البوت غير متصل'); }
    btn.disabled = false; btn.textContent = orig;
  });
});

// ── Color radio buttons ───────────────────────────────────────────────
document.querySelectorAll('.color-option').forEach(el => {
  el.addEventListener('click', function() {
    document.querySelectorAll('.color-option').forEach(o => {
      o.style.borderColor = 'transparent';
      o.querySelector('span').style.opacity = '0';
    });
    this.style.borderColor = '#fff';
    this.querySelector('span').style.opacity = '1';
    this.querySelector('input[type=radio]').checked = true;
    updatePreview();
  });
});
// Set default blue
document.querySelector('.color-option[data-value=blue]')?.click();

// ── Announcement ──────────────────────────────────────────────────────
const announceForm = document.getElementById('announceForm');
const previewBtn = document.getElementById('previewBtn');
const previewDiv = document.getElementById('announcePreview');
const previewContent = document.getElementById('previewContent');
const announceColors = { blue: '#1a6fff', red: '#e53935', gold: '#ffd700', green: '#00c853', purple: '#7c4dff', orange: '#ff9800', black: '#333' };
const announceEmojis = { general: '📢', maintenance: '🔧', update: '✅', warning: '🚨', rules: '📋' };
const announceLabels = { general: 'إعلان عام', maintenance: 'صيانة', update: 'تحديث', warning: 'تحذير', rules: 'قواعد' };

function getColor() {
  const checked = document.querySelector('input[name=announceColor]:checked');
  return checked ? checked.value : 'blue';
}

function updatePreview() {
  const title = document.getElementById('announceTitle').value;
  const msg = document.getElementById('announceMessage').value;
  const type = document.getElementById('announceType').value;
  const color = getColor();
  const img = document.getElementById('announceImage').value;
  const footer = document.getElementById('announceFooter').value || `${announceLabels[type]} • FX9 Dashboard`;
  if (!title && !msg) { previewDiv.style.display = 'none'; return; }
  previewDiv.style.display = 'block';
  previewContent.innerHTML = `
    <div style="background:var(--bg-secondary);border-radius:12px;overflow:hidden;border:1px solid var(--border)">
      <div style="height:4px;background:${announceColors[color] || '#1a6fff'}"></div>
      <div style="padding:16px">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;font-size:.8rem;color:var(--text-muted)">
          <span>${announceEmojis[type] || '📢'} ${announceLabels[type] || 'إعلان'}</span>
          <span>•</span>
          <span>📅 ${new Date().toLocaleDateString('ar-SA')}</span>
        </div>
        <div style="font-weight:700;font-size:1.15rem;margin-bottom:10px;color:var(--text)">${escapeHtml(title) || 'عنوان الإعلان'}</div>
        <div style="font-size:.9rem;line-height:1.8;color:var(--text);white-space:pre-wrap">${escapeHtml(msg) || 'نص الإعلان...'}</div>
        ${img ? `<div style="margin-top:12px;border-radius:8px;overflow:hidden;background:var(--bg-primary)"><img src="${escapeHtml(img)}" style="max-width:100%;max-height:300px;display:block;margin:auto" onerror="this.parentElement.innerHTML='<div style=padding:20px;text-align:center;color:var(--text-muted);font-size:.8rem>⚠️ فشل تحميل الصورة</div>'"></div>` : ''}
        <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--border);font-size:.78rem;color:var(--text-muted);display:flex;gap:12px">
          <span>${escapeHtml(footer)}</span>
        </div>
      </div>
    </div>
  `;
}

function escapeHtml(str) {
  if (!str) return '';
  return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

['announceTitle','announceMessage','announceType'].forEach(id => {
  document.getElementById(id)?.addEventListener('input', updatePreview);
  document.getElementById(id)?.addEventListener('change', updatePreview);
});
document.getElementById('announceImage')?.addEventListener('input', updatePreview);
document.getElementById('announceFooter')?.addEventListener('input', updatePreview);
previewBtn?.addEventListener('click', updatePreview);

announceForm?.addEventListener('submit', async e => {
  e.preventDefault();
  const btn = e.target.querySelector('button[type=submit]');
  btn.disabled = true; btn.innerHTML = '⏳ جاري الإرسال...';

  const body = {
    channelId: document.getElementById('announceChannel').value,
    title: document.getElementById('announceTitle').value,
    message: document.getElementById('announceMessage').value,
    mention: document.getElementById('announceMention').value,
    type: document.getElementById('announceType').value,
    color: getColor(),
    image: document.getElementById('announceImage').value || undefined,
    footer: document.getElementById('announceFooter').value || undefined,
  };

  if (!body.channelId) { alert('❌ اختر القناة المستهدفة'); btn.disabled = false; btn.innerHTML = '📢 إرسال الإعلان'; return; }

  try {
    const res = await fetch('/notifications/<%= guild.id %>/announce', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const data = await res.json();
    if (data.success) {
      alert('✅ تم إرسال الإعلان بنجاح');
      announceForm.reset();
      previewDiv.style.display = 'none';
    } else {
      alert('❌ ' + (data.error || 'فشل الإرسال'));
    }
  } catch (err) {
    alert('❌ خطأ في الإتصال');
  }
  btn.disabled = false; btn.innerHTML = '📢 إرسال الإعلان';
});
</script>

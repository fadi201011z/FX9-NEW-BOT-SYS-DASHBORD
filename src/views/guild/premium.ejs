<% currentPage = 'premium' %>
<div class="page-header">
  <h1><i class="fas fa-gem" style="color:#f5b301"></i> نظام البريميوم — <%= guild.name %></h1>
  <p>فعّل سيرفرك الآن واحصل على تجربة فاخرة</p>
</div>

<% if (activePlanId) { %>
<!-- ═══ الحالة: اشتراك نشط ═══ النافذتان مخفيتان تماماً ═══ -->
<div class="active-screen glass fade-in-up" id="activeScreen">
  <div class="premium-particles" id="premiumParticles"></div>
  <div class="a-icon"><i class="fas fa-crown"></i></div>
  <h2>خطة <em><%= activePlanLabel %></em> مفعّلة بنجاح</h2>
  <p class="a-sub">بريميوم هذا السيرفر نشط الآن — استمتع بكل المزايا الفاخرة</p>

  <div class="active-stats">
    <div class="active-stat">
      <span class="v"><i class="fas fa-crown" style="font-size:0.9rem"></i> <%= activePlanLabel %></span>
      <span class="l">الخطة الحالية</span>
    </div>
    <div class="active-stat">
      <span class="v"><%= remainingText %></span>
      <span class="l">المدة المتبقية</span>
    </div>
    <div class="active-stat">
      <span class="v"><%= expiresAtText %></span>
      <span class="l">تاريخ الانتهاء</span>
    </div>
    <div class="active-stat">
      <span class="v"><%= activatedAtText %></span>
      <span class="l">تاريخ التفعيل</span>
    </div>
  </div>

  <button class="a-end-btn" onclick="deactivatePlan()">
    <i class="fas fa-ban"></i> إنهاء الاشتراك
  </button>
  <p style="font-size:0.72rem;color:var(--text-muted);margin-top:10px" id="deactivateMsg"></p>
</div>
<% } else { %>
<!-- ═══ الحالة: لا يوجد اشتراك ═══ النافذتان ظاهرتان فوراً ═══ -->
<div class="premium-section glass fade-in-up" style="margin-top:0">
  <div class="premium-orb o1"></div>
  <div class="premium-orb o2"></div>

  <div class="premium-header">
    <div class="premium-crown"><i class="fas fa-crown"></i></div>
    <div>
      <h3><i class="fas fa-gem"></i> نظام البريميوم <span class="premium-vip-badge"><i class="fas fa-crown"></i> VIP</span></h3>
      <p>اختر طريقك: اشترك في خطة، أو فعّل بكودك السري</p>
    </div>
  </div>
</div>

<div class="gates-grid">
  <!-- ═══ النافذة 1: الاشتراك في خطة ═══ -->
  <div class="gate-card gate-plans glass fade-in-up">
    <div class="gate-head">
      <div class="gate-icon"><i class="fas fa-credit-card"></i></div>
      <div>
        <h4>اشترك في خطة</h4>
        <p>اختر الخطة الأنسب لسيرفرك وسيتم تفعيلها فوراً</p>
      </div>
    </div>

    <div class="gate-plans-inner">
      <% plans.forEach(plan => { %>
      <div class="gate-plan-row <%= plan.id %>">
        <div class="p-icon"><i class="fas <%= plan.icon %>"></i></div>
        <div class="p-info">
          <strong><%= plan.name %>
            <% if (plan.popular) { %><span class="premium-vip-badge"><i class="fas fa-fire"></i> الأكثر طلباً</span><% } %>
          </strong>
          <span><%= plan.tagline %> — <%= plan.features.length %> مزايا</span>
        </div>
        <div class="p-price"><%= plan.price %></div>
        <button class="p-btn" onclick="openPayment('<%= plan.id %>')">اشترك</button>
      </div>
      <% }) %>
    </div>
  </div>

  <!-- ═══ النافذة 2: التفعيل بالكود السري ═══ -->
  <div class="gate-card gate-code glass fade-in-up">
    <div class="gate-head">
      <div class="gate-icon"><i class="fas fa-key"></i></div>
      <div>
        <h4>تفعيل بالكود السري</h4>
        <p>أدخل كود التفعيل لتفعيل الخطة فوراً</p>
      </div>
    </div>

    <form class="gate-code-inner" onsubmit="activatePlan(event)">
      <input type="text" class="code-input" id="activationCode" placeholder="FX9-XXX-XXXX-XXXX" autocomplete="off" spellcheck="false" maxlength="20">
      <button type="submit" class="code-btn" id="activateBtn"><i class="fas fa-key"></i> تفعيل الخطة الآن</button>
      <div class="activate-msg" id="activateMsg"></div>
      <div class="gate-code-note"><i class="fas fa-shield-halved"></i> الكود يتم التحقق منه بشكل آمن على الخادم — ولن يظهر لأي شخص</div>
    </form>
  </div>
</div>
<% } %>

<!-- ═══ نافذة الدفع المنبثقة ═══ -->
<div class="pay-modal-overlay" id="payModal">
  <div class="pay-modal">
    <button class="m-close" onclick="closePayment()"><i class="fas fa-times"></i></button>
    <div class="m-head">
      <div class="icon"><i class="fas fa-crown"></i></div>
      <h3 id="mTitle">اشتراك بريميوم</h3>
      <div class="m-price" id="mPrice">$4.99 / شهرياً</div>
    </div>
    <div class="m-summary">
      <div class="m-row"><span>السيرفر</span><strong><%= guild.name %></strong></div>
      <div class="m-row"><span>الخطة</span><strong id="mPlan">Standard</strong></div>
      <div class="m-row"><span>المدة</span><strong>شهرياً — تجديد تلقائي</strong></div>
      <div class="m-row"><span>الإجمالي</span><strong style="color:#f5b301" id="mTotal">$4.99</strong></div>
    </div>
    <div class="m-methods">
      <div class="m-method selected" onclick="selectMethod(this)">
        <span><i class="fas fa-credit-card" style="color:#818cf8"></i> بطاقة بنكية (Visa / Mastercard)</span>
        <i class="fas fa-check" style="color:#57f287"></i>
      </div>
      <div class="m-method" onclick="selectMethod(this)">
        <span><i class="fas fa-wallet" style="color:#60a5fa"></i> محفظة إلكترونية (PayPal)</span>
        <i class="fas fa-chevron-left" style="opacity:0.4"></i>
      </div>
    </div>
    <button class="m-confirm" onclick="confirmPayment()">
      <i class="fas fa-lock"></i> إتمام الدفع الآن
    </button>
    <div class="m-note"><i class="fas fa-shield-halved"></i> دفع آمن ومشفر 100% — يمكنك الإلغاء في أي وقت</div>
  </div>
</div>

<!-- ═══ JS الصفحة ═══ -->
<script>
const PLANS = JSON.parse('<%- JSON.stringify(plans).replace(/'/g, "\\'") %>');
const GUILD_ID = '<%= guild.id %>';

function openPayment(planId) {
  const plan = PLANS.find(p => p.id === planId);
  if (!plan) return;
  document.getElementById('mTitle').textContent = `اشترك في باقة ${plan.name}`;
  document.getElementById('mPlan').textContent = plan.name;
  document.getElementById('mPrice').textContent = `${plan.price} / ${plan.period}`;
  document.getElementById('mTotal').textContent = plan.price;
  document.getElementById('payModal').classList.add('show');
}

function closePayment() {
  document.getElementById('payModal').classList.remove('show');
}

function selectMethod(el) {
  document.querySelectorAll('.m-method').forEach(m => m.classList.remove('selected'));
  el.classList.add('selected');
}

function confirmPayment() {
  const planName = document.getElementById('mPlan').textContent;
  closePayment();
  alert('✅ تم تجهيز طلب اشتراك باقة ' + planName + ' — سيتم إتمام الدفع عبر بوابة آمنة (قيد الربط حالياً). سيصلك الإشعار قريباً.');
}

document.getElementById('payModal').addEventListener('click', (e) => {
  if (e.target.id === 'payModal') closePayment();
});

// ═══ تفعيل الخطة بالكود السري ═══
async function activatePlan(e) {
  e.preventDefault();
  const input = document.getElementById('activationCode');
  const msg = document.getElementById('activateMsg');
  const btn = document.getElementById('activateBtn');
  const code = input.value.trim();

  msg.className = 'activate-msg';
  if (!code) {
    msg.className = 'activate-msg err';
    msg.textContent = '⚠️ أدخل كود التفعيل أولاً.';
    return;
  }

  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جارٍ التفعيل...';

  try {
    const res = await fetch(`/premium/${GUILD_ID}/activate`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code }),
    });
    const data = await res.json();

    if (data.success) {
      msg.className = 'activate-msg ok';
      msg.innerHTML = `<i class="fas fa-crown"></i> ${data.message}`;
      btn.innerHTML = '<i class="fas fa-check"></i> تم التفعيل';
      setTimeout(() => location.reload(), 1300);
    } else {
      msg.className = 'activate-msg err';
      msg.textContent = '❌ ' + (data.error || 'فشل التفعيل.');
    }
  } catch {
    msg.className = 'activate-msg err';
    msg.textContent = '❌ حدث خطأ في الاتصال، حاول مجدداً.';
  } finally {
    btn.disabled = false;
    if (!msg.classList.contains('ok')) btn.innerHTML = '<i class="fas fa-key"></i> تفعيل الخطة الآن';
  }
}

// ═══ إنهاء الاشتراك ═══
async function deactivatePlan() {
  const msgEl = document.getElementById('deactivateMsg');
  if (!confirm('⚠️ هل أنت متأكد من إنهاء اشتراك البريميوم؟ ستعود النافذتان للظهور.')) return;
  try {
    const res = await fetch(`/premium/${GUILD_ID}/deactivate`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
    });
    const data = await res.json();
    if (data.success) {
      msgEl.textContent = '✅ ' + data.message;
      setTimeout(() => location.reload(), 1200);
    } else {
      msgEl.textContent = '❌ ' + (data.error || 'فشل الإنهاء.');
    }
  } catch {
    msgEl.textContent = '❌ حدث خطأ في الاتصال.';
  }
}

// ════════════════════════════════════════════════════════════════
//  ⚜️ أنيميشن سينمائي احترافي: شاشة الاشتراك → نقطة القائمة الجانبية
//  تقنية FLIP: قياس فعلي لموضعي البداية والنقطة الجانبية
//  ثم طيران واحد متواصل (Web Animations API) على قوس سلس
//  بمنحنى تحرّك واحد (easeInOutQuart) + ذيل ذهبي يتبع المسار
//  + حلقة شحن قبل الإقلاع + انفجار ذهبي عند الهبوط
// ════════════════════════════════════════════════════════════════
const ACTIVE_SCREEN_DELAY = 5000;

// منحنى الحركة الوحيد — نعومة تامة بلا تقطّع (easeInOutQuart)
const FLY_EASE = 'cubic-bezier(0.65, 0, 0.35, 1)';
const easeInOutQuart = (t) => (t < 0.5 ? 8 * t * t * t * t : 1 - Math.pow(-2 * t + 2, 4) / 2);

// نقطة على القوس عند الزمن t (0..1) بنفس منحنى التحرّك
function arcPoint(p0, pm, p1, t) {
  const seg = t < 0.5 ? 0 : 1;
  const sub = seg === 0 ? t / 0.5 : (t - 0.5) / 0.5;
  const a = seg === 0 ? p0 : pm;
  const b = seg === 0 ? pm : p1;
  const k = easeInOutQuart(sub);
  return { x: a.x + (b.x - a.x) * k, y: a.y + (b.y - a.y) * k };
}

// جسيم ذهبي (يُلحق بـ body بإحداثيات viewport)
function goldParticle(x, y) {
  const p = document.createElement('span');
  p.className = 'premium-particle';
  p.style.position = 'fixed';
  p.style.top = '0';
  p.style.left = '0';
  const s = 3 + Math.random() * 7;
  p.style.width = s + 'px';
  p.style.height = s + 'px';
  p.style.transform = `translate(${x - s / 2}px, ${y - s / 2}px)`;
  document.body.appendChild(p);
  const dx = (Math.random() - 0.5) * 60;
  const dy = (Math.random() - 0.5) * 60;
  const a = p.animate([
    { transform: `translate(${x - s / 2}px, ${y - s / 2}px) scale(1)`, opacity: 0.95 },
    { transform: `translate(${x - s / 2 + dx}px, ${y - s / 2 + dy}px) scale(0.15)`, opacity: 0 },
  ], { duration: 380 + Math.random() * 340, easing: 'cubic-bezier(0.2, 0.6, 0.3, 1)' });
  a.finished.then(() => p.remove()).catch(() => p.remove());
  return p;
}

// حلقة شحن تتسع وتتلاشى
function chargeRing(container, delay, scale) {
  const r = document.createElement('div');
  r.className = 'premium-charge-ring';
  container.appendChild(r);
  r.animate([
    { transform: 'scale(0.9)', opacity: 0.9, offset: 0 },
    { transform: `scale(${scale || 1.2})`, opacity: 0, offset: 1 },
  ], { duration: 540, delay: delay || 0, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' })
    .finished.catch(() => {}).then(() => r.remove());
}

// شرارات تجميع داخل الشاشة أثناء الشحن (لا تتأثر بالطيران)
function chargeSparks(container) {
  if (!container) return;
  const c = container.getBoundingClientRect();
  const cx = c.width / 2, cy = c.height / 2;
  for (let i = 0; i < 10; i++) {
    const p = document.createElement('span');
    p.className = 'premium-particle';
    const s = 3 + Math.random() * 6;
    p.style.width = s + 'px';
    p.style.height = s + 'px';
    p.style.left = (cx + (Math.random() - 0.5) * c.width * 0.4) + 'px';
    p.style.top = (cy + (Math.random() - 0.5) * c.height * 0.4) + 'px';
    const ang = Math.random() * Math.PI * 2;
    const dist = 26 + Math.random() * 60;
    container.appendChild(p);
    p.animate([
      { transform: 'translate(0,0) scale(1)', opacity: 0.9, offset: 0 },
      { transform: `translate(${Math.cos(ang) * dist}px, ${Math.sin(ang) * dist}px) scale(0.1)`, opacity: 0, offset: 1 },
    ], { duration: 420 + Math.random() * 360, easing: 'cubic-bezier(0.15, 0.7, 0.25, 1)' })
      .finished.catch(() => {}).then(() => p.remove());
  }
}

// انفجار ذهبي لحظي عند نقطة الهبوط
function burst(x, y, n) {
  for (let i = 0; i < (n || 12); i++) {
    const ang = (i / (n || 12)) * Math.PI * 2 + Math.random() * 0.5;
    const dist = 24 + Math.random() * 52;
    goldParticle(x + Math.cos(ang) * 4, y + Math.sin(ang) * 4)
      .animate([
        { transform: `translate(${x}px, ${y}px) scale(1)`, opacity: 1, offset: 0 },
        { transform: `translate(${x + Math.cos(ang) * dist}px, ${y + Math.sin(ang) * dist}px) scale(0.08)`, opacity: 0, offset: 1 },
      ], { duration: 520 + Math.random() * 320, easing: 'cubic-bezier(0.15, 0.7, 0.25, 1)' });
  }
}

async function collapseActiveScreen() {
  const screen = document.getElementById('activeScreen');
  const badge = document.getElementById('premiumSideDot');
  if (!screen) return;

  // ── FLIP: قياس موضعي البداية والنقطة الجانبية فعلياً ──
  const s = screen.getBoundingClientRect();
  const sx = s.left + s.width / 2;
  const sy = s.top + s.height / 2;
  let tx = sx, ty = s.top + 30;
  if (badge) {
    const b = badge.getBoundingClientRect();
    tx = b.left + b.width / 2;
    ty = b.top + b.height / 2;
  }

  const dx = tx - sx;
  const dy = ty - sy;
  const dist = Math.hypot(dx, dy);
  const arcH = Math.min(130, dist * 0.16); // ارتفاع قوس الطيران

  const p0 = { x: sx, y: sy };
  const pm = { x: sx + dx / 2, y: sy + dy / 2 - arcH };
  const p1 = { x: tx, y: ty };
  const startRadius = getComputedStyle(screen).borderRadius || '18px';

  screen.style.willChange = 'transform, opacity, border-radius, filter';

  // ── المرحلة 1: الشحن (0.62ث) — نبضة تجميع + حلقات + شرارات ──
  chargeSparks(document.getElementById('premiumParticles'));
  chargeRing(screen, 0, 1.18);
  chargeRing(screen, 150, 1.12);
  await screen.animate([
    { transform: 'scale(1)', filter: 'drop-shadow(0 0 0px rgba(245,179,1,0))', offset: 0 },
    { transform: 'scale(1.04)', filter: 'drop-shadow(0 0 28px rgba(245,179,1,0.55))', offset: 0.45 },
    { transform: 'scale(0.985)', filter: 'drop-shadow(0 0 42px rgba(245,179,1,0.78))', offset: 0.8 },
    { transform: 'scale(1)', filter: 'drop-shadow(0 0 50px rgba(245,179,1,0.9))', offset: 1 },
  ], { duration: 620, easing: FLY_EASE }).finished;

  // ── المرحلة 2: الطيران على القوس (طيران واحد متواصل) ──
  const flightDur = Math.min(1500, 900 + dist * 0.45);
  const flyAnim = screen.animate([
    {
      transform: 'translate(0, 0) scale(1) rotate(0deg)',
      borderRadius: startRadius, opacity: 1,
      filter: 'drop-shadow(0 0 50px rgba(245,179,1,0.9))',
      offset: 0,
    },
    {
      transform: `translate(${pm.x - sx}px, ${pm.y - sy}px) scale(0.42) rotate(-5deg)`,
      borderRadius: '46%', opacity: 0.97,
      filter: 'blur(1.4px) drop-shadow(0 0 22px rgba(245,179,1,0.9))',
      offset: 0.5,
    },
    {
      transform: `translate(${dx}px, ${dy}px) scale(0.035) rotate(0deg)`,
      borderRadius: '50%', opacity: 0.92,
      filter: 'blur(0px) drop-shadow(0 0 14px rgba(245,179,1,0.95))',
      offset: 1,
    },
  ], { duration: flightDur, easing: FLY_EASE, fill: 'forwards' });

  // ذيل ذهبي يتبع القوس بنفس منحنى الحركة
  const trailTimer = setInterval(() => {
    const t = flyAnim.currentTime == null ? 0 : flyAnim.currentTime / flightDur;
    const pt = arcPoint(p0, pm, p1, Math.max(0, Math.min(1, t)));
    goldParticle(pt.x, pt.y);
  }, 34);

  try { await flyAnim.finished; } catch { clearInterval(trailTimer); return; }
  clearInterval(trailTimer);

  // ── الهبوط: إخفاء الشاشة + انفجار على النقطة + نبضة الشارة ──
  screen.classList.add('collapsed');
  burst(tx, ty, 14);
  if (badge) {
    badge.classList.add('landed');
    setTimeout(() => badge.classList.remove('landed'), 1000);
  }
}

// ابدأ العد التنازلي فور ظهور شاشة الاشتراك النشط
if (document.getElementById('activeScreen')) {
  setTimeout(collapseActiveScreen, ACTIVE_SCREEN_DELAY);
}
</script>
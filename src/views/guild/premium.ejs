<% currentPage = 'premium' %>
<div class="page-header">
  <h1><i class="fas fa-gem" style="color:#f5b301"></i> نظام البريميوم — <%= guild.name %></h1>
  <p>اختر الخطة المناسبة لسيرفرك واحصل على أفضل تجربة</p>
</div>

<% if (activePlanId) { %>
<div class="premium-activated-banner glass fade-in-up">
  <div class="icon"><i class="fas fa-check"></i></div>
  <div>
    <strong>✅ خطة <span style="color:#57f287"><%= activePlanLabel %></span> مفعّلة حالياً</strong>
    <span>بريميوم هذا السيرفر نشط — استمتع بكل المزايا</span>
  </div>
</div>
<% } %>

<div class="premium-section glass fade-in-up">
  <div class="premium-orb o1"></div>
  <div class="premium-orb o2"></div>

  <div class="premium-header">
    <div class="premium-crown"><i class="fas fa-crown"></i></div>
    <div>
      <h3><i class="fas fa-gem"></i> نظام البريميوم <span class="premium-vip-badge"><i class="fas fa-crown"></i> VIP</span></h3>
      <p>اشتراك حصري بمزايا فاخرة لسيرفرك</p>
    </div>
  </div>

  <button class="plans-reveal-btn" id="plansRevealBtn" onclick="togglePlans()">
    <i class="fas fa-crown"></i> عرض خطط الاشتراك
    <i class="fas fa-chevron-down chev"></i>
  </button>
  <div class="plans-section" id="plansSection" style="display:none">
    <div class="plans-grid">
      <% plans.forEach(plan => { %>
        <% const isActive = activePlanId === plan.id %>
      <div class="plan-card <%= plan.id === 'ultimate' ? 'plan-ultimate' : 'plan-standard' %> <%= isActive ? 'plan-active' : '' %>">
        <% if (plan.popular && !isActive) { %>
          <div class="plan-popular"><i class="fas fa-fire"></i> الأكثر طلباً</div>
        <% } %>
        <% if (isActive) { %>
          <div class="plan-active-badge"><i class="fas fa-check"></i> مفعّلة حالياً</div>
        <% } %>
        <div class="plan-head">
          <div class="plan-icon"><i class="fas <%= plan.icon %>"></i></div>
          <h4><%= plan.name %></h4>
          <p><%= plan.tagline %></p>
        </div>
        <div class="plan-price">
          <span class="amount"><%= plan.price %> <small>/ <%= plan.period %></small></span>
          <span class="note">أو <%= plan.yearlyPrice %> سنوياً (وفّر أكثر)</span>
        </div>
        <ul class="plan-features">
          <% plan.features.forEach(f => { %>
            <li><i class="fas fa-check"></i> <%= f %></li>
          <% }) %>
        </ul>
        <% if (isActive) { %>
          <button class="plan-btn" disabled><i class="fas fa-check"></i> مفعّلة — <%= plan.name %></button>
        <% } else { %>
          <button class="plan-btn" onclick="openPayment('<%= plan.id %>')">
            <i class="fas fa-credit-card"></i> اشترك الآن — <%= plan.name %>
          </button>
        <% } %>
      </div>
      <% }) %>
    </div>
  </div>
</div>

<!-- ═══ تفعيل بالكود السري ═══ -->
<div class="activate-section">
  <div class="activate-card glass">
    <div class="activate-head">
      <div class="a-icon"><i class="fas fa-key"></i></div>
      <div>
        <h4>تفعيل بالكود السري</h4>
        <p>أدخل كود التفعيل الخاص بك لتفعيل الخطة فوراً</p>
      </div>
    </div>
    <form class="activate-form" onsubmit="activatePlan(event)">
      <input type="text" id="activationCode" placeholder="FX9-XXX-XXXX-XXXX" autocomplete="off" spellcheck="false" maxlength="20">
      <button type="submit" class="activate-btn" id="activateBtn"><i class="fas fa-key"></i> تفعيل الخطة</button>
    </form>
    <div class="activate-msg" id="activateMsg"></div>
  </div>
</div>

<!-- ═══ نافذة الدفع المنبثقة ═══ -->
<div class="pay-modal-overlay" id="payModal">
  <div class="pay-modal">
    <button class="m-close" onclick="closePayment()"><i class="fas fa-times"></i></button>
    <div class="m-head">
      <div class="icon"><i class="fas fa-crown"></i></div>
      <h3 id="mTitle">اشتراك بريميوم</h3>
      <div class="m-price" id="mPrice">$4.99 / شهرياً</div>
    </div>
    <div class="m-summary">
      <div class="m-row"><span>السيرفر</span><strong><%= guild.name %></strong></div>
      <div class="m-row"><span>الخطة</span><strong id="mPlan">Standard</strong></div>
      <div class="m-row"><span>المدة</span><strong>شهرياً — تجديد تلقائي</strong></div>
      <div class="m-row"><span>الإجمالي</span><strong style="color:#f5b301" id="mTotal">$4.99</strong></div>
    </div>
    <div class="m-methods">
      <div class="m-method selected" onclick="selectMethod(this)">
        <span><i class="fas fa-credit-card" style="color:#818cf8"></i> بطاقة بنكية (Visa / Mastercard)</span>
        <i class="fas fa-check" style="color:#57f287"></i>
      </div>
      <div class="m-method" onclick="selectMethod(this)">
        <span><i class="fas fa-wallet" style="color:#60a5fa"></i> محفظة إلكترونية (PayPal)</span>
        <i class="fas fa-chevron-left" style="opacity:0.4"></i>
      </div>
    </div>
    <button class="m-confirm" onclick="confirmPayment()">
      <i class="fas fa-lock"></i> إتمام الدفع الآن
    </button>
    <div class="m-note"><i class="fas fa-shield-halved"></i> دفع آمن ومشفر 100% — يمكنك الإلغاء في أي وقت</div>
  </div>
</div>

<!-- ═══ JS الصفحة ═══ -->
<script>
const PLANS = JSON.parse('<%- JSON.stringify(plans).replace(/'/g, "\\'") %>');
const GUILD_ID = '<%= guild.id %>';

function togglePlans() {
  const section = document.getElementById('plansSection');
  const btn = document.getElementById('plansRevealBtn');
  const showing = section.style.display !== 'none';
  section.style.display = showing ? 'none' : 'block';
  btn.classList.toggle('open', !showing);
}

function openPayment(planId) {
  const plan = PLANS.find(p => p.id === planId);
  if (!plan) return;
  document.getElementById('mTitle').textContent = `اشترك في باقة ${plan.name}`;
  document.getElementById('mPlan').textContent = plan.name;
  document.getElementById('mPrice').textContent = `${plan.price} / ${plan.period}`;
  document.getElementById('mTotal').textContent = plan.price;
  document.getElementById('payModal').classList.add('show');
}

function closePayment() {
  document.getElementById('payModal').classList.remove('show');
}

function selectMethod(el) {
  document.querySelectorAll('.m-method').forEach(m => m.classList.remove('selected'));
  el.classList.add('selected');
}

function confirmPayment() {
  const planName = document.getElementById('mPlan').textContent;
  closePayment();
  alert('✅ تم تجهيز طلب اشتراك باقة ' + planName + ' — سيتم إتمام الدفع عبر بوابة آمنة (قيد الربط حالياً). سيصلك الإشعار قريباً.');
}

// إغلاق النافذة بالنقر خارجها
document.getElementById('payModal').addEventListener('click', (e) => {
  if (e.target.id === 'payModal') closePayment();
});

// ═══ تفعيل الخطة بالكود السري ═══
async function activatePlan(e) {
  e.preventDefault();
  const input = document.getElementById('activationCode');
  const msg = document.getElementById('activateMsg');
  const btn = document.getElementById('activateBtn');
  const code = input.value.trim();

  msg.className = 'activate-msg';
  if (!code) {
    msg.className = 'activate-msg err';
    msg.textContent = '⚠️ أدخل كود التفعيل أولاً.';
    return;
  }

  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جارٍ التفعيل...';

  try {
    const res = await fetch(`/premium/${GUILD_ID}/activate`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code }),
    });
    const data = await res.json();

    if (data.success) {
      msg.className = 'activate-msg ok';
      msg.innerHTML = `<i class="fas fa-crown"></i> ${data.message}`;
      setTimeout(() => location.reload(), 1200);
    } else {
      msg.className = 'activate-msg err';
      msg.textContent = '❌ ' + (data.error || 'فشل التفعيل.');
    }
  } catch {
    msg.className = 'activate-msg err';
    msg.textContent = '❌ حدث خطأ في الاتصال، حاول مجدداً.';
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-key"></i> تفعيل الخطة';
  }
}
</script>
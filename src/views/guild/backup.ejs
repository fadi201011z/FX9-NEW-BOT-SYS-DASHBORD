<% currentPage = 'backup' %>
<div class="page-header">
  <h1><i class="fas fa-database"></i> النسخ الاحتياطي — <%= guild.name %></h1>
  <p>إنشاء واستعادة النسخ الاحتياطية لإعدادات البوت</p>
</div>

<div class="dashboard-grid">
  <div class="card glass">
    <div class="card-header">
      <h3><i class="fas fa-plus-circle"></i> إنشاء نسخة احتياطية</h3>
    </div>
    <div class="backup-create">
      <p>سيتم حفظ جميع إعدادات السيرفر الحالية في ملف JSON</p>
      <button class="btn-primary" onclick="createBackup()">
        <i class="fas fa-database"></i> إنشاء نسخة احتياطية
      </button>
    </div>
  </div>

  <div class="card glass">
    <div class="card-header">
      <h3><i class="fas fa-history"></i> النسخ السابقة</h3>
    </div>
    <div class="backup-list">
      <% if (backups && backups.length > 0) { %>
        <% backups.forEach(b => { %>
          <div class="backup-item">
            <div class="backup-info">
              <i class="fas fa-file-archive"></i>
              <div>
                <strong><%= b.filename %></strong>
                <span><%= (b.size / 1024).toFixed(1) %> KB • <%= new Date(b.created_at).toLocaleString('ar-SA') %></span>
              </div>
            </div>
            <div class="backup-actions">
              <button class="btn-sm" onclick="restoreBackup('<%= b.filename %>')">
                <i class="fas fa-undo"></i> استعادة
              </button>
              <a href="/backup/<%= guild.id %>/download/<%= b.filename %>" class="btn-sm">
                <i class="fas fa-download"></i>
              </a>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="empty-state">
          <i class="fas fa-database"></i>
          <p>لا توجد نسخ احتياطية بعد</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
async function createBackup() {
  const res = await fetch('/backup/<%= guild.id %>/create', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
  });
  const data = await res.json();
  if (data.success) {
    showToast('✅ تم إنشاء النسخة: ' + data.filename);
    location.reload();
  } else {
    showToast('❌ ' + data.error);
  }
}

async function restoreBackup(filename) {
  if (!confirm('⚠️ استعادة النسخة ستحل محل الإعدادات الحالية. هل أنت متأكد؟')) return;
  const res = await fetch('/backup/<%= guild.id %>/restore', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ filename }),
  });
  const data = await res.json();
  showToast(data.success ? '✅ تمت الاستعادة بنجاح' : '❌ ' + data.error);
}
</script>

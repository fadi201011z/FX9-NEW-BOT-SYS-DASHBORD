<% currentPage = 'protection' %>
<%
  // — الحماية: 5 أنظمة تلقائية + حدود + رومات محضورة.
  const prKeys = ['antiSpamEnabled', 'antiLinkEnabled', 'antiMentionEnabled', 'antiNukeEnabled', 'antiRaidEnabled'];
  const prCount = prKeys.filter(k => protection[k] === 'true').length;
  const restrictedCount = (restrictedChannels || []).length;
  const punishLabel = { timeout: 'إيقاف مؤقت', kick: 'طرد', warn: 'تحذير' }[protection.spamPunishment] || protection.spamPunishment || '—';
%>

<div class="page-header">
  <h1><i class="fas fa-shield-halved"></i> الحماية</h1>
  <p>أنظمة الحماية التلقائية والحدود والرومات المحضورة — في سيرفر <strong><%= guild.name %></strong></p>
</div>

<div class="stats-grid">
  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #57f287"><i class="fas fa-shield-halved" aria-hidden="true"></i></div>
    <div class="stat-info">
      <span class="stat-value"><%= prCount %>/<%= prKeys.length %></span>
      <span class="stat-label">أنظمة مفعّلة</span>
    </div>
  </div>
  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #ed4245"><i class="fas fa-ban" aria-hidden="true"></i></div>
    <div class="stat-info">
      <span class="stat-value"><%= restrictedCount %></span>
      <span class="stat-label">روم محضور</span>
    </div>
  </div>
  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #ffa63e"><i class="fas fa-gavel" aria-hidden="true"></i></div>
    <div class="stat-info">
      <span class="stat-value" style="font-size:1.15rem"><%= punishLabel %></span>
      <span class="stat-label">عقوبة السبام</span>
    </div>
  </div>
  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #4dd6e0"><i class="fas fa-users-slash" aria-hidden="true"></i></div>
    <div class="stat-info">
      <span class="stat-value" style="font-size:1.15rem"><%= protection.antiRaidEnabled === 'true' ? 'مفعّل' : 'متوقف' %></span>
      <span class="stat-label">حالة Anti-Raid</span>
    </div>
  </div>
</div>

<form id="protectionForm" onsubmit="updateProtection(event)">
  <% const systems = [
    { key: 'antiSpamEnabled', name: 'Anti-Spam', icon: 'fa-shield-halved', tint: '#ed4245', desc: 'منع السبام — 5 رسائل لكل 5 ثوانٍ ← إيقاف 60 ثانية' },
    { key: 'antiLinkEnabled', name: 'Anti-Link', icon: 'fa-link', tint: '#5a9bff', desc: 'منع الروابط التلقائية في الرسائل' },
    { key: 'antiMentionEnabled', name: 'Anti-Mention', icon: 'fa-at', tint: '#a855f7', desc: 'منع 5+ منشنات في رسالة واحدة' },
    { key: 'antiNukeEnabled', name: 'Anti-Nuke', icon: 'fa-bomb', tint: '#ffa63e', desc: 'منع حذف القنوات والحظر الجماعي المفاجئ' },
    { key: 'antiRaidEnabled', name: 'Anti-Raid', icon: 'fa-users-slash', tint: '#4dd6e0', desc: 'منع الانضمام الجماعي المفاجئ للسيرفر' },
  ] %>

  <div class="card glass">
    <div class="card-header"><h3><i class="fas fa-shield-halved"></i> أنظمة الحماية</h3></div>
    <div class="protection-grid pr-grid">
      <% systems.forEach(sys => { %>
        <div class="pr-card <%= protection[sys.key] === 'true' ? 'is-on' : '' %>">
          <div class="pr-head">
            <span class="pr-ic" style="--pr-tint:<%= sys.tint %>"><i class="fas <%= sys.icon %>" aria-hidden="true"></i></span>
            <h4><%= sys.name %></h4>
            <label class="toggle">
              <input type="checkbox" name="<%= sys.key %>" <%= protection[sys.key] === 'true' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>
          <p><%= sys.desc %></p>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="card glass">
    <div class="card-header"><h3><i class="fas fa-sliders-h"></i> الحدود والإعدادات</h3></div>
    <div class="form-grid">
      <div class="form-group">
        <label>حد السبام (رسائل)</label>
        <input type="number" name="spamLimit" value="<%= protection.spamLimit %>" min="1" max="20">
      </div>
      <div class="form-group">
        <label>نافذة السبام (مللي ثانية)</label>
        <input type="number" name="spamWindow" value="<%= protection.spamWindow %>" min="1000" max="30000">
      </div>
      <div class="form-group">
        <label>عقوبة السبام</label>
        <select name="spamPunishment">
          <option value="timeout" <%= protection.spamPunishment === 'timeout' ? 'selected' : '' %>>إيقاف مؤقت</option>
          <option value="kick" <%= protection.spamPunishment === 'kick' ? 'selected' : '' %>>طرد</option>
          <option value="warn" <%= protection.spamPunishment === 'warn' ? 'selected' : '' %>>تحذير</option>
        </select>
      </div>
      <div class="form-group">
        <label>حد حذف القنوات (Anti-Nuke)</label>
        <input type="number" name="nukeChannelLimit" value="<%= protection.nukeChannelLimit %>" min="1" max="10">
      </div>
      <div class="form-group">
        <label>حد الحظر (Anti-Nuke)</label>
        <input type="number" name="nukeBanLimit" value="<%= protection.nukeBanLimit %>" min="1" max="10">
      </div>
      <div class="form-group">
        <label>نافذة Nuke (مللي ثانية)</label>
        <input type="number" name="nukeWindow" value="<%= protection.nukeWindow %>" min="5000" max="30000">
      </div>
      <div class="form-group">
        <label>حد الانضمام (Raid)</label>
        <input type="number" name="raidLimit" value="<%= protection.raidLimit %>" min="5" max="30">
      </div>
      <div class="form-group">
        <label>نافذة Raid (مللي ثانية)</label>
        <input type="number" name="raidWindow" value="<%= protection.raidWindow %>" min="5000" max="30000">
      </div>
    </div>
    <button type="submit" class="btn-primary"><i class="fas fa-save"></i> حفظ إعدادات الحماية</button>
  </div>
</form>

<!-- ─── الرومات المحضورة ────────────────────────────────────────────── -->
<div class="card glass pr-restricted">
  <div class="card-header"><h3><i class="fas fa-ban"></i> الرومات المحضورة</h3></div>
  <p class="pr-rest-desc">
    أي شخص يرسل في هذه الرومات (حتى الإدارة) يُطرد لمدة يوم — باستثناء المالك والبوت والمبرمج
  </p>

  <div class="pr-add-row">
    <select id="restrictedChannelSelect">
      <option value="">-- اختر رومًا --</option>
      <% (guildChannels || []).forEach(ch => { %>
        <option value="<%= ch.id %>"><%= ch.name %></option>
      <% }) %>
    </select>
    <button onclick="addRestrictedChannel()" class="btn-primary">
      <i class="fas fa-plus"></i> إضافة روم محضور
    </button>
  </div>

  <div class="pr-rest-list">
    <% if (restrictedCount > 0) { %>
      <% restrictedChannels.forEach(ch => { %>
        <div class="pr-rest-item">
          <span class="pr-rest-name"><i class="fas fa-hashtag" aria-hidden="true"></i> <strong><%= ch.name || ch.id %></strong></span>
          <button onclick="removeRestrictedChannel('<%= ch.id %>')" class="btn-sm pr-rest-del">
            <i class="fas fa-trash"></i> حذف
          </button>
        </div>
      <% }) %>
    <% } else { %>
      <div class="empty-state">
        <i class="fas fa-inbox"></i>
        <p>لا توجد رومات محضورة — أضف رومًا من القائمة أعلاه</p>
      </div>
    <% } %>
  </div>
</div>

<style>
  .pr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px; }
  .pr-card {
    padding: 15px; border-radius: var(--radius, 12px);
    border: 1px solid var(--nx-line, rgba(255, 255, 255, .07));
    background: rgba(255, 255, 255, .015);
    transition: border-color .18s var(--nx-ease, ease), background .18s var(--nx-ease, ease), transform .18s var(--nx-ease, ease);
  }
  .pr-card:hover { transform: translateY(-1px); }
  .pr-card.is-on { border-color: rgba(87, 242, 135, .28); }
  .pr-head { display: flex; align-items: center; gap: 10px; margin-bottom: 9px; }
  .pr-head h4 { font-size: .9rem; font-weight: 700; flex: 1; }
  .pr-ic {
    width: 36px; height: 36px; flex: 0 0 36px; display: grid; place-items: center;
    border-radius: 10px; font-size: .9rem;
    background: color-mix(in srgb, var(--pr-tint) 14%, transparent); color: var(--pr-tint);
  }
  .pr-card p { color: var(--text-muted); font-size: .76rem; line-height: 1.65; margin: 0; }
  .pr-rest-desc { color: var(--text-muted); font-size: .82rem; line-height: 1.7; margin: 0 0 16px; }
  .pr-add-row { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 16px; }
  .pr-add-row select {
    flex: 1; min-width: 210px; padding: 10px 14px; border-radius: 10px;
    border: 1px solid var(--nx-line, rgba(255, 255, 255, .1));
    background: var(--bg-secondary, #1e1e2e); color: var(--text, #eee); font-family: inherit; outline: none;
  }
  .pr-add-row select:focus { border-color: var(--primary, #a855f7); }
  .pr-rest-list { display: flex; flex-direction: column; gap: 8px; }
  .pr-rest-item {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 11px 14px; border-radius: 11px;
    border: 1px solid var(--nx-line, rgba(255, 255, 255, .07)); background: rgba(237, 66, 69, .04);
  }
  .pr-rest-name { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .pr-rest-name i { color: var(--text-muted); }
  .pr-rest-name strong { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pr-rest-del { background: rgba(237, 66, 69, .15); color: #ed4245; border: 1px solid rgba(237, 66, 69, .3); cursor: pointer; }
  .pr-rest-del:hover { background: rgba(237, 66, 69, .28); color: #ff8b8b; }
  @media (max-width: 620px) { .pr-add-row select { min-width: 100%; } }
</style>

<script>
async function updateProtection(e) {
  e.preventDefault();
  const form = document.getElementById('protectionForm');
  const data = {};
  new FormData(form).forEach((v, k) => { data[k] = v; });
  const res = await fetch('/protection/<%= guild.id %>/update', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data),
  });
  if (res.ok) showToast('✅ تم حفظ إعدادات الحماية بنجاح');
}

async function addRestrictedChannel() {
  const sel = document.getElementById('restrictedChannelSelect');
  const channelId = sel.value;
  if (!channelId) return showToast('⚠️ اختر رومًا أولاً');
  const channelName = sel.options[sel.selectedIndex]?.text || channelId;
  const res = await fetch('/protection/<%= guild.id %>/restricted-channel/add', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ channelId, channelName }),
  });
  if (res.ok) {
    showToast('✅ تمت الإضافة');
    setTimeout(() => location.reload(), 1000);
  } else {
    const data = await res.json();
    showToast('❌ ' + (data.error || 'فشل'));
  }
}

async function removeRestrictedChannel(channelId) {
  if (!confirm('هل أنت متأكد من إزالة هذا الروم المحضور؟')) return;
  const res = await fetch('/protection/<%= guild.id %>/restricted-channel/remove', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ channelId }),
  });
  if (res.ok) {
    showToast('✅ تمت الإزالة');
    setTimeout(() => location.reload(), 1000);
  } else {
    showToast('❌ فشل الإزالة');
  }
}
</script>
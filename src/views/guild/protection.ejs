<% currentPage = 'protection' %>
<div class="page-header">
  <h1><i class="fas fa-shield-alt"></i> إعدادات الحماية — <%= guild.name %></h1>
  <p>تحكم بجميع أنظمة الحماية التلقائية والرومات المحضورة</p>
</div>

<form id="protectionForm" onsubmit="updateProtection(event)">
  <% const systems = [
    { key: 'antiSpamEnabled', name: 'Anti-Spam', icon: 'fa-shield-alt', desc: 'منع السبام — 5 رسائل/5ث ← إيقاف 60ث' },
    { key: 'antiLinkEnabled', name: 'Anti-Link', icon: 'fa-link', desc: 'منع الروابط التلقائية' },
    { key: 'antiMentionEnabled', name: 'Anti-Mention', icon: 'fa-at', desc: 'منع 5+ منشنات في رسالة' },
    { key: 'antiNukeEnabled', name: 'Anti-Nuke', icon: 'fa-bomb', desc: 'منع حذف القنوات والحظر الجماعي' },
    { key: 'antiRaidEnabled', name: 'Anti-Raid', icon: 'fa-users-slash', desc: 'منع الانضمام الجماعي المفاجئ' },
  ] %>

  <div class="card glass">
    <div class="card-header"><h3><i class="fas fa-shield-alt"></i> أنظمة الحماية</h3></div>
    <div class="protection-grid">
      <% systems.forEach(sys => { %>
        <div class="protection-card">
          <div class="protection-header">
            <i class="fas <%= sys.icon %>"></i>
            <h4><%= sys.name %></h4>
            <label class="toggle">
              <input type="checkbox" name="<%= sys.key %>" <%= protection[sys.key] === 'true' ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>
          <p><%= sys.desc %></p>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="card glass">
    <div class="card-header"><h3><i class="fas fa-sliders-h"></i> الحدود والإعدادات</h3></div>
    <div class="form-grid">
      <div class="form-group">
        <label>حد السبام (رسائل)</label>
        <input type="number" name="spamLimit" value="<%= protection.spamLimit %>" min="1" max="20">
      </div>
      <div class="form-group">
        <label>نافذة السبام (مللي ثانية)</label>
        <input type="number" name="spamWindow" value="<%= protection.spamWindow %>" min="1000" max="30000">
      </div>
      <div class="form-group">
        <label>عقوبة السبام</label>
        <select name="spamPunishment">
          <option value="timeout" <%= protection.spamPunishment === 'timeout' ? 'selected' : '' %>>إيقاف مؤقت</option>
          <option value="kick" <%= protection.spamPunishment === 'kick' ? 'selected' : '' %>>طرد</option>
          <option value="warn" <%= protection.spamPunishment === 'warn' ? 'selected' : '' %>>تحذير</option>
        </select>
      </div>
      <div class="form-group">
        <label>حد حذف القنوات (Anti-Nuke)</label>
        <input type="number" name="nukeChannelLimit" value="<%= protection.nukeChannelLimit %>" min="1" max="10">
      </div>
      <div class="form-group">
        <label>حد الحظر (Anti-Nuke)</label>
        <input type="number" name="nukeBanLimit" value="<%= protection.nukeBanLimit %>" min="1" max="10">
      </div>
      <div class="form-group">
        <label>نافذة Nuke (مللي ثانية)</label>
        <input type="number" name="nukeWindow" value="<%= protection.nukeWindow %>" min="5000" max="30000">
      </div>
      <div class="form-group">
        <label>حد الانضمام (Raid)</label>
        <input type="number" name="raidLimit" value="<%= protection.raidLimit %>" min="5" max="30">
      </div>
      <div class="form-group">
        <label>نافذة Raid (مللي ثانية)</label>
        <input type="number" name="raidWindow" value="<%= protection.raidWindow %>" min="5000" max="30000">
      </div>
    </div>
    <button type="submit" class="btn-primary"><i class="fas fa-save"></i> حفظ إعدادات الحماية</button>
  </div>

  <!-- ─── الكلمات الممنوعة ─────────────────────────────────────────────── -->
  <div class="card glass" style="margin-top:20px">
    <div class="card-header">
      <h3><i class="fas fa-ban"></i> الكلمات الممنوعة (Bad Words)</h3>
      <label class="toggle" title="تفعيل/تعطيل الفلتر">
        <input type="checkbox" name="badWordsEnabled" <%= protection.badWordsEnabled === 'true' ? 'checked' : '' %>>
        <span class="toggle-slider"></span>
      </label>
    </div>
    <p class="card-desc" style="margin:0 20px 16px;color:var(--text-muted);font-size:.85rem">
      يُحذف أي محتوى يحتوي كلمة من القائمة مع كشف الحيل (التشكيل، الأحرف المتباعدة، الرموز بين الحروف) ويُسجَّل في سجلات الإشراف. لكل كلمة: تفعيل/تعطيل مستقل + عقوبة خاصة بها (وإن تُركت «حسب السيرفر» تُطبَّق العقوبة العامة) — إذا خليت القائمة فارغة يعمل البوت بقائمة افتراضية مدمجة
    </p>

    <div style="padding:0 20px">
      <div style="display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap">
        <input type="text" id="badWordInput" placeholder="اكتب كلمة ممنوعة ثم اضغط إضافة..." style="flex:1;min-width:220px;padding:10px 14px;border-radius:10px;border:1px solid var(--border);background:var(--bg-secondary);color:var(--text);font-family:inherit;outline:none">
        <button type="button" onclick="addBadWord()" class="btn-primary" style="display:flex;align-items:center;gap:6px;padding:10px 20px">
          <i class="fas fa-plus"></i> إضافة
        </button>
      </div>

      <% if (usingDefaultList) { %>
        <div style="font-size:.78rem;color:var(--text-muted);background:rgba(88,101,242,.1);border:1px dashed rgba(88,101,242,.4);border-radius:10px;padding:10px 14px;margin-bottom:12px">
          <i class="fas fa-database"></i> هذه القائمة الافتراضية المدمجة في البوت — تُعرض لأن سيرفرك لا يملك قائمة خاصة بعد. أي تعديل ثم «حفظ» سيثبّتها كقائمة خاصة بسيرفرك.
        </div>
      <% } %>

      <div class="form-group" style="margin-bottom:14px">
        <label>العقوبة عند المخالفة</label>
        <select name="badWordsPunishment" id="badWordsPunishment" onchange="toggleTimeoutField()">
          <option value="delete" <%= protection.badWordsPunishment === 'delete' ? 'selected' : '' %>>حذف الرسالة فقط</option>
          <option value="timeout" <%= protection.badWordsPunishment === 'timeout' ? 'selected' : '' %>>حذف + إيقاف مؤقت</option>
          <option value="warn" <%= protection.badWordsPunishment === 'warn' ? 'selected' : '' %>>حذف + تحذير رسمي (يظهر في /warn)</option>
          <option value="kick" <%= protection.badWordsPunishment === 'kick' ? 'selected' : '' %>>حذف + طرد</option>
          <option value="ban" <%= protection.badWordsPunishment === 'ban' ? 'selected' : '' %>>حذف + حظر</option>
        </select>
        <div style="font-size:.72rem;color:var(--text-muted);margin-top:4px">
          التحذير الرسمي يُسجَّل ويزيد في عدّاد <code>/warn</code>. الطرد والحظر لا يطبقان على المالك، والبوت يحتاج صلاحيات كافية لتطبيقها.
        </div>
      </div>

      <div style="display:flex;gap:20px;flex-wrap:wrap;margin-bottom:14px">
        <div class="form-group" id="badWordsTimeoutGroup" style="display:none;margin:0">
          <label>مدة الإيقاف العامة (ثوانٍ)</label>
          <input type="number" name="badWordsTimeout" id="badWordsTimeout" value="<%= protection.badWordsTimeout || 60 %>" min="10" max="86400" style="max-width:160px">
        </div>
        <label style="display:inline-flex;align-items:center;gap:8px;font-size:.82rem;cursor:pointer;padding:8px 0" title="عند الإيقاف: الرسالة تُحذف أم تُبقى كدليل؟">
          <input type="checkbox" name="badWordsDeleteMessage" <%= protection.badWordsDeleteMessage === 'true' ? 'checked' : '' %> style="accent-color:#5865f2;width:16px;height:16px">
          <i class="fas fa-trash-alt" style="color:var(--text-muted)"></i> حذف رسالة المخالفة (الإعداد العام)
        </label>
      </div>

      <input type="hidden" name="badWordsList" id="badWordsList" value='<%= JSON.stringify(badWords || []) %>'>

      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;flex-wrap:wrap;gap:8px">
        <span style="font-size:.78rem;color:var(--text-muted)"><i class="fas fa-list"></i> القائمة (<span id="badWordsCount">0</span> كلمة)</span>
        <button type="button" onclick="toggleBadWordsCollapse()" id="badWordsToggleBtn" class="btn-sm" style="display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:8px;border:1px solid var(--border);background:var(--bg-secondary);color:var(--text);cursor:pointer;font-size:.78rem">
          <i class="fas fa-chevron-up" id="badWordsToggleIcon"></i> <span id="badWordsToggleLabel">إخفاء القائمة</span>
        </button>
      </div>

      <div id="badWordsListEl" style="display:flex;flex-direction:column;gap:8px;margin-bottom:6px"></div>
      <div style="font-size:.75rem;color:var(--text-muted);margin-bottom:16px">
        <i class="fas fa-info-circle"></i> تُطبق التغييرات على البوت **فوراً** عند الحفظ (دفع مباشر) — بدون إعادة تشغيل. **الإعفاء الوحيد هو مالك السيرفر** — الإدارة والرتب الإشرافية تُعاقب أيضاً على المخالفات. لكل كلمة عقوبة ومدة إيقاف خاصة اختيارية، وخيار «عدم حذف الرسالة» خاص بها.
      </div>
    </div>
  </div>
</form>

<!-- ─── الرومات المحضورة ────────────────────────────────────────────── -->
<div class="card glass" style="margin-top:20px">
  <div class="card-header"><h3><i class="fas fa-ban"></i> الرومات المحضورة</h3></div>
  <p class="card-desc" style="margin:0 20px 16px;color:var(--text-muted);font-size:.85rem">
    أي شخص يرسل في هذه الرومات (حتى الإدارة) يتم طرده لمدة يوم — باستثناء المالك والبوت والمبرمج
  </p>

  <div style="display:flex;gap:10px;padding:0 20px 16px;flex-wrap:wrap">
    <select id="restrictedChannelSelect" style="flex:1;min-width:200px;padding:10px 14px;border-radius:10px;border:1px solid var(--border);background:var(--bg-secondary);color:var(--text);font-family:inherit">
      <option value="">-- اختر رومًا --</option>
      <% (guildChannels || []).forEach(ch => { %>
        <option value="<%= ch.id %>"><%= ch.name %></option>
      <% }) %>
    </select>
    <button onclick="addRestrictedChannel()" class="btn-primary" style="display:flex;align-items:center;gap:6px;padding:10px 20px">
      <i class="fas fa-plus"></i> إضافة روم محضور
    </button>
  </div>

  <div style="padding:0 20px 20px">
    <% if (restrictedChannels && restrictedChannels.length > 0) { %>
      <div style="display:flex;flex-direction:column;gap:8px">
        <% restrictedChannels.forEach(ch => { %>
          <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:var(--bg-glass);border-radius:10px;border:1px solid var(--border)">
            <span><i class="fas fa-hashtag" style="color:var(--text-muted);margin-left:8px"></i> <strong><%= ch.name || ch.id %></strong></span>
            <button onclick="removeRestrictedChannel('<%= ch.id %>')" class="btn-sm" style="background:rgba(237,66,69,.15);color:#ed4245;border:1px solid rgba(237,66,69,.3);padding:6px 14px;border-radius:8px;cursor:pointer">
              <i class="fas fa-trash"></i> حذف
            </button>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div style="text-align:center;padding:30px 20px;color:var(--text-muted)">
        <i class="fas fa-inbox" style="font-size:2rem;display:block;margin-bottom:8px"></i>
        لا توجد رومات محضورة — أضف رومًا من القائمة أعلاه
      </div>
    <% } %>
  </div>
</div>

<script>
async function updateProtection(e) {
  e.preventDefault();
  const form = document.getElementById('protectionForm');
  const data = {};
  new FormData(form).forEach((v, k) => { data[k] = v; });
  const res = await fetch('/protection/<%= guild.id %>/update', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data),
  });
  if (res.ok) showToast('✅ تم حفظ إعدادات الحماية بنجاح');
}

async function addRestrictedChannel() {
  const sel = document.getElementById('restrictedChannelSelect');
  const channelId = sel.value;
  if (!channelId) return showToast('⚠️ اختر رومًا أولاً');
  const channelName = sel.options[sel.selectedIndex]?.text || channelId;
  const res = await fetch('/protection/<%= guild.id %>/restricted-channel/add', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ channelId, channelName }),
  });
  if (res.ok) {
    showToast('✅ تمت الإضافة');
    setTimeout(() => location.reload(), 1000);
  } else {
    const data = await res.json();
    showToast('❌ ' + (data.error || 'فشل'));
  }
}

async function removeRestrictedChannel(channelId) {
  if (!confirm('هل أنت متأكد من إزالة هذا الروم المحضور؟')) return;
  const res = await fetch('/protection/<%= guild.id %>/restricted-channel/remove', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ channelId }),
  });
  if (res.ok) {
    showToast('✅ تمت الإزالة');
    setTimeout(() => location.reload(), 1000);
  } else {
    showToast('❌ فشل الإزالة');
  }
}

// ── الكلمات الممنوعة ──
let currentBadWords = [];
try { currentBadWords = JSON.parse(document.getElementById('badWordsList').value || '[]'); } catch { currentBadWords = []; }
currentBadWords = (Array.isArray(currentBadWords) ? currentBadWords : []).map(w => {
  if (typeof w === 'string') return { word: w, enabled: true, punishment: '', timeout: '', deleteMsg: null };
  return {
    word: w?.word || '',
    enabled: w?.enabled !== false,
    punishment: w?.punishment || '',
    timeout: w?.timeout || '',
    deleteMsg: typeof w?.deleteMsg === 'boolean' ? w.deleteMsg : null,
  };
}).filter(w => w.word);
let badWordsCollapsed = false;
const escWord = s => String(s || '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const PUNISHMENT_LABELS = {
  '': 'حسب السيرفر', 'delete': 'حذف فقط', 'timeout': 'إيقاف مؤقت',
  'warn': 'تحذير رسمي', 'kick': 'طرد', 'ban': 'حظر'
};
function wordRowHTML(w, i) {
  const isTimeout = (w.punishment || '') === 'timeout';
  return '<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:10px 14px;background:var(--bg-glass);border:1px solid var(--border);border-radius:10px;' + (w.enabled === false ? 'opacity:.55' : '') + '">' +
    '<label style="display:inline-flex;align-items:center;gap:6px;font-size:.8rem;cursor:pointer;min-width:100px" title="تفعيل/تعطيل">' +
      '<input type="checkbox" ' + (w.enabled !== false ? 'checked' : '') + ' onchange="toggleBadWord(' + i + ')" style="accent-color:#5865f2;width:16px;height:16px">' +
      '<strong>' + escWord(w.word) + '</strong>' +
    '</label>' +
    '<select onchange="setBadWordPunishment(' + i + ', this.value)" style="flex:1;min-width:130px;padding:7px 10px;border-radius:8px;border:1px solid var(--border);background:var(--bg-secondary);color:var(--text);font-family:inherit;font-size:.8rem">' +
      Object.entries(PUNISHMENT_LABELS).map(([val, label]) =>
        '<option value="' + val + '" ' + ((w.punishment || '') === val ? 'selected' : '') + '>' + label + '</option>'
      ).join('') +
    '</select>' +
    (isTimeout
      ? '<label style="display:inline-flex;align-items:center;gap:5px;font-size:.72rem;color:var(--text-muted)" title="مدة الإيقاف الخاصة بهذه الكلمة">⏱ ' +
          '<input type="number" value="' + (w.timeout || '') + '" onchange="setBadWordTimeout(' + i + ', this.value)" placeholder="عام" min="10" max="86400" style="width:70px;padding:6px 8px;border-radius:8px;border:1px solid var(--border);background:var(--bg-secondary);color:var(--text);font-family:inherit;font-size:.75rem">ث</label>'
      : '') +
    '<label style="display:inline-flex;align-items:center;gap:5px;font-size:.7rem;color:var(--text-muted);cursor:pointer;white-space:nowrap" title="حذف رسالة المخالفة الخاصة بهذه الكلمة">' +
      '<input type="checkbox" ' + (w.deleteMsg === false ? '' : 'checked') + ' onchange="toggleBadWordDelete(' + i + ')" style="accent-color:#5865f2;width:14px;height:14px">' +
      '<i class="fas fa-trash-alt"></i> حذف الرسالة' +
    '</label>' +
    '<button type="button" onclick="removeBadWord(' + i + ')" style="background:none;border:none;color:#ed4245;cursor:pointer;padding:4px 8px;font-size:.8rem;line-height:1" title="حذف الكلمة"><i class="fas fa-times"></i></button>' +
  '</div>';
}
function renderBadWords() {
  const listEl = document.getElementById('badWordsList');
  const listEl2 = document.getElementById('badWordsListEl');
  const countEl = document.getElementById('badWordsCount');
  if (!listEl || !listEl2) return;
  listEl.value = JSON.stringify(currentBadWords.map(w => ({
    word: w.word, enabled: w.enabled !== false, punishment: w.punishment || '',
    timeout: w.timeout || '', deleteMsg: w.deleteMsg === null ? null : w.deleteMsg !== false,
  })));
  if (countEl) countEl.textContent = currentBadWords.length;
  if (!currentBadWords.length) {
    listEl2.innerHTML = '<span style="color:var(--text-muted);font-size:.85rem;padding:6px 0"><i class="fas fa-inbox"></i> لا توجد كلمات — يعمل البوت بالقائمة الافتراضية المدمجة</span>';
    updateBadWordsToggleUI();
    return;
  }
  if (badWordsCollapsed) {
    // ملخص مختصر: أول 5 كلمات + عدّاد
    const preview = currentBadWords.slice(0, 5).map(w => escWord(w.word)).join('، ');
    const more = currentBadWords.length > 5 ? '… (+' + (currentBadWords.length - 5) + ')' : '';
    listEl2.innerHTML = '<div style="font-size:.8rem;color:var(--text-muted);padding:8px 4px"><i class="fas fa-eye-slash"></i> ' + preview + ' ' + more + '</div>';
  } else {
    listEl2.innerHTML = currentBadWords.map((w, i) => wordRowHTML(w, i)).join('');
  }
  updateBadWordsToggleUI();
}
function updateBadWordsToggleUI() {
  const btn = document.getElementById('badWordsToggleBtn');
  const label = document.getElementById('badWordsToggleLabel');
  const icon = document.getElementById('badWordsToggleIcon');
  if (!btn) return;
  label.textContent = badWordsCollapsed ? 'فتح القائمة' : 'إخفاء القائمة';
  icon.className = badWordsCollapsed ? 'fas fa-chevron-down' : 'fas fa-chevron-up';
}
function toggleBadWordsCollapse() {
  badWordsCollapsed = !badWordsCollapsed;
  renderBadWords();
}
function addBadWord() {
  const inp = document.getElementById('badWordInput');
  const w = (inp.value || '').trim();
  if (!w) return showToast('⚠️ اكتب الكلمة أولاً');
  if (currentBadWords.some(x => x.word === w)) return showToast('⚠️ هذه الكلمة مضافة مسبقاً');
  if (currentBadWords.length >= 100) return showToast('⚠️ الحد الأقصى 100 كلمة');
  currentBadWords.push({ word: w, enabled: true, punishment: '', timeout: '', deleteMsg: null });
  inp.value = '';
  renderBadWords();
  showToast('✅ أُضيفت الكلمة — اضغط «حفظ إعدادات الحماية» لتثبيتها');
}
function removeBadWord(i) {
  currentBadWords.splice(i, 1);
  renderBadWords();
}
function toggleBadWord(i) {
  currentBadWords[i].enabled = currentBadWords[i].enabled !== false ? false : true;
  renderBadWords();
}
function setBadWordPunishment(i, val) {
  currentBadWords[i].punishment = val;
  renderBadWords();
}
function setBadWordTimeout(i, val) {
  const t = parseInt(val, 10);
  currentBadWords[i].timeout = (Number.isFinite(t) && t > 0) ? t : '';
  renderBadWords();
}
function toggleBadWordDelete(i) {
  currentBadWords[i].deleteMsg = currentBadWords[i].deleteMsg === false ? true : false;
  renderBadWords();
}
function toggleTimeoutField() {
  const sel = document.getElementById('badWordsPunishment');
  const grp = document.getElementById('badWordsTimeoutGroup');
  if (grp) grp.style.display = (sel && sel.value === 'timeout') ? 'flex' : 'none';
}
renderBadWords();
toggleTimeoutField();
</script>

<% currentPage = 'commands' %>
<%
  // — لوحة الأوامر: شبكة بطاقات موحّدة بعرض كامل + تحرير داخل البطاقة.
  const byCat = {};
  commands.forEach(c => { const k = c.category || 'أخرى'; (byCat[k] = byCat[k] || []).push(c); });
  const cats = Object.keys(byCat);
  const total = commands.length;
  const enabledOf = c => { const cfg = configMap[c.name]; return cfg ? cfg.enabled !== false : true; };
  const enabledCount = commands.filter(enabledOf).length;
  const customPerms = Object.values(configMap || {}).filter(cfg => cfg && (((cfg.allowedRoles || []).length) || ((cfg.blockedRoles || []).length))).length;
%>

<style>
  /* ═══ لوحة الأوامر — شبكة بطاقات موحّدة ═══ */
  .cmds-page { --ok: #00c8ff; --no: #ff3545; --acc: #d000ff; --acc2: #8700ff; }

  .cmds-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .cmds-header h1 i { color: var(--acc); }
  .cmds-kpis { display: flex; gap: 8px; flex-wrap: wrap; }
  .cmds-kpi { min-width: 76px; text-align: center; padding: 9px 13px; border-radius: 13px; background: rgba(237,240,255,0.03); border: 1px solid var(--border); }
  .cmds-kpi b { display: block; font-size: 1.25rem; font-weight: 800; line-height: 1.2; }
  .cmds-kpi span { font-size: 0.68rem; color: var(--text-muted); }
  .cmds-kpi.is-on b { color: var(--ok); }
  .cmds-kpi.is-off b { color: var(--no); }
  .cmds-kpi.is-perm b { color: var(--acc); }

  /* ── شريط الأدوات ── */
  .cmds-toolbar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 16px 0 20px; }
  .cmds-search { position: relative; flex: 1 1 260px; max-width: 420px; }
  .cmds-search > i { position: absolute; inset-inline-start: 13px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.82rem; pointer-events: none; }
  .cmds-search input { width: 100%; padding-block: 10px; padding-inline: 37px 13px; border-radius: 11px; border: 1px solid var(--border); background: rgba(237,240,255,0.03); color: var(--text); font-family: inherit; font-size: 0.85rem; outline: none; transition: border-color .16s, box-shadow .16s; }
  .cmds-search input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(208,0,255,0.15); }
  .cmds-catfilter { display: flex; gap: 6px; flex-wrap: wrap; }
  .cmds-chip { padding: 7px 13px; border-radius: 999px; border: 1px solid var(--border); background: rgba(237,240,255,0.03); color: var(--text-muted); font-family: inherit; font-size: 0.78rem; cursor: pointer; transition: .15s; white-space: nowrap; }
  .cmds-chip:hover { color: var(--text); border-color: rgba(208,0,255,0.4); }
  .cmds-chip.is-active { background: rgba(208,0,255,0.16); border-color: rgba(208,0,255,0.5); color: #edf0ff; }

  /* ── الأقسام والشبكة ── */
  .cmds-sections { display: flex; flex-direction: column; gap: 24px; }
  .cmds-section[hidden] { display: none; }
  .cmds-section-head { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; flex-wrap: wrap; }
  .cmds-section-head h2 { font-size: 1rem; font-weight: 800; display: flex; align-items: center; gap: 9px; }
  .cmds-section-count { font-size: 0.72rem; font-weight: 600; color: var(--text-muted); background: rgba(237,240,255,0.05); border-radius: 999px; padding: 2px 9px; }
  .cmds-section-acts { margin-inline-start: auto; display: flex; align-items: center; gap: 8px; }
  .cmds-cat-check { display: inline-flex; align-items: center; gap: 6px; font-size: 0.74rem; color: var(--text-muted); cursor: pointer; user-select: none; }

  .cmds-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(248px, 1fr)); gap: 14px; }

  /* ── بطاقة الأمر (حجم موحّد) ── */
  .cmd-card { position: relative; display: flex; flex-direction: column; height: 178px; padding: 15px; cursor: pointer; transition: border-color .16s, transform .16s; }
  .cmd-card[hidden] { display: none; }
  .cmd-card:hover { border-color: rgba(208,0,255,0.4); transform: translateY(-2px); }
  .cmd-card.is-off .cmd-name { color: var(--text-muted); }
  .cmd-card.is-open { grid-column: 1 / -1; height: auto; cursor: default; border-color: rgba(208,0,255,0.45); }
  .cmd-card.is-open:hover { transform: none; }

  .cmd-top { display: flex; align-items: center; gap: 9px; margin-bottom: 8px; }
  .cmd-name { flex: 1; min-width: 0; font-family: var(--nx-mono, Consolas, monospace); direction: ltr; unicode-bidi: isolate; font-size: 1.02rem; font-weight: 800; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cmd-card.is-off .cmd-name { color: var(--text-muted); }
  .cmd-cat { align-self: flex-start; font-size: 0.64rem; font-weight: 700; padding: 2px 9px; border-radius: 999px; background: rgba(208,0,255,0.13); color: var(--acc); margin-bottom: 7px; }
  .cmd-desc { color: var(--text-muted); font-size: 0.8rem; line-height: 1.65; flex: 1; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .cmd-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: auto; padding-top: 10px; border-top: 1px solid var(--border); }
  .cmd-perm { font-size: 0.68rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cmd-perm.is-allow { background: rgba(0,200,255,0.12); color: var(--ok); }
  .cmd-perm.is-block { background: rgba(255,53,69,0.12); color: var(--no); }
  .cmd-perm.is-def { background: rgba(237,240,255,0.05); color: var(--text-muted); }
  .cmd-openbtn { display: inline-flex; align-items: center; gap: 6px; font-family: inherit; font-size: 0.74rem; font-weight: 700; color: var(--text); background: rgba(208,0,255,0.10); border: 1px solid rgba(208,0,255,0.35); border-radius: 9px; padding: 5px 11px; cursor: pointer; transition: .15s; white-space: nowrap; }
  .cmd-openbtn:hover { background: rgba(208,0,255,0.2); }

  /* ── المفتاح ── */
  .cmds-switch { position: relative; flex: 0 0 auto; width: 40px; height: 22px; border-radius: 999px; background: #34343f; border: 1px solid rgba(237,240,255,0.08); cursor: pointer; transition: .18s; outline: none; }
  .cmds-switch > span { position: absolute; top: 2px; inset-inline-start: 2px; width: 16px; height: 16px; border-radius: 50%; background: #c9d0e5; transition: .18s; }
  .cmds-switch[data-on="true"] { background: linear-gradient(135deg, var(--acc), var(--acc2)); border-color: transparent; }
  .cmds-switch[data-on="true"] > span { inset-inline-start: 20px; background: #edf0ff; }
  .cmds-switch:focus-visible { box-shadow: 0 0 0 3px rgba(208,0,255,0.3); }

  .cmds-check { display: inline-flex; flex: 0 0 auto; position: relative; }
  .cmds-check input { position: absolute; opacity: 0; width: 0; height: 0; }
  .cmds-check > span { display: inline-block; width: 16px; height: 16px; border-radius: 5px; border: 1.5px solid #34343f; background: rgba(237,240,255,0.04); position: relative; transition: .15s; cursor: pointer; }
  .cmds-check input:checked + span { background: linear-gradient(135deg, var(--acc), var(--acc2)); border-color: transparent; }
  .cmds-check input:checked + span::after { content: ''; position: absolute; left: 4.5px; top: 1.5px; width: 4px; height: 8px; border: solid #edf0ff; border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .cmds-check input:focus-visible + span { box-shadow: 0 0 0 3px rgba(208,0,255,0.3); }

  /* ── محرّر البطاقة المنفتحة ── */
  .cmd-card.is-open { height: auto; }
  .cmd-editor { margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border); cursor: default; }
  .cmd-editor[hidden] { display: none; }
  .ce-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
  .ce-title { font-size: 0.86rem; font-weight: 700; display: flex; align-items: center; gap: 8px; }
  .ce-title i { color: var(--acc); }
  .ce-title b { font-family: var(--nx-mono, Consolas, monospace); direction: ltr; }
  .ce-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media (max-width: 820px) { .ce-grid { grid-template-columns: 1fr; gap: 16px; } }
  .ce-col { min-width: 0; }
  .ce-col h4 { font-size: 0.82rem; font-weight: 700; display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
  .ce-col h4 > i { color: var(--acc); }
  .ce-col h4 > span:first-child { display: inline-flex; align-items: center; gap: 8px; }

  .ed-desc { width: 100%; min-height: 78px; resize: vertical; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--border); background: rgba(237,240,255,0.03); color: var(--text); font-family: inherit; font-size: 0.85rem; line-height: 1.6; outline: none; transition: border-color .16s, box-shadow .16s; }
  .ed-desc:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(208,0,255,0.15); }
  .cmds-btn { display: inline-flex; align-items: center; gap: 7px; padding: 9px 14px; border-radius: 10px; border: 1px solid var(--border); background: rgba(237,240,255,0.04); color: var(--text); font-family: inherit; font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: .15s; white-space: nowrap; }
  .cmds-btn:hover { border-color: rgba(208,0,255,0.45); background: rgba(208,0,255,0.10); }
  .cmds-btn:disabled { opacity: 0.55; cursor: default; }
  .cmds-btn.is-primary { background: linear-gradient(135deg, var(--acc), var(--acc2)); border-color: transparent; color: #edf0ff; }
  .cmds-btn.is-primary:hover { filter: brightness(1.08); }
  .cmds-btn.is-ghost { background: transparent; border-color: transparent; color: var(--text-muted); }
  .cmds-btn.is-ghost:hover { color: var(--text); background: rgba(237,240,255,0.05); }
  .cmds-mini { display: inline-flex; align-items: center; gap: 6px; color: var(--text-muted); background: transparent; border: 1px solid transparent; border-radius: 8px; padding: 5px 8px; cursor: pointer; font-family: inherit; font-size: 0.74rem; transition: .15s; line-height: 1; }
  .cmds-mini:hover { color: #edf0ff; background: rgba(237,240,255,0.06); border-color: var(--border); }
  .ed-block-foot { display: flex; align-items: center; gap: 10px; margin-top: 10px; }
  .ed-save-state { font-size: 0.74rem; color: var(--ok); }
  .ed-hint { font-size: 0.74rem; color: var(--text-muted); line-height: 1.7; margin-bottom: 8px; }
  .ed-perms-tools { display: flex; gap: 10px; align-items: center; margin-bottom: 8px; flex-wrap: wrap; }
  .ed-rolesearch { position: relative; flex: 1 1 150px; }
  .ed-rolesearch > i { position: absolute; inset-inline-start: 11px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.78rem; pointer-events: none; }
  .ed-rolesearch input { width: 100%; padding-block: 8px; padding-inline: 32px 11px; border-radius: 9px; border: 1px solid var(--border); background: rgba(237,240,255,0.03); color: var(--text); font-family: inherit; font-size: 0.82rem; outline: none; }
  .ed-rolesearch input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(208,0,255,0.15); }
  .ed-onlyset { display: inline-flex; align-items: center; gap: 5px; font-size: 0.74rem; color: var(--text-muted); cursor: pointer; white-space: nowrap; }
  .ed-perms-chips { display: inline-flex; gap: 6px; flex-wrap: wrap; }
  .ed-chip { display: inline-flex; align-items: center; gap: 5px; font-size: 0.68rem; font-weight: 700; padding: 3px 9px; border-radius: 999px; }
  .ed-chip.is-allow { background: rgba(0,200,255,0.12); color: var(--ok); }
  .ed-chip.is-block { background: rgba(255,53,69,0.12); color: var(--no); }
  .ed-chip.is-def { background: rgba(237,240,255,0.05); color: var(--text-muted); }

  .ed-roles { border: 1px solid var(--border); border-radius: 12px; padding: 6px; max-height: 300px; overflow: auto; }
  .ed-roles::-webkit-scrollbar { width: 8px; }
  .ed-roles::-webkit-scrollbar-thumb { background: rgba(135,0,255,0.35); border-radius: 8px; }
  .ed-role { display: flex; align-items: center; gap: 10px; padding: 6px 8px; border-radius: 9px; }
  .ed-role[hidden] { display: none; }
  .ed-role:hover { background: rgba(237,240,255,0.035); }
  .ed-role-dot { width: 11px; height: 11px; border-radius: 50%; flex: 0 0 auto; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.35); }
  .ed-role-name { flex: 1; min-width: 0; font-size: 0.84rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ed-seg { display: inline-flex; gap: 2px; padding: 2px; border-radius: 9px; background: rgba(237,240,255,0.04); border: 1px solid var(--border); flex: 0 0 auto; }
  .ed-seg button { border: 0; background: transparent; color: var(--text-muted); font-family: inherit; font-size: 0.72rem; font-weight: 600; padding: 5px 10px; border-radius: 7px; cursor: pointer; transition: .14s; white-space: nowrap; }
  .ed-seg button:hover { color: var(--text); }
  .ed-seg button.is-allow { background: rgba(0,200,255,0.16); color: var(--ok); }
  .ed-seg button.is-block { background: rgba(255,53,69,0.16); color: var(--no); }
  .ed-seg button.is-def { background: rgba(52,52,63,0.9); color: #edf0ff; }
  .ed-roles-loading, .ed-roles-empty { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 22px; color: var(--text-muted); font-size: 0.82rem; }
  .ed-roles-error { display: flex; align-items: center; justify-content: center; gap: 8px; flex-wrap: wrap; padding: 22px; color: #ff8088; font-size: 0.82rem; }

  .cmds-nores { display: none; flex-direction: column; align-items: center; gap: 6px; padding: 48px 16px; color: var(--text-muted); text-align: center; }
  .cmds-nores[hidden] { display: none; }
  .cmds-nores.show { display: flex; }
  .cmds-nores i { font-size: 1.7rem; }

  /* ── شريط الإجراءات الجماعية (عائم) ── */
  .cmds-bulkbar { position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%); z-index: 60; display: flex; align-items: center; gap: 8px; padding: 8px 10px 8px 16px; border-radius: 14px; background: rgba(16,16,20,0.96); border: 1px solid rgba(208,0,255,0.4); box-shadow: 0 14px 44px rgba(0,0,0,0.5); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); }
  .cmds-bulkbar[hidden] { display: none; }
  .cmds-bulkcount { font-size: 0.78rem; color: var(--text-muted); }
  .cmds-bulkcount b { color: var(--text); }

  @media (max-width: 520px) {
    .cmd-card { height: auto; min-height: 150px; }
    .ed-seg button { padding: 5px 8px; font-size: 0.68rem; }
  }
</style>

<div class="cmds-page">
  <div class="page-header cmds-header">
    <div>
      <h1><i class="fas fa-terminal"></i> الأوامر</h1>
      <p>تحكّم كامل بأوامر سيرفر <strong><%= guild.name %></strong> — تفعيل، وصف، وصلاحيات</p>
    </div>
    <div class="cmds-kpis">
      <div class="cmds-kpi"><b id="kpiTotal"><%= total %></b><span>إجمالي</span></div>
      <div class="cmds-kpi is-on"><b id="kpiOn"><%= enabledCount %></b><span>مفعّلة</span></div>
      <div class="cmds-kpi is-off"><b id="kpiOff"><%= total - enabledCount %></b><span>معطّلة</span></div>
      <div class="cmds-kpi is-perm"><b id="kpiPerm"><%= customPerms %></b><span>بصلاحيات</span></div>
    </div>
  </div>

  <div class="cmds-toolbar">
    <div class="cmds-search">
      <i class="fas fa-search" aria-hidden="true"></i>
      <input type="search" id="cmdsSearch" placeholder="ابحث باسم الأمر…" autocomplete="off">
    </div>
    <div class="cmds-catfilter" id="cmdsCats">
      <button type="button" class="cmds-chip is-active" data-cat="all">الكل</button>
      <% cats.forEach(cat => { %>
        <button type="button" class="cmds-chip" data-cat="<%= cat %>"><%= cat %></button>
      <% }) %>
    </div>
  </div>

  <div class="cmds-sections" id="cmdsSections">
    <% cats.forEach(cat => { %>
      <section class="cmds-section" data-cat="<%= cat %>">
        <div class="cmds-section-head">
          <h2><%= cat %> <span class="cmds-section-count"><%= byCat[cat].length %></span></h2>
          <div class="cmds-section-acts">
            <label class="cmds-cat-check"><input type="checkbox" class="cmds-cat-check-box"> تحديد الكل</label>
            <button type="button" class="cmds-mini" onclick='cmdsBulkCategory(<%- JSON.stringify(cat) %>, true)'><i class="fas fa-toggle-on"></i> تفعيل</button>
            <button type="button" class="cmds-mini" onclick='cmdsBulkCategory(<%- JSON.stringify(cat) %>, false)'><i class="fas fa-toggle-off"></i> تعطيل</button>
          </div>
        </div>
        <div class="cmds-grid">
          <% byCat[cat].forEach(cmd => { %>
            <% const cfg = configMap[cmd.name]; %>
            <% const enabled = enabledOf(cmd); %>
            <% const allowed = (cfg && cfg.allowedRoles) || []; %>
            <% const blocked = (cfg && cfg.blockedRoles) || []; %>
            <% const aN = allowed.length, bN = blocked.length; %>
            <% const permCls = (aN || bN) ? (bN && !aN ? 'is-block' : 'is-allow') : 'is-def'; %>
            <% const permTxt = (aN && bN) ? (aN + ' مسموح · ' + bN + ' ممنوع') : aN ? (aN + ' مسموح') : bN ? (bN + ' ممنوع') : 'متاح للجميع'; %>
            <article class="cmd-card glass<%= enabled ? '' : ' is-off' %>"
                     data-name="<%= cmd.name %>" data-cat="<%= cat %>"
                     data-enabled="<%= enabled ? 'true' : 'false' %>"
                     data-allowed="<%= JSON.stringify(allowed) %>" data-blocked="<%= JSON.stringify(blocked) %>"
                     data-desc="<%= cmd.description || '' %>" data-file="<%= cmd.file || '' %>">
              <div class="cmd-top">
                <span class="cmds-check" title="تحديد"><input type="checkbox" class="cmds-pick"><span></span></span>
                <span class="cmd-name">/<%= cmd.name %></span>
                <span class="cmds-switch" role="switch" tabindex="0" data-on="<%= enabled ? 'true' : 'false' %>" aria-label="تفعيل أو تعطيل <%= cmd.name %>"><span></span></span>
              </div>
              <span class="cmd-cat"><%= cat %></span>
              <p class="cmd-desc"><%= cmd.description || 'بدون وصف' %></p>
              <div class="cmd-foot">
                <span class="cmd-perm <%= permCls %>"><%= permTxt %></span>
                <button type="button" class="cmd-openbtn"><span class="t">ضبط</span> <i class="fas fa-sliders"></i></button>
              </div>
            </article>
          <% }) %>
        </div>
      </section>
    <% }) %>

    <div class="cmds-nores" id="cmdsNoRes" hidden>
      <i class="fas fa-search"></i>
      <p>لا توجد أوامر مطابقة</p>
    </div>
  </div>

  <!-- محرّر واحد يُنقل داخل البطاقة المنفتحة -->
  <div class="cmd-editor" id="cmdEditor" hidden>
    <div class="ce-head">
      <span class="ce-title"><i class="fas fa-sliders"></i> ضبط <b id="ceName"></b></span>
      <button type="button" class="cmds-mini" id="ceClose"><i class="fas fa-xmark"></i> إغلاق</button>
    </div>
    <div class="ce-grid">
      <div class="ce-col">
        <h4><span><i class="fas fa-pen"></i> الوصف</span></h4>
        <textarea class="ed-desc" id="edDesc" maxlength="100" placeholder="وصف يظهر للأعضاء…"></textarea>
        <div class="ed-block-foot">
          <button type="button" class="cmds-btn is-primary" id="edDescSave"><i class="fas fa-floppy-disk"></i> حفظ الوصف</button>
          <span class="ed-save-state" id="edDescState"></span>
        </div>
      </div>
      <div class="ce-col">
        <h4><span><i class="fas fa-shield-halved"></i> الصلاحيات</span> <span class="ed-perms-chips" id="edPermChips"></span></h4>
        <p class="ed-hint">افتراضياً الجميع مسموح. اختر <b>مسموح</b> لقصر الأمر على رتب محدّدة، أو <b>ممنوع</b> لاستثناء رتب.</p>
        <div class="ed-perms-tools">
          <div class="ed-rolesearch">
            <i class="fas fa-search" aria-hidden="true"></i>
            <input type="search" id="edRoleSearch" placeholder="ابحث عن رتبة…" autocomplete="off">
          </div>
          <label class="ed-onlyset"><input type="checkbox" id="edOnlySet"> المحدّدة فقط</label>
        </div>
        <div class="ed-roles" id="edRoles">
          <div class="ed-roles-loading"><i class="fas fa-spinner fa-spin"></i> جاري تحميل الرتب…</div>
        </div>
        <div class="ed-block-foot">
          <button type="button" class="cmds-btn is-primary" id="edPermSave"><i class="fas fa-floppy-disk"></i> حفظ الصلاحيات</button>
          <span class="ed-save-state" id="edPermState"></span>
        </div>
      </div>
    </div>
  </div>

  <div class="cmds-bulkbar" id="cmdsBulkBar" hidden>
    <span class="cmds-bulkcount"><b id="cmdsPickCount">0</b> محدد</span>
    <button type="button" class="cmds-btn is-primary" onclick="cmdsBulkSelected(true)"><i class="fas fa-toggle-on"></i> تفعيل</button>
    <button type="button" class="cmds-btn" onclick="cmdsBulkSelected(false)"><i class="fas fa-toggle-off"></i> تعطيل</button>
    <button type="button" class="cmds-btn is-ghost" onclick="cmdsClearSelection()">مسح</button>
  </div>
</div>

<script>
(function () {
  const GID = '<%= guild.id %>';
  const TOTAL = <%= total %>;

  const sectionsEl = document.getElementById('cmdsSections');
  const editor = document.getElementById('cmdEditor');
  const searchEl = document.getElementById('cmdsSearch');
  const catsEl = document.getElementById('cmdsCats');
  const bulkBar = document.getElementById('cmdsBulkBar');
  const bulkCount = document.getElementById('cmdsPickCount');
  const noRes = document.getElementById('cmdsNoRes');
  const kpiOn = document.getElementById('kpiOn');
  const kpiOff = document.getElementById('kpiOff');
  const kpiPerm = document.getElementById('kpiPerm');

  const ceName = document.getElementById('ceName');
  const ceClose = document.getElementById('ceClose');
  const edDesc = document.getElementById('edDesc');
  const edDescState = document.getElementById('edDescState');
  const edDescSave = document.getElementById('edDescSave');
  const edRoleSearch = document.getElementById('edRoleSearch');
  const edOnlySet = document.getElementById('edOnlySet');
  const edRoles = document.getElementById('edRoles');
  const edPermChips = document.getElementById('edPermChips');
  const edPermSave = document.getElementById('edPermSave');
  const edPermState = document.getElementById('edPermState');

  let activeCat = 'all';
  let selected = null;
  let roles = null;
  let rolesPromise = null;
  let rolesState = {};

  const qsa = (sel, root) => Array.from((root || document).querySelectorAll(sel));
  const cards = () => qsa('.cmd-card', sectionsEl);
  const cardOf = name => qsa('.cmd-card', sectionsEl).find(c => c.dataset.name === name) || null;
  const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const toast = msg => { try { if (typeof showToast === 'function') showToast(msg); } catch (e) { /* noop */ } };
  const parseLen = (json) => { try { return JSON.parse(json || '[]').length; } catch (e) { return 0; } };

  /* ── تفعيل / تعطيل ─────────────────────────────────────────── */
  function paintCardEnabled(card, enabled) {
    card.dataset.enabled = enabled ? 'true' : 'false';
    card.classList.toggle('is-off', !enabled);
    const sw = card.querySelector('.cmds-switch');
    if (sw) sw.dataset.on = enabled ? 'true' : 'false';
  }
  async function setEnabled(card, enabled, quiet) {
    const name = card.dataset.name;
    const prev = card.dataset.enabled === 'true';
    if (prev === enabled) return true;
    paintCardEnabled(card, enabled);
    try {
      const res = await fetch('/commands/' + GID + '/update', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ command: name, enabled })
      });
      if (!res.ok) throw new Error('bad');
      updateKpis();
      return true;
    } catch (e) {
      paintCardEnabled(card, prev);
      if (!quiet) toast('❌ تعذّر تحديث «' + name + '»');
      return false;
    }
  }

  /* ── فتح/إغلاق محرّر البطاقة ───────────────────────────────── */
  function openEditor(card) {
    const prev = sectionsEl.querySelector('.cmd-card.is-open');
    if (prev && prev !== card) prev.classList.remove('is-open');
    card.classList.add('is-open');
    card.appendChild(editor);
    editor.hidden = false;
    selected = card.dataset.name;
    fillEditor(card);
  }
  function closeEditor() {
    const open = sectionsEl.querySelector('.cmd-card.is-open');
    if (open) open.classList.remove('is-open');
    editor.hidden = true;
    selected = null;
  }
  function fillEditor(card) {
    document.getElementById('ceName').textContent = '/' + card.dataset.name;
    edDesc.value = card.dataset.desc || '';
    edDescState.textContent = '';
    edRoleSearch.value = '';
    edOnlySet.checked = false;
    rolesState = {};
    try { JSON.parse(card.dataset.allowed || '[]').forEach(id => { rolesState[id] = 'allow'; }); } catch (e) { /* noop */ }
    try { JSON.parse(card.dataset.blocked || '[]').forEach(id => { rolesState[id] = 'block'; }); } catch (e) { /* noop */ }
    updateChips();
    loadRoles();
  }

  /* ── تحميل الرتب ───────────────────────────────────────────── */
  function fetchRoles() {
    if (!rolesPromise) {
      rolesPromise = fetch('/commands/' + GID + '/roles')
        .then(r => { if (!r.ok) throw new Error('roles'); return r.json(); })
        .catch(e => { rolesPromise = null; throw e; });
    }
    return rolesPromise;
  }
  async function loadRoles() {
    const edPermStateEl = document.getElementById('edPermState');
    if (edPermStateEl) edPermStateEl.textContent = '';
    const edRolesEl = document.getElementById('edRoles');
    if (roles) { renderRoles(); return; }
    edRolesEl.innerHTML = '<div class="ed-roles-loading"><i class="fas fa-spinner fa-spin"></i> جاري تحميل الرتب…</div>';
    try {
      roles = await fetchRoles();
      renderRoles();
    } catch (e) {
      edRolesEl.innerHTML = '<div class="ed-roles-error"><i class="fas fa-triangle-exclamation"></i> تعذّر تحميل الرتب. <button type="button" class="cmds-mini" id="edRolesRetry">إعادة المحاولة</button></div>';
    }
  }
  function renderRoles() {
    const edRolesEl = document.getElementById('edRoles');
    if (!roles || !roles.length) {
      edRolesEl.innerHTML = '<div class="ed-roles-empty">لا توجد رتب في هذا السيرفر</div>';
      return;
    }
    edRolesEl.innerHTML = roles.map(r => {
      const color = r.color ? ('#' + Number(r.color).toString(16).padStart(6, '0')) : '#858b9d';
      const st = rolesState[r.id] || 'def';
      return '<div class="ed-role" data-id="' + esc(r.id) + '">'
        + '<span class="ed-role-dot" style="background:' + color + '"></span>'
        + '<span class="ed-role-name">' + esc(r.name) + '</span>'
        + '<span class="ed-seg">'
        + '<button type="button" data-st="allow" class="' + (st === 'allow' ? 'is-allow' : '') + '">مسموح</button>'
        + '<button type="button" data-st="def" class="' + (st === 'def' ? 'is-def' : '') + '">افتراضي</button>'
        + '<button type="button" data-st="block" class="' + (st === 'block' ? 'is-block' : '') + '">ممنوع</button>'
        + '</span></div>';
    }).join('');
    filterRoles();
  }
  function paintRole(roleEl) {
    const st = rolesState[roleEl.dataset.id] || 'def';
    qsa('.ed-seg button', roleEl).forEach(b => {
      b.classList.toggle('is-allow', b.dataset.st === 'allow' && st === 'allow');
      b.classList.toggle('is-block', b.dataset.st === 'block' && st === 'block');
      b.classList.toggle('is-def', b.dataset.st === 'def' && st === 'def');
    });
  }
  function filterRoles() {
    const q = edRoleSearch.value.trim().toLowerCase();
    const only = edOnlySet.checked;
    qsa('.ed-role').forEach(el => {
      const nm = (el.querySelector('.ed-role-name').textContent || '').toLowerCase();
      const set = !!rolesState[el.dataset.id];
      el.hidden = !((!q || nm.indexOf(q) !== -1) && (!only || set));
    });
  }
  function updateChips() {
    let a = 0, b = 0;
    Object.keys(rolesState).forEach(k => { if (rolesState[k] === 'allow') a++; else if (rolesState[k] === 'block') b++; });
    const bits = [];
    if (a) bits.push('<span class="ed-chip is-allow"><i class="fas fa-check"></i> ' + a + ' مسموح</span>');
    if (b) bits.push('<span class="ed-chip is-block"><i class="fas fa-ban"></i> ' + b + ' ممنوع</span>');
    if (!a && !b) bits.push('<span class="ed-chip is-def">الجميع مسموح</span>');
    document.getElementById('edPermChips').innerHTML = bits.join('');
  }

  /* ── الحفظ ─────────────────────────────────────────────────── */
  async function saveDesc() {
    if (!selected) return;
    const card = cardOf(selected);
    const desc = edDesc.value.trim();
    edDescSave.disabled = true;
    edDescState.textContent = '…جاري الحفظ';
    try {
      const res = await fetch('/commands/' + GID + '/update-description', {
        method: 'PATCH', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ command: selected, description: desc })
      });
      if (!res.ok) throw new Error('bad');
      if (card) { card.dataset.desc = desc; card.querySelector('.cmd-desc').textContent = desc || 'بدون وصف'; }
      edDescState.textContent = '✅ تم الحفظ';
      toast('✅ تم تحديث الوصف');
    } catch (e) {
      edDescState.textContent = '';
      toast('❌ فشل تحديث الوصف');
    } finally {
      edDescSave.disabled = false;
    }
  }
  async function savePerms() {
    if (!selected) return;
    const allowed = [], blocked = [];
    Object.keys(rolesState).forEach(id => {
      if (rolesState[id] === 'allow') allowed.push(id);
      else if (rolesState[id] === 'block') blocked.push(id);
    });
    edPermSave.disabled = true;
    edPermState.textContent = '…جاري الحفظ';
    try {
      const res = await fetch('/commands/' + GID + '/permissions', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ command: selected, allowedRoles: allowed, blockedRoles: blocked })
      });
      if (!res.ok) throw new Error('bad');
      const card = cardOf(selected);
      if (card) { card.dataset.allowed = JSON.stringify(allowed); card.dataset.blocked = JSON.stringify(blocked); paintPerm(card); }
      edPermState.textContent = '✅ تم الحفظ';
      toast('✅ تم حفظ صلاحيات «' + selected + '»');
      updateKpis();
    } catch (e) {
      edPermState.textContent = '';
      toast('❌ فشل حفظ الصلاحيات');
    } finally {
      edPermSave.disabled = false;
    }
  }
  function paintPerm(card) {
    const el = card.querySelector('.cmd-perm');
    if (!el) return;
    const a = parseLen(card.dataset.allowed), b = parseLen(card.dataset.blocked);
    if (!a && !b) { el.className = 'cmd-perm is-def'; el.textContent = 'متاح للجميع'; }
    else if (a && b) { el.className = 'cmd-perm is-allow'; el.textContent = a + ' مسموح · ' + b + ' ممنوع'; }
    else if (a) { el.className = 'cmd-perm is-allow'; el.textContent = a + ' مسموح'; }
    else { el.className = 'cmd-perm is-block'; el.textContent = b + ' ممنوع'; }
  }

  /* ── التصفية ───────────────────────────────────────────────── */
  function applyFilter() {
    const q = searchEl.value.trim().toLowerCase().replace(/^\//, '');
    let visible = 0;
    qsa('.cmds-section').forEach(sec => {
      let sv = 0;
      qsa('.cmd-card', sec).forEach(card => {
        const match = (!q || card.dataset.name.toLowerCase().indexOf(q) !== -1) && (activeCat === 'all' || card.dataset.cat === activeCat);
        card.hidden = !match;
        if (match) { sv++; visible++; }
      });
      sec.hidden = sv === 0;
    });
    if (visible === 0) noRes.removeAttribute('hidden'); else noRes.setAttribute('hidden', '');
    syncBulkBar();
  }

  /* ── الإجراءات الجماعية ────────────────────────────────────── */
  function syncBulkBar() {
    const n = qsa('.cmds-pick:checked').length;
    bulkCount.textContent = n;
    if (n === 0) bulkBar.setAttribute('hidden', ''); else bulkBar.removeAttribute('hidden');
    syncSectionChecks();
  }
  function syncSectionChecks() {
    qsa('.cmds-section').forEach(sec => {
      const cb = sec.querySelector('.cmds-cat-check-box');
      const cards = qsa('.cmd-card', sec).filter(c => !c.hidden);
      const checked = cards.filter(c => c.querySelector('.cmds-pick').checked).length;
      cb.checked = cards.length > 0 && checked === cards.length;
      cb.indeterminate = checked > 0 && checked < cards.length;
    });
  }
  async function bulkSet(cards, enabled) {
    const targets = cards.filter(c => (c.dataset.enabled === 'true') !== enabled);
    if (!targets.length) { toast('لا يوجد تغيير'); return; }
    let failed = 0;
    for (const card of targets) {
      const ok = await setEnabled(card, enabled, true);
      if (!ok) failed++;
    }
    updateKpis();
    const done = targets.length - failed;
    toast((failed ? '⚠️ ' : '✅ ') + (enabled ? 'تم تفعيل ' : 'تم تعطيل ') + done + ' أمر' + (failed ? ' — فشل ' + failed : ''));
  }
  window.cmdsBulkSelected = function (enabled) {
    bulkSet(qsa('.cmds-pick:checked').map(p => p.closest('.cmd-card')), enabled);
  };
  window.cmdsBulkCategory = function (cat, enabled) {
    const sec = qsa('.cmds-section').find(s => s.dataset.cat === cat);
    if (sec) bulkSet(qsa('.cmd-card', sec), enabled);
  };
  window.cmdsClearSelection = function () {
    qsa('.cmds-pick').forEach(p => { p.checked = false; });
    syncBulkBar();
  };
  function updateKpis() {
    const cards = qsa('.cmd-card');
    let on = 0, perm = 0;
    cards.forEach(c => {
      if (c.dataset.enabled === 'true') on++;
      if (parseLen(c.dataset.allowed) + parseLen(c.dataset.blocked) > 0) perm++;
    });
    kpiOn.textContent = on;
    kpiOff.textContent = cards.length - on;
    kpiPerm.textContent = perm;
  }

  /* ── الأحداث ───────────────────────────────────────────────── */
  sectionsEl.addEventListener('click', e => {
    const card = e.target.closest('.cmd-card');
    if (!card) return;
    if (e.target.closest('.cmds-switch')) { setEnabled(card, card.dataset.enabled !== 'true'); return; }
    if (e.target.closest('.cmds-check')) return;
    if (e.target.closest('.cmd-editor')) return;
    if (e.target.closest('.cmd-openbtn')) { if (card.classList.contains('is-open')) closeEditor(); else openEditor(card); return; }
    if (card.classList.contains('is-open')) return;
    openEditor(card);
  });
  sectionsEl.addEventListener('keydown', e => {
    if ((e.key === 'Enter' || e.key === ' ') && e.target.classList.contains('cmds-switch')) {
      e.preventDefault();
      const card = e.target.closest('.cmd-card');
      if (card) setEnabled(card, card.dataset.enabled !== 'true');
    }
  });
  sectionsEl.addEventListener('change', e => {
    if (e.target.classList.contains('cmds-pick')) { syncBulkBar(); return; }
    if (e.target.classList.contains('cmds-cat-check-box')) {
      const sec = e.target.closest('.cmds-section');
      const on = e.target.checked;
      qsa('.cmd-card', sec).filter(c => !c.hidden).forEach(c => { c.querySelector('.cmds-pick').checked = on; });
      syncBulkBar();
    }
  });
  document.getElementById('ceClose').addEventListener('click', closeEditor);
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !editor.hidden) closeEditor(); });
  document.getElementById('edDescSave').addEventListener('click', saveDesc);
  document.getElementById('edPermSave').addEventListener('click', savePerms);
  document.getElementById('edRoleSearch').addEventListener('input', filterRoles);
  document.getElementById('edOnlySet').addEventListener('change', filterRoles);
  document.getElementById('edRoles').addEventListener('click', e => {
    if (e.target.closest('#edRolesRetry')) { roles = null; rolesPromise = null; loadRoles(); return; }
    const btn = e.target.closest('.ed-seg button');
    if (!btn) return;
    const roleEl = btn.closest('.ed-role');
    const id = roleEl.dataset.id;
    const st = btn.dataset.st;
    if (st === 'def') delete rolesState[id]; else rolesState[id] = st;
    paintRole(roleEl);
    updateChips();
    document.getElementById('edPermState').textContent = '';
    if (document.getElementById('edOnlySet').checked) filterRoles();
  });
  searchEl.addEventListener('input', applyFilter);
  catsEl.addEventListener('click', e => {
    const b = e.target.closest('.cmds-chip');
    if (!b) return;
    activeCat = b.dataset.cat;
    qsa('.cmds-chip', catsEl).forEach(c => c.classList.toggle('is-active', c === b));
    applyFilter();
  });

  /* ── التهيئة ───────────────────────────────────────────────── */
  qsa('.cmd-card').forEach(paintPerm);
  applyFilter();
})();
</script>

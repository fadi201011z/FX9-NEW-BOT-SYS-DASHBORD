<% currentPage = 'tickets' %>
<div class="page-header">
  <h1><i class="fas fa-ticket-alt"></i> إدارة التذاكر — <%= guild.name %></h1>
  <p>إجمالي التذاكر: <%= ticketCount %></p>
</div>

<div class="ticket-search">
  <i class="fas fa-search search-icon"></i>
  <input type="text" id="ticketSearch" placeholder="🔍 بحث برقم التذكرة، اسم العضو، المعرف، القسم، العنوان..."
         oninput="filterTickets()" class="search-input">
</div>

<div class="tabs">
  <button class="tab active" onclick="switchTab(this, 'open')">مفتوحة (<span id="openCount"><%= tickets.open?.length || 0 %></span>)</button>
  <button class="tab" onclick="switchTab(this, 'closed')">مغلقة (<span id="closedCount"><%= tickets.closed?.length || 0 %></span>)</button>
</div>

<div class="tab-content active" id="tab-open">
  <div class="card glass">
    <div class="card-header"><h3>📩 التذاكر المفتوحة</h3></div>
    <div class="ticket-list" id="openList">
      <% if (tickets.open && tickets.open.length > 0) { %>
        <% tickets.open.forEach(t => { %>
          <div class="ticket-acc" data-search="<%= (t.ticketId+' '+t.username+' '+t.userId+' '+t.category+' '+t.title+' '+(t.claimedByUsername||'')).toLowerCase() %>">
            <div class="ticket-acc-header" onclick="toggleTicket(this)">
              <div class="ticket-acc-info">
                <span class="ticket-id">#<%= t.ticketId %></span>
                <span class="ticket-acc-user"><%= t.username || t.userId || '—' %></span>
                <span class="ticket-status open">مفتوحة</span>
                <% if (t.claimedBy) { %>
                  <span class="ticket-acc-claimed"><i class="fas fa-headset"></i> <%= t.claimedByUsername || t.claimedBy %></span>
                <% } %>
              </div>
              <div class="ticket-acc-arrow"><i class="fas fa-chevron-down"></i></div>
            </div>
            <div class="ticket-acc-body">
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-folder"></i> القسم:</span>
                <span><%= t.category || '—' %></span>
              </div>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-user"></i> فتح التذكرة:</span>
                <span><%= t.username || '—' %> <code style="direction:ltr;display:inline-block"><%= t.userId || '' %></code></span>
              </div>
              <% if (t.claimedBy) { %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-headset"></i> مستلم التكت:</span>
                <span><%= t.claimedByUsername || '—' %> <code style="direction:ltr;display:inline-block"><%= t.claimedBy %></code></span>
              </div>
              <% } %>
              <% if (t.title) { %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-tag"></i> العنوان:</span>
                <span><%= t.title %></span>
              </div>
              <% } %>
              <% if (t.description) { %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-align-left"></i> الوصف:</span>
                <span><%= t.description.length > 200 ? t.description.slice(0,200)+'...' : t.description %></span>
              </div>
              <% } %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-clock"></i> تاريخ الفتح:</span>
                <span><%= new Date(t.openedAt || t.createdAt || Date.now()).toLocaleString('ar-SA') %></span>
              </div>
              <% if (t.lastActivity) { %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-exchange-alt"></i> آخر نشاط:</span>
                <span><%= new Date(t.lastActivity).toLocaleString('ar-SA') %></span>
              </div>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="empty-state"><i class="fas fa-check-circle" style="color:var(--success)"></i><p>لا توجد تذاكر مفتوحة</p></div>
      <% } %>
    </div>
  </div>
</div>

<div class="tab-content" id="tab-closed">
  <div class="card glass">
    <div class="card-header"><h3>📁 التذاكر المغلقة</h3></div>
    <div class="ticket-list" id="closedList">
      <% if (tickets.closed && tickets.closed.length > 0) { %>
        <% tickets.closed.forEach(t => { %>
          <div class="ticket-acc closed" data-search="<%= (t.ticketId+' '+t.username+' '+t.userId+' '+t.category+' '+t.title+' '+(t.claimedByUsername||'')+' '+(t.rating||'')).toLowerCase() %>">
            <div class="ticket-acc-header" onclick="toggleTicket(this)">
              <div class="ticket-acc-info">
                <span class="ticket-id">#<%= t.ticketId %></span>
                <span class="ticket-acc-user"><%= t.username || t.userId || '—' %></span>
                <span class="ticket-status closed">مغلقة</span>
                <% if (t.rating) { %>
                  <span class="ticket-acc-rating"><%= '⭐'.repeat(t.rating) %> <%= t.rating %>/5</span>
                <% } else { %>
                  <span class="ticket-acc-rating no-rate">غير مقيمة</span>
                <% } %>
                <% if (t.claimedBy) { %>
                  <span class="ticket-acc-claimed"><i class="fas fa-headset"></i> <%= t.claimedByUsername || t.claimedBy %></span>
                <% } %>
              </div>
              <div class="ticket-acc-arrow"><i class="fas fa-chevron-down"></i></div>
            </div>
            <div class="ticket-acc-body">
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-folder"></i> القسم:</span>
                <span><%= t.category || '—' %></span>
              </div>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-user"></i> فتح التذكرة:</span>
                <span><%= t.username || '—' %> <code style="direction:ltr;display:inline-block"><%= t.userId || '' %></code></span>
              </div>
              <% if (t.claimedBy) { %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-headset"></i> مستلم التكت:</span>
                <span><%= t.claimedByUsername || '—' %> <code style="direction:ltr;display:inline-block"><%= t.claimedBy %></code></span>
              </div>
              <% } %>
              <% if (t.closedBy) { %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-lock"></i> أغلق بواسطة:</span>
                <span><code style="direction:ltr;display:inline-block"><%= t.closedBy %></code></span>
              </div>
              <% } %>
              <% if (t.title) { %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-tag"></i> العنوان:</span>
                <span><%= t.title %></span>
              </div>
              <% } %>
              <% if (t.description) { %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-align-left"></i> الوصف:</span>
                <span><%= t.description.length > 200 ? t.description.slice(0,200)+'...' : t.description %></span>
              </div>
              <% } %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-play-circle"></i> الفتح:</span>
                <span><%= new Date(t.openedAt || t.createdAt || Date.now()).toLocaleString('ar-SA') %></span>
              </div>
              <% if (t.closedAt) { %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-stop-circle"></i> الإغلاق:</span>
                <span><%= new Date(t.closedAt).toLocaleString('ar-SA') %></span>
              </div>
              <% } %>
              <% if (t.rating) { %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-star"></i> التقييم:</span>
                <span><%= '⭐'.repeat(t.rating) %> <%= t.rating %>/5 <% if (t.ratedBy) { %>— <code style="direction:ltr;display:inline-block"><%= t.ratedBy %></code><% } %></span>
              </div>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="empty-state"><i class="fas fa-inbox"></i><p>لا توجد تذاكر مغلقة</p></div>
      <% } %>
    </div>
  </div>
</div>

<style>
.ticket-search {
  margin-bottom: 16px;
  position: relative;
}
.search-input {
  width: 100%;
  padding: 12px 16px 12px 44px;
  border-radius: 12px;
  border: 1px solid var(--border-color, #2a2a3e);
  background: var(--bg-secondary, #1e1e2e);
  color: var(--text, #eee);
  font-size: 0.95rem;
  outline: none;
  transition: all 0.2s;
  box-sizing: border-box;
}
.search-input:focus {
  border-color: var(--accent, #5865f2);
  box-shadow: 0 0 0 3px rgba(88,101,242,0.2);
}
.search-icon {
  position: absolute;
  left: 16px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-muted, #666);
  font-size: 1rem;
  z-index: 1;
}
.ticket-acc {
  background: var(--bg-secondary, #1e1e2e);
  border: 1px solid var(--border-color, #2a2a3e);
  border-radius: 12px;
  margin-bottom: 8px;
  overflow: hidden;
  transition: all 0.2s;
}
.ticket-acc:hover {
  border-color: var(--accent, #5865f2);
}
.ticket-acc.closed {
  opacity: 0.85;
}
.ticket-acc-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  cursor: pointer;
  user-select: none;
  gap: 8px;
  transition: background 0.15s;
}
.ticket-acc-header:hover {
  background: rgba(88,101,242,0.05);
}
.ticket-acc-info {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  flex: 1;
  min-width: 0;
}
.ticket-acc-user {
  font-size: 0.9rem;
  color: var(--text, #eee);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 180px;
}
.ticket-acc-claimed {
  font-size: 0.8rem;
  color: var(--text-muted, #888);
  display: flex;
  align-items: center;
  gap: 4px;
}
.ticket-acc-rating {
  font-size: 0.85rem;
}
.ticket-acc-rating.no-rate {
  color: var(--text-muted, #666);
  font-size: 0.75rem;
}
.ticket-acc-arrow {
  color: var(--text-muted, #666);
  transition: transform 0.2s;
  font-size: 0.85rem;
}
.ticket-acc.open .ticket-acc-arrow {
  transform: rotate(180deg);
}
.ticket-acc-body {
  display: none;
  padding: 0 16px 16px;
  border-top: 1px solid var(--border-color, #2a2a3e);
  padding-top: 12px;
}
.ticket-acc.open .ticket-acc-body {
  display: block;
}
.ticket-acc-row {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 0.9rem;
  padding: 4px 0;
  flex-wrap: wrap;
}
.ticket-acc-row .ticket-label {
  color: var(--text-muted, #888);
  min-width: 110px;
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 0.85rem;
  flex-shrink: 0;
}
.ticket-label i {
  width: 16px;
  text-align: center;
}
.ticket-id {
  font-weight: 700;
  font-size: 1rem;
  color: var(--accent, #5865f2);
  direction: ltr;
  display: inline-block;
  white-space: nowrap;
}
.ticket-status {
  font-size: 0.7rem;
  padding: 2px 10px;
  border-radius: 20px;
  font-weight: 600;
  white-space: nowrap;
}
.ticket-status.open {
  background: rgba(46, 204, 113, 0.15);
  color: #2ecc71;
  border: 1px solid rgba(46, 204, 113, 0.3);
}
.ticket-status.closed {
  background: rgba(231, 76, 60, 0.15);
  color: #e74c3c;
  border: 1px solid rgba(231, 76, 60, 0.3);
}
code {
  background: rgba(255,255,255,0.06);
  padding: 1px 6px;
  border-radius: 4px;
  font-size: 0.8rem;
  color: var(--text-muted, #aaa);
}
</style>

<script>
function switchTab(btn, tab) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('tab-' + tab).classList.add('active');
}

function toggleTicket(header) {
  const acc = header.parentElement;
  acc.classList.toggle('open');
  const arrow = header.querySelector('.ticket-acc-arrow i');
  if (arrow) arrow.style.transform = acc.classList.contains('open') ? 'rotate(180deg)' : '';
}

function filterTickets() {
  const q = document.getElementById('ticketSearch').value.toLowerCase().trim();
  document.querySelectorAll('.ticket-acc').forEach(el => {
    const data = el.getAttribute('data-search') || '';
    el.style.display = !q || data.includes(q) ? '' : 'none';
  });
  ['open', 'closed'].forEach(tab => {
    const list = document.getElementById(tab + 'List');
    if (!list) return;
    const visible = Array.from(list.querySelectorAll('.ticket-acc')).filter(el => el.style.display !== 'none').length;
    const countEl = document.getElementById(tab === 'open' ? 'openCount' : 'closedCount');
    if (countEl) countEl.textContent = visible;
    const empty = list.querySelector('.empty-state');
    if (empty) empty.style.display = visible > 0 ? 'none' : '';
  });
}
</script>
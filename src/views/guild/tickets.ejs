<% currentPage = 'tickets' %>
<%
  // — نظام التذاكر: مفتوحة/مغلقة مع بحث فوري وتقييمات.
  const oList = tickets.open || [];
  const cList = tickets.closed || [];
  const total = ticketCount || (oList.length + cList.length);
  const rated = cList.filter(t => t.rating);
  const avg = rated.length ? Math.round((rated.reduce((s, t) => s + t.rating, 0) / rated.length) * 10) / 10 : 0;
  const closedPct = total > 0 ? Math.round((cList.length / total) * 100) : 0;
  const statusIcon = (t) => t.claimedBy ? 'fa-headset' : 'fa-message';
%>

<div class="page-header">
  <h1><i class="fas fa-ticket"></i> التذاكر</h1>
  <p>دعم الأعضاء عبر التذاكر — في سيرفر <strong><%= guild.name %></strong></p>
</div>

<div class="stats-grid">
  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #5a9bff"><i class="fas fa-layer-group" aria-hidden="true"></i></div>
    <div class="stat-info">
      <span class="stat-value"><%= total %></span>
      <span class="stat-label">إجمالي التذاكر</span>
    </div>
  </div>
  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #57f287"><i class="fas fa-inbox" aria-hidden="true"></i></div>
    <div class="stat-info">
      <span class="stat-value"><%= oList.length %></span>
      <span class="stat-label">مفتوحة الآن</span>
    </div>
  </div>
  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #ed4245"><i class="fas fa-check-double" aria-hidden="true"></i></div>
    <div class="stat-info">
      <span class="stat-value"><%= cList.length %></span>
      <span class="stat-label">مغلقة</span>
    </div>
  </div>
  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: var(--nx-gold)"><i class="fas fa-star" aria-hidden="true"></i></div>
    <div class="stat-info">
      <span class="stat-value"><%= rated.length ? avg + '/' + 5 : '—' %></span>
      <span class="stat-label">متوسط التقييم (<%= rated.length %> تقييم)</span>
    </div>
  </div>
</div>

<div class="tk-progress card glass">
  <div class="tk-progress-info">
    <span><i class="fas fa-circle-check" style="color:#57f287"></i> مغلقة <strong><%= closedPct %>%</strong></span>
    <span><i class="fas fa-hourglass-half" style="color:#57f287"></i> مفتوحة <strong><%= total ? 100 - closedPct : 0 %>%</strong></span>
  </div>
  <div class="tk-bar"><div class="tk-bar-fill" style="width:<%= closedPct %>%"></div></div>
</div>

<div class="ticket-search">
  <i class="fas fa-search search-icon"></i>
  <input type="text" id="ticketSearch" placeholder="بحث برقم التذكرة، اسم العضو، المعرف، القسم، العنوان..."
         oninput="filterTickets()" class="search-input">
</div>

<div class="tabs">
  <button class="tab active" onclick="switchTab(this, 'open')"><i class="fas fa-inbox"></i> مفتوحة (<span id="openCount"><%= oList.length %></span>)</button>
  <button class="tab" onclick="switchTab(this, 'closed')"><i class="fas fa-folder-closed"></i> مغلقة (<span id="closedCount"><%= cList.length %></span>)</button>
</div>

<div class="tab-content active" id="tab-open">
  <div class="card glass">
    <div class="card-header"><h3><i class="fas fa-inbox"></i> التذاكر المفتوحة</h3></div>
    <div class="ticket-list" id="openList">
      <% if (oList.length > 0) { %>
        <% oList.forEach(t => { %>
          <div class="ticket-acc" data-search="<%= (t.ticketId+' '+t.username+' '+t.userId+' '+t.category+' '+(t.title||'')+' '+(t.claimedByUsername||'')).toLowerCase() %>">
            <div class="ticket-acc-header" onclick="toggleTicket(this)">
              <div class="ticket-acc-info">
                <span class="ticket-id">#<%= t.ticketId %></span>
                <span class="ticket-acc-user"><%= t.username || t.userId || '—' %></span>
                <span class="ticket-status open">مفتوحة</span>
                <span class="ticket-acc-cat"><i class="fas fa-folder"></i> <%= t.category || 'عام' %></span>
                <% if (t.claimedBy) { %>
                  <span class="ticket-acc-claimed"><i class="fas fa-headset"></i> <%= t.claimedByUsername || t.claimedBy %></span>
                <% } %>
              </div>
              <div class="ticket-acc-arrow"><i class="fas fa-chevron-down"></i></div>
            </div>
            <div class="ticket-acc-body">
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-folder"></i> القسم:</span>
                <span><%= t.category || '—' %></span>
              </div>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-user"></i> فتح التذكرة:</span>
                <span><%= t.username || '—' %> <code style="direction:ltr;display:inline-block"><%= t.userId || '' %></code></span>
              </div>
              <% if (t.claimedBy) { %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-headset"></i> مستلم التكت:</span>
                <span><%= t.claimedByUsername || '—' %> <code style="direction:ltr;display:inline-block"><%= t.claimedBy %></code></span>
              </div>
              <% } %>
              <% if (t.title) { %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-tag"></i> العنوان:</span>
                <span><%= t.title %></span>
              </div>
              <% } %>
              <% if (t.description) { %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-align-left"></i> الوصف:</span>
                <span><%= t.description.length > 200 ? t.description.slice(0,200)+'...' : t.description %></span>
              </div>
              <% } %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-clock"></i> تاريخ الفتح:</span>
                <span><%= new Date(t.openedAt || t.createdAt || Date.now()).toLocaleString('ar-SA') %></span>
              </div>
              <% if (t.lastActivity) { %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-exchange-alt"></i> آخر نشاط:</span>
                <span><%= new Date(t.lastActivity).toLocaleString('ar-SA') %></span>
              </div>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="empty-state"><i class="fas fa-check-circle" style="color:var(--success)"></i><p>لا توجد تذاكر مفتوحة</p></div>
      <% } %>
    </div>
  </div>
</div>

<div class="tab-content" id="tab-closed">
  <div class="card glass">
    <div class="card-header"><h3><i class="fas fa-folder-closed"></i> التذاكر المغلقة</h3></div>
    <div class="ticket-list" id="closedList">
      <% if (cList.length > 0) { %>
        <% cList.forEach(t => { %>
          <div class="ticket-acc closed" data-search="<%= (t.ticketId+' '+t.username+' '+t.userId+' '+t.category+' '+(t.title||'')+' '+(t.claimedByUsername||'')+' '+(t.rating||'')).toLowerCase() %>">
            <div class="ticket-acc-header" onclick="toggleTicket(this)">
              <div class="ticket-acc-info">
                <span class="ticket-id">#<%= t.ticketId %></span>
                <span class="ticket-acc-user"><%= t.username || t.userId || '—' %></span>
                <span class="ticket-status closed">مغلقة</span>
                <span class="ticket-acc-cat"><i class="fas fa-folder"></i> <%= t.category || 'عام' %></span>
                <% if (t.rating) { %>
                  <span class="ticket-acc-rating"><%= '⭐'.repeat(t.rating) %> <%= t.rating %>/5</span>
                <% } else { %>
                  <span class="ticket-acc-rating no-rate">غير مقيمة</span>
                <% } %>
                <% if (t.claimedBy) { %>
                  <span class="ticket-acc-claimed"><i class="fas fa-headset"></i> <%= t.claimedByUsername || t.claimedBy %></span>
                <% } %>
              </div>
              <div class="ticket-acc-arrow"><i class="fas fa-chevron-down"></i></div>
            </div>
            <div class="ticket-acc-body">
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-folder"></i> القسم:</span>
                <span><%= t.category || '—' %></span>
              </div>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-user"></i> فتح التذكرة:</span>
                <span><%= t.username || '—' %> <code style="direction:ltr;display:inline-block"><%= t.userId || '' %></code></span>
              </div>
              <% if (t.claimedBy) { %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-headset"></i> مستلم التكت:</span>
                <span><%= t.claimedByUsername || '—' %> <code style="direction:ltr;display:inline-block"><%= t.claimedBy %></code></span>
              </div>
              <% } %>
              <% if (t.closedBy) { %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-lock"></i> أغلق بواسطة:</span>
                <span><code style="direction:ltr;display:inline-block"><%= t.closedBy %></code></span>
              </div>
              <% } %>
              <% if (t.title) { %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-tag"></i> العنوان:</span>
                <span><%= t.title %></span>
              </div>
              <% } %>
              <% if (t.description) { %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-align-left"></i> الوصف:</span>
                <span><%= t.description.length > 200 ? t.description.slice(0,200)+'...' : t.description %></span>
              </div>
              <% } %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-play-circle"></i> الفتح:</span>
                <span><%= new Date(t.openedAt || t.createdAt || Date.now()).toLocaleString('ar-SA') %></span>
              </div>
              <% if (t.closedAt) { %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-stop-circle"></i> الإغلاق:</span>
                <span><%= new Date(t.closedAt).toLocaleString('ar-SA') %></span>
              </div>
              <% } %>
              <% if (t.rating) { %>
              <div class="ticket-acc-row">
                <span class="ticket-label"><i class="fas fa-star"></i> التقييم:</span>
                <span><%= '⭐'.repeat(t.rating) %> <%= t.rating %>/5 <% if (t.ratedBy) { %>— <code style="direction:ltr;display:inline-block"><%= t.ratedBy %></code><% } %></span>
              </div>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="empty-state"><i class="fas fa-inbox"></i><p>لا توجد تذاكر مغلقة</p></div>
      <% } %>
    </div>
  </div>
</div>

<style>
.ticket-search { margin-bottom: 16px; position: relative; max-width: 560px; }
.search-input {
  width: 100%; padding: 13px 16px 13px 44px;
  border-radius: 12px; border: 1px solid var(--nx-line, rgba(255,255,255,.09));
  background: rgba(255,255,255,.03); color: var(--text, #eee);
  font-size: .92rem; outline: none; box-sizing: border-box;
  transition: border-color .18s var(--nx-ease, ease), box-shadow .18s var(--nx-ease, ease);
}
.search-input:focus {
  border-color: var(--primary, #a855f7);
  box-shadow: 0 0 0 3px rgba(168,85,247,.18);
}
.search-icon { position: absolute; inset-inline-start: 15px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: .95rem; z-index: 1; }

.tk-progress { padding: 16px 20px; display: flex; flex-direction: column; gap: 10px; }
.tk-progress-info { display: flex; gap: 20px; font-size: .82rem; color: var(--text-muted); }
.tk-progress-info strong { color: var(--text); }
.tk-bar { height: 8px; border-radius: 20px; background: rgba(255,255,255,.05); overflow: hidden; }
.tk-bar-fill { height: 100%; border-radius: 20px; background: linear-gradient(90deg, #57f287, #2ecc71); transition: width .5s ease; }

.ticket-acc {
  background: rgba(255,255,255,.02);
  border: 1px solid var(--nx-line, rgba(255,255,255,.08));
  border-radius: 12px; margin-bottom: 9px; overflow: hidden;
  transition: border-color .18s var(--nx-ease, ease), background .18s var(--nx-ease, ease);
}
.ticket-acc:hover { border-color: rgba(168,85,247,.45); }
.ticket-acc.closed { opacity: .78; }
.ticket-acc.closed .ticket-id { color: var(--text-muted); }
.ticket-acc-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 13px 16px; cursor: pointer; user-select: none; gap: 8px;
}
.ticket-acc-header:hover { background: rgba(168,85,247,.05); }
.ticket-acc-info { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; flex: 1; min-width: 0; }
.ticket-acc-user { font-size: .9rem; color: var(--text, #eee); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 180px; }
.ticket-acc-cat { font-size: .74rem; color: var(--text-muted); background: rgba(255,255,255,.04); padding: 2px 9px; border-radius: 20px; white-space: nowrap; }
.ticket-acc-claimed { font-size: .78rem; color: var(--text-muted); display: flex; align-items: center; gap: 5px; }
.ticket-acc-claimed i { color: var(--primary); }
.ticket-acc-rating { font-size: .82rem; color: var(--nx-gold, #ffcc4d); }
.ticket-acc-rating.no-rate { color: var(--text-muted); font-size: .72rem; }
.ticket-acc-arrow { color: var(--text-muted); transition: transform .2s ease; font-size: .8rem; }
.ticket-acc.open .ticket-acc-arrow { transform: rotate(180deg); }
.ticket-acc-body { display: none; padding: 12px 16px 16px; border-top: 1px solid var(--nx-line, rgba(255,255,255,.07)); }
.ticket-acc.open .ticket-acc-body { display: block; }
.ticket-acc-row { display: flex; align-items: flex-start; gap: 8px; font-size: .88rem; padding: 4px 0; flex-wrap: wrap; }
.ticket-acc-row .ticket-label { color: var(--text-muted); min-width: 110px; display: flex; align-items: center; gap: 5px; font-size: .82rem; flex-shrink: 0; }
.ticket-label i { width: 16px; text-align: center; }
.ticket-id { font-weight: 700; font-size: 1rem; color: var(--primary, #a855f7); direction: ltr; display: inline-block; white-space: nowrap; }
.ticket-status { font-size: .68rem; padding: 2px 11px; border-radius: 20px; font-weight: 700; white-space: nowrap; }
.ticket-status.open { background: rgba(46,204,113,.14); color: #2ecc71; border: 1px solid rgba(46,204,113,.3); }
.ticket-status.closed { background: rgba(231,76,60,.14); color: #e74c3c; border: 1px solid rgba(231,76,60,.3); }
.ticket-acc code { background: rgba(255,255,255,.06); padding: 1px 6px; border-radius: 5px; font-size: .78rem; color: var(--text-muted); }
</style>

<script>
function switchTab(btn, tab) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('tab-' + tab).classList.add('active');
}

function toggleTicket(header) {
  const acc = header.parentElement;
  acc.classList.toggle('open');
  const arrow = header.querySelector('.ticket-acc-arrow i');
  if (arrow) arrow.style.transform = acc.classList.contains('open') ? 'rotate(180deg)' : '';
}

function filterTickets() {
  const q = document.getElementById('ticketSearch').value.toLowerCase().trim();
  document.querySelectorAll('.ticket-acc').forEach(el => {
    const data = el.getAttribute('data-search') || '';
    el.style.display = !q || data.includes(q) ? '' : 'none';
  });
  ['open', 'closed'].forEach(tab => {
    const list = document.getElementById(tab + 'List');
    if (!list) return;
    const visible = Array.from(list.querySelectorAll('.ticket-acc')).filter(el => el.style.display !== 'none').length;
    const countEl = document.getElementById(tab === 'open' ? 'openCount' : 'closedCount');
    if (countEl) countEl.textContent = visible;
    const empty = list.querySelector('.empty-state');
    if (empty) empty.style.display = visible > 0 ? 'none' : '';
  });
}
</script>
<% currentPage = 'tickets' %>
<div class="page-header">
  <h1><i class="fas fa-ticket-alt"></i> إدارة التذاكر — <%= guild.name %></h1>
  <p>إجمالي التذاكر: <%= ticketCount %></p>
</div>

<div class="tabs">
  <button class="tab active" onclick="switchTab(this, 'open')">مفتوحة (<%= tickets.open?.length || 0 %>)</button>
  <button class="tab" onclick="switchTab(this, 'closed')">مغلقة (<%= tickets.closed?.length || 0 %>)</button>
</div>

<div class="tab-content active" id="tab-open">
  <div class="card glass">
    <div class="card-header"><h3>📩 التذاكر المفتوحة</h3></div>
    <div class="ticket-list">
      <% if (tickets.open && tickets.open.length > 0) { %>
        <% tickets.open.forEach(t => { %>
          <div class="ticket-card">
            <div class="ticket-top">
              <span class="ticket-id">#<%= t.ticketId %></span>
              <span class="ticket-status open">مفتوحة</span>
            </div>
            <div class="ticket-body">
              <div class="ticket-row">
                <span class="ticket-label"><i class="fas fa-folder"></i> القسم:</span>
                <span><%= t.category || '—' %></span>
              </div>
              <div class="ticket-row">
                <span class="ticket-label"><i class="fas fa-user"></i> فتح التذكرة:</span>
                <span><%= t.username || t.userId || '—' %></span>
              </div>
              <% if (t.claimedBy) { %>
              <div class="ticket-row">
                <span class="ticket-label"><i class="fas fa-headset"></i> مستلم التكت:</span>
                <span><%= t.claimedByUsername || t.claimedBy %></span>
              </div>
              <% } %>
              <% if (t.title) { %>
              <div class="ticket-row">
                <span class="ticket-label"><i class="fas fa-tag"></i> العنوان:</span>
                <span><%= t.title %></span>
              </div>
              <% } %>
              <div class="ticket-row">
                <span class="ticket-label"><i class="fas fa-clock"></i> الفتح:</span>
                <span><%= new Date(t.openedAt || t.createdAt || Date.now()).toLocaleString('ar-SA') %></span>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="empty-state">
          <i class="fas fa-check-circle" style="color:var(--success)"></i>
          <p>لا توجد تذاكر مفتوحة</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<div class="tab-content" id="tab-closed">
  <div class="card glass">
    <div class="card-header"><h3>📁 التذاكر المغلقة</h3></div>
    <div class="ticket-list">
      <% if (tickets.closed && tickets.closed.length > 0) { %>
        <% tickets.closed.forEach(t => { %>
          <div class="ticket-card closed">
            <div class="ticket-top">
              <span class="ticket-id">#<%= t.ticketId %></span>
              <span class="ticket-status closed">مغلقة</span>
              <% if (t.rating) { %>
                <span class="ticket-rating"><%= '⭐'.repeat(t.rating) %> <%= t.rating %>/5</span>
              <% } else { %>
                <span class="ticket-rating no-rate">غير مقيمة</span>
              <% } %>
            </div>
            <div class="ticket-body">
              <div class="ticket-row">
                <span class="ticket-label"><i class="fas fa-folder"></i> القسم:</span>
                <span><%= t.category || '—' %></span>
              </div>
              <div class="ticket-row">
                <span class="ticket-label"><i class="fas fa-user"></i> فتح التذكرة:</span>
                <span><%= t.username || t.userId || '—' %></span>
              </div>
              <% if (t.claimedBy) { %>
              <div class="ticket-row">
                <span class="ticket-label"><i class="fas fa-headset"></i> مستلم التكت:</span>
                <span><%= t.claimedByUsername || t.claimedBy %></span>
              </div>
              <% } %>
              <% if (t.closedBy) { %>
              <div class="ticket-row">
                <span class="ticket-label"><i class="fas fa-lock"></i> أغلق بواسطة:</span>
                <span><%= t.closedBy %></span>
              </div>
              <% } %>
              <% if (t.title) { %>
              <div class="ticket-row">
                <span class="ticket-label"><i class="fas fa-tag"></i> العنوان:</span>
                <span><%= t.title %></span>
              </div>
              <% } %>
              <div class="ticket-row">
                <span class="ticket-label"><i class="fas fa-play-circle"></i> الفتح:</span>
                <span><%= new Date(t.openedAt || t.createdAt || Date.now()).toLocaleString('ar-SA') %></span>
              </div>
              <% if (t.closedAt) { %>
              <div class="ticket-row">
                <span class="ticket-label"><i class="fas fa-stop-circle"></i> الإغلاق:</span>
                <span><%= new Date(t.closedAt).toLocaleString('ar-SA') %></span>
              </div>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="empty-state">
          <i class="fas fa-inbox"></i>
          <p>لا توجد تذاكر مغلقة</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<style>
.ticket-card {
  background: var(--bg-secondary, #1e1e2e);
  border: 1px solid var(--border-color, #2a2a3e);
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  transition: all 0.2s;
}
.ticket-card:hover {
  border-color: var(--accent, #5865f2);
  box-shadow: 0 2px 12px rgba(88, 101, 242, 0.15);
}
.ticket-card.closed {
  opacity: 0.85;
}
.ticket-top {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
  flex-wrap: wrap;
}
.ticket-id {
  font-weight: 700;
  font-size: 1.1rem;
  color: var(--accent, #5865f2);
  direction: ltr;
  display: inline-block;
}
.ticket-status {
  font-size: 0.75rem;
  padding: 2px 10px;
  border-radius: 20px;
  font-weight: 600;
}
.ticket-status.open {
  background: rgba(46, 204, 113, 0.15);
  color: #2ecc71;
  border: 1px solid rgba(46, 204, 113, 0.3);
}
.ticket-status.closed {
  background: rgba(231, 76, 60, 0.15);
  color: #e74c3c;
  border: 1px solid rgba(231, 76, 60, 0.3);
}
.ticket-rating {
  font-size: 0.85rem;
  margin-right: auto;
}
.ticket-rating.no-rate {
  color: var(--text-muted, #666);
  font-size: 0.75rem;
}
.ticket-body {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.ticket-row {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.9rem;
  flex-wrap: wrap;
}
.ticket-label {
  color: var(--text-muted, #888);
  min-width: 110px;
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 0.85rem;
}
.ticket-label i {
  width: 16px;
  text-align: center;
}
</style>

<script>
function switchTab(btn, tab) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('tab-' + tab).classList.add('active');
}
</script>
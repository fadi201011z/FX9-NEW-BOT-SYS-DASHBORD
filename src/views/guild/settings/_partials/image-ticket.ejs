      <!-- صورة بنل التذاكر -->
      <div class="stat-voice-item item-lg-general ci-stack" data-for="ticket_panel_image">
        <div class="ci-head">
        <div class="stat-voice-icon"><i class="fas fa-ticket-alt"></i></div>
        <div class="stat-voice-info">
          <strong>صورة بنل التذاكر</strong>
          <small>الصورة العلوية لبنل فتح التذاكر — أول ما يراه العضو قبل فتح التذكرة</small>
        </div>
        </div>
        <div class="ci-mode" data-ci-mode-group="ticket_panel_image" role="tablist" aria-label="طريقة العرض: صورة أم امبد">
          <button type="button" class="ci-mode-btn is-active" data-ci-set-mode="ticket_panel_image" data-ci-mode="image" role="tab" aria-selected="true"><i class="fas fa-image" aria-hidden="true"></i> صورة</button>
          <button type="button" class="ci-mode-btn" data-ci-set-mode="ticket_panel_image" data-ci-mode="embed" role="tab" aria-selected="false"><i class="fas fa-rectangle-ad" aria-hidden="true"></i> امبد</button>
        </div>
        <div class="ci-pane ci-pane-image" data-ci-pane="ticket_panel_image" data-ci-kind="image">
        <div class="custom-img-body">
          <div class="custom-img-preview" id="preview-ticket_panel_image">
            <i class="fas fa-image preview-ph"></i>
          </div>
          <div class="custom-img-controls">
            <label class="img-upload-btn">
              <i class="fas fa-upload"></i> رفع صورة
              <input type="file" accept="image/*" hidden data-img-key="ticket_panel_image" />
            </label>
            <input type="text" class="ticket-select img-url-input" data-img-url="ticket_panel_image" placeholder="أو ألصق رابط صورة مباشر https://..." />
            <div class="img-actions">
              <button type="button" class="btn-sm btn-save-img" data-img-save="ticket_panel_image"><i class="fas fa-save"></i> حفظ</button>
              <button type="button" class="btn-sm btn-view-img" data-img-view="ticket_panel_image" title="عرض الصورة الحالية"><i class="fas fa-eye"></i> عرض الصورة الحالية</button>
              <button type="button" class="btn-delete-sm" data-img-delete="ticket_panel_image" title="استعادة الصورة الافتراضية"><i class="fas fa-trash"></i></button>
              <span class="ticket-field-state" data-state-of="ticket_panel_image"><i class="fas fa-check-circle"></i><span>افتراضي</span></span>
            </div>
          </div>
        </div>
        </div>

        <div class="ci-pane ci-pane-embed" data-ci-pane="ticket_panel_image" data-ci-kind="embed" hidden>

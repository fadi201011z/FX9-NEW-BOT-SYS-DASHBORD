            <div class="em-preview ci-embed-preview" data-ci-preview="ticket_panel_image"></div>
            <div class="ci-embed-actions">
              <button type="button" class="btn-save-img" data-ci-edit="ticket_panel_image"><i class="fas fa-pen-ruler" aria-hidden="true"></i> تخصيص الإمبد</button>
              <span class="ci-embed-state" data-ci-state="ticket_panel_image">لا يوجد امبد بعد — اضغط «تخصيص الإمبد»</span>
            </div>
          </div>

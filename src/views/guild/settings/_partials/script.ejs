<script>
/*
 * يجمع إعدادات هذه الصفحة وحدها.
 *
 * The form used to be one page carrying every card, so this function built its
 * payload from a fixed list of eleven keys and wrote an empty string for every
 * key whose element was not on the page. Now that each card is a page of its
 * own, that empty string is a deletion: POST /:guildId/save writes every key it
 * receives, so a page that sent forty keys with thirty-nine of them blank would
 * wipe the other pages' settings the first time anyone pressed save.
 *
 * The payload is therefore read from the page instead of from a list: every
 * [data-key] input that is actually here, and nothing else. A page cannot send
 * a key it does not show, which is the guarantee the whole split rests on.
 */
function collectSettings() {
  const data = {};
  document.querySelectorAll('[data-key]').forEach(el => {
    if (el.dataset.key) data[el.dataset.key] = el.value;
  });
  const sr = document.getElementById('supportRoleState');
  if (sr) data.support_role = sr.value;
  return data;
}

// ─── Professional support-role picker ──────────────────────────────────────

const SUPPORT_ROLES = <%- JSON.stringify((roles || []).filter(r => r.name !== '@everyone' && !r.managed)).replace(/</g, '\\u003c') %>;
const selectedSupport = new Set();

function initSupport() {
  if (!document.getElementById('supportRoleState')) return;
  document.querySelectorAll('.role-item.selected').forEach(b => selectedSupport.add(b.dataset.roleId));
  syncSupportState();
}

function toggleSupportRole(btn) {
  const id = btn.dataset.roleId;
  if (selectedSupport.has(id)) {
    selectedSupport.delete(id);
    btn.classList.remove('selected');
  } else {
    selectedSupport.add(id);
    btn.classList.add('selected');
  }
  syncSupportState();
  const r = SUPPORT_ROLES.find(x => x.id === id);
  showToast((r ? r.name : 'الرتبة') + (selectedSupport.has(id) ? ' أُضيفت لفريق الدعم ✅' : ' أُزيلت من فريق الدعم'), 'success');
}

function syncSupportState() {
  document.getElementById('supportRoleState').value = [...selectedSupport].join(',');

  document.getElementById('supportRolesStat').textContent = selectedSupport.size;
  document.getElementById('supportCountBadge').textContent = selectedSupport.size + ' رتب';

  let members = 0;
  selectedSupport.forEach(id => {
    const r = SUPPORT_ROLES.find(x => x.id === id);
    if (r && r.members_count) members += r.members_count;
  });
  document.getElementById('supportMembersStat').textContent = members;

  const wrap = document.getElementById('selectedSupportChips');
  wrap.innerHTML = '';
  selectedSupport.forEach(id => {
    const r = SUPPORT_ROLES.find(x => x.id === id);
    const name = r ? r.name : id;
    const color = r ? (r.color || 0) : 0;
    const chip = document.createElement('span');
    chip.className = 'chip';
    chip.innerHTML =
      '<span class="chip-dot" style="background-color:#' + color.toString(16).padStart(6, '0') + '"></span>' +
      '<span class="chip-name"></span>' +
      '<button type="button" class="chip-x" title="إزالة"><i class="fas fa-times"></i></button>';
    chip.querySelector('.chip-name').textContent = name;
    chip.querySelector('.chip-x').onclick = (ev) => {
      ev.stopPropagation();
      removeSupportRole(id);
    };
    wrap.appendChild(chip);
  });

  document.getElementById('visibleRoleCount').textContent = document.querySelectorAll('.role-item:not(.hidden)').length;
}

function removeSupportRole(id) {
  selectedSupport.delete(id);
  const btn = document.querySelector('.role-item[data-role-id="' + id + '"]');
  if (btn) btn.classList.remove('selected');
  syncSupportState();
}

function filterSupportRoles(q) {
  const query = q.toLowerCase();
  let visible = 0;
  document.querySelectorAll('.role-item').forEach(b => {
    const show = !query || b.dataset.roleName.toLowerCase().includes(query);
    b.classList.toggle('hidden', !show);
    if (show) visible++;
  });
  document.getElementById('visibleRoleCount').textContent = visible;
}

function stepCounter(d) {
  const el = document.getElementById('ticketCounterInput');
  el.value = Math.max(0, (parseInt(el.value, 10) || 0) + d);
}

// ─── Ticket system status ───────────────────────────────────────────────────

function updateTicketStatus() {
  if (!document.getElementById('ticketStatusBadge')) return;
  const checks = ['panel_channel', 'log_channel_id', 'ticket_category', 'admin_category'];
  let done = 0;
  checks.forEach(key => {
    const sel = document.querySelector('[data-key="' + key + '"]');
    const isSet = sel && sel.value;
    const step = document.querySelector('.ticket-progress-item[data-for="' + key + '"]');
    if (step) step.classList.toggle('done', !!isSet);
    const state = document.querySelector('.ticket-field-state[data-state-of="' + key + '"]');
    if (state) {
      state.classList.toggle('on', !!isSet);
      state.querySelector('span').textContent = isSet ? 'مضبوط' : 'غير مضبوط';
    }
    if (isSet) done++;
  });

  const badge = document.getElementById('ticketStatusBadge');
  const text = document.getElementById('ticketStatusText');
  if (done === 4) {
    badge.className = 'ticket-status ready';
    text.textContent = 'جاهز بالكامل';
  } else if (done > 0) {
    badge.className = 'ticket-status partial';
    text.textContent = done + ' من 4 مضبوطة';
  } else {
    badge.className = 'ticket-status empty';
    text.textContent = 'غير مضبوط';
  }
}

document.querySelectorAll('.ticket-select').forEach(el => el.addEventListener('change', updateTicketStatus));
updateTicketStatus();

// ─── Voice stats status ─────────────────────────────────────────────────────

function updateVoiceStatus() {
  if (!document.getElementById('statsStatusBadge')) return;
  const keys = ['stats_total', 'stats_online', 'stats_bots'];
  let done = 0;
  keys.forEach(key => {
    const sel = document.querySelector('[data-key="' + key + '"]');
    const isSet = sel && sel.value;
    const item = document.querySelector('.voice-grid [data-for="' + key + '"]');
    if (item) item.classList.toggle('done', !!isSet);
    const st = document.querySelector('.ticket-field-state[data-state-of="' + key + '"]');
    if (st) {
      st.classList.toggle('on', !!isSet);
      st.querySelector('span').textContent = isSet ? 'مضبوط' : 'غير مضبوط';
    }
    if (isSet) done++;
  });

  const badge = document.getElementById('statsStatusBadge');
  const text = document.getElementById('statsStatusText');
  if (done === 3) {
    badge.className = 'ticket-status ready';
    text.textContent = 'مفعل بالكامل';
  } else if (done > 0) {
    badge.className = 'ticket-status partial';
    text.textContent = done + ' من 3 مضبوطة';
  } else {
    badge.className = 'ticket-status empty';
    text.textContent = 'غير مضبوط';
  }
}

document.querySelectorAll('.voice-grid select').forEach(el => el.addEventListener('change', updateVoiceStatus));
updateVoiceStatus();

// ─── Log channels status ────────────────────────────────────────────────────

function updateLogStatus() {
  if (!document.getElementById('logStatusBadge')) return;
  const keys = ['log_channel', 'modlog_channel', 'botlog_channel'];
  let done = 0;
  keys.forEach(key => {
    const sel = document.querySelector('[data-key="' + key + '"]');
    const isSet = sel && sel.value;
    const item = document.querySelector('.log-grid [data-for="' + key + '"]');
    if (item) item.classList.toggle('done', !!isSet);
    const st = document.querySelector('.ticket-field-state[data-state-of="' + key + '"]');
    if (st) {
      st.classList.toggle('on', !!isSet);
      st.querySelector('span').textContent = isSet ? 'مضبوط' : 'غير مضبوط';
    }
    if (isSet) done++;
  });

  const badge = document.getElementById('logStatusBadge');
  const text = document.getElementById('logStatusText');
  if (done === 3) {
    badge.className = 'ticket-status ready';
    text.textContent = 'مفعل بالكامل';
  } else if (done > 0) {
    badge.className = 'ticket-status partial';
    text.textContent = done + ' من 3 مضبوطة';
  } else {
    badge.className = 'ticket-status empty';
    text.textContent = 'غير مضبوط';
  }
}

document.querySelectorAll('.log-grid select').forEach(el => el.addEventListener('change', updateLogStatus));
updateLogStatus();

// ─── Welcome status ─────────────────────────────────────────────────────────

function updateWelcomeStatus() {
  if (!document.getElementById('welcomeStatusBadge')) return;
  const sel = document.querySelector('[data-key="welcome_channel"]');
  const isSet = sel && sel.value;
  const item = document.querySelector('.welcome-card [data-for="welcome_channel"]');
  if (item) item.classList.toggle('done', !!isSet);
  const st = document.querySelector('.ticket-field-state[data-state-of="welcome_channel"]');
  if (st) {
    st.classList.toggle('on', !!isSet);
    st.querySelector('span').textContent = isSet ? 'مضبوط' : 'غير مضبوط';
  }

  const badge = document.getElementById('welcomeStatusBadge');
  const text = document.getElementById('welcomeStatusText');
  if (isSet) {
    badge.className = 'ticket-status ready';
    text.textContent = 'مفعل';
  } else {
    badge.className = 'ticket-status empty';
    text.textContent = 'غير مضبوط';
  }
}

document.querySelectorAll('.welcome-card select').forEach(el => el.addEventListener('change', updateWelcomeStatus));
updateWelcomeStatus();

initSupport();

function updateSyncUi(ok, msg) {
  const el = document.getElementById('syncStatus');
  if (!el) return;
  if (ok === true) { el.className = 'sync-ok'; el.innerHTML = '<i class="fas fa-check-circle"></i> متزامن مع البوت الآن'; }
  else if (ok === false) { el.className = 'sync-warn'; el.innerHTML = '<i class="fas fa-circle"></i> البوت غير متصل — ستُطبق الإعدادات تلقائياً خلال ثوانٍ'; }
  else if (msg) { el.innerHTML = '<i class="fas fa-circle"></i> ' + msg; el.className = 'sync-idle'; }
}

async function saveSettings(e) {
  e.preventDefault();
  /* The two pages that only point elsewhere (الإعدادات العامة, أنظمة أخرى)
     carry no save button and nothing to save. Their form cannot be submitted
     with a value in it, but Enter in a stray field would still land here, so
     the button is treated as the optional thing it now is. */
  const btn = document.getElementById('saveBtn');
  const orig = btn ? btn.innerHTML : '';
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جارٍ الحفظ...'; }
  try {
    const res = await fetch('/settings/<%= guild.id %>/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ settings: collectSettings() }),
    });
    const data = await res.json();
    if (res.ok && data.success) {
      showToast('✅ تم حفظ الإعدادات' + (data.synced ? ' — مزامنة فورية مع البوت' : ' — ستُطبَّق تلقائياً خلال ثوانٍ'), 'success');
      updateSyncUi(data.synced);
    } else {
      showToast('❌ ' + (data.error || 'فشل الحفظ'), 'error');
    }
  } catch (err) {
    showToast('❌ حدث خطأ في الاتصال', 'error');
  } finally {
    if (btn) { btn.disabled = false; btn.innerHTML = orig; }
  }
}

async function syncNow() {
  const el = document.getElementById('syncStatus');
  el.className = 'sync-idle';
  el.innerHTML = '<i class="fas fa-sync-alt fa-spin"></i> جارٍ المزامنة...';
  try {
    const res = await fetch('/settings/<%= guild.id %>/sync', { method: 'POST' });
    const data = await res.json();
    updateSyncUi(data.success);
    showToast(data.message, data.success ? 'success' : 'warning');
  } catch {
    updateSyncUi(false);
    showToast('لا يمكن الوصول للبوت — مزامنة تلقائية خلال ثوانٍ', 'warning');
  }
}

async function deleteSetting(key) {
  if (!confirm('هل تريد إلغاء هذا الإعداد؟')) return;
  const res = await fetch('/settings/<%= guild.id %>/delete', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ key }),
  });
  if (res.ok) {
    showToast('✅ تم إلغاء الإعداد');
    setTimeout(() => location.reload(), 900);
  } else {
    showToast('❌ فشل الحذف', 'error');
  }
}

// ─── Custom Images (welcome / ticket / voice) ───────────────────────────────

const CUSTOM_IMAGES = ['welcome_image', 'ticket_panel_image', 'voice_panel_image'];

function imgIsDataUri(v) { return typeof v === 'string' && v.startsWith('data:image/'); }
function imgIsUrl(v) { return typeof v === 'string' && /^https?:\/\//i.test(v); }

function setImagePreview(key, value) {
  if (key === 'welcome_image') waSetImage(value);
  const prev = document.getElementById('preview-' + key);
  if (!prev) return;
  prev.innerHTML = '';
  if (imgIsDataUri(value) || imgIsUrl(value)) {
    const img = document.createElement('img');
    img.src = value;
    img.alt = '';
    img.onload = () => {
      prev.querySelectorAll('img').forEach(i => i.style.display = 'block');
    };
    img.onerror = () => {
      img.style.display = 'none';
      const ph = document.createElement('i');
      ph.className = 'fas fa-image preview-ph';
      prev.appendChild(ph);
    };
    prev.appendChild(img);
    img.style.display = 'none';
  } else {
    const ph = document.createElement('i');
    ph.className = 'fas fa-image preview-ph';
    prev.appendChild(ph);
  }
}

function setImageState(key, has) {
  const st = document.querySelector('.ticket-field-state[data-state-of="' + key + '"]');
  if (st) {
    st.classList.toggle('on', !!has);
    st.querySelector('span').textContent = has ? 'مخصص' : 'افتراضي';
  }
  const item = document.querySelector('.custom-images-grid [data-for="' + key + '"]');
  if (item) item.classList.toggle('done', !!has);
}

function updateImagesBadge() {
  if (!document.getElementById('imagesStatusBadge')) return;
  let done = 0;
  CUSTOM_IMAGES.forEach(key => {
    const url = document.querySelector('[data-img-url="' + key + '"]');
    // يُحتسب العنصر مخصّصاً إذا كانت له صورة أو إمبد محفوظ.
    if ((url && url.value.trim()) || customEmbeds[key]) done++;
  });
  const badge = document.getElementById('imagesStatusBadge');
  const text = document.getElementById('imagesStatusText');
  if (done === 3) {
    badge.className = 'ticket-status ready';
    text.textContent = 'جميع العناصر مخصصة';
  } else if (done > 0) {
    badge.className = 'ticket-status partial';
    text.textContent = done + ' من 3 مخصصة';
  } else {
    badge.className = 'ticket-status empty';
    text.textContent = 'الافتراضية';
  }
}

async function saveCustomImage(key, value) {
  const btn = document.querySelector('[data-img-save="' + key + '"]');
  const orig = btn ? btn.innerHTML : '';
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جارٍ الحفظ...'; }
  try {
    const res = await fetch('/settings/<%= guild.id %>/images', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ key, value: value || '' }),
    });
    const data = await res.json();
    if (res.ok && data.success) {
      customImageValues[key] = value || '';
      setImagePreview(key, value || '');
      setImageState(key, !!value);
      showToast('✅ تم حفظ الصورة' + (data.refreshed ? ' — البنلات حُدّثت فوراً' : ' — ستُطبَّق قريباً'), 'success');
    } else {
      showToast('❌ ' + (data.error || 'فشل الحفظ'), 'error');
    }
  } catch {
    showToast('❌ حدث خطأ في الاتصال', 'error');
  } finally {
    if (btn) { btn.disabled = false; btn.innerHTML = orig; }
    updateImagesBadge();
  }
}

function setUploadBusy(input, busy) {
  const label = input && input.closest('.img-upload-btn');
  if (label) label.classList.toggle('is-uploading', !!busy);
}

// يرفع الملف إلى موقع الصور (بدون base64) ثم يحفظ الرابط المُعاد فقط.
async function uploadCustomImage(key, file, input) {
  setUploadBusy(input, true);
  showToast('جارٍ رفع الصورة إلى الموقع...', 'info');
  try {
    const res = await fetch('/settings/<%= guild.id %>/images/upload', {
      method: 'POST',
      headers: { 'Content-Type': file.type || 'application/octet-stream' },
      body: file,
    });
    let data = {};
    try { data = await res.json(); } catch {}
    if (!res.ok || !data.success || !data.url) {
      showToast(data.error || 'فشل رفع الصورة إلى الموقع', 'error');
      return;
    }
    const urlInput = document.querySelector('[data-img-url="' + key + '"]');
    if (urlInput) urlInput.value = data.url;
    await saveCustomImage(key, data.url);
  } catch {
    showToast('تعذّر الاتصال بموقع رفع الصور — تحقق من الشبكة', 'error');
  } finally {
    setUploadBusy(input, false);
  }
}

function initCustomImages() {
  if (!document.querySelector('[data-img-key]')) return;
  fetch('/settings/<%= guild.id %>/images')
    .then(r => r.json())
    .then(data => {
      if (!data.success) return;
      CUSTOM_IMAGES.forEach(key => {
        const val = data.images[key] || '';
        customImageValues[key] = val;
        setImagePreview(key, val);
        setImageState(key, !!val);
        const url = document.querySelector('[data-img-url="' + key + '"]');
        if (url && imgIsUrl(val)) url.value = val;

        customEmbeds[key] = (data.embeds && data.embeds[key]) || null;
        ciRenderItem(key);
        ciApplyMode(key, (data.modes && data.modes[key]) === 'embed' ? 'embed' : 'image');
      });
      updateImagesBadge();
    })
    .catch(() => {});

  document.querySelectorAll('input[type=file][data-img-key]').forEach(input => {
    input.addEventListener('change', () => {
      const key = input.dataset.imgKey;
      const file = input.files[0];
      input.value = ''; // يسمح بإعادة اختيار الملف نفسه لاحقاً
      if (!file) return;
      if (!/^image\/(png|jpe?g|gif|webp)$/i.test(file.type)) {
        showToast('صيغة غير مدعومة — المسموح: PNG / JPG / GIF / WEBP', 'warning');
        return;
      }
      if (file.size > 8 * 1024 * 1024) {
        showToast('حجم الصورة كبير جداً (الحد 8MB)', 'warning');
        return;
      }
      uploadCustomImage(key, file, input);
    });
  });

  document.querySelectorAll('[data-img-save]').forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.imgSave;
      const url = document.querySelector('[data-img-url="' + key + '"]');
      saveCustomImage(key, url ? url.value.trim() : '');
    });
  });

  document.querySelectorAll('[data-img-delete]').forEach(btn => {
    btn.addEventListener('click', async () => {
      const key = btn.dataset.imgDelete;
      if (!confirm('هل تريد استعادة الصورة الافتراضية لهذا العنصر؟')) return;
      const url = document.querySelector('[data-img-url="' + key + '"]');
      if (url) url.value = '';
      await saveCustomImage(key, '');
    });
  });

  // مبدّل «صورة / امبد» وزر تخصيص الإمبد لكل عنصر
  document.querySelectorAll('[data-ci-set-mode]').forEach(btn => {
    btn.addEventListener('click', () => ciSetMode(btn.dataset.ciSetMode, btn.dataset.ciMode));
  });
  document.querySelectorAll('[data-ci-edit]').forEach(btn => {
    btn.addEventListener('click', () => ciOpenEditor(btn.dataset.ciEdit));
  });
}

// ─── صورة / امبد: حالة وواجهة ───────────────────────────────────────────────

const CUSTOM_MODE_VALUES = ['image', 'embed'];

// وصف كل عنصر + قيم نموذجية للمتغيّرات تُستخدم في المعاينة فقط.
const GUILD_NAME = <%- JSON.stringify(guild.name) %>;
const CI_ITEMS = {
  welcome_image: {
    label: 'رسالة الترحيب',
    sample: { user: 'اسم العضو', mention: '@العضو', tag: 'اسم العضو#0000', server: GUILD_NAME, count: '128' },
  },
  ticket_panel_image: { label: 'بنل التذاكر', sample: {} },
  voice_panel_image: { label: 'بنل الصوتيات', sample: { count: '3' } },
};

const customImageValues = {};
const customModes = {};
const customEmbeds = {};

function ciEsc(t) {
  return String(t == null ? '' : t).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}
function ciNl2br(t) { return ciEsc(t).replace(/\n/g, '<br>'); }
function ciSafeUrl(u) { return /^https?:\/\//i.test(u || '') ? ciEsc(u) : ''; }

// يستبدل {user} و{mention} ... بقيم نموذجية ليظهر أثرها في المعاينة.
function ciFill(text, key) {
  const sample = (CI_ITEMS[key] && CI_ITEMS[key].sample) || {};
  return String(text == null ? '' : text).replace(/\{(user|mention|tag|server|count)\}/gi, (m, name) => {
    const v = sample[name.toLowerCase()];
    return v === undefined ? m : v;
  });
}

function ciPhHintText(key) {
  if (key === 'welcome_image') return 'يدعم المتغيّرات: <code>{user}</code> اسم العضو، <code>{mention}</code> منشن، <code>{tag}</code> الوسم، <code>{server}</code> اسم السيرفر، <code>{count}</code> عدد الأعضاء';
  if (key === 'voice_panel_image') return 'يدعم المتغيّر: <code>{count}</code> عدد الغرف الصوتية النشطة';
  return '';
}

/** HTML لمعاينة الإمبد بأسلوب ديسكورد (يُستخدم داخل البطاقة وفي النافذة). */
function ciPreviewHtml(cfg, key) {
  if (!cfg) return '';
  const color = /^#[0-9a-f]{6}$/i.test(cfg.color || '') ? cfg.color : '#d000ff';
  const authorName = ciFill(cfg.authorName, key);
  const authorIcon = /^https?:\/\//i.test(cfg.authorIcon || '') ? ciEsc(cfg.authorIcon) : '';
  const title = ciFill(cfg.title, key);
  const desc = cfg.description ? ciFill(cfg.description, key) : '';
  const image = /^https?:\/\//i.test(cfg.image || '') ? ciEsc(cfg.image) : '';
  const thumb = /^https?:\/\//i.test(cfg.thumbnail || '') ? ciEsc(cfg.thumbnail) : '';
  const footerText = ciFill(cfg.footerText, key);
  const footerIcon = /^https?:\/\//i.test(cfg.footerIcon || '') ? ciEsc(cfg.footerIcon) : '';
  const fields = Array.isArray(cfg.fields)
    ? cfg.fields.filter((f) => (f.name || '').trim() || (f.value || '').trim())
    : [];

  let html = '<div class="em-msg"><div class="em-avatar">K</div><div class="em-body">';
  html += '<div class="em-meta"><span class="em-name">Kratos</span><span class="em-bot"><i class="fas fa-check"></i> BOT</span><span class="em-time">' + new Date().toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' }) + '</span></div>';
  html += '<div class="em-embed"><div class="em-embed-bar" style="background:' + ciEsc(color) + '"></div><div class="em-embed-in"><div class="em-embed-main">';
  if (authorName) html += '<div class="em-embed-author">' + (authorIcon ? '<img src="' + authorIcon + '" alt="">' : '') + ciEsc(authorName) + '</div>';
  if (title) html += '<div class="em-embed-title">' + ciEsc(title) + '</div>';
  if (desc) html += '<div class="em-embed-desc">' + ciEsc(desc).replace(/\n/g, '<br>') + '</div>';
  if (fields.length) {
    html += '<div class="em-embed-fields">';
    fields.forEach((f) => {
      html += '<div class="em-embed-field' + (f.inline ? ' inline' : '') + '"><div class="n">' + (ciEsc(ciFill(f.name, key)) || '&#8203;') + '</div><div class="v">' + ciEsc(ciFill(f.value, key)).replace(/\n/g, '<br>') + '</div></div>';
    });
    html += '</div>';
  }
  if (image) html += '<div class="em-embed-img"><img src="' + image + '" alt="" onerror="this.parentElement.style.display=\'none\'"></div>';
  if (footerText || cfg.timestamp) {
    html += '<div class="em-embed-footer">' + (footerIcon ? '<img src="' + footerIcon + '" alt="">' : '');
    if (footerText) html += ciEsc(footerText);
    if (cfg.timestamp) html += '<span>' + (footerText ? ' • ' : '') + new Date().toLocaleDateString('ar-EG', { day: 'numeric', month: 'long', year: 'numeric' }) + '</span>';
    html += '</div>';
  }
  html += '</div>';
  if (thumb) html += '<div class="em-embed-thumb"><img src="' + thumb + '" alt="" onerror="this.parentElement.style.display=\'none\'"></div>';
  html += '</div></div></div></div>';
  return html;
}

/** يحدّث معاينة البطاقة وحالة عنصر (لا يوجد إمبد / محفوظ). */
function ciRenderItem(key) {
  const preview = document.querySelector('[data-ci-preview="' + key + '"]');
  const state = document.querySelector('[data-ci-state="' + key + '"]');
  const cfg = customEmbeds[key];
  if (preview) {
    preview.innerHTML = cfg
      ? ciPreviewHtml(cfg, key)
      : '<div class="em-empty"><i class="fas fa-wand-magic-sparkles"></i>لم تُضبط إعدادات الإمبد بعد</div>';
  }
  if (state) {
    if (cfg) { state.innerHTML = '<i class="fas fa-check-circle"></i> الإمبد محفوظ ومُفعّل'; }
    else { state.textContent = 'لا يوجد إمبد بعد — اضغط «تخصيص الإمبد»'; }
  }
}

/** يطبّق الوضع المختار على أزرار المبدّل ولوحات العنصر. */
function ciApplyMode(key, mode) {
  customModes[key] = mode === 'embed' ? 'embed' : 'image';
  document.querySelectorAll('[data-ci-set-mode="' + key + '"]').forEach((btn) => {
    const on = btn.dataset.ciMode === customModes[key];
    btn.classList.toggle('is-active', on);
    btn.setAttribute('aria-selected', on ? 'true' : 'false');
  });
  document.querySelectorAll('[data-ci-pane="' + key + '"]').forEach((pane) => {
    pane.hidden = pane.dataset.ciKind !== customModes[key];
  });
}

async function ciSetMode(key, mode) {
  if (!CUSTOM_MODE_VALUES.includes(mode) || customModes[key] === mode) return;
  const previous = customModes[key] || 'image';
  ciApplyMode(key, mode);
  try {
    const res = await fetch('/settings/<%= guild.id %>/images/mode', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ key, mode }),
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok && data.success) {
      showToast(mode === 'embed' ? '✅ تم تفعيل وضع الإمبد' : '✅ تم تفعيل وضع الصورة', 'success');
    } else {
      ciApplyMode(key, previous);
      showToast('❌ ' + (data.error || 'فشل تغيير الوضع'), 'error');
    }
  } catch {
    ciApplyMode(key, previous);
    showToast('❌ تعذّر الاتصال بالخادم', 'error');
  }
}

// ─── محرر الإمبد (نافذة مشتركة) ────────────────────────────────────────────
const ci = { current: null };
const ciFieldsBox = document.getElementById('ciFields');

function ciSetBusy(label, busy) {
  if (label) label.classList.toggle('is-uploading', !!busy);
}

function ciUpdateCounters() {
  const t = document.getElementById('ciTitle');
  const d = document.getElementById('ciDesc');
  const tc = document.getElementById('ciTitleCounter');
  const dc = document.getElementById('ciDescCounter');
  if (t && tc) { tc.textContent = t.value.length + '/256'; tc.classList.toggle('warn', t.value.length > 230); }
  if (d && dc) { dc.textContent = d.value.length + '/4096'; dc.classList.toggle('warn', d.value.length > 3686); }
}

function ciAddFieldRow(name = '', value = '', inline = false) {
  if (!ciFieldsBox) return;
  if (ciFieldsBox.querySelectorAll('.em-field-row').length >= 25) {
    showToast('الحد الأقصى 25 حقلاً', 'warning');
    return;
  }
  const row = document.createElement('div');
  row.className = 'em-field-row';
  row.innerHTML =
    '<input type="text" class="ci-ctl em-f-name" maxlength="256" placeholder="إسم الحقل" value="' + ciEsc(name) + '">' +
    '<input type="text" class="ci-ctl em-f-value" maxlength="1024" placeholder="قيمة الحقل" value="' + ciEsc(value) + '">' +
    '<label class="em-f-inline-wrap"><input type="checkbox" class="em-f-inline"' + (inline ? ' checked' : '') + '> ضمن السطر</label>' +
    '<button type="button" class="em-f-remove" title="حذف"><i class="fas fa-xmark"></i></button>';
  row.querySelector('.em-f-remove').addEventListener('click', () => { row.remove(); ciRenderModalPreview(); });
  row.querySelectorAll('input').forEach((i) => i.addEventListener('input', ciRenderModalPreview));
  row.querySelector('.em-f-inline').addEventListener('change', ciRenderModalPreview);
  ciFieldsBox.appendChild(row);
}

function ciReadFields() {
  if (!ciFieldsBox) return [];
  return Array.from(ciFieldsBox.querySelectorAll('.em-field-row')).map((r) => ({
    name: r.querySelector('.em-f-name').value.trim(),
    value: r.querySelector('.em-f-value').value.trim(),
    inline: r.querySelector('.em-f-inline').checked,
  })).filter((f) => f.name || f.value);
}

function ciSetColor(hex) {
  hex = (hex || '').trim().toLowerCase();
  if (!/^#[0-9a-f]{6}$/.test(hex)) hex = '#d000ff';
  const hidden = document.getElementById('ciColor');
  const pick = document.getElementById('ciColorPick');
  const hexInput = document.getElementById('ciColorHex');
  if (hidden) hidden.value = hex;
  if (pick) pick.value = hex;
  if (hexInput) hexInput.value = hex;
  document.querySelectorAll('#ciSwatches .em-swatch[data-color]').forEach((s) => {
    s.classList.toggle('active', s.dataset.color.toLowerCase() === hex);
  });
}

function ciReadForm() {
  const val = (id) => (document.getElementById(id)?.value || '').trim();
  const cfg = {
    color: document.getElementById('ciColor')?.value || '#d000ff',
    authorName: val('ciAuthorName'), authorIcon: val('ciAuthorIcon'),
    title: val('ciTitle'), description: val('ciDesc'),
    fields: ciReadFields(),
    image: val('ciImage'), thumbnail: val('ciThumb'),
    footerText: val('ciFooterText'), footerIcon: val('ciFooterIcon'),
    timestamp: !!document.getElementById('ciTimestamp')?.checked,
  };
  const empty = !cfg.authorName && !cfg.title && !cfg.description && !cfg.fields.length
    && !cfg.image && !cfg.thumbnail && !cfg.footerText;
  return empty ? null : cfg;
}

function ciRenderModalPreview() {
  const el = document.getElementById('ciPreview');
  if (!el) return;
  const cfg = ciReadForm();
  el.innerHTML = cfg
    ? ciPreviewHtml(cfg, ci.current)
    : '<div class="em-empty"><i class="fas fa-wand-magic-sparkles"></i>ابدأ بتعبئة الحقول لعرض المعاينة هنا</div>';
}

function ciFillForm(cfg, key) {
  cfg = cfg || {};
  const set = (id, v) => { const el = document.getElementById(id); if (el) el.value = v == null ? '' : v; };
  set('ciAuthorName', cfg.authorName);
  set('ciAuthorIcon', cfg.authorIcon);
  set('ciTitle', cfg.title);
  set('ciDesc', cfg.description);
  set('ciImage', cfg.image);
  set('ciThumb', cfg.thumbnail);
  set('ciFooterText', cfg.footerText);
  set('ciFooterIcon', cfg.footerIcon);
  const ts = document.getElementById('ciTimestamp');
  if (ts) ts.checked = cfg.timestamp !== false;
  if (ciFieldsBox) ciFieldsBox.innerHTML = '';
  (Array.isArray(cfg.fields) ? cfg.fields : []).forEach((f) => ciAddFieldRow(f.name, f.value, f.inline));
  ciSetColor(cfg.color || '#d000ff');
  ciUpdateCounters();

  const hint = document.getElementById('ciPhHint');
  if (hint) {
    const text = ciPhHintText(key);
    hint.hidden = !text;
    hint.innerHTML = text;
  }
}

function ciOpenModal() {
  const m = document.getElementById('ciEmbedModal');
  if (m) m.classList.add('open');
}

function ciCloseModal() {
  const m = document.getElementById('ciEmbedModal');
  if (m) m.classList.remove('open');
}

function ciOpenEditor(key) {
  ci.current = key;
  const item = CI_ITEMS[key] || {};
  const title = document.getElementById('ciModalTitle');
  if (title) title.textContent = 'تخصيص إمبد — ' + (item.label || key);
  ciFillForm(customEmbeds[key] || null, key);
  ciRenderModalPreview();
  ciOpenModal();
}

async function ciSave() {
  const key = ci.current;
  if (!key) return;
  const embed = ciReadForm();
  const btn = document.getElementById('ciSave');
  const orig = btn ? btn.innerHTML : '';
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جارٍ الحفظ...'; }
  try {
    const res = await fetch('/settings/<%= guild.id %>/images/embed', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      // إرسال null يعني حذف الإمبد والعودة إلى الصورة.
      body: JSON.stringify({ key, embed: embed || null }),
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok && data.success) {
      customEmbeds[key] = data.embed || null;
      ciRenderItem(key);
      updateImagesBadge();
      showToast(data.embed ? '✅ تم حفظ الإمبد' : '🗑️ تم حذف الإمبد', 'success');
      ciCloseModal();
    } else {
      showToast('❌ ' + (data.error || 'فشل الحفظ'), 'error');
    }
  } catch {
    showToast('❌ تعذّر الاتصال بالخادم', 'error');
  } finally {
    if (btn) { btn.disabled = false; btn.innerHTML = orig; }
  }
}

async function ciUpload(targetId, file, input) {
  const label = input.closest('.ci-upload-btn');
  ciSetBusy(label, true);
  showToast('جارٍ رفع الصورة إلى الموقع...', 'info');
  try {
    const res = await fetch('/settings/<%= guild.id %>/images/upload', {
      method: 'POST',
      headers: { 'Content-Type': file.type || 'application/octet-stream' },
      body: file,
    });
    let data = {};
    try { data = await res.json(); } catch {}
    if (!res.ok || !data.success || !data.url) {
      showToast(data.error || 'فشل رفع الصورة إلى الموقع', 'error');
      return;
    }
    const target = document.getElementById(targetId);
    if (target) target.value = data.url;
    showToast('✅ تم رفع الصورة', 'success');
    ciRenderModalPreview();
  } catch {
    showToast('تعذّر الاتصال بموقع رفع الصور', 'error');
  } finally {
    ciSetBusy(label, false);
  }
}

function ciInitEditor() {
  const modal = document.getElementById('ciEmbedModal');
  if (!modal) return;

  ['ciAuthorName', 'ciAuthorIcon', 'ciTitle', 'ciDesc', 'ciImage', 'ciThumb', 'ciFooterText', 'ciFooterIcon']
    .forEach((id) => document.getElementById(id)?.addEventListener('input', ciRenderModalPreview));
  document.getElementById('ciTitle')?.addEventListener('input', ciUpdateCounters);
  document.getElementById('ciDesc')?.addEventListener('input', ciUpdateCounters);
  document.getElementById('ciTimestamp')?.addEventListener('change', ciRenderModalPreview);
  document.getElementById('ciAddField')?.addEventListener('click', () => { ciAddFieldRow(); ciRenderModalPreview(); });

  document.querySelectorAll('#ciSwatches .em-swatch[data-color]').forEach((s) => {
    s.addEventListener('click', () => { ciSetColor(s.dataset.color); ciRenderModalPreview(); });
  });
  document.getElementById('ciColorPick')?.addEventListener('input', (e) => { ciSetColor(e.target.value); ciRenderModalPreview(); });
  document.getElementById('ciColorHex')?.addEventListener('input', (e) => { ciSetColor(e.target.value); ciRenderModalPreview(); });

  document.getElementById('ciSave')?.addEventListener('click', ciSave);
  document.getElementById('ciCancel')?.addEventListener('click', ciCloseModal);
  document.getElementById('ciClose')?.addEventListener('click', ciCloseModal);
  document.getElementById('ciClear')?.addEventListener('click', () => {
    if (!confirm('تفريغ كل حقول الإمبد؟ (لن يُحفظ الحذف حتى تضغط «حفظ الإمبد»)')) return;
    ciFillForm(null, ci.current);
    ciRenderModalPreview();
  });

  modal.addEventListener('click', (e) => { if (e.target === modal) ciCloseModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') ciCloseModal(); });

  document.querySelectorAll('input[type=file][data-ci-upload]').forEach((input) => {
    input.addEventListener('change', () => {
      const targetId = input.dataset.ciUpload;
      const file = input.files[0];
      input.value = '';
      if (!file) return;
      if (!/^image\/(png|jpe?g|gif|webp)$/i.test(file.type)) {
        showToast('صيغة غير مدعومة — المسموح: PNG / JPG / GIF / WEBP', 'warning');
        return;
      }
      if (file.size > 8 * 1024 * 1024) {
        showToast('حجم الصورة كبير جداً (الحد 8MB)', 'warning');
        return;
      }
      ciUpload(targetId, file, input);
    });
  });
}

const DEFAULT_IMG_ENDPOINT = {
  welcome_image: '/settings/<%= guild.id %>/default-image/welcome',
  ticket_panel_image: '/settings/<%= guild.id %>/default-image/ticket',
  voice_panel_image: '/settings/<%= guild.id %>/default-image/voice',
};

const IMG_VIEW_TITLES = {
  welcome_image: 'صورة الترحيب',
  ticket_panel_image: 'صورة بنل التذاكر',
  voice_panel_image: 'صورة بنل الصوتيات',
};

function openImgViewer(key) {
  const modal = document.getElementById('imgViewerModal');
  const img = document.getElementById('imgViewerImage');
  const note = document.getElementById('imgViewerNote');
  const title = document.getElementById('imgViewerTitle');
  if (!modal || !img) return;
  if (title) title.textContent = 'عرض الصورة الحالية — ' + (IMG_VIEW_TITLES[key] || key);

  const isCustom = !!(customImageValues[key] || '').trim();
  const src = isCustom ? customImageValues[key] : DEFAULT_IMG_ENDPOINT[key];
  img.style.display = 'none';
  note.textContent = 'جارٍ تحميل الصورة...';
  img.onload = () => {
    img.style.display = 'block';
    note.textContent = isCustom
      ? 'هذه هي الصورة المخصصة المعروضة حالياً على البوت في هذا السيرفر'
      : 'لا توجد صورة مخصصة لهذا السيرفر — هذه هي الصورة الافتراضية للبوت';
  };
  img.onerror = () => {
    img.style.display = 'none';
    note.textContent = 'تعذّر تحميل الصورة — تأكد من أن البوت متصل أو أن الرابط المخصص سليم';
  };
  img.src = src;
  modal.classList.add('open');
}

function closeImgViewer() {
  const modal = document.getElementById('imgViewerModal');
  if (modal) modal.classList.remove('open');
  const img = document.getElementById('imgViewerImage');
  if (img) img.src = '';
}

document.querySelectorAll('[data-img-view]').forEach(btn => {
  btn.addEventListener('click', () => openImgViewer(btn.dataset.imgView));
});
const imgViewerModal = document.getElementById('imgViewerModal');
if (imgViewerModal) {
  imgViewerModal.addEventListener('click', (e) => {
    if (e.target === imgViewerModal) closeImgViewer();
  });
}
const imgViewerClose = document.getElementById('imgViewerClose');
if (imgViewerClose) imgViewerClose.addEventListener('click', closeImgViewer);
document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeImgViewer(); });

// ─── محرر صورة الترحيب: وضع وحجم الصورة الرمزية للعضو المنضم ───────────────
// الحالة محفوظة بإحداثيات مساحة البوت الأصلية (1920×1080) ثم تُقاس إلى مساحة
// المعاينة، فتكون المعاينة مطابقة تماماً لما يرسمه البوت على البطاقة.
const WA = {
  defaults: { x: 1340, y: 527, size: 512, ring: true, ringColor: '#ffffff', ringWidth: 5 },
  state: Object.assign({}, <%- JSON.stringify(waInit) %>),
  stage: null, bg: null, empty: null, avatar: null,
};

function waClamp(v, min, max) { return Math.min(max, Math.max(min, v)); }

function waRender() {
  if (!WA.stage || !WA.avatar) return;
  const w = WA.stage.clientWidth || 1;
  const h = WA.stage.clientHeight || 1;
  const sx = w / 1920, sy = h / 1080;
  const s = WA.state;
  const d = Math.max(6, s.size * sy);
  WA.avatar.style.width = d + 'px';
  WA.avatar.style.height = d + 'px';
  WA.avatar.style.left = (s.x * sx) + 'px';
  WA.avatar.style.top = (s.y * sy) + 'px';
  WA.avatar.classList.toggle('no-ring', !s.ring || s.ringWidth <= 0);
  WA.avatar.style.setProperty('--ring-color', s.ringColor);
  WA.avatar.style.setProperty('--ring-w', Math.max(0, s.ringWidth * sy) + 'px');
  const meta = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
  meta('waValX', s.x); meta('waValY', s.y); meta('waValSize', s.size);
}

function waSyncControls() {
  const s = WA.state;
  const setV = (id, v) => { const el = document.getElementById(id); if (el) el.value = v; };
  const setT = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
  setV('waSize', s.size); setT('waSizeVal', s.size + 'px');
  setV('waX', s.x); setT('waXVal', s.x);
  setV('waY', s.y); setT('waYVal', s.y);
  setV('waRingWidth', s.ringWidth); setT('waRingWidthVal', s.ringWidth + 'px');
  const on = document.getElementById('waRingOn'); if (on) on.checked = !!s.ring;
  const col = document.getElementById('waRingColor'); if (col) col.value = s.ringColor;
  waRender();
}

function waImageState(ok) {
  if (WA.bg) WA.bg.classList.toggle('ready', ok);
  if (WA.stage) WA.stage.classList.toggle('no-image', !ok);
  if (WA.empty) WA.empty.style.display = ok ? 'none' : 'flex';
}

function waSetImage(value) {
  if (!WA.bg) return;
  const has = imgIsDataUri(value) || imgIsUrl(value);
  const src = has ? value : (DEFAULT_IMG_ENDPOINT.welcome_image || '');
  if (!src) { waImageState(false); return; }
  if (WA.bg.getAttribute('src') === src && WA.bg.classList.contains('ready')) return;
  WA.bg.onload = () => waImageState(true);
  WA.bg.onerror = () => waImageState(false);
  WA.bg.classList.remove('ready');
  WA.bg.src = src;
}

function waStatus(msg, kind) {
  const el = document.getElementById('waStatus');
  if (!el) return;
  el.textContent = msg || '';
  el.className = 'wa-status' + (kind ? ' ' + kind : '');
}

async function waSave() {
  const btn = document.getElementById('waSave');
  const orig = btn ? btn.innerHTML : '';
  if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جارٍ الحفظ...'; }
  waStatus('جارٍ حفظ التخصيص...', '');
  try {
    const res = await fetch('/settings/<%= guild.id %>/welcome-avatar', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(WA.state),
    });
    const data = await res.json();
    if (res.ok && data.success) {
      if (data.avatar) WA.state = Object.assign({}, data.avatar);
      waSyncControls();
      waStatus('تم الحفظ' + (data.synced ? ' — طُبّق على البوت فوراً' : ' — سيُطبَّق خلال ثوانٍ'), 'ok');
      showToast('✅ تم حفظ تخصيص صورة الترحيب', 'success');
    } else {
      waStatus(data.error || 'فشل الحفظ', 'err');
      showToast('❌ ' + (data.error || 'فشل الحفظ'), 'error');
    }
  } catch {
    waStatus('تعذّر الاتصال بالخادم', 'err');
    showToast('❌ حدث خطأ في الاتصال', 'error');
  } finally {
    if (btn) { btn.disabled = false; btn.innerHTML = orig; }
  }
}

function waInitEditor() {
  WA.stage = document.getElementById('waStage');
  WA.bg = document.getElementById('waStageBg');
  WA.empty = document.getElementById('waStageEmpty');
  WA.avatar = document.getElementById('waAvatar');
  if (!WA.stage || !WA.avatar) return;

  const slider = (id, key, labelId, suffix) => {
    const el = document.getElementById(id);
    if (!el) return;
    el.addEventListener('input', () => {
      WA.state[key] = Number(el.value);
      const t = document.getElementById(labelId);
      if (t) t.textContent = el.value + (suffix || '');
      waRender();
    });
  };
  slider('waSize', 'size', 'waSizeVal', 'px');
  slider('waX', 'x', 'waXVal');
  slider('waY', 'y', 'waYVal');
  slider('waRingWidth', 'ringWidth', 'waRingWidthVal', 'px');

  const ringOn = document.getElementById('waRingOn');
  if (ringOn) ringOn.addEventListener('change', () => { WA.state.ring = ringOn.checked; waRender(); });
  const ringColor = document.getElementById('waRingColor');
  if (ringColor) ringColor.addEventListener('input', () => { WA.state.ringColor = ringColor.value; waRender(); });

  // سحب الصورة الرمزية لإعادة وضعها
  let drag = false, px = 0, py = 0, ax = 0, ay = 0;
  const start = (e) => {
    drag = true; px = e.clientX; py = e.clientY; ax = WA.state.x; ay = WA.state.y;
    WA.stage.classList.add('dragging');
    try { WA.avatar.setPointerCapture(e.pointerId); } catch {}
    e.preventDefault();
  };
  const move = (e) => {
    if (!drag) return;
    const w = WA.stage.clientWidth || 1;
    const h = WA.stage.clientHeight || 1;
    WA.state.x = Math.round(waClamp(ax + (e.clientX - px) * (1920 / w), 0, 1920));
    WA.state.y = Math.round(waClamp(ay + (e.clientY - py) * (1080 / h), 0, 1080));
    const sx = document.getElementById('waX'); if (sx) sx.value = WA.state.x;
    const sy = document.getElementById('waY'); if (sy) sy.value = WA.state.y;
    const lx = document.getElementById('waXVal'); if (lx) lx.textContent = WA.state.x;
    const ly = document.getElementById('waYVal'); if (ly) ly.textContent = WA.state.y;
    waRender();
  };
  const end = (e) => {
    if (!drag) return;
    drag = false;
    WA.stage.classList.remove('dragging');
    try { WA.avatar.releasePointerCapture(e.pointerId); } catch {}
  };
  WA.avatar.addEventListener('pointerdown', start);
  WA.avatar.addEventListener('pointermove', move);
  WA.avatar.addEventListener('pointerup', end);
  WA.avatar.addEventListener('pointercancel', end);

  // أسهم لوحة المفاتيح لضبط دقيق
  WA.avatar.addEventListener('keydown', (e) => {
    const step = e.shiftKey ? 20 : 4;
    const s = WA.state;
    if (e.key === 'ArrowLeft') s.x = waClamp(s.x - step, 0, 1920);
    else if (e.key === 'ArrowRight') s.x = waClamp(s.x + step, 0, 1920);
    else if (e.key === 'ArrowUp') s.y = waClamp(s.y - step, 0, 1080);
    else if (e.key === 'ArrowDown') s.y = waClamp(s.y + step, 0, 1080);
    else return;
    e.preventDefault();
    const sx = document.getElementById('waX'); if (sx) sx.value = s.x;
    const sy = document.getElementById('waY'); if (sy) sy.value = s.y;
    const lx = document.getElementById('waXVal'); if (lx) lx.textContent = s.x;
    const ly = document.getElementById('waYVal'); if (ly) ly.textContent = s.y;
    waRender();
  });

  const save = document.getElementById('waSave');
  if (save) save.addEventListener('click', waSave);
  const reset = document.getElementById('waReset');
  if (reset) reset.addEventListener('click', () => { WA.state = Object.assign({}, WA.defaults); waStatus('', ''); waSyncControls(); });

  window.addEventListener('resize', waRender);
  waSyncControls();
}

waInitEditor();
ciInitEditor();
initCustomImages();
</script>

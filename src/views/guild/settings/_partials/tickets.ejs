  <!-- ④ نظام التذاكر -->
  <div class="card glass ticket-card st-section" id="st-tickets">
    <div class="card-header st-sec-head">
      <span class="st-sec-num">4</span>
      <h3><i class="fas fa-ticket-alt"></i> نظام التذاكر</h3>
      <span class="ticket-status" id="ticketStatusBadge"><span class="ticket-status-dot"></span><span id="ticketStatusText">—</span></span>
    </div>
    <p class="card-desc">التذاكر نظام متكامل من 4 خطوات مرتبطة: بنل الطلبات، تصنيف لتذاكر الأعضاء، تصنيف داخلي للمشرفين، وسجل لكل الأحداث.</p>

    <div class="ticket-progress">
      <div class="ticket-progress-item" data-for="panel_channel">
        <span class="step-ic"><i class="fas fa-clipboard-list"></i></span>
        <span class="step-name">بنل التذاكر</span>
        <span class="step-check"><i class="fas fa-check"></i></span>
      </div>
      <span class="progress-line"></span>
      <div class="ticket-progress-item" data-for="ticket_category">
        <span class="step-ic"><i class="fas fa-folder-open"></i></span>
        <span class="step-name">التصنيف</span>
        <span class="step-check"><i class="fas fa-check"></i></span>
      </div>
      <span class="progress-line"></span>
      <div class="ticket-progress-item" data-for="admin_category">
        <span class="step-ic"><i class="fas fa-folder-tree"></i></span>
        <span class="step-name">التصنيف الداخلي</span>
        <span class="step-check"><i class="fas fa-check"></i></span>
      </div>
      <span class="progress-line"></span>
      <div class="ticket-progress-item" data-for="log_channel_id">
        <span class="step-ic"><i class="fas fa-scroll"></i></span>
        <span class="step-name">سجل التذاكر</span>
        <span class="step-check"><i class="fas fa-check"></i></span>
      </div>
    </div>

    <div class="ticket-fields">
      <div class="ticket-field">
        <div class="ticket-field-head">
          <div class="ticket-field-title">
            <i class="fas fa-clipboard-list"></i>
            <div>
              <strong>بنل التذاكر</strong>
              <small>القناة التي يُعرض فيها بنل إنشاء التذاكر — زر فتح تذكرة يظهر أمام كل عضو</small>
            </div>
          </div>
          <div class="ticket-field-tools">
            <span class="ticket-field-state" data-state-of="panel_channel"><i class="fas fa-check-circle"></i><span>مضبوط</span></span>
            <button type="button" class="btn-delete-sm" onclick="deleteSetting('panel_channel')" title="إلغاء هذا الإعداد"><i class="fas fa-trash"></i></button>
          </div>
        </div>
        <select data-key="panel_channel" class="ticket-select">
          <option value="">— بدون (معطّل) —</option>
          <% (channels.text || []).forEach(ch => { %>
            <option value="<%= ch.id %>" <%= String(config.panel_channel || '') === String(ch.id) ? 'selected' : '' %>><%= ch.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="ticket-field">
        <div class="ticket-field-head">
          <div class="ticket-field-title">
            <i class="fas fa-scroll"></i>
            <div>
              <strong>سجل التذاكر</strong>
              <small>قناة تُسجل فيها أحداث التذاكر (فتح / إغلاق / سحب / نقل) لأرشفة كاملة</small>
            </div>
          </div>
          <div class="ticket-field-tools">
            <span class="ticket-field-state" data-state-of="log_channel_id"><i class="fas fa-check-circle"></i><span>مضبوط</span></span>
            <button type="button" class="btn-delete-sm" onclick="deleteSetting('log_channel_id')" title="إلغاء هذا الإعداد"><i class="fas fa-trash"></i></button>
          </div>
        </div>
        <select data-key="log_channel_id" class="ticket-select">
          <option value="">— بدون (معطّل) —</option>
          <% (channels.text || []).forEach(ch => { %>
            <option value="<%= ch.id %>" <%= String(config.log_channel_id || '') === String(ch.id) ? 'selected' : '' %>><%= ch.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="ticket-field">
        <div class="ticket-field-head">
          <div class="ticket-field-title">
            <i class="fas fa-folder-open"></i>
            <div>
              <strong>تصنيف التذاكر</strong>
              <small>التصنيف الذي تُنشأ فيه تذاكر الأعضاء — تُظهر التذكرة نفسها داخل هذا التصنيف</small>
            </div>
          </div>
          <div class="ticket-field-tools">
            <span class="ticket-field-state" data-state-of="ticket_category"><i class="fas fa-check-circle"></i><span>مضبوط</span></span>
            <button type="button" class="btn-delete-sm" onclick="deleteSetting('ticket_category')" title="إلغاء هذا الإعداد"><i class="fas fa-trash"></i></button>
          </div>
        </div>
        <select data-key="ticket_category" class="ticket-select">
          <option value="">— بدون (معطّل) —</option>
          <% (channels.category || []).forEach(ch => { %>
            <option value="<%= ch.id %>" <%= String(config.ticket_category || '') === String(ch.id) ? 'selected' : '' %>><%= ch.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="ticket-field">
        <div class="ticket-field-head">
          <div class="ticket-field-title">
            <i class="fas fa-folder-tree"></i>
            <div>
              <strong>التصنيف الداخلي</strong>
              <small>تصنيف خاص بالتذاكر الداخلية — يفتحه فقط فريق الدعم للطلبات الداخلية بين الإدارة</small>
            </div>
          </div>
          <div class="ticket-field-tools">
            <span class="ticket-field-state" data-state-of="admin_category"><i class="fas fa-check-circle"></i><span>مضبوط</span></span>
            <button type="button" class="btn-delete-sm" onclick="deleteSetting('admin_category')" title="إلغاء هذا الإعداد"><i class="fas fa-trash"></i></button>
          </div>
        </div>
        <select data-key="admin_category" class="ticket-select">
          <option value="">— بدون (معطّل) —</option>
          <% (channels.category || []).forEach(ch => { %>
            <option value="<%= ch.id %>" <%= String(config.admin_category || '') === String(ch.id) ? 'selected' : '' %>><%= ch.name %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <small class="field-hint role-picker-hint">
      <i class="fas fa-info-circle"></i>
      الجاهزية الكاملة للبوت تتطلب: <b>بنل التذاكر</b> + <b>تصنيف التذاكر</b> + <b>رتبة دعم واحدة على الأقل</b> (من قسم فريق الدعم بالأسفل).
    </small>
  </div>


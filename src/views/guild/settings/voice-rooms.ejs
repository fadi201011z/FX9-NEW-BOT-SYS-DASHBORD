<%- include('_partials/header', { pageTitle: 'إعدادات الرومات الصوتية', pageIcon: 'fa-sliders', pageDesc: 'كل ما يخصّ الغرف الصوتية المؤقتة: الاسم الافتراضي، الحد الأقصى للأعضاء، وصورة البنل.' }) %>
<form id="settingsForm" onsubmit="saveSettings(event)">
  <%- include('_partials/voice-rooms') %>

  <div class="card glass custom-images-card st-section" id="st-images">
    <div class="card-header st-sec-head">
      <h3><i class="fas fa-image"></i> صورة بنل الرومات الصوتية</h3>
      <span class="ticket-status" id="imagesStatusBadge"><span class="ticket-status-dot"></span><span id="imagesStatusText">—</span></span>
    </div>
    <p class="card-desc">الصورة العلوية التي تظهر لمن يريد إنشاء غرفة صوتية مؤقتة.</p>
    <div class="custom-images-note">
      <i class="fas fa-circle-info"></i>
      <span>اختر <b>صورة</b> جاهزة أو ابنِ <b>امبد</b> احترافياً — الصيغ المدعومة: <b>PNG / JPG / GIF / WEBP</b> بحد أقصى <b>8MB</b>، ويُخزَّن رابط مباشر فقط.</span>
    </div>
    <div class="custom-images-grid">
      <%- include('_partials/image-voice') %>
    </div>
  </div>

  <%- include('_partials/actions', { pageLabel: 'إعدادات الرومات المؤقتة' }) %>
</form>
<%- include('_partials/modals') %>
<%- include('_partials/style') %>
<%- include('_partials/script') %>

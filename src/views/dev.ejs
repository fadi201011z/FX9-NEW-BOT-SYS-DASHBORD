<% currentPage = 'dev' %>
<div class="page-header">
  <h1><i class="fas fa-code"></i> لوحة المطور</h1>
  <p>مرحباً، <%= user.globalName || user.username %> — لديك صلاحية كاملة</p>
</div>

<div class="stats-grid">
  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #5865f2">
      <i class="fas fa-server"></i>
    </div>
    <div class="stat-info">
      <span class="stat-value"><%= botGuilds.length %></span>
      <span class="stat-label">سيرفرات البوت</span>
    </div>
  </div>

  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #57f287">
      <i class="fas fa-database"></i>
    </div>
    <div class="stat-info">
      <span class="stat-value" id="totalDbKeys">---</span>
      <span class="stat-label">مفاتيح DB</span>
    </div>
  </div>

  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #fee75c">
      <i class="fas fa-users-cog"></i>
    </div>
    <div class="stat-info">
      <span class="stat-value" id="totalAdmins">---</span>
      <span class="stat-label">إجمالي المدراء</span>
    </div>
  </div>
</div>

<div class="card glass">
  <div class="card-header"><h3><i class="fas fa-server"></i> جميع سيرفرات البوت</h3></div>
  <div class="dev-guilds">
    <% botGuilds.forEach(g => { %>
      <div class="dev-guild-item">
        <div class="dev-guild-info">
          <strong><%= g.name %></strong>
          <span>🗄️ <%= g.configCount || 0 %></span>
          <span>👥 <%= g.adminCount || 0 %></span>
        </div>
        <a href="/guilds/<%= g.id %>" class="btn-sm"><i class="fas fa-external-link-alt"></i></a>
      </div>
    <% }) %>
  </div>
</div>

<div class="card glass">
  <div class="card-header"><h3><i class="fas fa-database"></i> إدارة قاعدة البيانات</h3></div>
  <div class="dev-actions">
    <button class="btn-primary" onclick="showDbStats()">
      <i class="fas fa-chart-bar"></i> إحصائيات DB
    </button>
    <button class="btn-danger" onclick="cleanupTickets()">
      <i class="fas fa-broom"></i> تنظيف التذاكر القديمة
    </button>
  </div>
</div>

<style>
.mnt-card { overflow: hidden; }
.mnt-header { padding:20px 24px; display:flex; align-items:center; justify-content:space-between; background:<%= maintenance.enabled ? 'rgba(229,57,53,.08)' : 'transparent' %>; border-bottom:1px solid var(--border); transition:.3s; }
.mnt-status { display:flex; align-items:center; gap:14px; }
.mnt-dot { width:14px;height:14px;border-radius:50%;background:<%= maintenance.enabled ? '#e53935' : '#666' %>;box-shadow:<%= maintenance.enabled ? '0 0 20px rgba(229,57,53,.5)' : 'none' %>;animation:<%= maintenance.enabled ? 'mntPulse 1.5s ease-in-out infinite' : 'none' %>; }
@keyframes mntPulse { 0%,100%{box-shadow:0 0 8px rgba(229,57,53,.4)} 50%{box-shadow:0 0 24px rgba(229,57,53,.7)} }
.mnt-label { font-weight:700;font-size:.95rem;color:<%= maintenance.enabled ? '#e53935' : '#888' %>; }
.mnt-body { padding:20px 24px; }
.mnt-actions { display:flex;gap:10px;flex-wrap:wrap; }
.mnt-btn { display:inline-flex;align-items:center;gap:8px;padding:10px 22px;border-radius:10px;font-weight:700;font-size:.85rem;text-decoration:none;cursor:pointer;border:none;transition:.2s; }
.mnt-btn:hover { transform:translateY(-1px); }
.mnt-btn-start { background:linear-gradient(135deg,#4caf50,#388e3c);color:#fff;box-shadow:0 4px 15px rgba(76,175,80,.3); }
.mnt-btn-start:hover { box-shadow:0 6px 20px rgba(76,175,80,.4); }
.mnt-btn-stop { background:linear-gradient(135deg,#e53935,#c62828);color:#fff;box-shadow:0 4px 15px rgba(229,57,53,.3); }
.mnt-btn-stop:hover { box-shadow:0 6px 20px rgba(229,57,53,.4); }
.mnt-btn-save { background:linear-gradient(135deg,var(--accent),var(--accent-hover));color:#fff;box-shadow:0 4px 15px rgba(88,101,242,.3); }
.mnt-btn-save:hover { box-shadow:0 6px 20px rgba(88,101,242,.4); }
.mnt-btn-ghost { background:rgba(255,255,255,.04);color:var(--text-muted);border:1px solid var(--border); }
.mnt-btn-ghost:hover { background:rgba(255,255,255,.08);color:var(--text); }
.mnt-form-row { margin-bottom:14px; }
.mnt-form-row:last-child { margin-bottom:0; }
.mnt-form-row label { display:block;font-size:.82rem;font-weight:600;margin-bottom:5px;color:var(--text-muted); }
.mnt-form-row input { width:100%;padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);box-sizing:border-box;font-size:.9rem;outline:none;transition:.2s; }
.mnt-form-row input:focus { border-color:var(--accent);box-shadow:0 0 0 3px rgba(88,101,242,.15); }
.mnt-divider { height:1px;background:var(--border);margin:16px 0; }
</style>

<div class="card glass mnt-card">
  <div class="mnt-header">
    <div class="mnt-status">
      <div class="mnt-dot"></div>
      <div>
        <div class="mnt-label"><%= maintenance.enabled ? 'وضع الصيانة — مفعل' : 'وضع الصيانة — معطل' %></div>
        <div style="font-size:.75rem;color:var(--text-muted);margin-top:2px">
          <% if (maintenance.enabled) { %>
            الصيانة عامة — جميع الزوار يتأثرون
          <% } else { %>
            كل الخدمات تعمل بشكل طبيعي
          <% } %>
        </div>
      </div>
    </div>
    <div class="mnt-actions">
      <% if (maintenance.enabled) { %>
        <button type="button" class="mnt-btn mnt-btn-stop" id="mntShowChangelogBtn"><i class="fas fa-power-off"></i> إيقاف الصيانة</button>
      <% } else { %>
        <a href="/dev/maintenance/start" id="mntStartBtn" class="mnt-btn mnt-btn-start" style="opacity:.5;pointer-events:none"><i class="fas fa-shield-halved"></i> تفعيل الصيانة</a>
      <% } %>
    </div>
  </div>
  <div class="mnt-body" style="<%= maintenance.enabled ? '' : 'opacity:.5' %>">
    <div style="font-size:.78rem;color:var(--text-muted);margin-bottom:12px;padding:8px 12px;background:rgba(255,152,0,.08);border-radius:8px;border:1px solid rgba(255,152,0,.2)">
      ⚠️ <strong>ملاحظة:</strong> يجب اختيار المدة الزمنية أولاً لتفعيل زر البدء. يمكنك إدخال <strong>0</strong> للصيانة بدون وقت محدد (مفتوحة).
    </div>
    <form method="POST" action="/dev/maintenance/save" id="mntSaveForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="minutes" id="mntMinutesField" value="">
      <div style="margin-bottom:12px">
        <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:6px;color:var(--text-muted)">⏱ المدة</label>
        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px">
          <button type="button" class="mnt-preset" data-min="15" style="padding:6px 14px;border-radius:8px;border:1px solid var(--border);background:rgba(255,255,255,.04);color:var(--text);cursor:pointer;font-size:.82rem;font-weight:600;transition:.2s">15د</button>
          <button type="button" class="mnt-preset" data-min="30" style="padding:6px 14px;border-radius:8px;border:1px solid var(--border);background:rgba(255,255,255,.04);color:var(--text);cursor:pointer;font-size:.82rem;font-weight:600;transition:.2s">30د</button>
          <button type="button" class="mnt-preset" data-min="60" style="padding:6px 14px;border-radius:8px;border:1px solid var(--border);background:rgba(255,255,255,.04);color:var(--text);cursor:pointer;font-size:.82rem;font-weight:600;transition:.2s">1س</button>
          <button type="button" class="mnt-preset" data-min="120" style="padding:6px 14px;border-radius:8px;border:1px solid var(--border);background:rgba(255,255,255,.04);color:var(--text);cursor:pointer;font-size:.82rem;font-weight:600;transition:.2s">2س</button>
          <button type="button" class="mnt-preset" data-min="360" style="padding:6px 14px;border-radius:8px;border:1px solid var(--border);background:rgba(255,255,255,.04);color:var(--text);cursor:pointer;font-size:.82rem;font-weight:600;transition:.2s">6س</button>
          <button type="button" class="mnt-preset" data-min="1440" style="padding:6px 14px;border-radius:8px;border:1px solid var(--border);background:rgba(255,255,255,.04);color:var(--text);cursor:pointer;font-size:.82rem;font-weight:600;transition:.2s">24س</button>
          <button type="button" id="mntCustomBtn" style="padding:6px 14px;border-radius:8px;border:1px solid var(--accent);background:var(--accent);color:#fff;cursor:pointer;font-size:.82rem;font-weight:600;transition:.2s">⌨️ مخصص</button>
        </div>
        <div style="display:flex;gap:8px;align-items:center">
          <input type="number" id="mntMinutes" min="0" placeholder="عدد الدقائق (0 = بدون وقت محدد)" style="flex:1;min-width:100px;padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);box-sizing:border-box;font-size:.9rem;outline:none;transition:.2s">
          <input type="datetime-local" id="mntPicker" style="flex:1.5;min-width:170px;padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);box-sizing:border-box;font-size:.9rem;outline:none;transition:.2s">
        </div>
      </div>
      <div style="margin-bottom:12px">
        <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:6px;color:var(--text-muted)">💬 رسالة الصيانة</label>
        <input type="text" name="message" id="mntMessage" value="<%= maintenance.message || '' %>" placeholder="الموقع تحت الصيانة حالياً..." style="width:100%;padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);box-sizing:border-box;font-size:.9rem;outline:none;transition:.2s">
      </div>
      <div style="margin-bottom:12px">
        <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:6px;color:var(--text-muted)">📢 روم إشعارات الصيانة (ID)</label>
        <input type="text" name="channelId" id="mntChannel" value="<%= maintenance.channelId || '' %>" placeholder="أدخل ID الروم في الديسكورد" style="width:100%;padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);box-sizing:border-box;font-size:.9rem;outline:none;transition:.2s;direction:ltr;text-align:left;font-family:monospace">
        <div style="font-size:.75rem;color:var(--text-muted);margin-top:4px">يُرسل إشعار عند بدء وانتهاء الصيانة في هذا الروم</div>
      </div>
      <div style="display:flex;gap:8px;align-items:center">
        <button type="submit" class="mnt-btn mnt-btn-save"><i class="fas fa-check"></i> حفظ الإعدادات</button>
        <span style="font-size:.8rem;color:var(--text-muted)" id="mntSummary"></span>
      </div>
      <div style="font-size:.75rem;color:var(--text-muted);margin-top:6px">💡 حفظ الإعدادات لا يرسل إشعار في الديسكورد. يتم الإرسال فقط عند تفعيل أو إيقاف الصيانة.</div>
    </form>
    <script>
    (function(){
      var mins = document.getElementById('mntMinutes');
      var picker = document.getElementById('mntPicker');
      var hidden = document.getElementById('mntMinutesField');
      var summary = document.getElementById('mntSummary');
      var presets = document.querySelectorAll('.mnt-preset');

      function setActive(btn) {
        presets.forEach(function(p) { p.style.background = 'rgba(255,255,255,.04)'; p.style.color = 'var(--text)'; p.style.borderColor = 'var(--border)'; });
        var c = document.getElementById('mntCustomBtn');
        c.style.background = 'rgba(255,255,255,.04)'; c.style.color = 'var(--text)'; c.style.borderColor = 'var(--border)';
        if (btn) { btn.style.background = 'var(--accent)'; btn.style.color = '#fff'; btn.style.borderColor = 'var(--accent)'; }
      }

      function calcMins() {
        var m = parseInt(mins.value) || 0;
        if (m > 0) {
          picker.value = '';
          hidden.value = m;
          summary.textContent = '🕐 تنتهي بعد ' + m + ' دقيقة';
          return;
        }
        var d = picker.value;
        if (d) {
          mins.value = '';
          var diff = Math.round((new Date(d).getTime() - Date.now()) / 60000);
          if (diff > 0) {
            hidden.value = diff;
            summary.textContent = '📅 تنتهي ' + d;
            return;
          }
        }
        hidden.value = '';
        summary.textContent = '⏳ غير محددة';
      }

      presets.forEach(function(b) {
        b.addEventListener('click', function() {
          setActive(this);
          mins.value = this.dataset.min;
          picker.value = '';
          calcMins();
        });
      });

      document.getElementById('mntCustomBtn').addEventListener('click', function() {
        setActive(null);
        this.style.background = 'var(--accent)'; this.style.color = '#fff'; this.style.borderColor = 'var(--accent)';
        mins.value = '';
        picker.value = '';
        picker.focus();
        calcMins();
      });

      mins.addEventListener('input', function() {
        setActive(null);
        if (this.value) picker.value = '';
        calcMins();
      });

      picker.addEventListener('input', function() {
        setActive(null);
        if (this.value) mins.value = '';
        calcMins();
      });

      document.getElementById('mntSaveForm').addEventListener('submit', function(e) {
        calcMins();
      });

      <% if (maintenance.durationMinutes > 0) { %>
        mins.value = <%= maintenance.durationMinutes %>;
        hidden.value = <%= maintenance.durationMinutes %>;
        summary.textContent = '🕐 تنتهي بعد <%= maintenance.durationMinutes %> دقيقة';
      <% } %>

      function updateStartBtn() {
        var btn = document.getElementById('mntStartBtn');
        if (!btn) return;
        var hasTime = !!(parseInt(mins.value) > 0) || !!(picker.value) || (parseInt(mins.value) === 0);
        btn.style.opacity = hasTime ? '1' : '.5';
        btn.style.pointerEvents = hasTime ? 'auto' : 'none';
      }

      updateStartBtn();
      mins.addEventListener('input', updateStartBtn);
      picker.addEventListener('input', updateStartBtn);
      presets.forEach(function(b) {
        b.addEventListener('click', updateStartBtn);
      });
      document.getElementById('mntCustomBtn').addEventListener('click', function() {
        setTimeout(updateStartBtn, 50);
      });
    })();
    </script>
    <% if (maintenance.enabled) { %>
    <div class="mnt-divider"></div>
    <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
      <a href="/maintenance?preview=1" target="_blank" class="mnt-btn mnt-btn-ghost"><i class="fas fa-eye"></i> معاينة صفحة الصيانة</a>
      <% if (maintenance.endTime) { %>
        <span style="font-size:.8rem;color:var(--text-muted)">🕐 تنتهي <span dir="ltr"><%= new Date(maintenance.endTime).toLocaleString('ar-EG') %></span></span>
      <% } %>
    </div>
    <!-- Changelog form (hidden, shown when clicking stop) -->
    <div class="mnt-divider"></div>
    <div id="mntChangelogSection" style="display:none">
      <div style="font-size:.9rem;font-weight:700;margin-bottom:10px;color:var(--text)">
        <i class="fas fa-scroll"></i> سجل التحديثات — أضف ملخصاً للتغييرات التي تمت أثناء الصيانة
      </div>
      <form method="POST" action="/dev/maintenance/stop" id="mntStopForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div style="margin-bottom:14px">
          <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:6px;color:var(--text-muted)">
            <i class="fas fa-robot"></i> تحديثات البوت — الأوامر، الأنظمة، الحماية، الصوت، التكتات...
          </label>
          <textarea name="botUpdates" rows="4" style="width:100%;padding:12px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);font-size:.9rem;outline:none;transition:.2s;resize:vertical;box-sizing:border-box;direction:rtl" placeholder="مثال: تم إصلاح مشكلة /ping↵تم إضافة أمر /newcommand↵تم تحسين أداء البوت"><%= maintenance.changelog && maintenance.changelog.botUpdates || '' %></textarea>
          <div style="font-size:.75rem;color:var(--text-muted);margin-top:4px">إذا تركت الحقل فارغاً، سيتم إرسال "لم يتم إضافة تحديثات" تلقائياً</div>
        </div>
        <div style="margin-bottom:14px">
          <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:6px;color:var(--text-muted)">
            <i class="fas fa-globe"></i> تحديثات الموقع — لوحة التحكم، التصميم، API، السرعة...
          </label>
          <textarea name="siteUpdates" rows="4" style="width:100%;padding:12px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);font-size:.9rem;outline:none;transition:.2s;resize:vertical;box-sizing:border-box;direction:rtl" placeholder="مثال: إعادة تصميم صفحة الإحصائيات↵إصلاح مشكلة الوقت في العدّاد↵تحسين سرعة تحميل الصفحات"><%= maintenance.changelog && maintenance.changelog.siteUpdates || '' %></textarea>
          <div style="font-size:.75rem;color:var(--text-muted);margin-top:4px">إذا تركت الحقل فارغاً، سيتم إرسال "لم يتم إضافة تحديثات" تلقائياً</div>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:16px">
          <button type="submit" class="mnt-btn mnt-btn-stop" style="font-size:1rem;padding:12px 30px">
            <i class="fas fa-power-off"></i> تأكيد إيقاف الصيانة وإرسال الإشعار
          </button>
          <button type="button" class="mnt-btn mnt-btn-ghost" id="mntCancelChangelog">
            <i class="fas fa-times"></i> إلغاء
          </button>
        </div>
      </form>
    </div>
    <script>
    (function(){
      var showBtn = document.getElementById('mntShowChangelogBtn');
      var section = document.getElementById('mntChangelogSection');
      var cancelBtn = document.getElementById('mntCancelChangelog');
      var botField = document.querySelector('textarea[name="botUpdates"]');
      var siteField = document.querySelector('textarea[name="siteUpdates"]');
      var stopForm = document.getElementById('mntStopForm');

      // Restore from localStorage if DB is empty (user was typing before refresh)
      if (botField && siteField) {
        var savedBot = localStorage.getItem('mntChangelogBot');
        var savedSite = localStorage.getItem('mntChangelogSite');
        if (savedBot && !botField.value.trim()) botField.value = savedBot;
        if (savedSite && !siteField.value.trim()) siteField.value = savedSite;
        // Auto-save on input
        botField.addEventListener('input', function() { localStorage.setItem('mntChangelogBot', botField.value); });
        siteField.addEventListener('input', function() { localStorage.setItem('mntChangelogSite', siteField.value); });
      }

      if (showBtn && section) {
        showBtn.addEventListener('click', function() {
          section.style.display = 'block';
          showBtn.style.display = 'none';
          section.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
        // Auto-open if there's unsaved text in localStorage
        if (localStorage.getItem('mntChangelogBot') || localStorage.getItem('mntChangelogSite')) {
          showBtn.click();
        }
      }
      if (cancelBtn && section && showBtn) {
        cancelBtn.addEventListener('click', function() {
          section.style.display = 'none';
          showBtn.style.display = '';
        });
      }
      // Clear localStorage on successful form submit
      if (stopForm) {
        stopForm.addEventListener('submit', function() {
          localStorage.removeItem('mntChangelogBot');
          localStorage.removeItem('mntChangelogSite');
        });
      }
    })();
    </script>
    <% } %>
  </div>
</div>

<script>
const botGuilds = <%= JSON.stringify(botGuilds) %>;
document.addEventListener('DOMContentLoaded', () => {
  let totalKeys = 0, totalAdmins = 0;
  Promise.all(botGuilds.map(g =>
    fetch(`/api/guild/${g.id}/stats`).then(r => r.json()).then(d => {
      totalKeys += d.configKeys || 0;
      totalAdmins += d.adminCount || 0;
    }).catch(() => {})
  )).then(() => {
    document.getElementById('totalDbKeys').textContent = totalKeys;
    document.getElementById('totalAdmins').textContent = totalAdmins;
  });
});

async function cleanupTickets() {
  if (!confirm('تنظيف التذاكر القديمة من قاعدة البيانات؟')) return;
  try {
    const res = await fetch('/api/tickets/cleanup', { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      alert('✅ تم حذف ' + data.deleted + ' تذكرة');
    } else {
      alert('⚠️ ' + (data.error || 'لا يمكن التنظيف'));
    }
  } catch { alert('❌ فشل التنظيف'); }
}
</script>


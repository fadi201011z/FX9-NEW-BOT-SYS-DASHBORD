<script>
const botGuilds = <%= JSON.stringify(botGuilds) %>;
const fmt = n => { n = Number(n) || 0; return n >= 1000 ? (n / 1000).toFixed(1) + 'K' : String(n); };
const esc = s => String(s || '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

function dvToast(msg, isErr) {
  let t = document.getElementById('dvToast');
  if (!t) { t = document.createElement('div'); t.id = 'dvToast'; t.className = 'dv-toast'; document.body.appendChild(t); }
  t.textContent = msg;
  t.classList.toggle('err', !!isErr);
  t.style.opacity = '1';
  t.style.transform = 'translate(-50%,0)';
  clearTimeout(t._tm);
  t._tm = setTimeout(() => { t.style.opacity = '0'; t.style.transform = 'translate(-50%,10px)'; }, 3200);
}

// ── انضمام إلى سيرفر (رابط دعوة) ──
async function joinGuild(guildId, btn) {
  const gname = btn.dataset.gname || 'السيرفر';
  const orig = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جارِ الإنشاء...';
  try {
    const r = await fetch(`/dev/guild-invite/${guildId}`);
    const data = await r.json();
    if (data.url) {
      window.open(data.url, '_blank', 'noopener');
      dvToast('✅ تم إنشاء رابط الانضمام لـ ' + gname);
    } else {
      dvToast('⚠️ ' + (data.error || 'تعذر إنشاء رابط الدعوة'), true);
    }
  } catch {
    dvToast('❌ فشل الاتصال بالبوت', true);
  } finally {
    btn.disabled = false;
    btn.innerHTML = orig;
  }
}

// ── بحث السيرفرات ──
function applySearch() {
  const q = (document.getElementById('dvSearch')?.value || '').trim().toLowerCase();
  document.querySelectorAll('.dv-g-card').forEach(card => {
    card.style.display = (!q || (card.dataset.name || '').toLowerCase().includes(q)) ? '' : 'none';
  });
}

// ── إحصائيات DB (مودال) ──
function showDbStats() {
  const rows = botGuilds.map(g =>
    `<tr><td><b>${esc(g.name)}</b></td><td>${fmt(g.memberCount)}</td><td>${g.configCount || 0}</td><td>${g.adminCount || 0}</td></tr>`
  ).join('');
  const cfg = botGuilds.reduce((s, g) => s + (g.configCount || 0), 0);
  const adm = botGuilds.reduce((s, g) => s + (g.adminCount || 0), 0);
  const mem = botGuilds.reduce((s, g) => s + (g.memberCount || 0), 0);
  document.getElementById('dvDbBody').innerHTML =
    `<table><thead><tr><th>السيرفر</th><th>الأعضاء</th><th>إعدادات</th><th>مدراء</th></tr></thead><tbody>${rows || '<tr><td colspan="4" style="text-align:center;color:rgba(255,255,255,.3)">لا توجد بيانات</td></tr>'}</tbody></table>` +
    `<div class="dv-modal-total"><span>الإجمالي: <b>${cfg}</b> إعداد</span><span>المدراء: <b>${adm}</b></span><span>الأعضاء: <b>${fmt(mem)}</b></span></div>`;
  document.getElementById('dvDbModal').classList.add('open');
}
function closeDbStats() { document.getElementById('dvDbModal').classList.remove('open'); }

// ── تنظيف التذاكر ──
async function cleanupTickets() {
  if (!confirm('تنظيف التذاكر القديمة من قاعدة البيانات؟')) return;
  try {
    const res = await fetch('/api/tickets/cleanup', { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      dvToast('✅ تم حذف ' + data.deleted + ' تذكرة');
    } else {
      dvToast('⚠️ ' + (data.error || 'لا يمكن التنظيف'), true);
    }
  } catch { dvToast('❌ فشل التنظيف', true); }
}

document.addEventListener('DOMContentLoaded', () => {
  document.getElementById('dvSearch')?.addEventListener('input', applySearch);

  let keys = 0, admins = 0, pending = botGuilds.length;
  const settle = () => {
    if (pending > 0) return;
    document.getElementById('dvDbKeys').textContent = fmt(keys);
  };
  if (pending === 0) { document.getElementById('dvDbKeys').textContent = '0'; }
  botGuilds.forEach(g => {
    fetch(`/api/guild/${g.id}/stats`).then(r => r.json()).then(d => {
      keys += d.configKeys || 0;
      admins += d.adminCount || 0;
      pending--; settle();
    }).catch(() => { pending--; settle(); });
  });

  fetch('/api/status').then(r => r.json()).then(d => {
    const el = document.getElementById('dvPing');
    if (el && d.ping != null) el.textContent = d.ping + 'ms';
  }).catch(() => {});

  fetch('/api/diagnostics').then(r => r.json()).then(d => {
    const row = document.getElementById('diagRow');
    if (!row) return;
    const num = v => v == null || isNaN(v) ? '—' : v;
    const cell = (label, value, ok) =>
      `<div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-radius:10px;padding:12px 14px">
        <div style="font-size:.72rem;color:rgba(255,255,255,0.35);margin-bottom:4px">${label}</div>
        <div style="font-weight:700;font-size:.95rem;color:${ok ? '#57f287' : '#f87171'}">${value}</div>
      </div>`;
    const botOk = d.botApi && d.botApi.online;
    row.innerHTML =
      cell('رابط API البوت', d.botApi.baseUrl, botOk) +
      cell('حالة البوت', botOk ? ('متصل • ' + num(d.botApi.stats.guilds) + ' سيرفر • ' + num(d.botApi.stats.members) + ' عضو • ' + num(d.botApi.stats.ping) + 'ms') : ('غير متصل' + (d.botApi.error ? ' (' + d.botApi.error + ')' : '')), botOk) +
      cell('توكن Discord', d.discord.hasBotToken ? 'متوفر ✓' : 'غير مضبوط ✗', d.discord.hasBotToken) +
      cell('MongoDB', (d.mongo.connected ? ('متصلة • ' + (d.mongo.dbName || '?')) : 'غير متصلة ✗'), d.mongo.connected);
    const colls = document.getElementById('diagColls');
    if (colls && d.mongo && d.mongo.connected && d.mongo.collections) {
      colls.style.display = 'grid';
      colls.innerHTML = Object.entries(d.mongo.collections).map(([k, c]) =>
        `<div><span>${k}:</span> <strong>${num(c)}</strong></div>`).join('');
    }
  }).catch(() => {});
});
</script>
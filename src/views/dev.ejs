<% currentPage = 'dev' %>
<div class="page-header">
  <h1><i class="fas fa-code"></i> لوحة المطور</h1>
  <p>مرحباً، <%= user.globalName || user.username %> — لديك صلاحية كاملة</p>
</div>

<div class="stats-grid">
  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #5865f2">
      <i class="fas fa-server"></i>
    </div>
    <div class="stat-info">
      <span class="stat-value"><%= botGuilds.length %></span>
      <span class="stat-label">سيرفرات البوت</span>
    </div>
  </div>

  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #57f287">
      <i class="fas fa-database"></i>
    </div>
    <div class="stat-info">
      <span class="stat-value" id="totalDbKeys">---</span>
      <span class="stat-label">مفاتيح DB</span>
    </div>
  </div>

  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #fee75c">
      <i class="fas fa-users-cog"></i>
    </div>
    <div class="stat-info">
      <span class="stat-value" id="totalAdmins">---</span>
      <span class="stat-label">إجمالي المدراء</span>
    </div>
  </div>
</div>

<div class="card glass">
  <div class="card-header"><h3><i class="fas fa-server"></i> جميع سيرفرات البوت</h3></div>
  <div class="dev-guilds">
    <% botGuilds.forEach(g => { %>
      <div class="dev-guild-item">
        <div class="dev-guild-info">
          <strong><%= g.name %></strong>
          <span>🗄️ <%= g.configCount || 0 %></span>
          <span>👥 <%= g.adminCount || 0 %></span>
        </div>
        <a href="/guilds/<%= g.id %>" class="btn-sm"><i class="fas fa-external-link-alt"></i></a>
      </div>
    <% }) %>
  </div>
</div>

<div class="card glass">
  <div class="card-header"><h3><i class="fas fa-database"></i> إدارة قاعدة البيانات</h3></div>
  <div class="dev-actions">
    <button class="btn-primary" onclick="showDbStats()">
      <i class="fas fa-chart-bar"></i> إحصائيات DB
    </button>
    <button class="btn-danger" onclick="cleanupTickets()">
      <i class="fas fa-broom"></i> تنظيف التذاكر القديمة
    </button>
  </div>
</div>

<div class="card glass" style="margin-top:20px">
  <div class="card-header">
    <h3><i class="fas fa-screwdriver-wrench"></i> وضع الصيانة</h3>
  </div>
  <div class="card-body" style="padding:16px 20px">
    <form method="POST" action="/dev/maintenance/toggle" id="mntForm">
      <input type="hidden" name="enabled" id="mntEnabled" value="<%= maintenance.enabled ? 'true' : 'false' %>">
      <input type="hidden" name="saveMinutes" id="mntSaveMinutes" value="">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
        <button type="button" id="mntToggleBtn" style="width:52px;height:28px;border-radius:14px;border:none;cursor:pointer;position:relative;flex-shrink:0;background:<%= maintenance.enabled ? '#e53935' : '#555' %>">
          <span style="position:absolute;top:3px;left:<%= maintenance.enabled ? '27px' : '3px' %>;width:22px;height:22px;border-radius:50%;background:#fff;transition:.3s" id="mntCircle"></span>
        </button>
        <span id="mntStatus" style="font-weight:600;font-size:.95rem"><%= maintenance.enabled ? '🟢 الصيانة مفعلة' : '⚪ الصيانة معطلة' %></span>
      </div>
      <div id="mntFields" style="<%= maintenance.enabled ? '' : 'display:none' %>">
        <div style="margin-bottom:12px">
          <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:4px;color:var(--text-muted)">مدة الصيانة (بالدقائق) — 0 = غير محددة</label>
          <input type="number" name="minutes" id="mntMinutes" value="<%= maintenance.endTime ? Math.max(1, Math.round((maintenance.endTime - Date.now()) / 60000)) : '' %>" style="width:100%;padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);box-sizing:border-box">
        </div>
        <div style="margin-bottom:12px">
          <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:4px;color:var(--text-muted)">رسالة الصيانة</label>
          <input type="text" name="message" id="mntMessage" value="<%= maintenance.message || '' %>" style="width:100%;padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);box-sizing:border-box">
        </div>
        <button type="submit" style="padding:10px 20px;border-radius:10px;border:none;background:var(--accent);color:#fff;font-weight:600;cursor:pointer">
          💾 حفظ الإعدادات
        </button>
      </div>
    </form>
  </div>
</div>

<script>
const botGuilds = <%= JSON.stringify(botGuilds) %>;
document.addEventListener('DOMContentLoaded', () => {
  let totalKeys = 0, totalAdmins = 0;
  Promise.all(botGuilds.map(g =>
    fetch(`/api/guild/${g.id}/stats`).then(r => r.json()).then(d => {
      totalKeys += d.configKeys || 0;
      totalAdmins += d.adminCount || 0;
    }).catch(() => {})
  )).then(() => {
    document.getElementById('totalDbKeys').textContent = totalKeys;
    document.getElementById('totalAdmins').textContent = totalAdmins;
  });
});

async function cleanupTickets() {
  if (!confirm('تنظيف التذاكر القديمة من قاعدة البيانات؟')) return;
  try {
    const res = await fetch('/api/tickets/cleanup', { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      alert('✅ تم حذف ' + data.deleted + ' تذكرة');
    } else {
      alert('⚠️ ' + (data.error || 'لا يمكن التنظيف'));
    }
  } catch { alert('❌ فشل التنظيف'); }
}

// ── Maintenance Mode ──────────────────────────────────────────────────
(function() {
  var mntOn = document.getElementById('mntEnabled').value === 'true';
  var mntBtn = document.getElementById('mntToggleBtn');
  var mntCircle = document.getElementById('mntCircle');
  var mntStat = document.getElementById('mntStatus');
  var mntFlds = document.getElementById('mntFields');

  function setUI(on) {
    mntBtn.style.background = on ? '#e53935' : '#555';
    mntCircle.style.left = on ? '27px' : '3px';
    mntFlds.style.display = on ? '' : 'none';
    mntStat.textContent = on ? '🟢 الصيانة مفعلة' : '⚪ الصيانة معطلة';
    document.getElementById('mntEnabled').value = on ? 'true' : 'false';
    mntOn = on;
  }

  mntBtn.addEventListener('click', function() {
    var newOn = !mntOn;
    setUI(newOn);
    document.getElementById('mntForm').submit();
  });

  document.getElementById('mntForm').addEventListener('submit', function() {
    var mins = parseInt(document.getElementById('mntMinutes').value) || 0;
    document.getElementById('mntSaveMinutes').value = mins;
  });
})();
</script>


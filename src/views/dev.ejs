<% currentPage = 'dev' %>
<div class="page-header">
  <h1><i class="fas fa-code"></i> لوحة المطور</h1>
  <p>مرحباً، <%= user.globalName || user.username %> — لديك صلاحية كاملة</p>
</div>

<div class="stats-grid">
  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #5865f2">
      <i class="fas fa-server"></i>
    </div>
    <div class="stat-info">
      <span class="stat-value"><%= botGuilds.length %></span>
      <span class="stat-label">سيرفرات البوت</span>
    </div>
  </div>

  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #57f287">
      <i class="fas fa-database"></i>
    </div>
    <div class="stat-info">
      <span class="stat-value" id="totalDbKeys">---</span>
      <span class="stat-label">مفاتيح DB</span>
    </div>
  </div>

  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #fee75c">
      <i class="fas fa-users-cog"></i>
    </div>
    <div class="stat-info">
      <span class="stat-value" id="totalAdmins">---</span>
      <span class="stat-label">إجمالي المدراء</span>
    </div>
  </div>
</div>

<div class="card glass">
  <div class="card-header"><h3><i class="fas fa-server"></i> جميع سيرفرات البوت</h3></div>
  <div class="dev-guilds">
    <% botGuilds.forEach(g => { %>
      <div class="dev-guild-item">
        <div class="dev-guild-info">
          <strong><%= g.name %></strong>
          <span>🗄️ <%= g.configCount || 0 %></span>
          <span>👥 <%= g.adminCount || 0 %></span>
        </div>
        <a href="/guilds/<%= g.id %>" class="btn-sm"><i class="fas fa-external-link-alt"></i></a>
      </div>
    <% }) %>
  </div>
</div>

<div class="card glass">
  <div class="card-header"><h3><i class="fas fa-database"></i> إدارة قاعدة البيانات</h3></div>
  <div class="dev-actions">
    <button class="btn-primary" onclick="showDbStats()">
      <i class="fas fa-chart-bar"></i> إحصائيات DB
    </button>
    <button class="btn-danger" onclick="cleanupTickets()">
      <i class="fas fa-broom"></i> تنظيف التذاكر القديمة
    </button>
  </div>
</div>

<style>
.mnt-card { overflow: hidden; }
.mnt-header { padding:20px 24px; display:flex; align-items:center; justify-content:space-between; background:<%= maintenance.enabled ? 'rgba(229,57,53,.08)' : 'transparent' %>; border-bottom:1px solid var(--border); transition:.3s; }
.mnt-status { display:flex; align-items:center; gap:14px; }
.mnt-dot { width:14px;height:14px;border-radius:50%;background:<%= maintenance.enabled ? '#e53935' : '#666' %>;box-shadow:<%= maintenance.enabled ? '0 0 20px rgba(229,57,53,.5)' : 'none' %>;animation:<%= maintenance.enabled ? 'mntPulse 1.5s ease-in-out infinite' : 'none' %>; }
@keyframes mntPulse { 0%,100%{box-shadow:0 0 8px rgba(229,57,53,.4)} 50%{box-shadow:0 0 24px rgba(229,57,53,.7)} }
.mnt-label { font-weight:700;font-size:.95rem;color:<%= maintenance.enabled ? '#e53935' : '#888' %>; }
.mnt-body { padding:20px 24px; }
.mnt-actions { display:flex;gap:10px;flex-wrap:wrap; }
.mnt-btn { display:inline-flex;align-items:center;gap:8px;padding:10px 22px;border-radius:10px;font-weight:700;font-size:.85rem;text-decoration:none;cursor:pointer;border:none;transition:.2s; }
.mnt-btn:hover { transform:translateY(-1px); }
.mnt-btn-start { background:linear-gradient(135deg,#4caf50,#388e3c);color:#fff;box-shadow:0 4px 15px rgba(76,175,80,.3); }
.mnt-btn-start:hover { box-shadow:0 6px 20px rgba(76,175,80,.4); }
.mnt-btn-stop { background:linear-gradient(135deg,#e53935,#c62828);color:#fff;box-shadow:0 4px 15px rgba(229,57,53,.3); }
.mnt-btn-stop:hover { box-shadow:0 6px 20px rgba(229,57,53,.4); }
.mnt-btn-save { background:linear-gradient(135deg,var(--accent),var(--accent-hover));color:#fff;box-shadow:0 4px 15px rgba(88,101,242,.3); }
.mnt-btn-save:hover { box-shadow:0 6px 20px rgba(88,101,242,.4); }
.mnt-btn-ghost { background:rgba(255,255,255,.04);color:var(--text-muted);border:1px solid var(--border); }
.mnt-btn-ghost:hover { background:rgba(255,255,255,.08);color:var(--text); }
.mnt-form-row { margin-bottom:14px; }
.mnt-form-row:last-child { margin-bottom:0; }
.mnt-form-row label { display:block;font-size:.82rem;font-weight:600;margin-bottom:5px;color:var(--text-muted); }
.mnt-form-row input { width:100%;padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);box-sizing:border-box;font-size:.9rem;outline:none;transition:.2s; }
.mnt-form-row input:focus { border-color:var(--accent);box-shadow:0 0 0 3px rgba(88,101,242,.15); }
.mnt-divider { height:1px;background:var(--border);margin:16px 0; }
</style>

<div class="card glass mnt-card">
  <div class="mnt-header">
    <div class="mnt-status">
      <div class="mnt-dot"></div>
      <div>
        <div class="mnt-label"><%= maintenance.enabled ? 'وضع الصيانة — مفعل' : 'وضع الصيانة — معطل' %></div>
        <div style="font-size:.75rem;color:var(--text-muted);margin-top:2px">
          <% if (maintenance.enabled) { %>
            الصيانة عامة — جميع الزوار يتأثرون
          <% } else { %>
            كل الخدمات تعمل بشكل طبيعي
          <% } %>
        </div>
      </div>
    </div>
    <div class="mnt-actions">
      <% if (maintenance.enabled) { %>
        <a href="/dev/maintenance/stop" class="mnt-btn mnt-btn-stop"><i class="fas fa-power-off"></i> إيقاف الصيانة</a>
      <% } else { %>
        <a href="/dev/maintenance/start" class="mnt-btn mnt-btn-start"><i class="fas fa-shield-halved"></i> تفعيل الصيانة</a>
      <% } %>
    </div>
  </div>
  <div class="mnt-body" style="<%= maintenance.enabled ? '' : 'opacity:.5' %>">
    <form method="POST" action="/dev/maintenance/save" id="mntSaveForm">
      <div style="margin-bottom:12px">
        <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:6px;color:var(--text-muted)">⏱ المدة</label>
        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px">
          <% var presets = [15,30,60,120,360,1440]; %>
          <% presets.forEach(function(m) { %>
            <button type="button" class="mnt-preset" data-minutes="<%= m %>" style="padding:6px 14px;border-radius:8px;border:1px solid var(--border);background:rgba(255,255,255,.04);color:var(--text);cursor:pointer;font-size:.82rem;font-weight:600;transition:.2s"><%= m < 60 ? m+'د' : (m/60)+'س' %></button>
          <% }) %>
          <button type="button" id="mntCustomBtn" class="mnt-preset mnt-preset-active" data-minutes="0" style="padding:6px 14px;border-radius:8px;border:1px solid var(--border);background:var(--accent);color:#fff;cursor:pointer;font-size:.82rem;font-weight:600;transition:.2s">⌨️ مخصص</button>
        </div>
        <div style="display:flex;gap:8px;align-items:center">
          <input type="number" name="minutes" id="mntMinutes" min="0" placeholder="الدقائق" value="<%= maintenance.endTime ? Math.max(1, Math.round((maintenance.endTime - Date.now()) / 60000)) : '' %>" style="flex:1;min-width:100px;padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);box-sizing:border-box;font-size:.9rem;outline:none;transition:.2s">
          <input type="datetime-local" name="endTime" id="mntEndTime" value="<%= maintenance.endTime ? new Date(maintenance.endTime).toLocaleString('sv-SE').replace(' ','T').slice(0,16) : '' %>" style="flex:1.5;min-width:170px;padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);box-sizing:border-box;font-size:.9rem;outline:none;transition:.2s">
        </div>
      </div>
      <div style="margin-bottom:12px">
        <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:6px;color:var(--text-muted)">💬 رسالة الصيانة</label>
        <input type="text" name="message" value="<%= maintenance.message || '' %>" placeholder="الموقع تحت الصيانة حالياً..." style="width:100%;padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);box-sizing:border-box;font-size:.9rem;outline:none;transition:.2s">
      </div>
      <div style="display:flex;gap:8px;align-items:center">
        <button type="submit" class="mnt-btn mnt-btn-save"><i class="fas fa-check"></i> حفظ الإعدادات</button>
        <span style="font-size:.8rem;color:var(--text-muted)" id="mntSummary"></span>
      </div>
    </form>
    <script>
    (function(){
      var f = document.getElementById('mntSaveForm');
      var mins = document.getElementById('mntMinutes');
      var dt = document.getElementById('mntEndTime');
      var presets = document.querySelectorAll('.mnt-preset');
      var summary = document.getElementById('mntSummary');

      function updateSummary() {
        var v = parseInt(mins.value) || 0;
        if (v > 0) summary.textContent = '🕐 تنتهي بعد ' + v + ' دقيقة';
        else if (dt.value) summary.textContent = '📅 تنتهي في ' + dt.value;
        else summary.textContent = '⏳ غير محددة';
      }

      presets.forEach(function(b) {
        b.addEventListener('click', function() {
          presets.forEach(function(p) { p.style.background = 'rgba(255,255,255,.04)'; p.style.color = 'var(--text)'; });
          var m = parseInt(this.dataset.minutes);
          if (m > 0) {
            this.style.background = 'var(--accent)'; this.style.color = '#fff';
            mins.value = m; dt.value = '';
          } else {
            document.getElementById('mntCustomBtn').style.background = 'var(--accent)'; document.getElementById('mntCustomBtn').style.color = '#fff';
            mins.value = ''; dt.focus();
          }
          updateSummary();
        });
      });

      mins.addEventListener('input', function() {
        if (this.value) dt.value = '';
        presets.forEach(function(p) { p.style.background = 'rgba(255,255,255,.04)'; p.style.color = 'var(--text)'; });
        document.getElementById('mntCustomBtn').style.background = 'var(--accent)'; document.getElementById('mntCustomBtn').style.color = '#fff';
        updateSummary();
      });

      dt.addEventListener('input', function() {
        if (this.value) mins.value = '';
        presets.forEach(function(p) { p.style.background = 'rgba(255,255,255,.04)'; p.style.color = 'var(--text)'; });
        document.getElementById('mntCustomBtn').style.background = 'var(--accent)'; document.getElementById('mntCustomBtn').style.color = '#fff';
        updateSummary();
      });

      updateSummary();
    })();
    </script>
    <% if (maintenance.enabled) { %>
    <div class="mnt-divider"></div>
    <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
      <a href="/maintenance?preview=1" target="_blank" class="mnt-btn mnt-btn-ghost"><i class="fas fa-eye"></i> معاينة صفحة الصيانة</a>
      <% if (maintenance.endTime) { %>
        <span style="font-size:.8rem;color:var(--text-muted)">🕐 تنتهي <span dir="ltr"><%= new Date(maintenance.endTime).toLocaleString('ar-EG') %></span></span>
      <% } %>
    </div>
    <% } %>
  </div>
</div>

<script>
const botGuilds = <%= JSON.stringify(botGuilds) %>;
document.addEventListener('DOMContentLoaded', () => {
  let totalKeys = 0, totalAdmins = 0;
  Promise.all(botGuilds.map(g =>
    fetch(`/api/guild/${g.id}/stats`).then(r => r.json()).then(d => {
      totalKeys += d.configKeys || 0;
      totalAdmins += d.adminCount || 0;
    }).catch(() => {})
  )).then(() => {
    document.getElementById('totalDbKeys').textContent = totalKeys;
    document.getElementById('totalAdmins').textContent = totalAdmins;
  });
});

async function cleanupTickets() {
  if (!confirm('تنظيف التذاكر القديمة من قاعدة البيانات؟')) return;
  try {
    const res = await fetch('/api/tickets/cleanup', { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      alert('✅ تم حذف ' + data.deleted + ' تذكرة');
    } else {
      alert('⚠️ ' + (data.error || 'لا يمكن التنظيف'));
    }
  } catch { alert('❌ فشل التنظيف'); }
}
</script>


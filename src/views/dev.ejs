<% currentPage = 'dev' %>
<%
  const fmt = n => { n = Number(n) || 0; return n >= 1000 ? (n / 1000).toFixed(1) + 'K' : String(n); };
  const totalConfigs = botGuilds.reduce((s, g) => s + (g.configCount || 0), 0);
  const totalAdmins = botGuilds.reduce((s, g) => s + (g.adminCount || 0), 0);
%>
<div class="dv">
  <div class="dv-bg">
    <div class="dv-orb dv-o1"></div>
    <div class="dv-orb dv-o2"></div>
    <div class="dv-grid"></div>
  </div>

  <!-- ── الهيرو ── -->
  <section class="dv-hero">
    <div class="dv-avatar">
      <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=128" alt="" onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
      <span class="dv-status"></span>
    </div>
    <div class="dv-hero-main">
      <div class="dv-eyebrow"><i class="fas fa-code"></i> لوحة المطور — KRS <span class="dv-ver">v5.0</span></div>
      <h1>مرحباً، <span class="dv-name"><%= user.globalName || user.username %></span></h1>
      <p>تحكم كامل بالبوت: السيرفرات المتصلة، التشخيص، قاعدة البيانات، ووضع الصيانة — كلها من مكان واحد.</p>
      <div class="dv-pills">
        <span><i class="fas fa-crown" style="color:#fbbf24"></i> صلاحية كاملة</span>
        <span><i class="fas fa-server" style="color:#818cf8"></i> إدارة مركزية</span>
        <span><i class="fas fa-shield-halved" style="color:#57f287"></i> أدوات صيانة</span>
        <span><i class="fas fa-wave-square" style="color:#60a5fa"></i> بيانات مباشرة</span>
      </div>
      <div class="dv-cta">
        <a href="<%= botInviteUrl %>" target="_blank" class="dv-btn dv-btn-primary"><i class="fas fa-code-branch"></i> دعوة البوت</a>
        <a href="/status" class="dv-btn dv-btn-ghost"><i class="fas fa-heartbeat"></i> حالة البوت</a>
      </div>
    </div>
    <div class="dv-hero-side">
      <div class="dv-role"><i class="fas fa-user-shield"></i> المالك: <b><%= user.globalName || user.username %></b></div>
      <div class="dv-mini">
        <div class="dv-mini-ic ic-p"><i class="fas fa-layer-group"></i></div>
        <div class="dv-mini-txt"><b><%= totalConfigs %></b><span>إعداد مخصص</span></div>
      </div>
      <div class="dv-mini">
        <div class="dv-mini-ic ic-g"><i class="fas fa-users-cog"></i></div>
        <div class="dv-mini-txt"><b><%= totalAdmins %></b><span>مدراء معتمدون</span></div>
      </div>
    </div>
  </section>

  <!-- ── مؤشرات حية ── -->
  <section class="dv-kpis">
    <div class="dv-kpi">
      <div class="dv-kpi-ic ic-p"><i class="fas fa-server"></i></div>
      <div class="dv-kpi-txt"><b id="dvGuilds"><%= botGuilds.length %></b><span>سيرفر متصل</span></div>
    </div>
    <div class="dv-kpi">
      <div class="dv-kpi-ic ic-g"><i class="fas fa-users"></i></div>
      <div class="dv-kpi-txt"><b><%= fmt(totalMembers) %></b><span>إجمالي الأعضاء</span></div>
    </div>
    <div class="dv-kpi">
      <div class="dv-kpi-ic ic-a"><i class="fas fa-gauge-high"></i></div>
      <div class="dv-kpi-txt"><b id="dvPing">—</b><span>سرعة البنج</span></div>
    </div>
    <div class="dv-kpi">
      <div class="dv-kpi-ic ic-c"><i class="fas fa-database"></i></div>
      <div class="dv-kpi-txt"><b id="dvDbKeys">—</b><span>مفتاح DB</span></div>
    </div>
  </section>

  <!-- ── السيرفرات المتصلة بالبوت ── -->
  <div class="dv-sec-head dv-sec-row">
    <h2><i class="fas fa-server"></i> السيرفرات المتصلة بالبوت <span class="dv-count"><%= botGuilds.length %></span></h2>
    <span>جميع السيرفرات التي يعمل فيها البوت مع روابط انضمام</span>
    <div class="dv-search"><i class="fas fa-search"></i><input id="dvSearch" type="text" placeholder="بحث عن سيرفر..."></div>
    <button class="dv-refresh" type="button" onclick="location.reload()" title="تحديث القائمة"><i class="fas fa-rotate"></i></button>
  </div>

  <section class="dv-invite-banner">
    <div class="dv-invite-txt">
      <div class="dv-invite-ic"><i class="fas fa-code-branch"></i></div>
      <div>
        <b>أضف البوت إلى سيرفر آخر</b>
        <p>ادعُ البوت إلى أي سيرفر تديره — سيظهر هنا تلقائياً مع زر انضمام جاهز.</p>
      </div>
    </div>
    <a href="<%= botInviteUrl %>" target="_blank" class="dv-btn dv-btn-primary"><i class="fas fa-plus"></i> دعوة البوت</a>
  </section>

  <% if (!botGuilds.length) { %>
  <section class="dv-empty">
    <div class="dv-empty-ic"><i class="fas fa-plug-circle-xmark"></i></div>
    <h4>لا توجد سيرفرات متصلة</h4>
    <p>البوت غير متصل بأي سيرفر حالياً، أو تعذر الاتصال بالبوت. دعوة البوت هي أول خطوة.</p>
    <a href="<%= botInviteUrl %>" target="_blank" class="dv-btn dv-btn-primary"><i class="fas fa-code-branch"></i> دعوة البوت</a>
  </section>
  <% } else { %>
  <section class="dv-g-grid">
    <% botGuilds.forEach(g => { %>
    <div class="dv-g-card" data-name="<%= g.name %>">
      <div class="dv-g-ava <%= g.icon ? '' : 'noimg' %>">
        <% if (g.icon) { %>
        <img src="https://cdn.discordapp.com/icons/<%= g.id %>/<%= g.icon %>.png?size=128" alt="" onerror="this.remove();this.parentNode.classList.add('noimg')">
        <% } %>
        <span class="dv-g-letter"><%= (g.name || '?').charAt(0) %></span>
      </div>
      <div class="dv-g-body">
        <div class="dv-g-top">
          <b><%= g.name %></b>
          <span class="dv-g-mem"><i class="fas fa-user"></i> <%= fmt(g.memberCount) %></span>
        </div>
        <div class="dv-g-meta">
          <span><i class="fas fa-cog" style="color:#60a5fa"></i> <%= g.configCount || 0 %> إعداد</span>
          <span><i class="fas fa-users-cog" style="color:#fbbf24"></i> <%= g.adminCount || 0 %> مدراء</span>
        </div>
        <div class="dv-g-actions">
          <button type="button" class="dv-btn dv-btn-join" onclick="joinGuild('<%= g.id %>', this)" data-gname="<%= g.name %>"><i class="fas fa-right-to-bracket"></i> انضمام</button>
          <a href="/guilds/<%= g.id %>" class="dv-btn dv-btn-ghost"><i class="fas fa-sliders"></i> لوحة التحكم</a>
        </div>
      </div>
    </div>
    <% }) %>
  </section>
  <% } %>

  <!-- ── تشخيص الاتصال ── -->
  <div class="dv-sec-head"><h2><i class="fas fa-stethoscope"></i> تشخيص الاتصال والإحصائيات</h2></div>
  <section class="dv-panel">
    <div id="diagRow" class="dv-diag">
      <div class="dv-diag-note"><i class="fas fa-spinner fa-spin"></i> جارِ الفحص...</div>
    </div>
    <div id="diagColls" class="dv-diag-colls"></div>
  </section>

  <!-- ── إدارة قاعدة البيانات ── -->
  <div class="dv-sec-head"><h2><i class="fas fa-database"></i> إدارة قاعدة البيانات</h2></div>
  <section class="dv-panel dv-db-bar">
    <button type="button" class="dv-btn dv-btn-primary" onclick="showDbStats()"><i class="fas fa-chart-bar"></i> إحصائيات DB</button>
    <button type="button" class="dv-btn dv-btn-danger" onclick="cleanupTickets()"><i class="fas fa-broom"></i> تنظيف التذاكر القديمة</button>
  </section>

  <!-- ── وضع الصيانة ── -->
  <div class="dv-sec-head">
    <h2><i class="fas fa-shield-halved"></i> وضع الصيانة</h2>
    <span class="dv-mnt-state <%= maintenance.enabled ? 'on' : '' %>"><i class="fas fa-circle"></i> <%= maintenance.enabled ? 'الصيانة مفعلة' : 'الخدمات تعمل بشكل طبيعي' %></span>
  </div>

  <section class="dv-panel dv-mnt <%= maintenance.enabled ? 'on' : '' %>">
    <div class="dv-mnt-head">
      <div class="dv-mnt-status">
        <div class="dv-mnt-dot"></div>
        <div>
          <div class="dv-mnt-label"><%= maintenance.enabled ? 'وضع الصيانة — مفعل' : 'وضع الصيانة — معطل' %></div>
          <div class="dv-mnt-sub">
            <% if (maintenance.enabled) { %>
              الصيانة عامة — جميع الزوار يتأثرون
            <% } else { %>
              كل الخدمات تعمل بشكل طبيعي
            <% } %>
          </div>
        </div>
      </div>
      <div class="dv-mnt-actions">
        <% if (maintenance.enabled) { %>
          <button type="button" class="dv-btn dv-btn-danger" id="mntShowChangelogBtn"><i class="fas fa-power-off"></i> إيقاف الصيانة</button>
        <% } else { %>
          <a href="/dev/maintenance/start" id="mntStartBtn" class="dv-btn dv-btn-success" style="opacity:.5;pointer-events:none"><i class="fas fa-play"></i> تفعيل الصيانة</a>
        <% } %>
      </div>
    </div>

    <div class="dv-mnt-body <%= maintenance.enabled ? '' : 'dim' %>">
      <div class="dv-mnt-note">
        <i class="fas fa-circle-exclamation"></i>
        <div>يجب اختيار المدة الزمنية أولاً لتفعيل زر البدء. يمكنك إدخال <strong>0</strong> للصيانة بدون وقت محدد (مفتوحة).</div>
      </div>

      <form method="POST" action="/dev/maintenance/save" id="mntSaveForm">
        <input type="hidden" name="minutes" id="mntMinutesField" value="">
        <div class="dv-mnt-f">
          <label>⏱ المدة الزمنية</label>
          <div class="dv-mnt-presets">
            <button type="button" class="mnt-preset" data-min="15">15د</button>
            <button type="button" class="mnt-preset" data-min="30">30د</button>
            <button type="button" class="mnt-preset" data-min="60">1س</button>
            <button type="button" class="mnt-preset" data-min="120">2س</button>
            <button type="button" class="mnt-preset" data-min="360">6س</button>
            <button type="button" class="mnt-preset" data-min="1440">24س</button>
            <button type="button" id="mntCustomBtn" class="mnt-preset"><i class="fas fa-keyboard"></i> مخصص</button>
          </div>
          <div class="dv-mnt-inputs">
            <input type="number" id="mntMinutes" min="0" placeholder="عدد الدقائق (0 = بدون وقت محدد)">
            <input type="datetime-local" id="mntPicker">
          </div>
        </div>

        <div class="dv-mnt-f">
          <label>💬 رسالة الصيانة</label>
          <input type="text" name="message" id="mntMessage" value="<%= maintenance.message || '' %>" placeholder="الموقع تحت الصيانة حالياً...">
        </div>

        <div class="dv-mnt-f">
          <label>📢 روم إشعارات الصيانة (ID)</label>
          <input type="text" name="channelId" id="mntChannel" value="<%= maintenance.channelId || '' %>" placeholder="أدخل ID الروم في الديسكورد" style="direction:ltr;text-align:left;font-family:monospace">
          <div class="dv-hint">يُرسل إشعار عند بدء وانتهاء الصيانة في هذا الروم</div>
        </div>

        <div class="dv-mnt-save-row">
          <button type="submit" class="dv-btn dv-btn-primary"><i class="fas fa-check"></i> حفظ الإعدادات</button>
          <span id="mntSummary"></span>
        </div>
        <div class="dv-hint">💡 حفظ الإعدادات لا يرسل إشعار في الديسكورد. يتم الإرسال فقط عند تفعيل أو إيقاف الصيانة.</div>
      </form>

      <script>
      (function(){
        var mins = document.getElementById('mntMinutes');
        var picker = document.getElementById('mntPicker');
        var hidden = document.getElementById('mntMinutesField');
        var summary = document.getElementById('mntSummary');
        var presets = document.querySelectorAll('.mnt-preset');
        var customBtn = document.getElementById('mntCustomBtn');

        function setActive(btn) {
          presets.forEach(function(p) { p.classList.remove('active'); });
          if (customBtn) customBtn.classList.remove('active');
          if (btn) btn.classList.add('active');
        }

        function calcMins() {
          var m = parseInt(mins.value) || 0;
          if (m > 0) {
            picker.value = '';
            hidden.value = m;
            summary.textContent = '🕐 تنتهي بعد ' + m + ' دقيقة';
            return;
          }
          var d = picker.value;
          if (d) {
            mins.value = '';
            var diff = Math.round((new Date(d).getTime() - Date.now()) / 60000);
            if (diff > 0) {
              hidden.value = diff;
              summary.textContent = '📅 تنتهي ' + d;
              return;
            }
          }
          hidden.value = '';
          summary.textContent = '⏳ غير محددة';
        }

        presets.forEach(function(b) {
          b.addEventListener('click', function() {
            setActive(this);
            mins.value = this.dataset.min;
            picker.value = '';
            calcMins();
          });
        });

        customBtn.addEventListener('click', function() {
          setActive(null);
          customBtn.classList.add('active');
          mins.value = '';
          picker.value = '';
          picker.focus();
          calcMins();
        });

        mins.addEventListener('input', function() {
          setActive(null);
          if (this.value) picker.value = '';
          calcMins();
        });

        picker.addEventListener('input', function() {
          setActive(null);
          if (this.value) mins.value = '';
          calcMins();
        });

        document.getElementById('mntSaveForm').addEventListener('submit', function(e) {
          calcMins();
        });

        <% if (maintenance.durationMinutes > 0) { %>
          mins.value = <%= maintenance.durationMinutes %>;
          hidden.value = <%= maintenance.durationMinutes %>;
          summary.textContent = '🕐 تنتهي بعد <%= maintenance.durationMinutes %> دقيقة';
        <% } %>

        function updateStartBtn() {
          var btn = document.getElementById('mntStartBtn');
          if (!btn) return;
          var hasTime = !!(parseInt(mins.value) > 0) || !!(picker.value) || (parseInt(mins.value) === 0);
          btn.style.opacity = hasTime ? '1' : '.5';
          btn.style.pointerEvents = hasTime ? 'auto' : 'none';
        }

        updateStartBtn();
        mins.addEventListener('input', updateStartBtn);
        picker.addEventListener('input', updateStartBtn);
        presets.forEach(function(b) {
          b.addEventListener('click', updateStartBtn);
        });
        customBtn.addEventListener('click', function() {
          setTimeout(updateStartBtn, 50);
        });
      })();
      </script>

      <% if (maintenance.enabled) { %>
      <div class="dv-mnt-divider"></div>
      <div class="dv-mnt-extra">
        <a href="/maintenance?preview=1" target="_blank" class="dv-btn dv-btn-ghost"><i class="fas fa-eye"></i> معاينة صفحة الصيانة</a>
        <% if (maintenance.endTime) { %>
          <span class="dv-hint">🕐 تنتهي <span dir="ltr"><%= new Date(maintenance.endTime).toLocaleString('ar-EG') %></span></span>
        <% } %>
      </div>
      <!-- Changelog form (hidden, shown when clicking stop) -->
      <div class="dv-mnt-divider"></div>
      <div id="mntChangelogSection" style="display:none">
        <div class="dv-mnt-chg-title"><i class="fas fa-scroll"></i> سجل التحديثات — أضف ملخصاً للتغييرات التي تمت أثناء الصيانة</div>
        <form method="POST" action="/dev/maintenance/stop" id="mntStopForm">
          <div class="dv-mnt-f">
            <label><i class="fas fa-robot"></i> تحديثات البوت — الأوامر، الأنظمة، الحماية، الصوت، التكتات...</label>
            <textarea name="botUpdates" rows="4" placeholder="مثال: تم إصلاح مشكلة /ping↵تم إضافة أمر /newcommand↵تم تحسين أداء البوت"><%= maintenance.changelog && maintenance.changelog.botUpdates || '' %></textarea>
            <div class="dv-hint">إذا تركت الحقل فارغاً، سيتم إرسال "لم يتم إضافة تحديثات" تلقائياً</div>
          </div>
          <div class="dv-mnt-f">
            <label><i class="fas fa-globe"></i> تحديثات الموقع — لوحة التحكم، التصميم، API، السرعة...</label>
            <textarea name="siteUpdates" rows="4" placeholder="مثال: إعادة تصميم صفحة الإحصائيات↵إصلاح مشكلة الوقت في العدّاد↵تحسين سرعة تحميل الصفحات"><%= maintenance.changelog && maintenance.changelog.siteUpdates || '' %></textarea>
            <div class="dv-hint">إذا تركت الحقل فارغاً، سيتم إرسال "لم يتم إضافة تحديثات" تلقائياً</div>
          </div>
          <div class="dv-mnt-actions-row">
            <button type="submit" class="dv-btn dv-btn-danger"><i class="fas fa-power-off"></i> تأكيد إيقاف الصيانة وإرسال الإشعار</button>
            <button type="button" class="dv-btn dv-btn-ghost" id="mntCancelChangelog"><i class="fas fa-times"></i> إلغاء</button>
          </div>
        </form>
      </div>
      <script>
      (function(){
        var showBtn = document.getElementById('mntShowChangelogBtn');
        var section = document.getElementById('mntChangelogSection');
        var cancelBtn = document.getElementById('mntCancelChangelog');
        var botField = document.querySelector('textarea[name="botUpdates"]');
        var siteField = document.querySelector('textarea[name="siteUpdates"]');
        var stopForm = document.getElementById('mntStopForm');

        // Restore from localStorage if DB is empty (user was typing before refresh)
        if (botField && siteField) {
          var savedBot = localStorage.getItem('mntChangelogBot');
          var savedSite = localStorage.getItem('mntChangelogSite');
          if (savedBot && !botField.value.trim()) botField.value = savedBot;
          if (savedSite && !siteField.value.trim()) siteField.value = savedSite;
          // Auto-save on input
          botField.addEventListener('input', function() { localStorage.setItem('mntChangelogBot', botField.value); });
          siteField.addEventListener('input', function() { localStorage.setItem('mntChangelogSite', siteField.value); });
        }

        if (showBtn && section) {
          showBtn.addEventListener('click', function() {
            section.style.display = 'block';
            showBtn.style.display = 'none';
            section.scrollIntoView({ behavior: 'smooth', block: 'center' });
          });
          // Auto-open if there's unsaved text in localStorage
          if (localStorage.getItem('mntChangelogBot') || localStorage.getItem('mntChangelogSite')) {
            showBtn.click();
          }
        }
        if (cancelBtn && section && showBtn) {
          cancelBtn.addEventListener('click', function() {
            section.style.display = 'none';
            showBtn.style.display = '';
          });
        }
        // Clear localStorage on successful form submit
        if (stopForm) {
          stopForm.addEventListener('submit', function() {
            localStorage.removeItem('mntChangelogBot');
            localStorage.removeItem('mntChangelogSite');
          });
        }
      })();
      </script>
      <% } %>
    </div>
  </section>

  <%- include('partials/dev-developers') %>

  <style>
  .dv{max-width:1120px;margin:0 auto;position:relative;padding-bottom:28px}
  .dv-bg{position:fixed;inset:0;pointer-events:none;z-index:0}
  .dv-orb{position:absolute;border-radius:50%;filter:blur(140px)}
  .dv-o1{width:520px;height:520px;background:#6366f1;top:-260px;right:-120px;opacity:0.06}
  .dv-o2{width:420px;height:420px;background:#8b5cf6;bottom:-220px;left:-120px;opacity:0.05}
  .dv-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.02) 1px,transparent 1px);background-size:64px 64px;-webkit-mask-image:radial-gradient(ellipse 90% 55% at 50% 0%,#000 0%,transparent 75%);mask-image:radial-gradient(ellipse 90% 55% at 50% 0%,#000 0%,transparent 75%)}

  /* ── الهيرو ── */
  .dv-hero{position:relative;z-index:1;display:flex;align-items:center;gap:28px;padding:30px;border-radius:22px;background:rgba(14,14,30,0.55);border:1px solid rgba(255,255,255,0.07);box-shadow:0 24px 70px rgba(0,0,0,0.28);overflow:hidden}
  .dv-hero::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,#6366f1 40%,#8b5cf6 60%,transparent)}
  .dv-avatar{position:relative;width:88px;height:88px;flex-shrink:0}
  .dv-avatar img{width:100%;height:100%;border-radius:50%;object-fit:cover;border:3px solid rgba(99,102,241,0.35);box-shadow:0 0 0 7px rgba(99,102,241,0.08),0 14px 34px rgba(0,0,0,0.35)}
  .dv-status{position:absolute;bottom:2px;right:2px;width:20px;height:20px;border-radius:50%;background:#57f287;border:4px solid #0e0e1e}
  .dv-hero-main{flex:1;min-width:0}
  .dv-eyebrow{display:inline-flex;align-items:center;gap:7px;font-size:0.68rem;font-weight:600;color:#818cf8;background:rgba(99,102,241,0.08);border:1px solid rgba(99,102,241,0.14);padding:4px 13px;border-radius:100px;margin-bottom:12px}
  .dv-eyebrow i{font-size:0.6rem}
  .dv-ver{display:inline-block;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.08);color:rgba(255,255,255,0.4);padding:1px 8px;border-radius:100px;font-size:0.6rem}
  .dv-hero h1{font-size:1.6rem;font-weight:800;margin:0 0 7px;line-height:1.25}
  .dv-name{background:linear-gradient(135deg,#818cf8,#c4b5fd);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}

<% currentPage = 'dev' %>
<div class="page-header">
  <h1><i class="fas fa-code"></i> لوحة المطور</h1>
  <p>مرحباً، <%= user.globalName || user.username %> — لديك صلاحية كاملة</p>
</div>

<div class="stats-grid">
  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #5865f2">
      <i class="fas fa-server"></i>
    </div>
    <div class="stat-info">
      <span class="stat-value"><%= botGuilds.length %></span>
      <span class="stat-label">سيرفرات البوت</span>
    </div>
  </div>

  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #57f287">
      <i class="fas fa-database"></i>
    </div>
    <div class="stat-info">
      <span class="stat-value" id="totalDbKeys">---</span>
      <span class="stat-label">مفاتيح DB</span>
    </div>
  </div>

  <div class="stat-card glass">
    <div class="stat-icon" style="--stat-color: #fee75c">
      <i class="fas fa-users-cog"></i>
    </div>
    <div class="stat-info">
      <span class="stat-value" id="totalAdmins">---</span>
      <span class="stat-label">إجمالي المدراء</span>
    </div>
  </div>
</div>

<div class="card glass">
  <div class="card-header"><h3><i class="fas fa-server"></i> جميع سيرفرات البوت</h3></div>
  <div class="dev-guilds">
    <% botGuilds.forEach(g => { %>
      <div class="dev-guild-item">
        <div class="dev-guild-info">
          <strong><%= g.name %></strong>
          <span>🗄️ <%= g.configCount || 0 %></span>
          <span>👥 <%= g.adminCount || 0 %></span>
        </div>
        <a href="/guilds/<%= g.id %>" class="btn-sm"><i class="fas fa-external-link-alt"></i></a>
      </div>
    <% }) %>
  </div>
</div>

<div class="card glass">
  <div class="card-header"><h3><i class="fas fa-database"></i> إدارة قاعدة البيانات</h3></div>
  <div class="dev-actions">
    <button class="btn-primary" onclick="showDbStats()">
      <i class="fas fa-chart-bar"></i> إحصائيات DB
    </button>
    <button class="btn-danger" onclick="cleanupTickets()">
      <i class="fas fa-broom"></i> تنظيف التذاكر القديمة
    </button>
  </div>
</div>

<div class="card glass" style="margin-top:20px">
  <div class="card-header">
    <h3><i class="fas fa-screwdriver-wrench"></i> وضع الصيانة</h3>
  </div>
  <div class="card-body" style="padding:16px 20px">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
      <label style="position:relative;display:inline-block;width:48px;height:26px">
        <input type="checkbox" id="maintenanceToggle" <%= maintenance.enabled ? 'checked' : '' %> style="opacity:0;width:0;height:0">
        <span style="position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:<%= maintenance.enabled ? '#e53935' : '#555' %>;border-radius:26px;transition:.3s">
          <span style="position:absolute;content:'';height:20px;width:20px;left:<%= maintenance.enabled ? '24px' : '4px' %>;bottom:3px;background:#fff;border-radius:50%;transition:.3s"></span>
        </span>
      </label>
      <span id="mntStatus" style="font-weight:600;font-size:.95rem"><%= maintenance.enabled ? '🟢 الصيانة مفعلة' : '⚪ الصيانة معطلة' %></span>
    </div>
    <div id="maintenanceFields" style="<%= maintenance.enabled ? '' : 'display:none' %>">
      <div style="margin-bottom:12px">
        <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:4px;color:var(--text-muted)">مدة الصيانة (بالدقائق)</label>
        <input type="number" id="maintenanceMinutes" placeholder="0 = مدة مفتوحة" value="<%= maintenance.endTime ? Math.max(1, Math.round((maintenance.endTime - Date.now()) / 60000)) : '' %>" style="width:100%;padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);box-sizing:border-box">
      </div>
      <div style="margin-bottom:12px">
        <label style="display:block;font-size:.82rem;font-weight:600;margin-bottom:4px;color:var(--text-muted)">رسالة الصيانة</label>
        <input type="text" id="maintenanceMessage" placeholder="رسالة تظهر للمستخدمين" value="<%= maintenance.message || '' %>" style="width:100%;padding:10px 14px;border-radius:10px;background:var(--bg-secondary);border:1px solid var(--border);color:var(--text);box-sizing:border-box">
      </div>
      <button class="btn-primary" onclick="saveMaintenance()" style="border:none;cursor:pointer;padding:10px 20px;border-radius:10px;font-weight:600">
        💾 حفظ التغييرات
      </button>
    </div>
  </div>
</div>

<script>
const botGuilds = <%= JSON.stringify(botGuilds) %>;
document.addEventListener('DOMContentLoaded', () => {
  let totalKeys = 0, totalAdmins = 0;
  Promise.all(botGuilds.map(g =>
    fetch(`/api/guild/${g.id}/stats`).then(r => r.json()).then(d => {
      totalKeys += d.configKeys || 0;
      totalAdmins += d.adminCount || 0;
    }).catch(() => {})
  )).then(() => {
    document.getElementById('totalDbKeys').textContent = totalKeys;
    document.getElementById('totalAdmins').textContent = totalAdmins;
  });
});

async function cleanupTickets() {
  if (!confirm('تنظيف التذاكر القديمة من قاعدة البيانات؟')) return;
  try {
    const res = await fetch('/api/tickets/cleanup', { method: 'POST' });
    const data = await res.json();
    if (data.success) {
      alert('✅ تم حذف ' + data.deleted + ' تذكرة');
    } else {
      alert('⚠️ ' + (data.error || 'لا يمكن التنظيف'));
    }
  } catch { alert('❌ فشل التنظيف'); }
}

// ── Maintenance Mode ──────────────────────────────────────────────────
const mntToggle = document.getElementById('maintenanceToggle');
const mntStatus = document.getElementById('mntStatus');
mntToggle?.addEventListener('change', function() {
  const fields = document.getElementById('maintenanceFields');
  const bg = this.parentElement.querySelector('span');
  const circle = bg.querySelector('span');
  if (this.checked) {
    fields.style.display = 'block';
    bg.style.background = '#e53935';
    circle.style.left = '24px';
    mntStatus.textContent = '🟢 الصيانة مفعلة';
  } else {
    fields.style.display = 'none';
    bg.style.background = '#555';
    circle.style.left = '4px';
    mntStatus.textContent = '⚪ الصيانة معطلة';
  }
  saveMaintenance();
});

async function saveMaintenance() {
  const enabled = document.getElementById('maintenanceToggle').checked;
  const minutes = parseInt(document.getElementById('maintenanceMinutes').value) || 0;
  const message = document.getElementById('maintenanceMessage').value;
  const endTime = minutes > 0 ? Date.now() + minutes * 60 * 1000 : null;

  try {
    const res = await fetch('/dev/maintenance/toggle', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ enabled, endTime, message }),
    });
    const data = await res.json();
    if (data.success) {
      document.getElementById('maintenanceMinutes').value = minutes;
    }
  } catch {}
}
</script>


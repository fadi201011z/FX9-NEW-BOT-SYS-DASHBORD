<% layout = 'layouts/main' %>
<% currentPage = 'home' %>
<%
  const guilds = user?.guilds || [];
%>
<div class="p">
  <canvas id="fxParticles"></canvas>
  <div class="p-bg">
    <div class="p-orb p-o1"></div>
    <div class="p-orb p-o2"></div>
    <div class="p-orb p-o3"></div>
  </div>
  <div class="p-grid"></div>
  <div class="cube c1"><i></i><i></i><i></i><i></i><i></i><i></i></div>
  <div class="cube c2"><i></i><i></i><i></i><i></i><i></i><i></i></div>
  <div class="cube c3"><i></i><i></i><i></i><i></i><i></i><i></i></div>

  <div class="p-hero">
    <div class="p-h-left">
      <div class="p-avatar-ring">
        <div class="p-avatar">
          <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=128" alt="" onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
          <span class="p-dot"></span>
        </div>
      </div>
      <div class="p-badge"><i class="fas fa-bolt"></i> FX9 Bot v5.0</div>
      <h1 class="p-greeting">مرحباً، <span class="p-grad"><%= user.globalName || user.username %></span></h1>
      <p class="p-bio">لوحة تحكم متكاملة — أنظمة الحماية، التذاكر، الصوت، والإشراف في مكان واحد</p>
    </div>
    <div class="p-h-right">
      <div class="p-stat p-stat-p" data-tilt>
        <div class="p-stat-ring"><i class="fas fa-server"></i></div>
        <div class="p-stat-body">
          <span class="p-sn" id="hpManaged" data-t="<%= managedGuilds.length %>">0</span>
          <span class="p-sl">سيرفر تديره</span>
        </div>
      </div>
      <div class="p-stat p-stat-g" data-tilt>
        <div class="p-stat-ring"><i class="fas fa-layer-group"></i></div>
        <div class="p-stat-body">
          <span class="p-sn" id="hpTotal" data-t="<%= guilds.length %>">0</span>
          <span class="p-sl">إجمالي سيرفراتك</span>
        </div>
      </div>
      <div class="p-stat p-stat-a" data-tilt>
        <div class="p-stat-ring"><i class="fas fa-terminal"></i></div>
        <div class="p-stat-body">
          <span class="p-sn" id="hpHeroCmd" data-t="0">—</span>
          <span class="p-sl">أمر منفذ</span>
        </div>
      </div>
    </div>
  </div>

  <div class="p-power" data-tilt>
    <div class="p-power-top"><i class="fas fa-bolt"></i> قوة FX9 — إحصائيات حية <span class="p-live"><i class="fas fa-circle"></i> مباشر</span></div>
    <div class="p-power-grid">
      <div class="pp">
        <span class="pp-n" id="hpCmd" data-t="0">—</span>
        <span class="pp-l">أمر منفّذ</span>
      </div>
      <div class="pp">
        <span class="pp-n" id="hpGuilds" data-t="0">—</span>
        <span class="pp-l">سيرفر نشط</span>
      </div>
      <div class="pp">
        <span class="pp-n" id="hpMembers" data-t="0">—</span>
        <span class="pp-l">عضو</span>
      </div>
      <div class="pp">
        <span class="pp-n" id="hpPing" data-t="0">—</span>
        <span class="pp-l">سرعة البنج</span>
      </div>
    </div>
  </div>

  <div class="p-divider"><span><i class="fas fa-cubes"></i> الأنظمة</span></div>

  <div class="p-grid-c">
    <% if (roleLevel >= 3) { %>
    <a href="/dashboard" class="p-card" style="--pc:#6366f1" data-tilt>
      <div class="p-card-glow"></div>
      <div class="p-ci" style="background:rgba(99,102,241,0.1);color:#6366f1"><i class="fas fa-th-large"></i></div>
      <h3>لوحة التحكم</h3>
      <p>نظرة عامة وإحصائيات</p>
      <div class="p-card-line"></div>
      <div class="shine"></div>
    </a>
    <% } %>
    <a href="/guilds" class="p-card" style="--pc:#34d399" data-tilt>
      <div class="p-card-glow"></div>
      <div class="p-ci" style="background:rgba(52,211,153,0.1);color:#34d399"><i class="fas fa-server"></i></div>
      <h3>السيرفرات</h3>
      <p>تصفح وإدارة</p>
      <div class="p-card-line"></div>
      <div class="shine"></div>
    </a>
    <a href="/guilds" class="p-card" style="--pc:#fbbf24" data-tilt>
      <div class="p-card-glow"></div>
      <div class="p-ci" style="background:rgba(251,191,36,0.1);color:#fbbf24"><i class="fas fa-ticket-alt"></i></div>
      <h3>التذاكر</h3>
      <p>دعم فني متكامل</p>
      <div class="p-card-line"></div>
      <div class="shine"></div>
    </a>
    <% if (roleLevel >= 2) { %>
    <a href="/docs#protection" class="p-card" style="--pc:#f87171" data-tilt>
      <div class="p-card-glow"></div>
      <div class="p-ci" style="background:rgba(248,113,113,0.1);color:#f87171"><i class="fas fa-shield-halved"></i></div>
      <h3>الحماية</h3>
      <p>أمان وحظر ذكي</p>
      <div class="p-card-line"></div>
      <div class="shine"></div>
    </a>
    <% } %>
    <% if (roleLevel >= 1) { %>
    <a href="/docs#voice" class="p-card" style="--pc:#a78bfa" data-tilt>
      <div class="p-card-glow"></div>
      <div class="p-ci" style="background:rgba(167,139,250,0.1);color:#a78bfa"><i class="fas fa-microphone"></i></div>
      <h3>الغرف الصوتية</h3>
      <p>رومات مؤقتة</p>
      <div class="p-card-line"></div>
      <div class="shine"></div>
    </a>
    <% } %>
    <% if (roleLevel >= 2) { %>
    <a href="/docs#commands" class="p-card" style="--pc:#60a5fa" data-tilt>
      <div class="p-card-glow"></div>
      <div class="p-ci" style="background:rgba(96,165,250,0.1);color:#60a5fa"><i class="fas fa-terminal"></i></div>
      <h3>الأوامر</h3>
      <p>صلاحيات وتحكم</p>
      <div class="p-card-line"></div>
      <div class="shine"></div>
    </a>
    <% } %>
  </div>

  <div class="p-divider"><span><i class="fas fa-link"></i> روابط</span></div>

  <div class="p-qs">
    <a href="/status" class="p-q" style="--qc:#6366f1" data-tilt><i class="fas fa-heartbeat"></i><span>حالة البوت</span></a>
    <% if (roleLevel >= 4) { %><a href="/dev" class="p-q" style="--qc:#a78bfa" data-tilt><i class="fas fa-code"></i><span>المطور</span></a><% } %>
    <a href="/docs" class="p-q" style="--qc:#34d399" data-tilt><i class="fas fa-book"></i><span>التوثيق</span></a>
    <button onclick="toggleTheme()" class="p-q" style="--qc:#fbbf24;cursor:pointer;border:none;font-family:var(--font)" data-tilt><i class="fas fa-palette"></i><span>السمة</span></button>
  </div>
</div>

<style>
@property --bc { syntax:'<angle>'; initial-value:0deg; inherits:false; }
.p{max-width:1100px;margin:0 auto;position:relative}
#fxParticles{position:fixed;inset:0;z-index:0;pointer-events:none}
.p-bg{position:fixed;inset:0;pointer-events:none;z-index:0}
.p-orb{position:absolute;border-radius:50%;filter:blur(150px)}
.p-o1{width:600px;height:600px;background:#6366f1;top:-300px;left:-150px;opacity:0.05;animation:pF 18s ease-in-out infinite}
.p-o2{width:400px;height:400px;background:#8b5cf6;bottom:-200px;right:-100px;opacity:0.04;animation:pF 18s ease-in-out infinite;animation-delay:-6s}
.p-o3{width:300px;height:300px;background:#fbbf24;top:40%;right:30%;opacity:0.03;animation:pF 18s ease-in-out infinite;animation-delay:-12s}
@keyframes pF{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(40px,-30px) scale(1.05)}66%{transform:translate(-20px,30px) scale(0.95)}}
.p-grid{position:fixed;inset:0;background-image:linear-gradient(rgba(255,255,255,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.02) 1px,transparent 1px);background-size:60px 60px;pointer-events:none;z-index:0;opacity:0.5}

/* ── مكعبات ثلاثية الأبعاد عائمة ── */
.cube{position:fixed;width:64px;height:64px;transform-style:preserve-3d;opacity:.16;pointer-events:none;z-index:0;animation:cubeSpin 22s linear infinite}
.cube i{position:absolute;inset:0;border:1px solid rgba(99,102,241,.5);background:rgba(99,102,241,.06)}
.cube i:nth-child(1){transform:translateZ(32px)}
.cube i:nth-child(2){transform:rotateY(180deg) translateZ(32px)}
.cube i:nth-child(3){transform:rotateY(90deg) translateZ(32px)}
.cube i:nth-child(4){transform:rotateY(-90deg) translateZ(32px)}
.cube i:nth-child(5){transform:rotateX(90deg) translateZ(32px)}
.cube i:nth-child(6){transform:rotateX(-90deg) translateZ(32px)}
.c1{width:64px;height:64px;top:18%;right:4%}
.c2{width:40px;height:40px;bottom:20%;left:3%;animation-delay:-8s;animation-duration:16s}
.c2 i{transform:translateZ(20px)}
.c2 i:nth-child(1){transform:translateZ(20px)}
.c2 i:nth-child(2){transform:rotateY(180deg) translateZ(20px)}
.c2 i:nth-child(3){transform:rotateY(90deg) translateZ(20px)}
.c2 i:nth-child(4){transform:rotateY(-90deg) translateZ(20px)}
.c2 i:nth-child(5){transform:rotateX(90deg) translateZ(20px)}
.c2 i:nth-child(6){transform:rotateX(-90deg) translateZ(20px)}
.c3{width:28px;height:28px;top:55%;right:38%;opacity:.12;animation-delay:-14s;animation-duration:12s}
.c3 i{transform:translateZ(14px)}
.c3 i:nth-child(1){transform:translateZ(14px)}
.c3 i:nth-child(2){transform:rotateY(180deg) translateZ(14px)}
.c3 i:nth-child(3){transform:rotateY(90deg) translateZ(14px)}
.c3 i:nth-child(4){transform:rotateY(-90deg) translateZ(14px)}
.c3 i:nth-child(5){transform:rotateX(90deg) translateZ(14px)}
.c3 i:nth-child(6){transform:rotateX(-90deg) translateZ(14px)}
@keyframes cubeSpin{from{transform:rotateX(-22deg) rotateY(0)}to{transform:rotateX(-22deg) rotateY(360deg)}}

/* ── الهيرو ── */
.p-hero{position:relative;z-index:1;display:grid;grid-template-columns:1fr 1fr;gap:40px;padding:28px 0 12px}
@media(max-width:800px){.p-hero{grid-template-columns:1fr;gap:24px}}
.p-avatar-ring{width:76px;height:76px;border-radius:50%;padding:3px;position:relative;margin-bottom:14px;background:conic-gradient(from var(--bc,#6366f1),#6366f1,#8b5cf6,#fbbf24,#34d399,#6366f1);animation:avatarSpin 6s linear infinite;box-shadow:0 0 44px rgba(99,102,241,.35)}
@keyframes avatarSpin{to{--bc:360deg}}
.p-avatar{position:relative;width:100%;height:100%;border-radius:50%;overflow:hidden;background:#06060e}
.p-avatar img{width:100%;height:100%;object-fit:cover;border-radius:50%;display:block}
.p-dot{position:absolute;bottom:0;right:0;width:16px;height:16px;border-radius:50%;background:#57f287;border:3px solid #06060e;animation:dotPulse 2.2s ease-in-out infinite}
@keyframes dotPulse{0%,100%{box-shadow:0 0 0 0 rgba(87,242,135,.5)}50%{box-shadow:0 0 0 8px rgba(87,242,135,0)}}
.p-badge{display:inline-flex;align-items:center;gap:6px;padding:4px 14px;border-radius:100px;background:rgba(99,102,241,0.06);border:1px solid rgba(99,102,241,0.08);font-size:0.68rem;font-weight:600;color:#818cf8;margin-bottom:12px}
.p-badge i{color:#fbbf24}
.p-greeting{font-size:2rem;font-weight:800;margin:0 0 6px;line-height:1.2}
.p-grad{background:linear-gradient(135deg,#6366f1,#8b5cf6,#fbbf24);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;position:relative}
.p-bio{font-size:0.88rem;color:rgba(255,255,255,0.3);margin:0;line-height:1.7}
.p-h-right{display:flex;flex-direction:column;gap:12px;justify-content:center}
.p-stat{display:flex;align-items:center;gap:16px;padding:16px 20px;border-radius:14px;background:rgba(12,12,26,0.6);backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,0.05);transition:transform .35s cubic-bezier(.16,1,.3,1),border-color .35s,box-shadow .35s;will-change:transform;position:relative;overflow:hidden}
.p-stat::before{content:'';position:absolute;inset:0;border-radius:14px;padding:1px;background:conic-gradient(from var(--bc,0deg),transparent 0 100deg,var(--pc2,#6366f1) 130deg,transparent 160deg 360deg);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;opacity:0;transition:opacity .4s;animation:borderSpin 5s linear infinite;pointer-events:none}
.p-stat:hover::before{opacity:.9}
.p-stat-p{--pc2:#6366f1}.p-stat-g{--pc2:#34d399}.p-stat-a{--pc2:#fbbf24}
.p-stat:hover{transform:translateY(-4px);border-color:rgba(255,255,255,0.08);box-shadow:0 16px 40px rgba(0,0,0,.3),0 0 30px -10px var(--pc2,#6366f1)}
.p-stat-ring{width:42px;height:42px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1rem;flex-shrink:0}
.p-stat-p .p-stat-ring{background:rgba(99,102,241,0.1);color:#6366f1}
.p-stat-g .p-stat-ring{background:rgba(52,211,153,0.1);color:#34d399}
.p-stat-a .p-stat-ring{background:rgba(251,191,36,0.1);color:#fbbf24}
.p-sn{display:block;font-size:1.25rem;font-weight:800;background:linear-gradient(135deg,#6366f1,#8b5cf6);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1.2}
.p-sl{font-size:0.7rem;color:rgba(255,255,255,0.22)}

/* ── شريط القوة ── */
.p-power{position:relative;z-index:1;margin:34px 0 6px;border-radius:16px;padding:20px 24px;background:linear-gradient(135deg,rgba(99,102,241,0.04),rgba(139,92,246,0.04));backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,0.05);overflow:hidden;transition:transform .35s cubic-bezier(.16,1,.3,1)}
.p-power::before{content:'';position:absolute;inset:0;border-radius:16px;padding:1px;background:conic-gradient(from var(--bc,0deg),transparent 0%,#6366f1 12%,#8b5cf6 24%,#fbbf24 36%,transparent 48%);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;animation:borderSpin 6s linear infinite;pointer-events:none}
.p-power::after{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:70%;height:1px;background:linear-gradient(90deg,transparent,#fbbf24,transparent);opacity:.6}
@keyframes borderSpin{to{--bc:360deg}}
.p-power-top{display:flex;align-items:center;gap:9px;font-size:0.85rem;font-weight:700;margin-bottom:16px;color:rgba(255,255,255,0.85)}
.p-power-top>i{color:#fbbf24;font-size:0.95rem;animation:boltPulse 2s ease-in-out infinite}
@keyframes boltPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.25)}}
.p-live{display:inline-flex;align-items:center;gap:5px;margin-inline-start:auto;font-size:0.65rem;font-weight:600;color:#57f287;padding:3px 10px;border-radius:100px;background:rgba(87,242,135,0.08);border:1px solid rgba(87,242,135,0.15)}
.p-live i{font-size:0.4rem;animation:dotPulse 2s ease-in-out infinite}
.p-power-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
@media(max-width:700px){.p-power-grid{grid-template-columns:repeat(2,1fr);gap:12px}}
.pp{text-align:center;padding:10px 6px;border-radius:12px;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.04);transition:all .3s}
.pp:hover{background:rgba(255,255,255,0.04);transform:translateY(-2px)}
.pp-n{display:block;font-size:1.5rem;font-weight:800;background:linear-gradient(135deg,#fbbf24,#f59e0b);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1.3}
.pp-l{font-size:0.68rem;color:rgba(255,255,255,0.28)}

.p-divider{display:flex;align-items:center;gap:14px;margin:30px 0 18px;position:relative;z-index:1}
.p-divider::before,.p-divider::after{content:'';flex:1;height:1px;background:linear-gradient(90deg,transparent,rgba(99,102,241,0.12),transparent)}
.p-divider span{display:inline-flex;align-items:center;gap:7px;font-size:0.78rem;font-weight:700;color:rgba(255,255,255,0.2);padding:0 8px}
.p-divider span i{color:rgba(129,140,248,0.5)}

/* ── بطاقات الأنظمة (3D Tilt) ── */
.p-grid-c{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;position:relative;z-index:1}
@media(max-width:900px){.p-grid-c{grid-template-columns:repeat(2,1fr)}}
@media(max-width:500px){.p-grid-c{grid-template-columns:1fr}}
.p-card{position:relative;padding:26px 16px 20px;border-radius:16px;background:rgba(12,12,26,0.55);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.05);text-align:center;transition:transform .35s cubic-bezier(.16,1,.3,1),border-color .35s,box-shadow .35s;overflow:hidden;display:block;will-change:transform}
.p-card::before{content:'';position:absolute;inset:0;border-radius:16px;padding:1px;background:conic-gradient(from var(--bc,0deg),transparent 0 100deg,var(--pc,#6366f1) 130deg,transparent 160deg 360deg);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;opacity:0;transition:opacity .4s;animation:borderSpin 4.5s linear infinite;pointer-events:none}
.p-card:hover::before{opacity:.85}
.p-card:hover{transform:translateY(-6px);border-color:rgba(255,255,255,0.08);box-shadow:0 20px 50px rgba(0,0,0,.35),0 0 46px -12px var(--pc,#6366f1)}
.p-card-glow{position:absolute;top:var(--my,50%);left:var(--mx,50%);width:260px;height:260px;transform:translate(-50%,-50%);border-radius:50%;background:radial-gradient(circle,var(--pc,#6366f1) 0%,transparent 70%);opacity:0;transition:opacity .4s;filter:blur(8px);pointer-events:none}
.p-card:hover .p-card-glow{opacity:.15}
.p-ci{width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.05rem;margin:0 auto 12px;transition:all .4s;position:relative;z-index:1;box-shadow:0 0 0 0 transparent}
.p-card:hover .p-ci{transform:translateY(-3px) scale(1.08);box-shadow:0 8px 24px -8px var(--pc,#6366f1)}
.p-card h3{font-size:0.9rem;font-weight:700;margin:0 0 3px;position:relative;z-index:1}
.p-card p{font-size:0.7rem;color:rgba(255,255,255,0.25);margin:0;position:relative;z-index:1}
.p-card-line{position:absolute;bottom:0;left:20px;right:20px;height:2px;border-radius:2px;background:linear-gradient(90deg,transparent,var(--pc,#6366f1),transparent);opacity:0;transition:opacity .4s;z-index:1}
.p-card:hover .p-card-line{opacity:1}
.shine{position:absolute;top:0;left:-80%;width:55%;height:100%;background:linear-gradient(105deg,transparent,rgba(255,255,255,0.07),transparent);transform:skewX(-20deg);pointer-events:none}
.p-card:hover .shine{animation:shineSweep .8s ease}
@keyframes shineSweep{0%{left:-80%}100%{left:135%}}

/* ── الروابط ── */
.p-qs{display:flex;gap:10px;flex-wrap:wrap;position:relative;z-index:1}
.p-q{display:inline-flex;align-items:center;gap:8px;padding:11px 22px;border-radius:12px;background:rgba(12,12,26,0.6);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.05);font-size:0.82rem;font-weight:600;color:rgba(255,255,255,0.5);transition:all .35s cubic-bezier(.16,1,.3,1);position:relative;overflow:hidden}
.p-q::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,var(--qc,#6366f1),transparent);opacity:0;transition:opacity .35s}
.p-q:hover::before{opacity:.07}
.p-q i{position:relative;z-index:1;color:var(--qc,#6366f1)}
.p-q span{position:relative;z-index:1}
.p-q:hover{transform:translateY(-3px);border-color:rgba(255,255,255,0.08);color:white;box-shadow:0 12px 30px rgba(0,0,0,.3),0 0 24px -10px var(--qc,#6366f1)}

@media(max-width:720px){
  .p-greeting{font-size:1.5rem}
  .p-hero{padding:16px 0}
  .p-qs{flex-direction:column}
  .p-q{justify-content:center}
  .cube{display:none}
}
</style>
<script>
(function(){
  function countUp(el, target, dur){
    if(!el) return;
    target = Number(target)||0;
    dur = dur||1200;
    var t0 = performance.now();
    function fmt(v){ return v.toLocaleString('en-US'); }
    function tick(t){
      var p = Math.min(1, (t - t0) / dur);
      var e = 1 - Math.pow(1 - p, 3);
      el.textContent = fmt(target * e);
      if (p < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
  // إحصائيات معروفة من الخادم
  countUp(document.getElementById('hpManaged'), document.getElementById('hpManaged').dataset.t, 900);
  countUp(document.getElementById('hpTotal'), document.getElementById('hpTotal').dataset.t, 900);
  // جلب إحصائيات حية من البوت
  Promise.all([
    fetch('/api/commands/stats').then(function(r){ return r.ok ? r.json() : null }).catch(function(){ return null }),
    fetch('/api/status').then(function(r){ return r.ok ? r.json() : null }).catch(function(){ return null }),
  ]).then(function(a){
    var s = a[0], d = a[1];
    var cmd = s && s.total ? Number(s.total) : 0;
    if (cmd) { countUp(document.getElementById('hpHeroCmd'), cmd, 1400); countUp(document.getElementById('hpCmd'), cmd, 1400); }
    if (d) {
      countUp(document.getElementById('hpGuilds'), Number(d.guildCount) || 0, 1400);
      countUp(document.getElementById('hpMembers'), Number(d.members) || 0, 1400);
      var pg = document.getElementById('hpPing');
      if (pg) { if (d.ping != null) { pg.textContent = Number(d.ping) + 'ms'; } else { pg.textContent = '—'; } }
    }
  });
  // ميلان ثلاثي الأبعاد يتبع الماوس + بقعة ضوء ديناميكية
  document.querySelectorAll('.p-card, .p-stat, .p-q').forEach(function(c){
    c.addEventListener('mousemove', function(e){
      var r = c.getBoundingClientRect();
      var x = (e.clientX - r.left) / r.width - 0.5;
      var y = (e.clientY - r.top) / r.height - 0.5;
      c.style.transform = 'perspective(900px) rotateY(' + (x * 9).toFixed(2) + 'deg) rotateX(' + (-y * 9).toFixed(2) + 'deg) translateY(-6px)';
      c.style.setProperty('--mx', ((x + 0.5) * 100).toFixed(1) + '%');
      c.style.setProperty('--my', ((y + 0.5) * 100).toFixed(1) + '%');
    });
    c.addEventListener('mouseleave', function(){
      c.style.transform = '';
      c.style.setProperty('--mx', '50%');
      c.style.setProperty('--my', '50%');
    });
  });
  // جزيئات متحركة في الخلفية
  var cv = document.getElementById('fxParticles');
  function initParticles(){
    if (!cv) return;
    var ctx = cv.getContext('2d');
    var W, H, pts = [];
    function rs(){
      W = cv.width = window.innerWidth;
      H = cv.height = window.innerHeight;
      pts = [];
      var n = Math.min(60, Math.floor(window.innerWidth / 24));
      for (var i = 0; i < n; i++){
        pts.push({ x: Math.random()*W, y: Math.random()*H, r: Math.random()*1.8+0.6, vx: (Math.random()-.5)*.28, vy: (Math.random()-.5)*.28, a: Math.random()*.45+.12 });
      }
    }
    rs();
    window.addEventListener('resize', rs);
    (function loop(){
      ctx.clearRect(0, 0, W, H);
      for (var i = 0; i < pts.length; i++){
        var p = pts[i];
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0) p.x = W; if (p.x > W) p.x = 0;
        if (p.y < 0) p.y = H; if (p.y > H) p.y = 0;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, 7);
        ctx.fillStyle = 'rgba(136,146,255,' + p.a + ')';
        ctx.fill();
      }
      requestAnimationFrame(loop);
    })();
  }
  initParticles();
})();
</script>
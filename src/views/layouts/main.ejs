<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Kratos Dashboard</title>
  <meta name="description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : 'Kratos Dashboard — لوحة تحكم متقدمة لإدارة بوت KRS على ديسكورد' %>">
  <meta property="og:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : title + ' — Kratos Dashboard' %>" />
  <meta property="og:description" content="<%= typeof ogDesc !== 'undefined' ? ogDesc : 'Kratos Dashboard — لوحة تحكم متقدمة لإدارة بوت KRS على ديسكورد' %>" />
  <meta property="og:image" content="https://kratos-botdashboard.onrender.com/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Kratos Dashboard — لوحة تحكم نظام كراتوس" />
  <meta property="og:url" content="https://kratos-botdashboard.onrender.com" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Kratos Dashboard" />
  <meta property="og:locale" content="ar_AR" />
  <meta name="theme-color" content="#a855f7" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : title + ' — Kratos Dashboard' %>" />
  <meta name="twitter:description" content="<%= typeof ogDesc !== 'undefined' ? ogDesc : 'Kratos Dashboard — لوحة تحكم متقدمة لإدارة بوت KRS على ديسكورد' %>" />
  <meta name="twitter:image" content="https://kratos-botdashboard.onrender.com/og-image.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
</head>
<body>
  <%- include('../partials/navbar') %>
  <div class="layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <%- body %>
    </main>
  </div>
  <%- include('../partials/footer') %>
  <script src="/js/theme.js"></script>
  <script src="/js/websocket.js"></script>
  <script src="/js/main.js"></script>
  <script>
const autoRefreshPages = ['dashboard', 'guild-overview', 'tickets', 'voice', 'admins', 'logs', 'guilds', 'dev', 'status'];
const currentPg = '<%= typeof currentPage !== "undefined" ? currentPage : "" %>';
if (autoRefreshPages.includes(currentPg)) {
  setInterval(() => location.reload(), 45000);
}
  </script>
</body>
</html>

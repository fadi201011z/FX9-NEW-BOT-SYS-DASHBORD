<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Kratos Dashboard</title>
  <meta name="description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : 'Kratos Dashboard — لوحة تحكم متقدمة لإدارة بوت KRS على ديسكورد' %>">
  <meta property="og:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : title + ' — Kratos Dashboard' %>" />
  <meta property="og:description" content="<%= typeof ogDesc !== 'undefined' ? ogDesc : 'Kratos Dashboard — لوحة تحكم متقدمة لإدارة بوت KRS على ديسكورد' %>" />
  <meta property="og:url" content="https://kratos-botdashboard.onrender.com" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Kratos Dashboard" />
  <meta property="og:locale" content="ar_AR" />
  <meta name="theme-color" content="#090713" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : title + ' — Kratos Dashboard' %>" />
  <meta name="twitter:description" content="<%= typeof ogDesc !== 'undefined' ? ogDesc : 'Kratos Dashboard — لوحة تحكم متقدمة لإدارة بوت KRS على ديسكورد' %>" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <%# shell.css after style.css on purpose: it owns the bar, the rail and their
      menus, and wins on load order rather than on specificity. See its header. -%>
  <link rel="stylesheet" href="/css/shell.css">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <%# The shell introduces itself once per tab. See the note on html.no-arrival in
      css/shell.css for why the arrival has to be limited at all; this is why the
      limit lives here and not in a script file.

      Inline, in <head>, and before the first paint, because the class has to be
      on <html> by the time anything is drawn. js/shell.js sits at the end of
      <body>, so a class written there would arrive after the browser had already
      been free to paint -- which on the second load of a tab means the first
      frames of the arrival get drawn and then cut off, a flash of precisely the
      thing this is meant to stop. A stylesheet rule cannot do this job for the
      same reason: no rule can ask a question only JavaScript can answer.

      sessionStorage and not a cookie, for the two reasons that are visible: it
      is per tab, so a second tab gets its own introduction rather than inheriting
      a stranger's, and it dies with the tab instead of outliving it. The catch is
      not defensive noise -- storage disabled throws here, and the cost of that is
      only today's behaviour, the arrival on every load. -%>
  <script>
    try {
      if (sessionStorage.getItem('nx-arrival')) {
        document.documentElement.classList.add('no-arrival');
      } else {
        sessionStorage.setItem('nx-arrival', '1');
      }
    } catch (e) { /* storage disabled: the shell arrives on every load, as before */ }
  </script>
</head>
<body>
  <%- include('../partials/navbar') %>
  <div class="layout">
    <%# This document is RTL, so the first child of .layout is the rightmost.
        The server rail is on the window's edge and the navigation rail is inboard
        of it, so this is also the tab order: the switcher, then the menu, then the
        page. Both are position:fixed, so DOM order decides nothing about paint --
        only stacking and focus, and it should agree with what the eye reads. -%>
    <%- include('../partials/guild-rail') %>
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <%- body %>
    </main>
  </div>
  <%- include('../partials/footer') %>
  <script src="/js/theme.js"></script>
  <script src="/js/websocket.js"></script>
  <script src="/js/main.js"></script>
  <%# shell.js last: it observes the classes main.js and websocket.js write, so
      it wants the DOM to exist but does not care who wrote what. -%>
  <script src="/js/shell.js"></script>
  <script>
    /*
     * Auto-refresh, guarded.
     *
     * This used to be an unconditional location.reload() on a 45 second timer, on
     * nine pages. It threw
     * away scroll position, any dropdown or modal the user had open, and
     * whatever they had half-typed into a form -- a bot admin configuring a
     * server could lose a paragraph of text because the clock ran out.
     *
     * Same intent, three guards:
     *   1. refresh while the tab is in the background, so returning to it lands
     *      on fresh data instead of stale data;
     *   2. never refresh with a modal open or a field focused;
     *   3. never refresh within a few seconds of the user having touched the
     *      page -- a reload under a moving mouse is the same as (2).
     * If any guard says busy, the refresh is deferred, not dropped: `due` stays
     * set and the next visibilitychange or focus retries it.
     */
    const autoRefreshPages = ['dashboard', 'guild-overview', 'tickets', 'voice', 'admins', 'logs', 'guilds', 'dev', 'status'];
    const currentPg = '<%= typeof currentPage !== "undefined" ? currentPage : "" %>';
    if (autoRefreshPages.includes(currentPg)) {
      const REFRESH_MS = 45000;
      const SETTLE_MS = 8000;
      let due = false;
      let lastTouch = 0;

      ['pointerdown', 'keydown', 'wheel', 'input'].forEach(function (ev) {
        document.addEventListener(ev, function () { lastTouch = Date.now(); }, { passive: true, capture: true });
      });

      setInterval(function () { due = true; }, REFRESH_MS);

      function refreshBlocked() {
        if (document.visibilityState !== 'visible') return true;
        if (document.querySelector('.modal.show, .pay-modal.show, .dropdown.show, .user-menu-dropdown.show, .notif-menu.show')) return true;
        var el = document.activeElement;
        if (el && /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName)) return true;
        return Date.now() - lastTouch < SETTLE_MS;
      }

      function flushRefresh() {
        if (!due || refreshBlocked()) return;
        due = false;
        location.reload();
      }

      document.addEventListener('visibilitychange', flushRefresh);
      window.addEventListener('focus', flushRefresh);
    }
  </script>
</body>
</html>

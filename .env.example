# ════════════════════════════════════════════════════════════════
#  Kratos Dashboard — متغيرات البيئة (انسخ القيم في Northflank)
#  ⚠️ لا ترفع هذا الملف بـ Git — ضع القيم في Northflank مباشرة
# ════════════════════════════════════════════════════════════════

# ─── إعدادات عامة ───
NODE_ENV=production
PORT=10000

# ─── الأمان (مهم جداً) ───
# سر عشوائي طويل — ولّد واحداً: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ⚠️ يجب أن يكون نفس قيمة API_SECRET في البوت تماماً
SESSION_SECRET=

# ─── Discord OAuth2 ───
CLIENT_ID=
CLIENT_SECRET=
# لازم دومين الداشبورد الفعلي (مثل https://fx9dash.onrender.com)
CALLBACK_URL=
# معرّف صاحب البوت (للمسجّلينyng وللمالك)
OWNER_ID=

# ─── الاتصال بالبوت ───
# رابط البوت العام (بعد نقله) أو http://localhost:10000 إن كان على نفس الشبكة
BOT_API_URL=
# نفس سر API_SECRET الموجود في البوت
API_SECRET=

# ─── قاعدة البيانات ───
# Northflank addon: mongodb://user:pass@host:27017/fx9_dashboard
# أو Atlas:          mongodb+srv://user:pass@cluster.mongodb.net/fx9_dashboard
MONGODB_URI=
